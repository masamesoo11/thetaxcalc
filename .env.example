# ─── Required Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# JWT secret for admin authentication (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Admin password for /admin panel
ADMIN_PASSWORD=your_admin_password_here

# ─── Public (client-side) Variables ────────────────────────────────────────────
# These are inlined at build time and exposed to the browser.

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://thetaxcalc.com

# Google Tag Manager Container ID (starts with GTM-)
# Get from: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Google Analytics 4 Measurement ID (starts with G-) — optional, can use GTM instead
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Client ID (starts with ca-pub-) — optional
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
