,\"template\":[\"$\",\"$L11\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n21:T1645,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/resources#webpage\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Data, Brackets & Rates — Free Reference\",\"description\":\"Free 2026 federal tax brackets, FICA rates, state tax comparison, deductions & 401(k) limits. IRS-sourced. Cite freely.\",\"url\":\"https://thetaxcalc.com/resources\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/resources#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/resources#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/resources#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/resources#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tax Data & Resources\"}]},{\"@id\":\"https://thetaxcalc.com/resources#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/resources#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Are these 2026 tax brackets final?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 federal income tax brackets shown on this page are based on IRS Revenue Procedure 2025-XX, which adjusts brackets for inflation annually. The IRS typically publishes final figures in late October or November of the preceding year. We update this page within 48 hours of official IRS publication. The numbers shown are the most current available.\"}},{\"@type\":\"Question\",\"name\":\"What is the Social Security wage base for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Social Security (OASDI) wage base for 2026 is $184,500. This means the 6.2% Social Security tax applies only to the first $184,500 of earned income. Any wages above this amount are not subject to Social Security tax, though the 1.45% Medicare tax still applies with no cap.\"}},{\"@type\":\"Question\",\"name\":\"What is the self-employment tax rate for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The self-employment tax rate for 2026 is 15.3%, applied to 92.35% of your net self-employment income. This breaks down to 12.4% for Social Security (capped at the $184,500 wage base) and 2.9% for Medicare (no cap). If your earned income exceeds $200,000 ($250,000 for married filing jointly), you also owe the 0.9% Additional Medicare Tax.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As of 2026, nine states have no state income tax: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming. New Hampshire taxes dividends and interest but not wages. We cover Texas and Florida in detail on this site.\"}},{\"@type\":\"Question\",\"name\":\"What is the standard deduction for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 standard deduction is $16,100 for Single and Married Filing Separately filers, $32,200 for Married Filing Jointly, and $24,150 for Head of Household. Taxpayers who are 65 or older or blind get an additional $1,600 (Single/MFS) or $1,300 (MFJ/QW).\"}},{\"@type\":\"Question\",\"name\":\"How much can I contribute to my 401(k) in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 401(k) contribution limit is $24,500. If you are age 50 or older, you can make an additional catch-up contribution of $8,000, for a total of $32,500. Under SECURE 2.0, workers aged 60–63 have an enhanced catch-up limit of $11,250, for a total of $35,750.\"}},{\"@type\":\"Question\",\"name\":\"Can I cite this data in my article or report?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — that is exactly what this page is for. Click the \\\"Cite this data\\\" button on any section to copy an APA-formatted citation. You may also link directly to any section using the \\\"Link\\\" button. All data is free to use with attribution. Suggested citation format: TheTaxCalc. (2026). [Section Title]. Retrieved from https://thetaxcalc.com/resources\"}},{\"@type\":\"Question\",\"name\":\"Where does the data on this page come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"All federal tax data comes directly from IRS publications, including Revenue Procedures for annual inflation adjustments. State tax data is sourced from each state's Department of Revenue. FICA rates and wage bases are set by the Social Security Administration. We update this page within 48 hours of official government publications. See our Source & Methodology section for details.\"}}]}]}6:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$21\"}}],\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}],[\"$L31\"],\"$L32\"]}]\n33:[]\n7:\"$W33\"\n8:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L34\",null,{\"children\":\"$L35\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L36\",null,{\"children\":[\"$\",\"$37\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L38\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\na:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/233p45nuh4m5b.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\nb:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0dwp-mo_n_jm0.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n39:I[46236,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"DynamicProviders\"]\n3a:I[25020,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/3hdsldxk1ut9_.js\"],\"CiteButton\"]\n7e:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n13:[\"$\",\"$L12\",\"/texas-tax-calculator\",{\"href\":\"/texas-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hove