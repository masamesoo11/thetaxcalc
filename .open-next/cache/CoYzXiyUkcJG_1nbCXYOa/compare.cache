en\":[\"1.62\",\"%\"]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-auto flex items-center gap-1.5 text-sm font-medium text-emerald-400 group-hover:gap-3 transition-all\",\"children\":[\"View Full Comparison\",[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]]}]]}]\n1d:[\"$\",\"path\",\"q3az6g\",{\"d\":\"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z\"}]\n1e:[\"$\",\"path\",\"1h4pet\",{\"d\":\"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8\"}]\n1f:[\"$\",\"path\",\"1jc1ny\",{\"d\":\"M12 17.5v-11\"}]\n20:[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Sales Tax Impact\"}]\n21:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"You pay sales tax every day — at the grocery store, the gas pump, online. Combined rates vary wildly: Louisiana and Tennessee can exceed 9%, while Oregon and Montana have zero state sales tax. Among the states we cover, combined rates range from 7% (Florida) to 8.86% (Illinois). It adds up quietly.\"}]\n22:[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-dollar-sign h-4 w-4 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"line\",\"7eqyqh\",{\"x1\":\"12\",\"x2\":\"12\",\"y1\":\"2\",\"y2\":\"22\"}],[\"$\",\"path\",\"1b0p4s\",{\"d\":\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Cost of Living Differences\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Here's the trap: a lower tax rate doesn't guarantee more money in your pocket if everything costs more. A $100,000 salary goes a lot further in Houston than in San Francisco, even before taxes. Housing is the big one — it can easily eat 30–50% of your take-home pay in high-cost cities. Always compare after-tax income against actual living costs.\"}]]}]\n23:[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-piggy-bank h-4 w-4 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1piglc\",{\"d\":\"M11 17h3v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a3.16 3.16 0 0 0 2-2h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1a5 5 0 0 0-2-4V3a4 4 0 0 0-3.2 1.6l-.3.4H11a6 6 0 0 0-6 6v1a5 5 0 0 0 2 4v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1z\"}],[\"$\",\"path\",\"1m94wz\",{\"d\":\"M16 10h.01\"}],[\"$\",\"path\",\"1env43\",{\"d\":\"M2 8v1a2 2 0 0 0 2 2h1\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Tax Credits & Exemptions\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Don't overlook credits and exemptions. Some states are generous — child dependent credits, earned income credits, property tax relief, senior exemptions. A state with a higher headline rate but robust credits can actually leave you with a lower effective tax bill than a flat-rate state with barely any deductions. The devil is in the details.\"}]]}]\n24:[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-down h-4 w-4 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"t6n2it\",{\"d\":\"M16 17h6v-6\"}],[\"$\",\"path\",\"x473p\",{\"d\":\"m22 17-8.5-8.5-5 5L2 7\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Overall Tax Burden vs Take-Home\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"At the end of the day, one number matters most: your actual take-home pay after all taxes. Not the rate, not the bracket — the real dollars in your checking account. That's why our comparison pages show take-home pay at $75K and $150K. It cuts through the noise and gives you the bottom line.\"}]]}]\n25:[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do property taxes compare across states?\"}]\n26:[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]\n27:[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"They vary enormously. Among our five states, Texas has the highest effective rate at roughly 1.71% of home value. Illinois isn't far behind at around 2.08%. California has a lower effective rate (~0.75%) thanks to Proposition 13 caps, but when homes cost $800,000+, the dollar amount is still huge. Florida and New York fall in between. Pro tip: a lower rate on a more expensive home can still cost you more in actual dollars than a higher rate on a cheaper home.\"}]\n28:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the total tax burden by state?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Total tax burden = income tax + property tax + sales tax combined. Among our five states, California and New York carry the highest total burden (often 10–13% of income for mid-to-high earners), while Texas and Florida have the lowest (roughly 6–8% depending on whether you own a home). Illinois sits in the middle — its flat income tax isn't terrible, but those property taxes really add up. Our comparison pages show take-home pay at $75K and $150K so you can see the real dollar impact, not just percentages.\"}]]}]\n29:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does a 0% income tax mean I pay no state taxes?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Absolutely not. Even in Texas and Florida, you're still paying state and local taxes — just not on your wages. Property taxes, sales taxes, fuel taxes, hotel taxes, various fees... they all add up. In fact, Texas has among the highest property tax rates in the nation, which can cost homeowners $5,000–$10,000+ per year. The 0% income tax is real and valuable, but it's not the whole story. That's why we show you the full picture on our comparison pages.\"}]]}]\n2a:[\"$\",\"$Lc\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$200K\"}]\n2b:[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-2\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/salary\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"All 26 Salary Levels\"]}],[\"$\",\"$Lc\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"2026 Federal Tax Brackets\"]}],[\"$\",\"$Lc\",null,{\"href\":\"/glossary\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Tax Glossary\"]}]]}]\n2c:[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground mb-3\",\"children\":\"Tax Guides & Blog\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"$Lc\",\"/blog\",{\"href\":\"/blog\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"All Blog Articles\"]}],[\"$\",\"$Lc\",\"/blog/florida-vs-texas-tax-comparison\",{\"href\":\"/blog/florida-vs-texas-tax-comparison\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Florida vs Texas Comparison\"]}],[\"$\",\"$Lc\",\"/blog/why-texas-has-no-income-tax\",{\"href\":\"/blog/why-texas-has-no-income-tax\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Why Texas Has No Income Tax\"]}],[\"$\",\"$Lc\",\"/blog/2026-federal-tax-brackets-explained\",{\"href\":\"/blog/2026-federal-tax-brackets-explained\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"2026 Tax Brackets Explained\"]}],[\"$\",\"$Lc\",\"/blog/illinois-income-tax-guide-2026\",{\"href\":\"/blog/illinois-income-tax-guide-2026\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Illinois Tax Guide 2026\"]}]]}]]}]\n2f:null\n","/compare":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"ClientAnalytics\"]\n5:I[40264,[\"/_next/