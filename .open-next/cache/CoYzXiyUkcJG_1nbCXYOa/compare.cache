e\\\":\\\"flex items-center gap-2 mb-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-percent h-4 w-4 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"line\\\",\\\"1x9vlm\\\",{\\\"x1\\\":\\\"19\\\",\\\"x2\\\":\\\"5\\\",\\\"y1\\\":\\\"5\\\",\\\"y2\\\":\\\"19\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"4mh3h7\\\",{\\\"cx\\\":\\\"6.5\\\",\\\"cy\\\":\\\"6.5\\\",\\\"r\\\":\\\"2.5\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"1mdrzq\\\",{\\\"cx\\\":\\\"17.5\\\",\\\"cy\\\":\\\"17.5\\\",\\\"r\\\":\\\"2.5\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground\\\",\\\"children\\\":\\\"Income Tax Rates\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"This is the sexy number everyone talks about. And sure, 0% income tax in Texas or Florida can save you thousands versus California's 13.3% top rate. But it's just one piece of the puzzle — and sometimes a misleading one.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 mb-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-house h-4 w-4 text-emerald-400\\\",\\\"ari