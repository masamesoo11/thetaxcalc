-5xl\",\"children\":[\"State vs State \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Tax Comparison\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-2xl text-lg text-muted-foreground leading-relaxed\",\"children\":\"We crunched the numbers so you don't have to. Income tax, property tax, sales tax, and actual take-home pay — side by side for every state pair we cover. See which one keeps more money in your pocket at $75K and $150K salaries.\"}],[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-down h-4 w-4 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"t6n2it\",{\"d\":\"M16 17h6v-6\"}],[\"$\",\"path\",\"x473p\",{\"d\":\"m22 17-8.5-8.5-5 5L2 7\"}],\"$undefined\"]}],\"Income Tax Rates\"]}],[\"$\",\"span\",null,{\"className\":\"flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-scale h-4 w-4 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"7g6ntu\",{\"d\":\"m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"}],[\"$\",\"path\",\"ijws7r\",{\"d\":\"m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z\"}],[\"$\",\"path\",\"1b0cd5\",{\"d\":\"M7 21h10\"}],[\"$\",\"path\",\"108xh3\",{\"d\":\"M12 3v18\"}],[\"$\",\"path\",\"3gwbw2\",{\"d\":\"M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2\"}],\"$undefined\"]}],\"Property & Sales