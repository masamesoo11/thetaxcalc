$\",\"div\",null,{\"className\":\"mt-10 flex flex-wrap items-center justify-center gap-3 text-sm\",\"children\":[[\"$\",\"$L13\",\"/illinois-tax-calculator\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Illinois\"}],\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"]}]]}]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"$L21\"]}]\n6:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L10\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L12\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n22:T1115,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/obbba-tax-calculator#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"OBBBA Tax Calculator\",\"item\":\"https://thetaxcalc.com/obbba-tax-calculator\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/obbba-tax-calculator#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the OBBBA tax calculator?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The OBBBA tax calculator compares your 2026 federal income tax under the One Big Beautiful Bill Act (OBBBA, P.L. 119-1) against what you would have paid if the Tax Cuts and Jobs Act (TCJA) had sunset as scheduled on December 31, 2025. It applies every relevant OBBBA provision — permanent TCJA brackets, the $40,400 SALT cap, the doubled $2,200 Child Tax Credit, the new tip and overtime deductions, and the $2,000 senior deduction — and shows your tax savings (or cost) line by line.\"}},{\"@type\":\"Question\",\"name\":\"How does OBBBA change my 2026 tax refund?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OBBBA generally increases refunds for most taxpayers by preventing the reversion to higher pre-TCJA brackets, doubling the Child Tax Credit to $2,200, raising the SALT cap from $10,000 to $40,400, and introducing new deductions for tips, overtime, and seniors. According to the Tax Foundation, OBBBA raises after-tax income by an average of 5.4% in 2026. Use the calculator above to see your specific refund impact, or try our free tax refund calculator for a complete picture including withholding.\"}},{\"@type\":\"Question\",\"name\":\"Is the OBBBA tip income deduction permanent?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and other traditionally tipped workers) is a temporary provision under OBBBA and is scheduled to sunset in future years. The overtime pay deduction is similarly temporary. The TCJA bracket structure, the higher SALT cap, and the doubled Child Tax Credit are permanent under OBBBA.\"}},{\"@type\":\"Question\",\"name\":\"Does the OBBBA SALT cap phaseout affect me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The OBBBA SALT cap of $40,400 begins to phase out for single filers with MAGI above $500,000 and married filing jointly filers above $1,000,000. The phaseout reduces the cap linearly back down to $10,000 over a $200,000 range. If your MAGI is below those thresholds, you get the full $40,400 cap (subject to the actual amount of state and local taxes you paid). Most taxpayers — over 95% — fall below the phaseout and receive the full benefit.\"}},{\"@type\":\"Question\",\"name\":\"How does OBBBA affect families with children?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OBBBA doubles the Child Tax Credit from $1,000 (pre-TCJA) to $2,200 per qualifying child under 17, with up to $1,700 refundable. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly. A family with three children can save up to $3,600 compared to pre-TCJA law. The credit is indexed to inflation going forward, so it will continue to rise in future tax years.\"}},{\"@type\":\"Question\",\"name\":\"Who benefits most from OBBBA?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The biggest winners under OBBBA are families with children (thanks to the doubled Child Tax Credit), upper-middle-income itemizers in high-tax states (California, New York, New Jersey, Connecticut, Illinois — thanks to the SALT cap increase), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new $2,000 senior deduction). Households without children in no-income-tax states who take the standard deduction benefit least, though they still gain from the permanent TCJA brackets.\"}}]},{\"@type\":\"WebApplication\",\"name\":\"OBBBA Tax Calculator 2026\",\"description\":\"Free OBBBA tax calculator for 2026. Compare your federal income tax under the One Big Beautiful Bill Act vs prior law.\",\"url\":\"https://thetaxcalc.com/obbba-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}}]}7:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$22\"}}],\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}],[\"$L31\"],\"$L32\"]}]\n33:[]\n8:\"$W33\"\n9:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L34\",null,{\"children\":\"$L35\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L36\",null,{\"children\":[\"$\",\"$37\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L38\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nb:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/233p45nuh4m5b.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\nc:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0dwp-mo_n_jm0.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n39:I[46236,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"DynamicProviders\"]\n3a:I[64365,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1ae_4t856lx51.js\"],\"OBBBACalculatorClient\"]\n3e:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n14:[\"$\",\"$L13\",\"/texas-tax-calculator\",{\"href\":\"/texas-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Texas\"}]\n15:[\"$\",\"$L13\",\"/florida-tax-calculator\",{\"href\":\"/florida-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Florida\"}]\n16:[\"$\",\"$L13\",\"/california-tax-calculator\",{\"href\":\"/california-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"California\"}]\n17:[\"$\",\"$L13\",\"/new-york-tax-calculator\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"New York\"}]\n18:[\"$\",\"$L13\",\"/mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Mortgage\"}]\n19:[\"$\",\"$L13\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Capital Gains\"}]\n1a:[\"$\",\"$L13\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"401(k)\"}]\n1b:[\"$\",\"$L13\",\"/blog\",{\"href\":\"/blog\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Blog\"}]\n1c:[\"$\",\"$L13\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}]\n1d:[\"$\",\"$L13\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}]\n1e:[\"$\",\"$L13\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}]\n1f:[\"$\",\"$L13\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}]\n20:[\"$\",\"$L13\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]\n21:[\"$\",\"$L39\",null,{}]\n23:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L13\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"OBBBA Tax Calculator\"}]]}]\n24:[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"OBBBA Tax Calculator 2026 — Compare the New Tax Law vs Prior Law\"}]\n25:[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed mb-8\",\"children\":\"The One Big Beautiful Bill Act (OBBBA) is the most significant change to the individual tax code since the TCJA. Use our free OBBBA tax calculator to instantly compare your 2026 federal income tax under OBBBA against what you would have paid if the TCJA had sunset as scheduled. All calculations run in your browser — no sign-up, no data stored.\"}]\n26:[\"$\",\"div\",null,{\"className\":\"mb-12\",\"children\":[\"$\",\"$L3a\",null,{}]}]\n27:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"What Is OBBBA?\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"The One Big Beautiful Bill Act (OBBBA, P.L. 119-1), signed in 2025, made the individual tax cuts from the Tax Cuts and Jobs Act (TCJA) of 2017 permanent. Without OBBBA, the TCJA provisions would have sunset on December 31, 2025, and 62% of taxpayers would have faced higher taxes in 2026 — the largest federal tax increase in a generation. OBBBA didn’t just extend TCJA, though; it also introduced several brand-new deductions that affect how much you owe.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The five OBBBA changes that matter most for your 2026 tax return are: (1) TCJA brackets made permanent, preventing reversion to higher rates; (2) the SALT deduction cap raised from $10,000 to $40,400; (3) the Child Tax Credit doubled from $1,000 to $2,200 per child; (4) new above-the-line deductions for qualifying tip income and overtime pay; and (5) a new $2,000 additional deduction for taxpayers aged 65 and older. The calculator above applies each of these provisions to your situation.\"}]]}]\n28:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"SALT Cap Increased to $40,400\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"The single most impactful OBBBA change for upper-middle-income filers in high-tax states is the increase in the state and local tax (SALT) deduction cap from $10,000 to $40,400. If you itemize deductions, you can now deduct up to $40,400 in combined state income tax, property tax, and sales tax — a $30,400 increase from the old TCJA cap that had been in place since 2018.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"A California family with $200,000 income paying $15,000 in state income tax and $8,000 in property tax can now deduct the full $23,000 (vs only $10,000 under the old cap). At a 22% marginal rate, that’s approximately $2,860 in federal tax savings — a meaningful win for itemizers in California, New York, New Jersey, Connecticut, and Illinois. Single filers with MAGI above $500,000 and married filers above $1,000,000 face a phaseout that reduces the cap back to $10,000.\"}]]}]\n29:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Child Tax Credit Doubled to $2,200\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"OBBBA raises the Child Tax Credit (CTC) to $2,200 per qualifying child under 17 for 2026, doubled from the $1,000 pre-TCJA level and indexed to inflation going forward. The refundable portion (Additional Child Tax Credit) increases to $1,700, meaning even families with little or no federal income tax liability can receive a partial refund. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"A family with three qualifying children saves up to $3,600 compared to pre-TCJA law ($1,200 increase per child × 3 children). Use the calculator above to see exactly how much your CTC will be under OBBBA. You can also pair this with our\",\" \",[\"$\",\"$L13\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"paycheck calculator\"}],\" \",\"to see how the CTC affects your take-home pay throughout the year.\"]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"New Tip & Overtime Deductions\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"OBBBA introduces two brand-new above-the-line deductions: a tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and similar roles), and an overtime pay deduction for qualifying time-and-a-half overtime pay. Both are temporary provisions scheduled to sunset in future years, but they provide meaningful after-tax income increases for service industry and hourly workers during their effective period.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"For a restaurant server earning $25,000 in tips on top of a $30,000 base wage, the tip deduction could reduce taxable income by up to $25,000 — potentially saving thousands in federal tax. Similarly, a manufacturing worker earning $15,000 in qualifying overtime pay could see a comparable deduction. Documentation requirements apply (Form 4137 or Form 4070 for tips; employer overtime reporting for the overtime deduction), and the IRS is expected to scrutinize these new deductions closely.\"}]]}]\n2b:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"New $2,000 Senior Deduction\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Taxpayers aged 65 and older can claim an additional $2,000 deduction on top of the standard deduction under OBBBA. Combined with the existing additional standard deduction for seniors (approximately $1,950 for single filers in 2026), a single senior taking the standard deduction can subtract roughly $20,050 from gross income before calculating federal tax. For married couples where both spouses are 65+, the combined deduction is even larger. This is particularly valuable for retirees with pension, Social Security, or IRA distribution income.\"}]]}]\n2c:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Who Benefits Most (and Who Doesn’t)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Biggest winners:\"}],\" Families with children (doubled CTC), upper-middle-income itemizers in high-tax states (raised SALT cap), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new senior deduction). The middle and upper-middle income quintiles see the largest percentage gains — roughly 5-6% increases in after-tax income according to Tax Foundation analysis.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Limited benefit:\"}],\" Very high earners (SALT phaseout), non-itemizers in no-income-tax states like Texas and Florida (no SALT to deduct), and households without children (no CTC). These taxpayers still benefit from the permanent TCJA brackets but miss out on the targeted OBBBA deductions.\"]}]]}]]}]\n2d:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Tax Calculators\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L13\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Take-home pay for all 50 states including federal, FICA, and state taxes.\"}]]}],[\"$\",\"$L13\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Estimate your 2026 federal tax refund based on withholding and credits.\"}]]}],[\"$\",\"$L13\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"2026 Federal Tax Brackets\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Complete reference for all 2026 federal income tax brackets and rates.\"}]]}],[\"$\",\"$L13\",\"/methodology\",{\"href\":\"/methodology\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Methodology & Data Sources\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"How we compute every number on TheTaxCalc — IRS, SSA, and state sources.\"}]]}]]}]]}]\n2e:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"OBBBA vs Prior Law: Key Tax Provisions Compared\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-4 leading-relaxed\",\"children\":\"The table below summarizes the most important differences between OBBBA (2026 tax law) and the prior law (pre-TCJA sunset). Use it to quickly understand how each provision affects your federal income tax.\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto rounded-xl border border-border/30 bg-card/50\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-muted/30 border-b border-border/30\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-foreground\",\"children\":\"Tax Provision\"}],[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-emerald-400\",\"children\":\"OBBBA (2026)\"}],[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-muted-foreground\",\"children\":\"Prior Law (Pre-TCJA)\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-border/20\",\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Top federal tax bracket\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"37% (TCJA made permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"39.6% (TCJA sunset)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Standard deduction (Single)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$16,100\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$8,300 (pre-TCJA level)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"SALT deduction cap\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$40,400\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$10,000 (old TCJA cap)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Child Tax Credit\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$2,200 per child\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$1,000 per child\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Tip income deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"New above-the-line deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Overtime pay deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"New above-the-line deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Senior deduction (65+)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$2,000 additional deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No additional deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"AMT exemption (Single)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$88,700 (TCJA permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$55,400 (pre-TCJA)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Estate tax exemption\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$14.6 million\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$7 million (pre-TCJA)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"QBI deduction (Section 199A)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"20% (made permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"Expired (0%)\"}]]}]]}]]}]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-xs text-muted-foreground\",\"children\":\"Source: One Big Beautiful Bill Act (P.L. 119-1), signed July 4, 2025. Estimates based on IRS 2026 tax brackets and TCJA provisions.\"}]]}]\n2f:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"OBBBA Tax Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"What is the OBBBA tax calculator?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"What is the OBBBA tax calculator?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA tax calculator compares your 2026 federal income tax under the One Big Beautiful Bill Act (OBBBA, P.L. 119-1) against what you would have paid if the Tax Cuts and Jobs Act (TCJA) had sunset as scheduled on December 31, 2025. It applies every relevant OBBBA provision — permanent TCJA brackets, the $40,400 SALT cap, the doubled $2,200 Child Tax Credit, the new tip and overtime deductions, and the $2,000 senior deduction — and shows your tax savings (or cost) line by line.\"}]]}],[\"$\",\"div\",\"How does OBBBA change my 2026 tax refund?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How does OBBBA change my 2026 tax refund?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"OBBBA generally increases refunds for most taxpayers by preventing the reversion to higher pre-TCJA brackets, doubling the Child Tax Credit to $2,200, raising the SALT cap from $10,000 to $40,400, and introducing new deductions for tips, overtime, and seniors. According to the Tax Foundation, OBBBA raises after-tax income by an average of 5.4% in 2026. Use the calculator above to see your specific refund impact, or try our free tax refund calculator for a complete picture including withholding.\"}]]}],[\"$\",\"div\",\"Is the OBBBA tip income deduction permanent?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Is the OBBBA tip income deduction permanent?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No. The tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and other traditionally tipped workers) is a temporary provision under OBBBA and is scheduled to sunset in future years. The overtime pay deduction is similarly temporary. The TCJA bracket structure, the higher SALT cap, and the doubled Child Tax Credit are permanent under OBBBA.\"}]]}],[\"$\",\"div\",\"Does the OBBBA SALT cap phaseout affect me?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Does the OBBBA SALT cap phaseout affect me?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA SALT cap of $40,400 begins to phase out for single filers with MAGI above $500,000 and married filing jointly filers above $1,000,000. The phaseout reduces the cap linearly back down to $10,000 over a $200,000 range. If your MAGI is below those thresholds, you get the full $40,400 cap (subject to the actual amount of state and local taxes you paid). Most taxpayers — over 95% — fall below the phaseout and receive the full benefit.\"}]]}],[\"$\",\"div\",\"How does OBBBA affect families with children?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[\"$L3b\",\"$L3c\"]}],\"$L3d\"]}]]}]\n30:[\"$\",\"section\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-amber-500/30 bg-amber-500/5 p-6\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"This OBBBA tax calculator provides estimates for informational and educational purposes only. It does not constitute tax advice. The calculator uses 2026 federal tax figures from IRS Revenue Procedure 2025-25 and the JCT description of OBBBA (P.L. 119-1). State taxes, AMT, and special circumstances are not included. Tax law changes frequently — consult a qualified tax professional (CPA, EA, or tax attorney) for advice specific to your situation.\"}]}]}]\n31:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1ae_4t856lx51.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n32:[\"$\",\"$L3e\",null,{\"children\":[\"$\",\"$37\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@3f\"}]}]\n3b:[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How does OBBBA affect families with children?\"}]\n3c:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"OBBBA doubles the Child Tax Credit from $1,000 (pre-TCJA) to $2,200 per qualifying child under 17, with up to $1,700 refundable. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly. A family with three children can save up to $3,600 compared to pre-TCJA law. The credit is indexed to inflation going forward, so it will continue to rise in future tax years.\"}]\n3d:[\"$\",\"div\",\"Who benefits most from OBBBA?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Who benefits most from OBBBA?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The biggest winners under OBBBA are families with children (thanks to the doubled Child Tax Credit), upper-middle-income itemizers in high-tax states (California, New York, New Jersey, Connecticut, Illinois — thanks to the SALT cap increase), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new $2,000 senior deduction). Households without children in no-income-tax states who take the standard deduction benefit least, though they still gain from the permanent TCJA brackets.\"}]]}]\n35:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n40:I[27201,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"IconMark\"]\n38:[[\"$\",\"title\",\"0\",{\"children\":\"OBBBA Tax Calculator 2026 — Compare New Tax Law vs Prior Law | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Free OBBBA tax calculator 2026. Compare federal tax under the One Big Beautiful Bill Act vs prior law. See SALT cap, CTC, and tip deduction savings.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/obbba-tax-calculator\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"7bdac16b5ecbdd40\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"OBBBA Tax Calculator 2026 | Compare New Tax Law vs Prior Law\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"See exactly how much the One Big Beautiful Bill Act saves you in 2026. Compare OBBBA vs prior law with our free calculator.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/obbba-tax-calculator\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:alt\",\"content\":\"OBBBA Tax Calculator 2026 — Compare New Tax Law vs Prior Law\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"OBBBA Tax Calculator 2026 | Compare New Tax Law vs Prior Law\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"See exactly how much the One Big Beautiful Bill Act saves you in 2026. Compare OBBBA vs prior law.\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"26\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L40\",\"27\",{}]]\n3f:null\n","/obbba-tax-calculator/__PAGE__":"1:\"$Sreact.fragment\"\n13:I[22016,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1ae_4t856lx51.js\"],\"\"]\n14:I[64365,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1ae_4t856lx51.js\"],\"OBBBACalculatorClient\"]\n18:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n19:\"$Sreact.suspense\"\n2:T1115,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/obbba-tax-calculator#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"OBBBA Tax Calculator\",\"item\":\"https://thetaxcalc.com/obbba-tax-calculator\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/obbba-tax-calculator#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the OBBBA tax calculator?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The OBBBA tax calculator compares your 2026 federal income tax under the One Big Beautiful Bill Act (OBBBA, P.L. 119-1) against what you would have paid if the Tax Cuts and Jobs Act (TCJA) had sunset as scheduled on December 31, 2025. It applies every relevant OBBBA provision — permanent TCJA brackets, the $40,400 SALT cap, the doubled $2,200 Child Tax Credit, the new tip and overtime deductions, and the $2,000 senior deduction — and shows your tax savings (or cost) line by line.\"}},{\"@type\":\"Question\",\"name\":\"How does OBBBA change my 2026 tax refund?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OBBBA generally increases refunds for most taxpayers by preventing the reversion to higher pre-TCJA brackets, doubling the Child Tax Credit to $2,200, raising the SALT cap from $10,000 to $40,400, and introducing new deductions for tips, overtime, and seniors. According to the Tax Foundation, OBBBA raises after-tax income by an average of 5.4% in 2026. Use the calculator above to see your specific refund impact, or try our free tax refund calculator for a complete picture including withholding.\"}},{\"@type\":\"Question\",\"name\":\"Is the OBBBA tip income deduction permanent?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and other traditionally tipped workers) is a temporary provision under OBBBA and is scheduled to sunset in future years. The overtime pay deduction is similarly temporary. The TCJA bracket structure, the higher SALT cap, and the doubled Child Tax Credit are permanent under OBBBA.\"}},{\"@type\":\"Question\",\"name\":\"Does the OBBBA SALT cap phaseout affect me?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The OBBBA SALT cap of $40,400 begins to phase out for single filers with MAGI above $500,000 and married filing jointly filers above $1,000,000. The phaseout reduces the cap linearly back down to $10,000 over a $200,000 range. If your MAGI is below those thresholds, you get the full $40,400 cap (subject to the actual amount of state and local taxes you paid). Most taxpayers — over 95% — fall below the phaseout and receive the full benefit.\"}},{\"@type\":\"Question\",\"name\":\"How does OBBBA affect families with children?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OBBBA doubles the Child Tax Credit from $1,000 (pre-TCJA) to $2,200 per qualifying child under 17, with up to $1,700 refundable. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly. A family with three children can save up to $3,600 compared to pre-TCJA law. The credit is indexed to inflation going forward, so it will continue to rise in future tax years.\"}},{\"@type\":\"Question\",\"name\":\"Who benefits most from OBBBA?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The biggest winners under OBBBA are families with children (thanks to the doubled Child Tax Credit), upper-middle-income itemizers in high-tax states (California, New York, New Jersey, Connecticut, Illinois — thanks to the SALT cap increase), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new $2,000 senior deduction). Households without children in no-income-tax states who take the standard deduction benefit least, though they still gain from the permanent TCJA brackets.\"}}]},{\"@type\":\"WebApplication\",\"name\":\"OBBBA Tax Calculator 2026\",\"description\":\"Free OBBBA tax calculator for 2026. Compare your federal income tax under the One Big Beautiful Bill Act vs prior law.\",\"url\":\"https://thetaxcalc.com/obbba-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\"]}],[\"$L11\"],\"$L12\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L13\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"OBBBA Tax Calculator\"}]]}]\n4:[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"OBBBA Tax Calculator 2026 — Compare the New Tax Law vs Prior Law\"}]\n5:[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed mb-8\",\"children\":\"The One Big Beautiful Bill Act (OBBBA) is the most significant change to the individual tax code since the TCJA. Use our free OBBBA tax calculator to instantly compare your 2026 federal income tax under OBBBA against what you would have paid if the TCJA had sunset as scheduled. All calculations run in your browser — no sign-up, no data stored.\"}]\n6:[\"$\",\"div\",null,{\"className\":\"mb-12\",\"children\":[\"$\",\"$L14\",null,{}]}]\n7:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"What Is OBBBA?\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"The One Big Beautiful Bill Act (OBBBA, P.L. 119-1), signed in 2025, made the individual tax cuts from the Tax Cuts and Jobs Act (TCJA) of 2017 permanent. Without OBBBA, the TCJA provisions would have sunset on December 31, 2025, and 62% of taxpayers would have faced higher taxes in 2026 — the largest federal tax increase in a generation. OBBBA didn’t just extend TCJA, though; it also introduced several brand-new deductions that affect how much you owe.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The five OBBBA changes that matter most for your 2026 tax return are: (1) TCJA brackets made permanent, preventing reversion to higher rates; (2) the SALT deduction cap raised from $10,000 to $40,400; (3) the Child Tax Credit doubled from $1,000 to $2,200 per child; (4) new above-the-line deductions for qualifying tip income and overtime pay; and (5) a new $2,000 additional deduction for taxpayers aged 65 and older. The calculator above applies each of these provisions to your situation.\"}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"SALT Cap Increased to $40,400\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"The single most impactful OBBBA change for upper-middle-income filers in high-tax states is the increase in the state and local tax (SALT) deduction cap from $10,000 to $40,400. If you itemize deductions, you can now deduct up to $40,400 in combined state income tax, property tax, and sales tax — a $30,400 increase from the old TCJA cap that had been in place since 2018.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"A California family with $200,000 income paying $15,000 in state income tax and $8,000 in property tax can now deduct the full $23,000 (vs only $10,000 under the old cap). At a 22% marginal rate, that’s approximately $2,860 in federal tax savings — a meaningful win for itemizers in California, New York, New Jersey, Connecticut, and Illinois. Single filers with MAGI above $500,000 and married filers above $1,000,000 face a phaseout that reduces the cap back to $10,000.\"}]]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Child Tax Credit Doubled to $2,200\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"OBBBA raises the Child Tax Credit (CTC) to $2,200 per qualifying child under 17 for 2026, doubled from the $1,000 pre-TCJA level and indexed to inflation going forward. The refundable portion (Additional Child Tax Credit) increases to $1,700, meaning even families with little or no federal income tax liability can receive a partial refund. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"A family with three qualifying children saves up to $3,600 compared to pre-TCJA law ($1,200 increase per child × 3 children). Use the calculator above to see exactly how much your CTC will be under OBBBA. You can also pair this with our\",\" \",[\"$\",\"$L13\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"paycheck calculator\"}],\" \",\"to see how the CTC affects your take-home pay throughout the year.\"]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"New Tip & Overtime Deductions\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"OBBBA introduces two brand-new above-the-line deductions: a tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and similar roles), and an overtime pay deduction for qualifying time-and-a-half overtime pay. Both are temporary provisions scheduled to sunset in future years, but they provide meaningful after-tax income increases for service industry and hourly workers during their effective period.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"For a restaurant server earning $25,000 in tips on top of a $30,000 base wage, the tip deduction could reduce taxable income by up to $25,000 — potentially saving thousands in federal tax. Similarly, a manufacturing worker earning $15,000 in qualifying overtime pay could see a comparable deduction. Documentation requirements apply (Form 4137 or Form 4070 for tips; employer overtime reporting for the overtime deduction), and the IRS is expected to scrutinize these new deductions closely.\"}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"New $2,000 Senior Deduction\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Taxpayers aged 65 and older can claim an additional $2,000 deduction on top of the standard deduction under OBBBA. Combined with the existing additional standard deduction for seniors (approximately $1,950 for single filers in 2026), a single senior taking the standard deduction can subtract roughly $20,050 from gross income before calculating federal tax. For married couples where both spouses are 65+, the combined deduction is even larger. This is particularly valuable for retirees with pension, Social Security, or IRA distribution income.\"}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Who Benefits Most (and Who Doesn’t)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Biggest winners:\"}],\" Families with children (doubled CTC), upper-middle-income itemizers in high-tax states (raised SALT cap), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new senior deduction). The middle and upper-middle income quintiles see the largest percentage gains — roughly 5-6% increases in after-tax income according to Tax Foundation analysis.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Limited benefit:\"}],\" Very high earners (SALT phaseout), non-itemizers in no-income-tax states like Texas and Florida (no SALT to deduct), and households without children (no CTC). These taxpayers still benefit from the permanent TCJA brackets but miss out on the targeted OBBBA deductions.\"]}]]}]]}]\nd:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Tax Calculators\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L13\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Take-home pay for all 50 states including federal, FICA, and state taxes.\"}]]}],[\"$\",\"$L13\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Estimate your 2026 federal tax refund based on withholding and credits.\"}]]}],[\"$\",\"$L13\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"2026 Federal Tax Brackets\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Complete reference for all 2026 federal income tax brackets and rates.\"}]]}],[\"$\",\"$L13\",\"/methodology\",{\"href\":\"/methodology\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400\",\"children\":\"Methodology & Data Sources\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"How we compute every number on TheTaxCalc — IRS, SSA, and state sources.\"}]]}]]}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"OBBBA vs Prior Law: Key Tax Provisions Compared\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-4 leading-relaxed\",\"children\":\"The table below summarizes the most important differences between OBBBA (2026 tax law) and the prior law (pre-TCJA sunset). Use it to quickly understand how each provision affects your federal income tax.\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto rounded-xl border border-border/30 bg-card/50\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-muted/30 border-b border-border/30\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-foreground\",\"children\":\"Tax Provision\"}],[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-emerald-400\",\"children\":\"OBBBA (2026)\"}],[\"$\",\"th\",null,{\"className\":\"text-left p-4 font-semibold text-muted-foreground\",\"children\":\"Prior Law (Pre-TCJA)\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-border/20\",\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Top federal tax bracket\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"37% (TCJA made permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"39.6% (TCJA sunset)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Standard deduction (Single)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$16,100\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$8,300 (pre-TCJA level)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"SALT deduction cap\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$40,400\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$10,000 (old TCJA cap)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Child Tax Credit\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$2,200 per child\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$1,000 per child\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Tip income deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"New above-the-line deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Overtime pay deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"New above-the-line deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Senior deduction (65+)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$2,000 additional deduction\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"No additional deduction\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"AMT exemption (Single)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$88,700 (TCJA permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$55,400 (pre-TCJA)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"Estate tax exemption\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"$$14.6 million\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"$$7 million (pre-TCJA)\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"p-4 font-medium text-foreground\",\"children\":\"QBI deduction (Section 199A)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-emerald-400\",\"children\":\"20% (made permanent)\"}],[\"$\",\"td\",null,{\"className\":\"p-4 text-muted-foreground\",\"children\":\"Expired (0%)\"}]]}]]}]]}]}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-xs text-muted-foreground\",\"children\":\"Source: One Big Beautiful Bill Act (P.L. 119-1), signed July 4, 2025. Estimates based on IRS 2026 tax brackets and TCJA provisions.\"}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"OBBBA Tax Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"What is the OBBBA tax calculator?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"What is the OBBBA tax calculator?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA tax calculator compares your 2026 federal income tax under the One Big Beautiful Bill Act (OBBBA, P.L. 119-1) against what you would have paid if the Tax Cuts and Jobs Act (TCJA) had sunset as scheduled on December 31, 2025. It applies every relevant OBBBA provision — permanent TCJA brackets, the $40,400 SALT cap, the doubled $2,200 Child Tax Credit, the new tip and overtime deductions, and the $2,000 senior deduction — and shows your tax savings (or cost) line by line.\"}]]}],[\"$\",\"div\",\"How does OBBBA change my 2026 tax refund?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How does OBBBA change my 2026 tax refund?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"OBBBA generally increases refunds for most taxpayers by preventing the reversion to higher pre-TCJA brackets, doubling the Child Tax Credit to $2,200, raising the SALT cap from $10,000 to $40,400, and introducing new deductions for tips, overtime, and seniors. According to the Tax Foundation, OBBBA raises after-tax income by an average of 5.4% in 2026. Use the calculator above to see your specific refund impact, or try our free tax refund calculator for a complete picture including withholding.\"}]]}],[\"$\",\"div\",\"Is the OBBBA tip income deduction permanent?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Is the OBBBA tip income deduction permanent?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No. The tip income deduction for qualifying tipped occupations (restaurant servers, bartenders, hospitality staff, hair stylists, and other traditionally tipped workers) is a temporary provision under OBBBA and is scheduled to sunset in future years. The overtime pay deduction is similarly temporary. The TCJA bracket structure, the higher SALT cap, and the doubled Child Tax Credit are permanent under OBBBA.\"}]]}],[\"$\",\"div\",\"Does the OBBBA SALT cap phaseout affect me?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Does the OBBBA SALT cap phaseout affect me?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA SALT cap of $40,400 begins to phase out for single filers with MAGI above $500,000 and married filing jointly filers above $1,000,000. The phaseout reduces the cap linearly back down to $10,000 over a $200,000 range. If your MAGI is below those thresholds, you get the full $40,400 cap (subject to the actual amount of state and local taxes you paid). Most taxpayers — over 95% — fall below the phaseout and receive the full benefit.\"}]]}],[\"$\",\"div\",\"How does OBBBA affect families with children?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[\"$L15\",\"$L16\"]}],\"$L17\"]}]]}]\n10:[\"$\",\"section\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-amber-500/30 bg-amber-500/5 p-6\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"This OBBBA tax calculator provides estimates for informational and educational purposes only. It does not constitute tax advice. The calculator uses 2026 federal tax figures from IRS Revenue Procedure 2025-25 and the JCT description of OBBBA (P.L. 119-1). State taxes, AMT, and special circumstances are not included. Tax law changes frequently — consult a qualified tax professional (CPA, EA, or tax attorney) for advice specific to your situation.\"}]}]}]\n11:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1ae_4t856lx51.js\",\"async\":true}]\n12:[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1a\"}]}]\n15:[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How does OBBBA affect families with children?\"}]\n16:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"OBBBA doubles the Child Tax Credit from $1,000 (pre-TCJA) to $2,200 per qualifying child under 17, with up to $1,700 refundable. The credit begins phasing out at $200,000 MAGI for single filers and $400,000 for married filing jointly. A family with three children can save up to $3,600 compared to pre-TCJA law. The credit is indexed to inflation going forward, so it will continue to rise in future tax years.\"}]\n17:[\"$\",\"div\",\"Who benefits most from OBBBA?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Who benefits most from OBBBA?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The biggest winners under OBBBA are families with children (thanks to the doubled Child Tax Credit), upper-middle-income itemizers in high-tax states (California, New York, New Jersey, Connecticut, Illinois — thanks to the SALT cap increase), tipped workers (new tip deduction), hourly employees with regular overtime (new overtime deduction), and seniors 65+ (new $2,000 senior deduction). Households without children in no-income-tax states who take the standard deduction benefit least, though they still gain from the permanent TCJA brackets.\"}]]}]\n1a:null\n","/obbba-tax-calculator":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"ClientAnalytics\"]\n5:I[40264,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"QueryProvider\"]\n6:I[41631,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"SiteShell\"]\n7:I[40230,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"WebMCPProvider\"]\n8:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n9:I[58298,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1kthlnkql3p_5.js\"],\"default\"]\na:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\nb:I[22016,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h