alc.com/research/2026-state-tax-burden\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"7bdac16b5ecbdd40\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"2026 State Tax Burden Analysis: All 50 States Ranked\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Original research ranking all 50 U.S. states by effective tax burden for 2026. Four household income profiles.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:title\",\"content\":\"TheTaxCalc — Free 2026 Paycheck & Mortgage Calculator\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:description\",\"content\":\"Compute your take-home pay after federal, FICA, and state taxes. Supports IL, TX, FL, CA, NY.\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"22\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"23\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L68\",\"24\",{}]]\n38:null\n","/research/2026-state-tax-burden/__PAGE__":"1:\"$Sreact.fragment\"\n6:I[22016,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"\"]\n10:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n11:\"$Sreact.suspense\"\n2:T5ff,{\"@context\":\"https://schema.org\",\"@type\":\"ScholarlyArticle\",\"headline\":\"Comparative Analysis of State Tax Burdens Across the 50 United S