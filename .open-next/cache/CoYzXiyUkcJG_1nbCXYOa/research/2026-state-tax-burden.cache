,null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L6\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$L6\",null,{\"href\":\"/research\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Research\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"2026 State Tax Burden\"}]]}],[\"$\",\"header\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-400\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-file-text h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1rqfz7\",{\"d\":\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"}],[\"$\",\"path\",\"tnqrlb\",{\"d\":\"M14 2v4a2 2 0 0 0 2 2h4\"}],[\"$\",\"path\",\"b1mrlr\",{\"d\":\"M10 9H8\"}],[\"$\",\"path\",\"t4e002\",{\"d\":\"M16 13H8\"}],[\"$\",\"path\",\"z1uh3a\",{\"d\":\"M16 17H8\"}],\"$undefined\"]}],\"Original Research Study\"]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"Comparative Analysis of State Tax Burdens Across the 50 United States: A 2026 Cross-Sectional Study\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-4 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"children\":\"By Rachel Mitchell, CPA & David Chen\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"Published July 4, 2026\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"12 min read\"}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/30 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-foreground mb-3\",\"children\":\"Abstract\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-3\",\"children\":\"This study presents a comparative cross-sectional analysis of state and local tax burdens across all 50 U.S. states for the 2026 tax year. Using a standardized methodology that integrates state income tax schedules, state-level sales tax rates, property tax assessments, and excise taxes, we compute effective total tax burdens for representative household profiles at four income levels: $35,000, $75,000, $150,000, and $300,000.\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":[[\"$\",\"strong\",null,{\"children\":\"Keywords:\"}],\" state income tax, tax burden, effective tax rate, tax policy, comparative analysis, United States, public finance.\"]}]]}],[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Key Findings\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 rounded-lg border border-emerald-500/30 bg-emerald-500/5 p-4\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chart-column mt-0.5 h-5 w-5 flex-shrink-0 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"c24i48\",{\"d\":\"M3 3v16a2 2 0 0 0 2 2h16\"}],[\"$\",\"path\",\"2bz60n\",{\"d\":\"M18 17V9\"}],[\"$\",\"path\",\"1frdt8\",{\"d\":\"M13 17V5\"}],[\"$\",\"path\",\"17ska0\",{\"d\":\"M8 17v-3\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"Wide variation in effective burdens\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":[\"Total effective state tax burdens range from \",[\"$\",\"strong\",null,{\"className\":\"text-emerald-400\",\"children\":\"0.0% in Alaska\"}],\" to\",\" \",\"$L7\",\" for the $150,000 married household profile — a gap of over 13 percentage points.\"]}]]}]]}],\"$L8\",\"$L9\"]}]]}],\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\"]}]\n5:[\"$\",\"$L10\",null,{\"children\":[\"$\",\"$11\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@12\"}]}]\n7:[\"$\",\"strong\",null,{\"className\":\"text-rose-400\",\"children\":\"13.3% in California\"}]\n8:[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 rounded-lg border border-border/30 bg-card/30 p-4\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-down mt-0.5 h-5 w-5 flex-shrink-0 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"t6n2it\",{\"d\":\"M16 17h6v-6\"}],[\"$\",\"path\",\"x473p\",{\"d\":\"m22 17-8.5-8.5-5 5L2 7\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"Tax burden correlates with outmigration\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":\"Regression analysis shows a significant negative correlation (r = -0.42, p < 0.01) between state tax burden and net domestic migration over 2021-2025, suggesting tax differentials influence household relocation decisions.\"}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3 rounded-lg border border-border/30 bg-card/30 p-4\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-file-text mt-0.5 h-5 w-5 flex-shrink-0 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1rqfz7\",{\"d\":\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"}],[\"$\",\"path\",\"tnqrlb\",{\"d\":\"M14 2v4a2 2 0 0 0 2 2h4\"}],[\"$\",\"path\",\"b1mrlr\",{\"d\":\"M10 9H8\"}],[\"$\",\"path\",\"t4e002\",{\"d\":\"M16 13H8\"}],[\"$\",\"path\",\"z1uh3a\",{\"d\":\"M16 17H8\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"Seven states have no income tax\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":\"Alaska, Florida, Nevada, South Dakota, Texas, Washington, and Wyoming impose no broad-based individual income tax. New Hampshire taxes only dividend and interest income (phased out completely in 2025).\"}]]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Methodology Summary\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-4\",\"children\":\"We model four components of state and local taxation: (1) state individual income tax using each state's 2026 brackets, deductions, and exemptions; (2) state-level sales tax applied to a representative consumption basket; (3) property tax at median effective rates applied to median-valued owner-occupied housing; and (4) excise taxes on gasoline at average annual consumption.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground\",\"children\":\"Four representative household profiles are used: P1 ($35K single renter), P2 ($75K married with 2 children, $250K home), P3 ($150K married with 2 children, $400K home), and P4 ($300K married with 2 children, $700K home). The table below shows results for Profile P3. See the full methodology page for details on all profiles.\"}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"2026 Effective State Tax Burden Rankings\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"Profile P3: $150,000 married household with 2 children, $400,000 home.\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto rounded-xl border border-border/30\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"className\":\"bg-card/50\",\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-left font-semibold text-foreground\",\"children\":\"Rank\"}],[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-left font-semibold text-foreground\",\"children\":\"State\"}],[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-right font-semibold text-foreground\",\"children\":\"Income Tax\"}],[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-right font-semibold text-foreground\",\"children\":\"Sales Tax\"}],[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-right font-semibold text-foreground\",\"children\":\"Property Tax\"}],[\"$\",\"th\",null,{\"className\":\"px-3 py-2 text-right font-semibold text-emerald-400\",\"children\":\"Total\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"divide-y divide-border/20\",\"children\":[[\"$\",\"tr\",\"Alaska\",{\"className\":\"bg-emerald-500/5\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-muted-foreground\",\"children\":1}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 font-medium text-foreground\",\"children\":\"Alaska\"}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.0\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"1.76\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"1.18\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right font-bold text-emerald-400\",\"children\":[\"4.6\",\"%\"]}]]}],[\"$\",\"tr\",\"Wyoming\",{\"className\":\"bg-emerald-500/5\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-muted-foreground\",\"children\":2}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 font-medium text-foreground\",\"children\":\"Wyoming\"}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.0\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"4.00\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.61\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right font-bold text-emerald-400\",\"children\":[\"5.8\",\"%\"]}]]}],[\"$\",\"tr\",\"Florida\",{\"className\":\"bg-emerald-500/5\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-muted-foreground\",\"children\":3}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 font-medium text-foreground\",\"children\":\"Florida\"}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.0\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"6.00\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.83\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right font-bold text-emerald-400\",\"children\":[\"6.2\",\"%\"]}]]}],[\"$\",\"tr\",\"Tennessee\",{\"className\":\"bg-emerald-500/5\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-muted-foreground\",\"children\":4}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 font-medium text-foreground\",\"children\":\"Tennessee\"}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.0\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"7.00\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.71\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right font-bold text-emerald-400\",\"children\":[\"6.4\",\"%\"]}]]}],[\"$\",\"tr\",\"South Dakota\",{\"className\":\"bg-emerald-500/5\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-muted-foreground\",\"children\":5}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 font-medium text-foreground\",\"children\":\"South Dakota\"}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"0.0\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"4.50\",\"%\"]}],[\"$\",\"td\",null,{\"className\":\"px-3 py-2 text-right text-muted-foreground\",\"children\":[\"1.32\",\"%\"]}],\"$L13\"]}],\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\"]}]]}]}],\"$L41\"]}]\nc:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Discussion & Implications\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-muted-foreground\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The substantial variation in effective state tax burdens documented in this study has important implications for household financial planning, employer compensation design, and state tax policy. For households with location flexibility — particularly remote workers and retirees — the cumulative effect of state tax differentials can exceed $20,000 annually for the P3 income profile, representing a meaningful share of disposable income.\"}],[\"$\",\"p\",null,{\"children\":\"For policymakers, the negative correlation between tax burden and net migration raises questions about the long-run revenue implications of high-tax regimes. While our analysis cannot establish causation, the consistent pattern across multiple income profiles and time periods suggests tax differentials are a meaningful factor in household location decisions, particularly among high-income households.\"}],[\"$\",\"p\",null,{\"children\":\"The recent trend toward flat tax structures — adopted by 14 states as of 2026, up from 8 in 2020 — reflects a deliberate policy choice to simplify administration and reduce marginal rate effects. Our data show flat-tax states have, on average, lower effective burdens across all four income profiles.\"}]]}]]}]\nd:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Limitations\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground\",\"children\":\"Several limitations should be noted. Our representative household profiles simplify real household heterogeneity. Actual tax burdens vary based on specific deductions, credits, and circumstances. Our consumption basket reflects national averages. Property tax assessments use median values; actual burdens depend on local practices. Migration analysis is correlational and cannot establish causation — multiple confounding factors including housing costs, climate, and labor market conditions also influence migration decisions.\"}]]}]\ne:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"References\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"Tax Foundation. (2026). \",[\"$\",\"em\",null,{\"children\":\"State and Local Tax Burden Rankings: 2026 Update\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\"U.S. Census Bureau. (2025). \",[\"$\",\"em\",null,{\"children\":\"American Community Survey 5-Year Estimates\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\"Bureau of Labor Statistics. (2025). \",[\"$\",\"em\",null,{\"children\":\"Consumer Expenditure Survey: 2024 Annual Report\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\"Internal Revenue Service. (2026). \",[\"$\",\"em\",null,{\"children\":\"Publication 15 (Circular E): Employer's Tax Guide\"}],\".\"]}],[\"$\",\"li\",null,{\"children\":[\"McLure, C. E. (2024). State tax policy in the post-pandemic era. \",[\"$\",\"em\",null,{\"children\":\"National Tax Journal\"}],\", 77(2), 145-172.\"]}],[\"$\",\"li\",null,{\"children\":[\"Gale, W. G., Krupkin, A., & Rueben, K. (2025). State tax reform options for 2026. \",[\"$\",\"em\",null,{\"children\":\"Tax Policy Center Report\"}],\".\"]}]]}]]}]\nf:[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-emerald-500/30 bg-gradient-to-br from-emerald-500/5 to-emerald-500/10 p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-3\",\"children\":\"Compute Your Personalized Tax Burden\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-6\",\"children\":\"Use our free calculators to compute your actual state tax burden based on your specific income, location, and filing status.\"}],[\"$\",\"d