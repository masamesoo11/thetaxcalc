ebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg\">Skip to main content</a><div class=\"min-h-screen flex flex-col bg-background bg-mesh\"><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg\">Skip to main content</a><header class=\"sticky top-0 z-[100] w-full glass-strong overflow-visible\"><div class=\"h-[2px] bg-gradient-to-r from-transparent via-emerald-500/60 to-transparent\"></div><div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6