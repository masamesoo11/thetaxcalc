_next/static/chunks/1l83f0l5jzis_.js\"],\"ScenarioComparison\"]\n1e:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n1f:\"$Sreact.suspense\"\n2:T112b,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/salary-comparison-calculator#software\",\"@type\":\"WebApplication\",\"name\":\"Salary Comparison Calculator\",\"url\":\"https://thetaxcalc.com/salary-comparison-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/salary-comparison-calculator\"},\"description\":\"Compare salaries after federal, state, and FICA taxes side by side for all 50 states. Free 2026 calculator.\",\"provider\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"author\":{\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}},{\"@id\":\"https://thetaxcalc.com/salary-comparison-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do I compare salaries in different states?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Enter each salary and select the corresponding state. The calculator will show you the after-tax take-home pay for each scenario side by side, including federal tax, FICA (Social Security and Medicare), and state income tax. The difference column highlights exactly how much more or less you would take home.\"}},{\"@type\":\"Question\",\"name\":\"Why is the after-tax difference bigger than the salary difference?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"State income tax rates vary dramatically — from 0% in Texas, Florida, and Washington to over 13% in California. A $10,000 salary increase in California might result in only $6,000 more after taxes, while the same $10,000 increase in Texas gives you nearly $7,700 more. This calculator shows you the real, after-tax value of any salary difference.\"}},{\"@type\":\"Question\",\"name\":\"Does this include FICA taxes (Social Security and Medicare)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Every scenario includes the full 6.2% Social Security tax (up to the 2026 wage base of $184,500) and 1.45% Medicare tax, plus the 0.9% Additional Medicare Tax for incomes over $200,000. These are the same regardless of state, but they reduce your take-home pay significantly.\"}},{\"@type\":\"Question\",\"name\":\"Can I compare job offers with different benefits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You can adjust 401(k) contributions and HSA contributions for each scenario. If one job offers a 5% 401(k) match and another does not, enter the contribution amounts to see how pre-tax deductions affect your net take-home pay.\"}},{\"@type\":\"Question\",\"name\":\"Is this calculator accurate for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. All federal tax brackets, standard deductions, FICA rates, and state tax rates are updated for the 2026 tax year. The 2026 Social Security wage base is $184,500, the standard deduction is $16,100 for single filers, and state rates reflect the latest published figures from each state revenue department.\"}}]},{\"@id\":\"https://thetaxcalc.com/salary-comparison-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Salary Comparison Calculator\"}]}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\"]}],[\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\"],\"$L10\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/\",\"className\":\"underline underline-offset-2 decoration-muted-foreground/40 hover:decoration-foreground hover:text-foreground transition-colors flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-house h-3.5 w-3.5\",\"aria-hid