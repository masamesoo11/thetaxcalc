{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/salary-comparison-calculator/layout,_N_T_/salary-comparison-calculator/page,_N_T_/salary-comparison-calculator"},"segmentPaths":["/_tree","/_full","/salary-comparison-calculator/__PAGE__","/salary-comparison-calculator","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/233p45nuh4m5b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0dwp-mo_n_jm0.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/35lt1fghf7uep.js\"/><script src=\"/_next/static/chunks/0paxexg6-m0de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2xgiyxwb0ui_c.js\" async=\"\"></script><script src=\"/_next/static/chunks/1ticr5om3zo_s.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-06pzha75hv9oa.js\" async=\"\"></script><script src=\"/_next/static/chunks/2g3ofza521d-d.js\" async=\"\"></script><script src=\"/_next/static/chunks/3mzfoc5k_0lxh.js\" async=\"\"></script><script src=\"/_next/static/chunks/1h498-er8bjws.js\" async=\"\"></script><script src=\"/_next/static/chunks/1i8lzoxtdw4ca.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6dwfk.js\" async=\"\"></script><script src=\"/_next/static/chunks/44p37290qsddb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1kthlnkql3p_5.js\" async=\"\"></script><script src=\"/_next/static/chunks/41ushzejcf42p.js\" asyn