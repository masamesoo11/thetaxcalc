,\"ul\",null,{\"className\":\"space-y-3 text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-bold text-emerald-400\",\"children\":\"1\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Filing status\"}],\" — Married filing jointly doubles the standard deduction to $32,200 and uses wider tax brackets, reducing federal tax significantly compared to single filing status.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-bold text-emerald-400\",\"children\":\"2\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"401(k) contributions\"}],\" — Pre-tax contributions reduce your federal and state taxable income. A $10,000 401(k) contribution at the 22% marginal rate saves you $2,200 in federal tax plus state tax savings.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-bold text-emerald-400\",\"children\":\"3\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"HSA contributions\"}],\" — Triple-tax-advantaged. Reduces FICA, federal, and state taxable income. The 2026 limit is $4,400 (self) or $8,300 (family).\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-bold text-emerald-400\",\"children\":\"4\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"NYC residency\"}],\" — If you live in NYC, add 3.078%–3.876% city tax on top of New York state tax. This can reduce a $100K salary's take-home by another $3,500+ per year.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/10 text-xs font-bold text-emerald-400\",\"children\":\"5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Additional Medicare Tax\"}],\" — Above $200,000 (single), add 0.9% Medicare surtax. This affects high earners and isn't matched by employers.\"]}]]}]]}]]}]\n1a:[\"$\",\"section\",null,{\"className\":\"mb-10 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":[\"Common \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Mistakes\"}],\" When Comparing Salaries\"]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"When evaluating job offers or planning a relocation, watch out for these common pitfalls:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-rose-500/20 bg-rose-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2 text-sm\",\"children\":\"❌ Comparing Gross Salaries Only\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed\",\"children\":\"A $120K offer in CA vs $110K in TX — the TX offer may actually pay more after taxes. Always compare take-home, not gross.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-rose-500/20 bg-rose-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2 text-sm\",\"children\":\"❌ Forgetting Property Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed\",\"children\":\"Texas has 1.71% property tax vs California's 0.71%. On a $500K home, that's $5,000/year extra in TX.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-rose-500/20 bg-rose-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2 text-sm\",\"children\":\"❌ Ignoring 401(k) Match\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed\",\"children\":\"A 5% match on $100K is $5,000 of \\\"free\\\" pre-tax money. Include this in your total compensation comparison.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-rose-500/20 bg-rose-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2 text-sm\",\"children\":\"❌ Overlooking Cost of Living\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed\",\"children\":\"$$100K in San Francisco is barely middle class; $100K in Houston is comfortable. Adjust for local costs.\"}]]}]]}]]}]\n1b:[\"$\",\"section\",null,{\"className\":\"mb-10 space-y-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":[\"How to \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Use Your Results\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"Once you've compared after-tax salaries, the next step is to factor in cost-of-living differences. A $5,000/year take-home advantage in Texas could be erased if housing costs $500 more per month. Use our \",[\"$\",\"$L11\",null,{\"href\":\"/relocation-calculator\",\"className\":\"text-emerald-400 hover:underline\",\"children\":\"Relocation Calculator\"}],\" \",\"to factor in housing, utilities, transportation, and groceries for a complete picture.\"]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"