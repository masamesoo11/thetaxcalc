-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Every scenario includes the full 6.2% Social Security tax (up to the 2026 wage base of $184,500) and 1.45% Medicare tax, plus the 0.9% Additional Medicare Tax for incomes over $200,000. These are the same regardless of state, but they reduce your take-home pay significantly.\"}]]}],\"$L1c\",\"$L1d\"]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8 text-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-xl font-bold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center justify-center gap-3\",\"children\":[[\"$\",\"$L11\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 bg-card/50 px-4 py-2 text-sm text-muted-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L11\",\"/job-offer-comparison-calculator\",{\"href\":\"/job-offer-comparison-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 bg-card/50 px-4 py-2 text-sm text-muted-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"Job Offer Comparison\"}],[\"$\",\"$L11\",\"/paycheck-difference-calculator\",{\"href\":\"/paycheck-difference-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 bg-card/50 px-4 py-2 text-sm text-muted-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"Paycheck Difference\"}],[\"$\",\"$L11\",\"/compare\",{\"href\":\"/compare\",\"className\":\"inline-flex items-center gap-1.5