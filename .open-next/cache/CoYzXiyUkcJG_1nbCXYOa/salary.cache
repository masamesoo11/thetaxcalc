 (4%–10.9%)\"]}]\n153:[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground mb-3\",\"children\":\"Salary & Guides\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2\",\"children\":[[\"$\",\"$L5\",\"/salary/50000-after-taxes\",{\"href\":\"/salary/50000-after-taxes\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$50K\"}],[\"$\",\"$L5\",\"/salary/75000-after-taxes\",{\"href\":\"/salary/75000-after-taxes\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$75K\"}],[\"$\",\"$L5\",\"/salary/100000-after-taxes\",{\"href\":\"/salary/100000-after-taxes\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$100K\"}],[\"$\",\"$L5\",\"/salary/150000-after-taxes\",{\"href\":\"/salary/150000-after-taxes\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$150K\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-2\",\"children\":[[\"$\",\"$L5\",null,{\"href\":\"/compare\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Compare State Taxes\"]}],[\"$\",\"$L5\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"2026 Federal Tax Brackets\"]}],[\"$\",\"$L5\",null,{\"href\":\"/glossary\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Tax Glossary\"]}],[\"$\",\"$L5\",null,{\"href\":\"/blog\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Blog\"]}]]}]]}]\n154:[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How are salary after-tax calculations done?\"}]\n155:[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]\n156:[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"We start with your gross salary and subtract: (1) Federal income tax using 2026 progressive brackets (10%–37%) after the $16,100 standard deduction for single filers, (2) FICA payroll tax at 6.2% for Social Security (up to $184,500 wage cap) plus 1.45% for Medicare on all wages, and (3) State income tax using each state's specific brackets or flat rate. The result is your net annual take-home pay, which we also break down into monthly, bi-weekly, and weekly amounts.\"}]\n157:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does the salary calculator include 401(k) or HSA deductions?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The salary pages show take-home pay with standard deduction only — no 401(k) or HSA. For a more detailed calculation that includes pre-tax deductions, different filing statuses, and additional options, use our full Paycheck Calculator. Pre-tax deductions like 401(k) contributions reduce your taxable income at both the federal and state level, which can lower your effective tax rate significantly.\"}]]}]\n158:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Why do Texas and Florida have 0% state income tax?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Texas and Florida generate revenue through other means instead of taxing wages. Texas relies heavily on property taxes (averaging ~1.71% of home value, among the highest in the nation) and sales tax (6.25% state + local). Florida uses sales tax (6% state + local) and has a relatively low property tax rate (~0.86%). Both states also collect revenue from tourism, oil (Texas), and various fees. The trade-off is that while your paycheck is bigger, other costs may be higher — especially property taxes in Texas.\"}]]}]\n159:[\"$\",\"div\",\"illinois\",{\"className\":\"text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-1.5 rounded-full bg-muted/30 overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-full bg-emerald-500/60\",\"style\":{\"width\":\"94.73594587905289%\"}}]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-muted-foreground mt-1\",\"children\":\"IL\"}]]}]\n15a:[\"$\",\"div\",\"pennsylvania\",{\"className\":\"text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"h-1.5 rounded-full bg-muted/30 overflow-hidden\",\"children\":[\"$\",\"div\",null,{\"className\":\"h-full rounded-full bg-emerald-500/60\",\"style\":{\"width\":\"96.45408794653906%\"}}]}],[\"$\",\"p\",null,{\"className\":\"text-[10px] text-muted-foreground mt-1\",\"child