{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/freefile-irs/layout,_N_T_/freefile-irs/page,_N_T_/freefile-irs"},"segmentPaths":["/_tree","/_full","/freefile-irs/__PAGE__","/freefile-irs","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/233p45nuh4m5b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0dwp-mo_n_jm0.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/35lt1fghf7uep.js\"/><script src=\"/_next/static/chunks/0paxexg6-m0de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2xgiyxwb0ui_c.js\" async=\"\"></script><script src=\"/_next/static/chunks/1ticr5om3zo_s.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-06pzha75hv9oa.js\" async=\"\"></script><script src=\"/_next/static/chunks/2g3ofza521d-d.js\" async=\"\"></script><script src=\"/_next/static/chunks/3mzfoc5k_0lxh.js\" async=\"\"></script><script src=\"/_next/static/chunks/1h498-er8bjws.js\" async=\"\"></script><script src=\"/_next/static/chunks/1i8lzoxtdw4ca.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6dwfk.js\" async=\"\"></script><script src=\"/_next/static/chunks/44p37290qsddb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1kthlnkql3p_5.js\" async=\"\"></script><script src=\"/_next/static/chunks/1l_n4bv91w2_0.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>IRS Free File 2026 — Free Federal Tax Filing | Eligibility &amp; Guide</title><meta name=\"description\" content=\"File federal taxes free with IRS Free File. AGI under $84K gets guided software; Fillable Forms for everyone. Free extension filing. 2026 guide with eligibility checker.\"/><link rel=\"author\" href=\"https://thetaxcalc.com/about#rachel-mitchell\"/><meta name=\"author\" content=\"Rachel Mitchell\"/><meta name=\"keywords\" content=\"freefile irs,irs free file,irs free file program,free federal tax filing,free file fillable forms,irs free tax filing,free tax return software,free tax return filing,irs gov free file,freefile,free filing taxes,irs free file extension,free tax extension,free federal income tax filing,irs free efile,free tax returns for low income,free tax returns for seniors,file tax extension free,irs free tax return,amended tax return online for free,free 1099 form,file taxes online irs,free tax return preparation,free online federal tax filing,free state and federal tax filing,1040 free file,irs free file fillable forms,irs free tax preparation,federal free file,free tax forms,irs free file online\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"finance\"/><meta name=\"classification\" content=\"Tax Calculator\"/><link rel=\"canonical\" href=\"https://thetaxcalc.com/freefile-irs\"/><meta name=\"google-site-verification\" content=\"7bdac16b5ecbdd40\"/><meta property=\"og:title\" content=\"IRS Free File 2026 — Free Federal Tax Filing Guide\"/><meta property=\"og:description\" content=\"File your federal taxes for free. IRS Free File guided software (AGI ≤ $84K) + Fillable Forms for everyone. Eligibility checker &amp; step-by-step guide.\"/><meta property=\"og:url\" content=\"https://thetaxcalc.com/freefile-irs\"/><meta property=\"og:site_name\" content=\"TheTaxCalc\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"IRS Free File 2026 — Free Federal Tax Filing Guide\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"IRS Free File 2026 — Free Federal Tax Filing Guide\"/><meta name=\"twitter:description\" content=\"File your federal taxes for free. IRS Free File guided software (AGI ≤ $84K) + Fillable Forms for everyone. Eligibility checker &amp; step-by-step guide.\"/><meta name=\"twitter:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></di