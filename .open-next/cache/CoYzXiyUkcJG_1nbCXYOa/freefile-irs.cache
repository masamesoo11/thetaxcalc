 font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Tax Brackets 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Full federal bracket breakdown\"}]]}]]}]]}]]}]\n20:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Explore More Tools\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/compare\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📊 Compare States\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Side-by-side tax comparison\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/salary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"💰 Salary After Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home for $30K–$500K\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📋 Tax Brackets 2026\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Federal brackets & rates\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/glossary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📖 Tax Glossary\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Key terms explained\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/blog\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📝 Tax Guides & Blog\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Expert tax tips & guides\"}]]}]]}]]}]\n23:null\n24:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I file a free tax extension through IRS Free File?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. IRS Free File partners allow you to e-file Form 4868 (Application for Automatic Extension of Time to File) for free. This gives you until October 15 to file your return. Important: the extension only gives you more time to file the paperwork — you still have to pay any tax you owe by April 15. If you expect a refund, there's no penalty for filing late, but you should still file as soon as possible to get your money.\"}]]}]\n25:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is IRS Free File really free? What's the catch?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It's genuinely free for federal filing if you access it through irs.gov/freefile. The catch? If you go directly to a tax software company's website instead of through the IRS portal, you may end up on their paid version. Always start at irs.gov/freefile to get the free version. Some Free File partners charge for state returns (though some include it free). Free File Fillable Forms don't include state filing at all — you'll need to file your state return separately.\"}]]}]\n26:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I use IRS Free File if I'm self-employed?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes, but it depends on which option you choose. Some IRS Free File Guided Preparation partners support self-employment income (Schedule C, Schedule SE, 1099-NEC) — check each partner's offerings before you start. Free File Fillable Forms definitely support self-employment forms, but you need to know which schedules to fill out. If your self-employment income is complex (multiple 1099s, inventory, home office, vehicle expenses), guided preparation may be easier.\"}]]}]\n27:[\"$\",\"details\",\"6\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do I file an amended tax return for free?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"To file an amended return (Form 1040-X) for free, you can use Free File Fillable Forms, which include Form 1040-X. Not all Guided Preparation partners support amended returns, so check before starting. You can also file Form 1040-X by mail — download it from irs.gov. There's no fee for filing an amended return either way. Note: you can't e-file an amended return for a year before 2020 — those must be mailed.\"}]]}]\n28:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What free tax help is available for seniors and low-income taxpayers?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Two excellent programs: VITA (Volunteer Income Tax Assistance) offers free tax preparation for people earning $64,000 or less, persons with disabilities, and limited English speakers. TCE (Tax Counseling for the Elderly) specializes in tax questions for people 60 and older. Both use IRS-certified volunteers and are available at community centers, libraries, and churches nationwide. Find locations at irs.gov/vita. Some AARP Tax-Aide sites also provide free preparation regardless of income or age.\"}]]}]\n29:[\"$\",\"details\",\"8\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I file state taxes for free through IRS Free File?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It depends on your Free File partner. Some Guided Preparation partners include free state filing, while others charge a fee (typically $15–$40). Active-duty military with AGI ≤ $84,000 get free state filing from all partners. Free File Fillable Forms do not include state filing — you'll need to file separately through your state's tax website or a state-specific free file program. Many states offer their own free filing options.\"}]]}]\n2a:[\"$\",\"details\",\"9\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What's the difference between IRS Free File and paid tax software?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The core difference is cost and support. IRS Free File Guided Preparation gives you the same brand-name software (TaxSlayer, OLT, etc.) for free — but only if you access it through irs.gov/freefile and meet the AGI threshold. Paid versions may include live chat support, audit protection, or more complex form coverage (like rental properties or K-1s). If your taxes are relatively straightforward — W-2 income, standard deduction, maybe some 1099s — Free File covers everything you need.\"}]]}]\n2b:[\"$\",\"details\",\"10\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"When does IRS Free File open for 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"IRS Free File typically opens in mid-to-late January. For the 2026 filing season (tax year 2025), the portal is expected to open around January 27, 2026. You can prepare your return early through a Free File partner, but the IRS won't start processing returns until late January. If you file early, your return is held and processed when the IRS systems open — you don't lose your place in line.\"}]]}]\n2c:[\"$\",\"details\",\"11\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do I get my 1099 form for free?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Your 1099 forms are provided by the payer (employer, bank, investment platform) — you don't pay for them. If you're missing a 1099, request a copy from the issuer or find it in your online account. The IRS also has a tool to view your wage and income transcripts (which include 1099 data) at irs.gov/transcript. Free File Fillable Forms support 1099-NEC, 1099-MISC, 1099-INT, 1099-DIV, and other common 1099 variants.\"}]]}]\n","/freefile-irs":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n4:[]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":\"$W4\",\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"ClientAnalytics\"]\n5:I[40264,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"QueryProvider\"]\n6:I[41631,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"SiteShell\"]\n7:I[40230,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\"],\"WebMCPProvider\"]\n8:I[39756,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"default\"]\n9:I[58298,[\"/_n