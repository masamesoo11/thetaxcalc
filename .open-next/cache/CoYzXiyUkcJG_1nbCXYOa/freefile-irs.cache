und mt-0.5\",\"children\":\"Take-home pay for all 50 states\"}]]}]]}],[\"$\",\"$L12\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"group flex items-start gap-3 rounded-lg border border-border/50 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-lg\",\"children\":\"📋\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Tax Brackets 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Full federal bracket breakdown\"}]]}]]}]]}]]}]\n46:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Explore More Tools\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\",\"children\":[[\"$\",\"$L12\",null,{\"href\":\"/compare\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📊 Compare States\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Side-by-side tax comparison\"}]]}],[\"$\",\"$L12\",null,{\"href\":\"/salary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"💰 Salary After Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home for $30K–$500K\"}]]}],[\"$\",\"$L12\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📋 Tax Brackets 2026\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Federal brackets & rates\"}]]}],[\"$\",\"$L12\",null,{\"href\":\"/glossary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📖 Tax Glossary\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Key terms explained\"}]]}],[\"$\",\"$L12\",null,{\"href\":\"/blog\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📝 Tax Guides & Blog\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Expert tax tips & guides\"}]]}]]}]]}]\n47:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I file a free tax extension through IRS Free File?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. IRS Free File partners allow you to e-file Form 4868 (Application for Automatic Extension of Time to File) for free. This gives you until October 15 to file your return. Important: the extension only gives you more time to file the paperwork — you still have to pay any tax you owe by April 15. If you expect a refund, there's no penalty for filing late, but you should still file as soon as possible to get your money.\"}]]}]\n48:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is IRS Free File really free? What's the catch?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It's genuinely free for federal filing if you access it through irs.gov/freefile. The catch? If you go directly to a tax software company's website instead of through the IRS portal, you may end up on their paid version. Always start at irs.gov/freefile to get the free version. Some Free File partners charge for state returns (though some include it free). Free File Fillable Forms don't include state filing at all — you'll need to file your state return separately.\"}]]}]\n49:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I use IRS Free File if I'm self-employed?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes, but it depends on which option you choose. Some IRS Free File Guided Preparation partners support self-employment income (Schedule C, Schedule SE, 1099-NEC) — check each partner's offerings before you start. Free File Fillable Forms definitely support self-employment forms, but you need to know which schedules to fill out. If your self-employment income is complex (multiple 1099s, inventory, home office, vehicle expenses), guided preparation may be easier.\"}]]}]\n4a:[\"$\",\"details\",\"6\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do I file an amended tax return for free?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"To file an amended return (Form 1040-X) for free, you can use Free File Fillable Forms, which include Form 1040-X. Not all Guided Preparation partners support amended returns, so check before starting. You can also file Form 1040-X by mail — download it from irs.gov. There's no fee for filing an amended return either way. Note: you can't e-file an amended return for a year before 2020 — those must be mailed.\"}]]}]\n4b:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What free tax help is available for seniors and low-income taxpayers?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Two excellent programs: VITA (Volunteer Income Tax Assistance) offers free tax preparation for people earning $64,000 or less, persons with disabilities, and limited English speakers. TCE (Tax Counseling for the Elderly) specializes in tax questions for people 60 and older. Both use IRS-certified volunteers and are available at community centers, libraries, and churches nationwide. Find locations at irs.gov/vita. Some AARP Tax-Aide sites also provide free preparation regardless of income or age.\"}]]}]\n4c:[\"$\",\"details\",\"8\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I file state taxes for free through IRS Free File?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It depends on your Free File partner. Some Guided Preparation partners include free state filing, while others charge a fee (typically $15–$40). Active-duty military with AGI ≤ $84,000 get free state filing from all partners. Free File Fillable Forms do not include state filing — you'll need to file separately through your state's tax website or a state-specific free file program. Many states offer their own free filing options.\"}]]}]\n4d:[\"$\",\"details\",\"9\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What's the difference between IRS Free File and paid tax software?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The core difference is cost and support. IRS Free File Guided Preparation gives you the same brand-name software (TaxSlayer, OLT, etc.) for free — but only if you access it through irs.gov/freefile and meet the AGI threshold. Paid versions may include live chat support, audit protection, or more complex form coverage (like rental properties or K-1s). If your taxes are relatively straightforward — W-2 income, standard deduction, maybe some 1099s — Free File covers everything you need.\"}]]}]\n4e:[\"$\",\"details\",\"10\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"When does IRS Free File open for 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"IRS Free File typically opens in mid-to-late January. For the 2026 filing season (tax year 2025), the portal is expected to open around January 27, 2026. You can prepare your return early through a Free File partner, but the IRS won't start processing returns until late January. If you file early, your return is held and processed when the IRS systems open — you don't lose your place in line.\"}]]}]\n4f:[\"$\",\"details\",\"11\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do I get my 1099 form for free?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Your 1099 forms are provided by the payer (employer, bank, investment platform) — you don't pay for them. If you're missing a 1099, request a copy from the issuer or find it in your online account. The IRS also has a tool to view your wage and income transcripts (which include 1099 data) at irs.gov/transcript. Free File Fillable Forms support 1099-NEC, 1099-MISC, 1099-INT, 1099-DIV, and other common 1099 variants.\"}]]}]\n27:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n51:I[27201,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"IconMark\"]\n24:null\n29:[[\"$\",\"title\",\"0\",{\"children\":\"IRS Free File 2026 — Free Federal Tax Filing | Eligibility & Guide\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"File federal taxes free with IRS Free File. AGI under $84K gets guided software; Fillable Forms for everyone. Free extension filing. 2026 guide with eligibility checker.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"freefile irs,irs free file,irs free file program,free federal tax filing,free file fillable forms,irs free tax filing,free tax return software,free tax return filing,irs gov free file,freefile,free filing taxes,irs free file extension,free tax extension,free federal income tax filing,irs free efile,free tax returns for low income,free tax returns for seniors,file tax extension free,irs free tax return,amended tax return online for free,free 1099 form,file taxes online irs,free tax return preparation,free online federal tax filing,free state and federal tax filing,1040 free file,irs free file fillable forms,irs free tax preparation,federal free file,free tax forms,irs free file online\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"9\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"10\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"11\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/freefile-irs\"}],[\"$\",\"meta\",\"12\",{\"name\":\"google-site-verification\",\"content\":\"7bdac16b5ecbdd40\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:title\",\"content\":\"IRS Free File 2026 — Free Federal Tax Filing Guide\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:description\",\"content\":\"File your federal taxes for free. IRS Free File guided software (AGI ≤ $84K) + Fillable Forms for everyone. Eligibility checker & step-by-step guide.\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/freefile-irs\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image:alt\",\"content\":\"IRS Free File 2026 — Free Federal Tax Filing Guide\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:title\",\"content\":\"IRS Free File 2026 — Free Federal Tax Filing Guide\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:description\",\"content\":\"File your federal taxes for free. IRS Free File guided software (AGI ≤ $84K) + Fillable Forms for everyone. Eligibility checker & step-by-step guide.\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"28\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L51\",\"29\",{}]]\n","/freefile-irs/__PAGE__":"1:\"$Sreact.fragment\"\nc:I[22016,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1l_n4bv91w2_0.js\"],\"\"]\nd:I[79086,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1l_n4bv91w2_0.js\"],\"ShareButtons\"]\ne:I[95144,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1l_n4bv91w2_0.js\"],\"FreefileIrsClient\"]\n21:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n22:\"$Sreact.suspense\"\n2d:I[18274,[\"/_next/static/chunks/2g3ofza521d-d.js\",\"/_next/static/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/1l_n4bv91w2_0.js\"],\"LinkToUs\"]\n2:T2a6a,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/freefile-irs#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"IRS Free File\"}]},{\"@id\":\"https://thetaxcalc.com/freefile-irs#webpage\",\"@type\":\"WebPage\",\"name\":\"IRS Free File 2026 — Free Federal Tax Filing Guide\",\"description\":\"File your federal taxes for free with IRS Free File. Guided tax software if your AGI is $84,000 or less, plus Free File Fillable Forms for everyone.\",\"url\":\"https://thetaxcalc.com/freefile-irs\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/freefile-irs#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/freefile-irs#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/freefile-irs#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/freefile-irs#webapp\",\"@type\":\"WebApplication\",\"name\":\"IRS Free File Eligibility Checker\",\"url\":\"https://thetaxcalc.com/freefile-irs\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/freefile-irs\"},\"author\":{\"@id\":\"https://thetaxcalc.com/freefile-irs#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/freefile-irs#howto\",\"@type\":\"HowTo\",\"name\":\"How to File Your Taxes for Free with IRS Free File\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Go to IRS Free File\",\"text\":\"Visit irs.gov/freefile to access the IRS Free File portal. Do not go directly to a tax software site — start from the IRS to get the free version.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Choose Your Option\",\"text\":\"If your AGI is $84,000 or less, choose Guided Tax Preparation. If higher, or you prefer doing your own taxes, choose Free File Fillable Forms.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Create an Account\",\"text\":\"Sign up with your chosen Free File partner. You'll need your Social Security number, last year's AGI for verification, and your W-2s/1099s.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Complete Your Return\",\"text\":\"Follow the guided interview (Guided Prep) or fill in the forms directly (Fillable Forms). Double-check all entries before submitting.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"E-File Your Return\",\"text\":\"Submit your federal return electronically. You'll receive a confirmation when the IRS accepts it. File state taxes separately if needed.\"}]},{\"@id\":\"https://thetaxcalc.com/freefile-irs#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is IRS Free File and how does it work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IRS Free File is a partnership between the IRS and private tax software companies that lets you file your federal tax return for free. If your AGI is $84,000 or less, you can use guided tax software (think TurboTax-style interview process) at no cost. If your income is higher, Free File Fillable Forms — electronic versions of IRS paper forms — are available to everyone. You access both through irs.gov/freefile.\"}},{\"@type\":\"Question\",\"name\":\"Who qualifies for IRS Free File guided tax preparation?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anyone with a 2025 adjusted gross income (AGI) of $84,000 or less qualifies for IRS Free File Guided Tax Preparation. That covers roughly 70% of all taxpayers. Active-duty military personnel with AGI ≤ $84,000 also get free state filing. Taxpayers 57 and older may have access to additional partner options. There's no age minimum — you just need to meet the income threshold.\"}},{\"@type\":\"Question\",\"name\":\"What are Free File Fillable Forms?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Free File Fillable Forms are electronic versions of IRS paper forms that anyone can use to file their federal taxes for free, regardless of income. They're available at freefilefillableforms.com and include Form 1040, Schedules A through SE, and most other common IRS forms. The forms do basic math calculations, but there's no interview process or guidance — you need to know which forms to fill out and how. There's no income limit, making them the go-to option for taxpayers who earn more than $84,000.\"}},{\"@type\":\"Question\",\"name\":\"Can I file a free tax extension through IRS Free File?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. IRS Free File partners allow you to e-file Form 4868 (Application for Automatic Extension of Time to File) for free. This gives you until October 15 to file your return. Important: the extension only gives you more time to file the paperwork — you still have to pay any tax you owe by April 15. If you expect a refund, there's no penalty for filing late, but you should still file as soon as possible to get your money.\"}},{\"@type\":\"Question\",\"name\":\"Is IRS Free File really free? What's the catch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's genuinely free for federal filing if you access it through irs.gov/freefile. The catch? If you go directly to a tax software company's website instead of through the IRS portal, you may end up on their paid version. Always start at irs.gov/freefile to get the free version. Some Free File partners charge for state returns (though some include it free). Free File Fillable Forms don't include state filing at all — you'll need to file your state return separately.\"}},{\"@type\":\"Question\",\"name\":\"Can I use IRS Free File if I'm self-employed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, but it depends on which option you choose. Some IRS Free File Guided Preparation partners support self-employment income (Schedule C, Schedule SE, 1099-NEC) — check each partner's offerings before you start. Free File Fillable Forms definitely support self-employment forms, but you need to know which schedules to fill out. If your self-employment income is complex (multiple 1099s, inventory, home office, vehicle expenses), guided preparation may be easier.\"}},{\"@type\":\"Question\",\"name\":\"How do I file an amended tax return for free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"To file an amended return (Form 1040-X) for free, you can use Free File Fillable Forms, which include Form 1040-X. Not all Guided Preparation partners support amended returns, so check before starting. You can also file Form 1040-X by mail — download it from irs.gov. There's no fee for filing an amended return either way. Note: you can't e-file an amended return for a year before 2020 — those must be mailed.\"}},{\"@type\":\"Question\",\"name\":\"What free tax help is available for seniors and low-income taxpayers?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Two excellent programs: VITA (Volunteer Income Tax Assistance) offers free tax preparation for people earning $64,000 or less, persons with disabilities, and limited English speakers. TCE (Tax Counseling for the Elderly) specializes in tax questions for people 60 and older. Both use IRS-certified volunteers and are available at community centers, libraries, and churches nationwide. Find locations at irs.gov/vita. Some AARP Tax-Aide sites also provide free preparation regardless of income or age.\"}},{\"@type\":\"Question\",\"name\":\"Can I file state taxes for free through IRS Free File?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on your Free File partner. Some Guided Preparation partners include free state filing, while others charge a fee (typically $15–$40). Active-duty military with AGI ≤ $84,000 get free state filing from all partners. Free File Fillable Forms do not include state filing — you'll need to file separately through your state's tax website or a state-specific free file program. Many states offer their own free filing options.\"}},{\"@type\":\"Question\",\"name\":\"What's the difference between IRS Free File and paid tax software?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The core difference is cost and support. IRS Free File Guided Preparation gives you the same brand-name software (TaxSlayer, OLT, etc.) for free — but only if you access it through irs.gov/freefile and meet the AGI threshold. Paid versions may include live chat support, audit protection, or more complex form coverage (like rental properties or K-1s). If your taxes are relatively straightforward — W-2 income, standard deduction, maybe some 1099s — Free File covers everything you need.\"}},{\"@type\":\"Question\",\"name\":\"When does IRS Free File open for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"IRS Free File typically opens in mid-to-late January. For the 2026 filing season (tax year 2025), the portal is expected to open around January 27, 2026. You can prepare your return early through a Free File partner, but the IRS won't start processing returns until late January. If you file early, your return is held and processed when the IRS systems open — you don't lose your place in line.\"}},{\"@type\":\"Question\",\"name\":\"How do I get my 1099 form for free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your 1099 forms are provided by the payer (employer, bank, investment platform) — you don't pay for them. If you're missing a 1099, request a copy from the issuer or find it in your online account. The IRS also has a tool to view your wage and income transcripts (which include 1099 data) at irs.gov/transcript. Free File Fillable Forms support 1099-NEC, 1099-MISC, 1099-INT, 1099-DIV, and other common 1099 variants.\"}}]},{\"@id\":\"https://thetaxcalc.com/freefile-irs#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],[\"$La\"],\"$Lb\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"IRS Free File\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$Ld\",null,{\"url\":\"https://thetaxcalc.com/freefile-irs\",\"title\":\"IRS Free File 2026 — Free Federal Tax Filing Guide\",\"description\":\"File federal taxes free with IRS Free File. AGI under $84K gets guided software; Fillable Forms for everyone. Free extension filing. 2026 guide with eligibility checker.\"}]}]\n5:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"IRS Free File — Free Federal Tax Filing 2026\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"File your federal taxes for free with IRS Free File. Guided tax software if your AGI is $84,000 or less, plus Free File Fillable Forms for everyone. Step-by-step guide, eligibility checker, and key dates for 2026.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-foreground max-w-2xl mx-auto leading-relaxed\",\"children\":\"IRS Free File lets you file your federal tax return for free. If your AGI is $84,000 or less, you can use brand-name tax software through the IRS Free File program at no cost. If your income is higher, Free File Fillable Forms — the electronic equivalent of IRS paper forms — are available to everyone regardless of income. You can also file a free tax extension (Form 4868) through IRS Free File.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":[\"Last reviewed: January 2026 · By \",\"Rachel Mitchell\",\", \",\"CPA\",\"· Information verified against IRS.gov & Free File Alliance\"]}]]}]\n6:[\"$\",\"div\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"IRS Free File Quick Summary\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-1\",\"children\":\"Guided Preparation\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"AGI ≤ $84K\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Brand-name tax software. Interview-style Q&A. Free federal e-file.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-sky-400 mb-1\",\"children\":\"Fillable Forms\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"No Income Limit\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Electronic IRS forms. Do the math yourself. Free federal e-file.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1\",\"children\":\"Free Extension\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Form 4868\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"File for an Oct 15 extension for free through IRS Free File.\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-4 flex flex-wrap gap-2\",\"children\":[[\"$\",\"a\",null,{\"href\":\"https://apps.irs.gov/app/freeFile\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-500 px-4 py-2 text-sm font-medium text-white hover:from-emerald-500 hover:to-emerald-400 transition-all\",\"children\":\"Go to IRS Free File →\"}],[\"$\",\"a\",null,{\"href\":\"https://www.freefilefillableforms.com/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-sky-500/30 bg-sky-500/5 px-4 py-2 text-sm font-medium text-sky-400 hover:bg-sky-500/10 transition-all\",\"children\":\"Open Fillable Forms →\"}]]}]]}]\n7:[\"$\",\"$Le\",null,{}]\n8:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"Related Tax Calculators & Tools\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$Lc\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💵\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"See your take-home pay after all taxes\"}]]}]]}],[\"$\",\"$Lc\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Estimate your 2025 tax refund\"}]]}]]}],[\"$\",\"$Lc\",\"/irs-withholding-calculator\",{\"href\":\"/irs-withholding-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📋\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"IRS Withholding Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Optimize your W-4 for 2026\"}]]}]]}],[\"$\",\"$Lc\",\"/self-employment-tax-calculator\",{\"href\":\"/self-employment-tax-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🛡️\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Self-Employment Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"15.3% SE tax + quarterly estimates\"}]]}]]}]]}]]}]\nf:T44d,A lot of people don't realize you can also <strong>file a free tax extension</strong> through IRS Free File. Form 4868 gives you until October 15 to file your return — but you still have to pay what you owe by April 15. The extension is just for the paperwork, not the payment. Free File partners let you e-file Form 4868 for free. If you're owed a refund, there's no penalty for filing late, but getting that money sooner is always better. For detailed IRS rules, check the <a href=\"https://www.irs.gov/e-file-providers/irs-free-file-program-for-online-tax-preparation\" target=\"_blank\" rel=\"noopener noreferrer\">official IRS Free File page</a>.<br/><br/>Key things to know:<br/>- IRS Free File opens in late January each year<br/>- Your AGI threshold is $84,000 for Guided Preparation (2026 filing season)<br/>- Free File Fillable Forms have no income limit<br/>- Active-duty military with AGI ≤ $84,000 get free state filing too<br/>- Seniors (57+) and low-income taxpayers may have additional free options through VITA/TCE<br/>- You can file Form 4868 (extension) for free through IRS Free File9:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How IRS Free File Works — Complete Guide\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"IRS Free File is a partnership between the IRS and private tax software companies. If your adjusted gross income (AGI) is $84,000 or less for the 2025 tax year (filed in 2026), you qualify for <strong>Guided Tax Preparation</strong> — that's brand-name software like TaxSlayer, OLT, or FreeTaxUSA walking you through your return step by step, asking you questions and doing the math for you. No charge for the federal return. Some partners also include free state filing, though that varies. The whole thing runs through <a href=\\\"https://apps.irs.gov/app/freeFile\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">irs.gov/freefile</a> — you pick a partner, create an account on their site, and file. The IRS doesn't see your data until you hit submit.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"If your AGI is over $84,000, or you're comfortable doing your own taxes without hand-holding, <strong>Free File Fillable Forms</strong> are the other option. These are electronic versions of IRS paper forms — Form 1040, Schedule A, Schedule C, Schedule SE, and dozens more. No income limit, no age restriction. You type in the numbers, the forms do basic math, and you e-file directly. It's free. The tradeoff: you're on your own. No interview process, no \\\"did you forget about this deduction?\\\" prompts. If you know what forms you need and how to fill them out, it's fantastic. If you're new to taxes, stick with Guided Preparation.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"$f\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"How to File Your Taxes for Free with IRS Free File — Step by Step\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}]]}],\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1l_n4bv91w2_0.js\",\"async\":true}]\nb:[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$22\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@23\"}]}]\n10:[\"$\",\"div\",\"1\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":1}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Gather Your Documents\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Collect your W-2(s), 1099(s), last year's tax return (for AGI verification), Social Security numbers for all household members, and bank account info for direct deposit.\"}]]}]]}]\n11:[\"$\",\"div\",\"2\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":2}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Go to irs.gov/freefile\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Always start from the IRS website — going directly to a tax software site may lead you to their paid version. Click \\\"Choose a Free File Company\\\" to see available partners.\"}]]}]]}]\n12:[\"$\",\"div\",\"3\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":3}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Pick a Free File Partner\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Browse the list of IRS-approved partners. Each has different features — some support self-employment income, some include free state filing, some are better for itemized deductions. Use the IRS lookup tool to find the best match.\"}]]}]]}]\n13:[\"$\",\"div\",\"4\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":4}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Create an Account & Verify\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Sign up on the partner's site. You'll verify your identity using last year's AGI or a self-select PIN. If it's your first time filing, you'll need to mail in a signature form (Form 8453) in some cases.\"}]]}]]}]\n14:[\"$\",\"div\",\"5\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":5}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Complete Your Return\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Follow the guided interview for Guided Preparation, or enter data directly into forms for Fillable Forms. Double-check everything — Social Security numbers, bank details, and math.\"}]]}]]}]\n15:[\"$\",\"div\",\"6\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":6}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"E-File & Confirm\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Submit electronically. You'll get an acknowledgment within 24–48 hours confirming the IRS accepted your return. If rejected, the error message tells you what to fix — resubmit for free.\"}]]}]]}]\n16:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-sky-500/20 bg-sky-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Free File Fillable Forms — No Income Limit\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Free File Fillable Forms are the electronic equivalent of IRS paper forms. There is \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"no income limit\"}],\"— anyone can use them regardless of how much they earn. The forms include basic math calculations (they add up lines and carry numbers forward), but they don't guide you through the process like paid software would.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Available forms include:\"}],\" Form 1040, Schedule A (Itemized Deductions), Schedule B (Interest and Dividends), Schedule C (Business Income), Schedule D (Capital Gains), Schedule E (Rental Income), Schedule SE (Self-Employment Tax), Form 8812 (Child Tax Credit), Form 2441 (Child and Dependent Care), and many more.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"What's NOT included:\"}],\" State tax returns (file separately through your state), some less common forms, and any hand-holding. If you need to file Form 2555 (Foreign Earned Income) or Form 1116 (Foreign Tax Credit), check availability first — not all international forms are supported.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Best for:\"}],\"Taxpayers who know which forms they need, have straightforward returns above the $84,000 AGI threshold, or previously filed with paper forms and want the convenience of e-filing. If you're comfortable reading IRS instructions and filling in the numbers yourself, this is a solid free option.\"]}]]}]]}]\n17:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-amber-500/20 bg-amber-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Free Tax Extension — File Form 4868 for Free\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Can't file by April 15? You can \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"file a free tax extension\"}],\"through IRS Free File. Form 4868 gives you an automatic 6-month extension until October 15 — no questions asked. Here's the critical distinction:\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 my-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-emerald-400 mb-1\",\"children\":\"Extension = More Time to File\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"You get until October 15 to submit your completed return. No penalty for late filing.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-red-400 mb-1\",\"children\":\"NOT More Time to Pay\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"You still owe taxes by April 15. Late payment = 0.5% per month penalty + interest.\"}]]}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"How to file a free extension:\"}],\" Go to \",[\"$\",\"a\",null,{\"href\":\"https://apps.irs.gov/app/freeFile\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"irs.gov/freefile\"}],\", choose any partner, and look for the \\\"File an Extension\\\" option. Most partners support free extension filing. You can also use Free File Fillable Forms to complete and e-file Form 4868 directly. If you expect a refund, there's no penalty for filing late — but don't wait, because that's your money sitting with the IRS.\"]}]]}]]}]\n18:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Free Tax Filing for Seniors & Low-Income Taxpayers\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Beyond IRS Free File, there are dedicated programs for \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"seniors\"}],\" and \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"low-income taxpayers\"}],\":\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 my-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"VITA — Volunteer Income Tax Assistance\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Free for taxpayers earning ≤ $64,000\"}],[\"$\",\"li\",null,{\"children\":\"• IRS-certified volunteers prepare your return\"}],[\"$\",\"li\",null,{\"children\":\"• Available at libraries, community centers, malls\"}],[\"$\",\"li\",null,{\"children\":\"• Includes persons with disabilities & limited English speakers\"}],[\"$\",\"li\",null,{\"children\":\"• Both federal AND state returns typically included\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-amber-500/20 bg-amber-500/5 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"TCE — Tax Counseling for the Elderly\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Specialized for taxpayers age 60+\"}],[\"$\",\"li\",null,{\"children\":\"• Focus on pensions, retirement, Social Security issues\"}],[\"$\",\"li\",null,{\"children\":\"• AARP Tax-Aide is the largest TCE program\"}],[\"$\",\"li\",null,{\"children\":\"• No income limit for most TCE locations\"}],[\"$\",\"li\",null,{\"children\":\"• Both federal AND state returns typically included\"}]]}]]}]]}],[\"$\",\"p\",null,{\"children\":[\"To find a VITA or TCE site near you, visit \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/individuals/find-a-location-for-free-tax-prep\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"irs.gov/individuals/find-a-location-for-free-tax-prep\"}],\" or call 1-800-906-9887. Many sites operate on a first-come, first-served basis, so arrive early during peak season (February–March).\"]}]]}]]}]\n19:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How to File an Amended Tax Return for Free\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"Made a mistake on your return? You can \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"file an amended tax return online for free\"}],\"using Form 1040-X. Here's how:\"]}],[\"$\",\"ol\",null,{\"className\":\"list-decimal list-inside space-y-2 text-sm\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"Go to \",[\"$\",\"a\",null,{\"href\":\"https://www.freefilefillableforms.com/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"Free File Fillable Forms\"}],\" — they support Form 1040-X\"]}],[\"$\",\"li\",null,{\"children\":\"Complete Form 1040-X with the corrected information\"}],[\"$\",\"li\",null,{\"children\":\"Include any changed schedules or forms\"}],[\"$\",\"li\",null,{\"children\":\"E-file the amended return (available for 2020 tax year and later)\"}],[\"$\",\"li\",null,{\"children\":\"For years before 2020, download Form 1040-X from irs.gov and mail it\"}]]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Important:\"}],\" Amended returns can take up to 16 weeks to process. If you're owed an additional refund, wait until you receive your original refund before filing Form 1040-X. Track your amended return status using the \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/refunds\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"IRS Where's My Amended Return?\"}],\" tool.\"]}]]}]]}]\n1a:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"IRS Free File — Key Data for 2026 Filing Season\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Guided Prep AGI Limit\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Guided Prep AGI Limit\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$84,000 (2025 tax year)\"}]]}],[\"$\",\"div\",\"Fillable Forms Income Limit\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Fillable Forms Income Limit\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"No limit\"}]]}],[\"$\",\"div\",\"VITA/TCE Income Limit\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"VITA/TCE Income Limit\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$64,000 (VITA), 60+ (TCE)\"}]]}],[\"$\",\"div\",\"Free File Partners (2026)\",{\"className\":\"roun