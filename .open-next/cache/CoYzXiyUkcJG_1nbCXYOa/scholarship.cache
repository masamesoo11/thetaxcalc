{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/scholarship/layout,_N_T_/scholarship/page,_N_T_/scholarship"},"segmentPaths":["/_tree","/_full","/scholarship/__PAGE__","/scholarship","/_index","/_head"]},"html":"<!DOCTYPE html><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.0r6juujl39pe6.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.0wgildi0cnwt9.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/233p45nuh4m5b.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/0dwp-mo_n_jm0.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/35lt1fghf7uep.js\"/><script src=\"/_next/static/chunks/0paxexg6-m0de.js\" async=\"\"></script><script src=\"/_next/static/chunks/2xgiyxwb0ui_c.js\" async=\"\"></script><script src=\"/_next/static/chunks/1ticr5om3zo_s.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-06pzha75hv9oa.js\" async=\"\"></script><script src=\"/_next/static/chunks/2g3ofza521d-d.js\" async=\"\"></script><script src=\"/_next/static/chunks/3mzfoc5k_0lxh.js\" async=\"\"></script><script src=\"/_next/static/chunks/1h498-er8bjws.js\" async=\"\"></script><script src=\"/_next/static/chunks/1i8lzoxtdw4ca.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6dwfk.js\" async=\"\"></script><script src=\"/_next/static/chunks/44p37290qsddb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1kthlnkql3p_5.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Scholarship 2026 — $2,500 Tax &amp; Finance Student Award | TheTaxCalc</title><meta name=\"description\" content=\"Apply for the 2026 TheTaxCalc Scholarship — $2,500 for finance, accounting, economics, or tax students. Free to apply. Deadline May 31, 2026.\"/><link rel=\"author\" href=\"https://thetaxcalc.com/about#rachel-mitchell\"/><meta name=\"author\" content=\"Rachel Mitchell, CPA\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"finance\"/><meta name=\"classification\" content=\"Tax Calculator\"/><link rel=\"canonical\" href=\"https://thetaxcalc.com/scholarship\"/><meta name=\"google-site-verification\" content=\"7bdac16b5ecbdd40\"/><meta property=\"og:title\" content=\"TheTaxCalc Scholarship 2026 | $2,500 Student Award\"/><meta property=\"og:description\" content=\"A $2,500 scholarship for students studying finance, accounting, economics, or tax. Free to apply. Deadline May 31, 2026.\"/><meta property=\"og:url\" content=\"https://thetaxcalc.com/scholarship\"/><meta property=\"og:site_name\" content=\"TheTaxCalc\"/><meta property=\"og:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"TheTaxCalc Scholarship 2026 — $2,500 Tax &amp; Finance Student Award\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"TheTaxCalc Scholarship 2026 | $2,500 Student Award\"/><meta name=\"twitter:description\" content=\"A $2,500 scholarship for finance, accounting, economics, or tax students. Free to apply.\"/><meta name=\"twitter:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}</script><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg\">Skip to main content</a><div class=\"min-h-screen flex flex-col bg-background bg-mesh\"><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white focus:shadow-lg\">Skip to main content</a><header class=\"sticky top-0 z-[100] w-full glass-strong overflow-visible\"><div class=\"h-[2px] bg-gradient-to-r from-transparent via-emerald-500/60 to-transparent\"></div><div class=\"mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 overflow-visible\"><a class=\"flex items-center gap-2.5 transition-all hover:opacity-90 group\" href=\"/\"><div class=\"relative flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-emerald-600 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/30 transition-shadow\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dollar-sign h-5 w-5 text-white\" aria-hidden=\"true\"><line x1=\"12\" x2=\"12\" y1=\"2\" y2=\"22\"></line><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path></svg><div class=\"absolute inset-0 rounded-xl bg-white/10 opacity-0 group-hover:opacity-100 transition-opacity\"></div></div><span class=\"text-lg font-bold tracking-tight text-foreground\">TheTaxCalc<span class=\"gradient-text\">.com</span></span></a><nav class=\"hidden items-center gap-1 lg:flex\"><div class=\"relative\" style=\"z-index:110\"><button class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-calculator h-4 w-4\" aria-hidden=\"true\"><rect width=\"16\" height=\"20\" x=\"4\" y=\"2\" rx=\"2\"></rect><line x1=\"8\" x2=\"16\" y1=\"6\" y2=\"6\"></line><line x1=\"16\" x2=\"16\" y1=\"14\" y2=\"18\"></line><path d=\"M16 10h.01\"></path><path d=\"M12 10h.01\"></path><path d=\"M8 10h.01\"></path><path d=\"M12 14h.01\"></path><path d=\"M8 14h.01\"></path><path d=\"M12 18h.01\"></path><path d=\"M8 18h.01\"></path></svg>Calculators<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down h-3 w-3 transition-transform\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/compare\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m16 3 4 4-4 4\"></path><path d=\"M20 7H4\"></path><path d=\"m8 21-4-4 4-4\"></path><path d=\"M4 17h16\"></path></svg>Compare</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/glossary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg>Glossary</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/blog\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-book-open h-4 w-4\" aria-hidden=\"true\"><path d=\"M12 7v14\"></path><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"></path></svg>Blog</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/salary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-4 w-4\" aria-hidden=\"true\"><path d=\"M16 7h6v6\"></path><path d=\"m22 7-8.5 8.5-5-5L2 17\"></path></svg>Salary</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/tax-data\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Data</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/widgets\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code-xml h-4 w-4\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4\"></path><path d=\"m6 8-4 4 4 4\"></path><path d=\"m14.5 4-5 16\"></path></svg>Widgets</a></nav><div class=\"flex items-center gap-3\"><a class=\"hidden sm:flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all hover:scale-[1.02]\" href=\"/paycheck-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Calculate Now</a><button data-slot=\"button\" class=\"inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-8 rounded-md gap-1.5 px-3 has-[&gt;svg]:px-2.5 lg:hidden text-muted-foreground hover:text-foreground\" aria-label=\"Toggle mobile menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 12h16\"></path><path d=\"M4 18h16\"></path><path d=\"M4 6h16\"></path></svg></button></div></div></header><main id=\"main-content\" class=\"flex-1\"><div class=\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/scholarship#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarship\",\"item\":\"https://thetaxcalc.com/scholarship\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/scholarship#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Who is eligible to apply for the TheTaxCalc Scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The TheTaxCalc Scholarship is open to U.S. citizens, permanent residents, and visa holders who are currently enrolled at an accredited U.S. college or university (undergraduate or graduate) with at least a 3.0 cumulative GPA. Eligible majors include finance, accounting, economics, taxation, business administration, mathematics, and related fields. High school seniors with proof of enrollment for the upcoming fall semester are also welcome to apply.\"}},{\"@type\":\"Question\",\"name\":\"How much is the scholarship award and when is the deadline?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 TheTaxCalc Scholarship is a one-time $2,500 award. Applications open January 1, 2026 and the final deadline is May 31, 2026 at 11:59 PM Pacific Time. The winner is announced on or before July 15, 2026. Funds are paid directly to the winner's college or university to be applied toward tuition, fees, or required course materials.\"}},{\"@type\":\"Question\",\"name\":\"What materials do I need to submit with my application?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You'll need three items: (1) a 500–800 word original essay on how understanding personal taxation improves financial literacy and long-term wealth building, (2) a current resume or CV highlighting your academic and extracurricular activities, and (3) proof of current enrollment (an unofficial transcript or registration confirmation). All materials must be submitted through our online application form by the deadline — emailed or mailed submissions are not accepted.\"}},{\"@type\":\"Question\",\"name\":\"How is the winner selected and when will I be notified?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Applications are reviewed by a committee of TheTaxCalc editors and a Certified Public Accountant (CPA). Essays are scored on clarity (30%), originality (30%), relevance to modern tax issues (25%), and writing mechanics (15%). Finalists may be contacted for a brief phone interview. The winner is notified by email no later than July 15, 2026 and announced on our blog shortly after. All applicants receive a confirmation email upon submission.\"}},{\"@type\":\"Question\",\"name\":\"Can I apply more than once or reapply in future years?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You may submit only one application per cycle. Previous applicants who did not win are welcome to reapply in subsequent years, provided they still meet the eligibility requirements. Previous winners are not eligible to apply again. The TheTaxCalc Scholarship runs annually, so even if you miss this year's deadline you can apply for next year's award.\"}},{\"@type\":\"Question\",\"name\":\"Is there any cost to apply or any obligation if I win?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The TheTaxCalc Scholarship is 100% free to apply — there is no application fee and no purchase required. If you win, the only obligation is to provide a brief headshot and short quote that we may use in our winner announcement. You retain all rights to your essay. We will never sell your personal information or use your contact details for marketing without explicit opt-in consent.\"}}]},{\"@type\":\"EducationalOccupationalProgram\",\"name\":\"TheTaxCalc Scholarship 2026\",\"description\":\"A $2,500 scholarship for undergraduate and graduate students studying finance, accounting, economics, or tax.\",\"url\":\"https://thetaxcalc.com/scholarship\",\"provider\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"2500\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\"},\"applicationDeadline\":\"2026-05-31\",\"startDate\":\"2026-01-01\"}]}</script><nav aria-label=\"Breadcrumb\" class=\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\"><a class=\"hover:text-foreground transition-colors\" href=\"/\">Home</a><span aria-hidden=\"true\">/</span><span class=\"text-foreground font-medium\">Scholarship</span></nav><div class=\"mb-10 rounded-2xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 to-teal-500/5 p-8 text-center\"><span class=\"inline-flex items-center gap-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-4 py-1.5 text-sm text-emerald-400 mb-4\">2026 Application Now Open</span><h1 class=\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\">TheTaxCalc Scholarship — $2,500 Award</h1><p class=\"text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto\">Supporting the next generation of tax professionals, financial planners, and economists. Open to U.S. undergraduate and graduate students studying finance, accounting, economics, or taxation.</p><div class=\"mt-6 flex flex-wrap items-center justify-center gap-3 text-sm\"><span class=\"rounded-full bg-background/50 px-3 py-1.5 text-muted-foreground\">Award: <span class=\"font-semibold text-foreground\">$2,500</span></span><span class=\"rounded-full bg-background/50 px-3 py-1.5 text-muted-foreground\">Deadline: <span class=\"font-semibold text-foreground\">May 31, 2026</span></span><span class=\"rounded-full bg-background/50 px-3 py-1.5 text-muted-foreground\">Cost: <span class=\"font-semibold text-emerald-400\">Free to Apply</span></span></div></div><section class=\"mb-10\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">About the Scholarship</h2><p class=\"text-muted-foreground leading-relaxed mb-4\">At TheTaxCalc, we believe that understanding taxation is the foundation of financial literacy. Our free tax calculators — covering paycheck estimation, capital gains, self-employment, retirement, and more — have helped millions of Americans better understand where their money goes. The TheTaxCalc Scholarship extends that mission by supporting students who are pursuing careers in finance, accounting, economics, and tax policy.</p><p class=\"text-muted-foreground leading-relaxed mb-4\">The 2026 TheTaxCalc Scholarship is a one-time $2,500 award given to one outstanding student who demonstrates academic excellence, an interest in taxation or personal finance, and a commitment to helping others make better financial decisions. Funds are paid directly to the winner’s accredited U.S. college or university and can be applied toward tuition, fees, or required course materials for the 2026-2027 academic year.</p><p class=\"text-muted-foreground leading-relaxed\">We launched this scholarship in 2024 as a way to give back to the community that has supported TheTaxCalc since our founding. Past winners have gone on to careers at Big Four accounting firms, regional CPA practices, financial planning firms, and public policy organizations. If you are passionate about helping people understand their taxes and build long-term wealth, we want to hear from you.</p></section><section class=\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Eligibility Requirements</h2><ul class=\"space-y-2 text-muted-foreground\"><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>U.S. citizen, permanent resident, or valid visa holder</span></li><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>Currently enrolled at an accredited U.S. college or university (undergraduate or graduate)</span></li><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>Cumulative GPA of 3.0 or higher</span></li><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>Majoring in finance, accounting, economics, taxation, business administration, mathematics, or a closely related field</span></li><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>High school seniors with proof of enrollment for the upcoming fall semester are also eligible</span></li><li class=\"flex items-start gap-2\"><span class=\"text-emerald-400 mt-0.5\">✓</span><span>At least 17 years old at the time of application</span></li></ul></section><section class=\"mb-10\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">How to Apply</h2><p class=\"text-muted-foreground leading-relaxed mb-4\">Applications are accepted online only. To apply for the 2026 TheTaxCalc Scholarship, submit the following three items through our online application form by 11:59 PM Pacific Time on May 31, 2026:</p><div class=\"grid gap-4 sm:grid-cols-3\"><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><div class=\"text-2xl font-bold text-emerald-400 mb-2\">1</div><h3 class=\"font-semibold text-foreground mb-1\">Original Essay</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">A 500–800 word essay on how understanding personal taxation improves financial literacy and long-term wealth building. Must be original and unpublished.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><div class=\"text-2xl font-bold text-emerald-400 mb-2\">2</div><h3 class=\"font-semibold text-foreground mb-1\">Resume / CV</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">A current resume highlighting your academic achievements, extracurricular activities, work experience, and any community involvement.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><div class=\"text-2xl font-bold text-emerald-400 mb-2\">3</div><h3 class=\"font-semibold text-foreground mb-1\">Proof of Enrollment</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">An unofficial transcript or registration confirmation showing current enrollment at an accredited U.S. institution.</p></div></div><p class=\"text-sm text-muted-foreground mt-4\">Email submissions are not accepted. To request an application form, contact<!-- --> <a href=\"mailto:scholarship@thetaxcalc.com\" class=\"text-emerald-400 hover:text-emerald-300 underline\">scholarship@thetaxcalc.com</a> <!-- -->with the subject line “2026 Scholarship Application Request.”</p></section><section class=\"mb-10\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Selection Process</h2><p class=\"text-muted-foreground leading-relaxed mb-4\">Applications are reviewed by a committee composed of TheTaxCalc editors and an external Certified Public Accountant (CPA) who volunteers as a reader. Each essay is scored on four criteria, weighted as follows:</p><div class=\"space-y-3\"><div class=\"flex items-center justify-between rounded-lg border border-border/30 bg-card/50 p-4\"><span class=\"text-sm text-foreground\">Clarity of argument and thesis</span><span class=\"font-semibold text-emerald-400\">30%</span></div><div class=\"flex items-center justify-between rounded-lg border border-border/30 bg-card/50 p-4\"><span class=\"text-sm text-foreground\">Originality of perspective</span><span class=\"font-semibold text-emerald-400\">30%</span></div><div class=\"flex items-center justify-between rounded-lg border border-border/30 bg-card/50 p-4\"><span class=\"text-sm text-foreground\">Relevance to modern tax issues</span><span class=\"font-semibold text-emerald-400\">25%</span></div><div class=\"flex items-center justify-between rounded-lg border border-border/30 bg-card/50 p-4\"><span class=\"text-sm text-foreground\">Writing mechanics (grammar, structure, style)</span><span class=\"font-semibold text-emerald-400\">15%</span></div></div><p class=\"text-sm text-muted-foreground mt-4 leading-relaxed\">Finalists may be contacted for a brief 15-minute phone interview. The winner is notified by email no later than July 15, 2026 and announced on our blog shortly after. All applicants receive a confirmation email upon submission, and finalists who are not selected are notified by August 31, 2026.</p></section><section class=\"mb-10\"><h2 class=\"text-2xl font-bold text-foreground mb-6\">Scholarship FAQ</h2><div class=\"space-y-4\"><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">Who is eligible to apply for the TheTaxCalc Scholarship?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">The TheTaxCalc Scholarship is open to U.S. citizens, permanent residents, and visa holders who are currently enrolled at an accredited U.S. college or university (undergraduate or graduate) with at least a 3.0 cumulative GPA. Eligible majors include finance, accounting, economics, taxation, business administration, mathematics, and related fields. High school seniors with proof of enrollment for the upcoming fall semester are also welcome to apply.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">How much is the scholarship award and when is the deadline?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">The 2026 TheTaxCalc Scholarship is a one-time $2,500 award. Applications open January 1, 2026 and the final deadline is May 31, 2026 at 11:59 PM Pacific Time. The winner is announced on or before July 15, 2026. Funds are paid directly to the winner&#x27;s college or university to be applied toward tuition, fees, or required course materials.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">What materials do I need to submit with my application?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">You&#x27;ll need three items: (1) a 500–800 word original essay on how understanding personal taxation improves financial literacy and long-term wealth building, (2) a current resume or CV highlighting your academic and extracurricular activities, and (3) proof of current enrollment (an unofficial transcript or registration confirmation). All materials must be submitted through our online application form by the deadline — emailed or mailed submissions are not accepted.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">How is the winner selected and when will I be notified?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">Applications are reviewed by a committee of TheTaxCalc editors and a Certified Public Accountant (CPA). Essays are scored on clarity (30%), originality (30%), relevance to modern tax issues (25%), and writing mechanics (15%). Finalists may be contacted for a brief phone interview. The winner is notified by email no later than July 15, 2026 and announced on our blog shortly after. All applicants receive a confirmation email upon submission.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">Can I apply more than once or reapply in future years?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">You may submit only one application per cycle. Previous applicants who did not win are welcome to reapply in subsequent years, provided they still meet the eligibility requirements. Previous winners are not eligible to apply again. The TheTaxCalc Scholarship runs annually, so even if you miss this year&#x27;s deadline you can apply for next year&#x27;s award.</p></div><div class=\"rounded-lg border border-border/30 bg-card/50 p-5\"><h3 class=\"font-semibold text-foreground mb-2\">Is there any cost to apply or any obligation if I win?</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">No. The TheTaxCalc Scholarship is 100% free to apply — there is no application fee and no purchase required. If you win, the only obligation is to provide a brief headshot and short quote that we may use in our winner announcement. You retain all rights to your essay. We will never sell your personal information or use your contact details for marketing without explicit opt-in consent.</p></div></div></section><section class=\"mb-10\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Related Resources</h2><div class=\"grid gap-3 sm:grid-cols-2\"><a class=\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\" href=\"/paycheck-calculator\"><p class=\"font-medium text-foreground\">Paycheck Calculator</p><p class=\"text-sm text-muted-foreground mt-1\">See how tax brackets work in practice with our free paycheck calculator.</p></a><a class=\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\" href=\"/methodology\"><p class=\"font-medium text-foreground\">Tax Calculation Methodology</p><p class=\"text-sm text-muted-foreground mt-1\">Understand exactly how we compute federal, state, and FICA taxes.</p></a><a class=\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\" href=\"/about\"><p class=\"font-medium text-foreground\">About TheTaxCalc</p><p class=\"text-sm text-muted-foreground mt-1\">Learn about our mission to make tax knowledge accessible to everyone.</p></a><a class=\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\" href=\"/tax-professionals\"><p class=\"font-medium text-foreground\">For Tax Professionals</p><p class=\"text-sm text-muted-foreground mt-1\">Resources and tools for CPAs, EAs, and tax preparers.</p></a></div></section><section><div class=\"rounded-xl border border-border/30 bg-muted/10 p-6\"><h3 class=\"font-semibold text-foreground mb-2\">Official Rules &amp; Terms</h3><p class=\"text-sm text-muted-foreground leading-relaxed\">The TheTaxCalc Scholarship is administered by TheTaxCalc. Employees of TheTaxCalc and their immediate family members are not eligible. The winner consents to the use of their name, headshot, and essay excerpt for promotional purposes. The decision of the selection committee is final. By applying, you agree to the full official rules available at<!-- --> <a class=\"text-emerald-400 hover:text-emerald-300 underline\" href=\"/terms\">/terms</a>. For questions, email<!-- --> <a href=\"mailto:scholarship@thetaxcalc.com\" class=\"text-emerald-400 hover:text-emerald-300 underline\">scholarship@thetaxcalc.com</a>.</p></div></section></div><!--$--><!--/$--></main><footer class=\"mt-auto border-t border-border/30 glass-strong\"><div class=\"bg-gradient-to-r from-emerald-500/5 via-emerald-500/10 to-emerald-500/5 border-b border-border/20\"><div class=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\"><div class=\"flex flex-col items-center gap-4 sm:flex-row sm:justify-between\"><div class=\"text-center sm:text-left\"><h2 class=\"text-lg font-bold text-foreground\">Stay Updated on <span class=\"text-emerald-400\">Tax Changes</span></h2><p class=\"mt-1 text-sm text-muted-foreground\">Get the latest tax tips, calculator updates, and financial insights delivered to your inbox.</p></div><div class=\"flex w-full max-w-sm gap-2\"><input type=\"email\" data-slot=\"input\" class=\"file:text-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 flex h-9 w-full min-w-0 rounded-md border px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-background/50 border-border/30 placeholder:text-muted-foreground\" aria-label=\"Email address for newsletter\" placeholder=\"Enter your email\" value=\"\"/><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:po