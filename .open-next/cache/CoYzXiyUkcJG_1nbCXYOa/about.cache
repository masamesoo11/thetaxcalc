/chunks/3mzfoc5k_0lxh.js\",\"/_next/static/chunks/1h498-er8bjws.js\",\"/_next/static/chunks/0kxe9smv8dkyp.js\"],\"ProtectedEmail\"]\n33:I[97367,[\"/_next/static/chunks/05-c3ty_6dwfk.js\",\"/_next/static/chunks/44p37290qsddb.js\"],\"OutletBoundary\"]\n34:\"$Sreact.suspense\"\n2:T20cb,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/about#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About\"}]},{\"@id\":\"https://thetaxcalc.com/about#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/about#david-chen\",\"@type\":\"Person\",\"name\":\"David Chen\",\"url\":\"https://thetaxcalc.com/about#david-chen\",\"jobTitle\":\"Tax Research Director & IRS Practice Lead, EA\",\"description\":\"David Chen is an IRS Enrolled Agent (EA) with 15+ years of experience representing taxpayers before the IRS in audits, collections, and appeals. He specializes in self-employment tax, quarterly estimated payments, independent contractor classification, and IRS dispute resolution. David is a member of the National Association of Enrolled Agents (NAEA) and the California Society of Enrolled Agents. He holds a Master of Taxation (MTax) from San Jose State University and has completed advanced coursework in IRS Circular 230 ethics. David regularly contributes to tax policy analysis and has been quoted in publications including Tax Notes and the Wall Street Journal tax section.\",\"knowsAbout\":[\"Self-Employment Tax\",\"Estimated Tax Payments\",\"IRS Representation\",\"Tax Audits\",\"1099 Tax Compliance\",\"Independent Contractor Tax\",\"IRS Collections\",\"Offer in Compromise\"],\"sameAs\":[\"https://www.linkedin.com/in/davidchenea/\",\"https://www.naea.org/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-david-chen.webp\"},{\"@id\":\"https://thetaxcalc.com/about#sarah-johnson\",\"@type\":\"Person\",\"name\":\"Sarah Johnson\",\"url\":\"https://thetaxcalc.com/about#sarah-johnson\",\"jobTitle\":\"Financial Planning Specialist & Retirement Tax Strategist, CFP®\",\"description\":\"Sarah Johnson is a CERTIFIED FINANCIAL PLANNER™ (CFP®) professional with over 10 years of experience helping individuals optimize their retirement savings, investment tax strategies, and long-term wealth building. She specializes in 401(k) optimization, Roth conversion strategies, capital gains harvesting, and required minimum distribution (RMD) planning. Sarah is a member of the Financial Planning Association (FPA) and holds the Chartered Retirement Planning Counselor (CRPC®) designation. She earned her BS in Finance from Indiana University and completed the CFP® certification program at Northwestern University. Sarah has presented at the FPA Annual Conference and contributes regularly to retirement planning publications.\",\"knowsAbout\":[\"Retirement Planning\",\"401(k) Optimization\",\"Capital Gains Tax\",\"Investment Tax Strategy\",\"IRS Withholding\",\"Tax-Advantaged Accounts\",\"Roth Conversions\",\"RMD Planning\"],\"sameAs\":[\"https://www.linkedin.com/in/sarahjohnsoncfp/\",\"https://www.financialplanningassociation.org/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-sarah-johnson.webp\"},{\"@id\":\"https://thetaxcalc.com/about#aboutpage\",\"@type\":\"WebPage\",\"name\":\"About TheTaxCalc\",\"description\":\"Learn about TheTaxCalc — our mission to provide free, accurate tax calculators for every American.\",\"url\":\"https://thetaxcalc.com/about\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-02-01\",\"author\":{\"@id\":\"https://thetaxcalc.com/about#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/about#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"mainEntity\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/about#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/about#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is TheTaxCalc really free? What's the catch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No catch. Because all calculations run in your browser and we don't store any of your data, our server costs are minimal. No premium tiers, no paywalls, no \\\"unlock full results for $9.99.\\\" Just free calculators.\"}},{\"@type\":\"Question\",\"name\":\"How accurate are the calculations?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We use the same data the IRS and state revenue departments publish — the 2026 brackets, standard deductions, FICA rates, the works. Every methodology is reviewed by tax professionals. Our tools give you solid estimates, not guarantees. For filing your actual return, talk to a CPA.\"}},{\"@type\":\"Question\",\"name\":\"Does TheTaxCalc store my salary or financial data?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nope. When you type your salary into one of our calculators, that number stays in your browser. It never gets sent to our servers. We don't have accounts, we don't use tracking cookies on calculations, and we couldn't tie your data to you even if we wanted to.\"}},{\"@type\":\"Question\",\"name\":\"Do you cover all 50 states?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We cover all 50 states with dedicated income tax calculators and all 50 states for sales tax — from zero-income-tax states (TX, FL, WA, NV, WY, AK, SD, NH, TN) to the highest-tax states (CA, NY), plus flat-tax states (IL, CO, IN, PA, MI, MA) and progressive states across the country. Every state has its own calculator with local rates and rules.\"}},{\"@type\":\"Question\",\"name\":\"When do you update tax brackets?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As soon as the IRS and state revenue departments publish new figures — usually late Q4 or early Q1. Our 2026 data is current as of January 2026.\"}},{\"@type\":\"Question\",\"name\":\"Can I use this to file my taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Please don't. Our calculators are for estimation and planning. When it's time to actually file, use real tax preparation software or work with a CPA who knows your situation. We're a starting point, not a substitute.\"}}]}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\"]}],[\"$L13\"],\"$L14\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"CoYzXiyUkcJG_1nbCXYOa\"}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L15\",null,{\"href\":\"/\",\"className\":\"underline underline-offset-2 decoration-muted-foreground/40 hover:decoration-foreground hover:text-foreground transition-colors flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-house h-3.5 w-3.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"5wwlr5\",{\"d\":\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"}],[\"$\",\"path\",\"1d0kgt\",{\"d\":\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"hidden sm:inline\",\"children\":\"Home\"}]]}],[[\"$\",\"span\",\"0\",{\"className\":\"flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-3.5 w-3.5 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"About\"}]]}]]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-12 text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"inline-flex items-center gap-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-4 py-1.5 text-sm text-emerald-400 mb-6\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users h-3.5 w-3.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"About TheTaxCalc\"]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-bold tracking-tight text-foreground sm:text-5xl\",\"children\":[\"Free \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Tax Calculators\"}],\" \",[\"$\",\"br\",null,{}],\"Built for You\"]}],[\"$\",\"p\",null,{\"className\":\"mx-auto mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed\",\"children\":\"We built TheTaxCalc because we were tired of tax calculators that felt like they were designed by the IRS itself — confusing, ugly, and somehow always trying to upsell you.\"}]]}]\n5:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-target h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"circle\",\"1vlfrh\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"6\"}],[\"$\",\"circle\",\"1c9p78\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"2\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Why We Built This\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"In 2022, one of our team members moved from Sacramento to Austin. Same salary ($115,000), same company — but suddenly his take-home pay jumped by over $8,700 a year. He knew Texas didn't have a state income tax, but actually seeing the number on a paycheck? That hit different. He'd been leaving nearly $725 a month on the table and didn't even realize it.\"}],[\"$\",\"p\",null,{\"children\":\"He went looking for a calculator that could have shown him this beforehand. What he found was frustrating: tools that required his email before showing results, calculators using outdated tax brackets, sites that looked like they hadn't been updated since 2015, and — worst of all — calculators that asked for his salary and then tried to sell him financial planning services.\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"So we built the tool we wished existed.\"}],[\"$\",\"p\",null,{\"children\":\"TheTaxCalc started as a weekend project — a single paycheck calculator that actually used current tax data and didn't try to sell you anything. It turns out a lot of people wanted exactly that. Today we have 64 calculators covering paycheck estimation, mortgage amortization, 401(k) projections, capital gains, self-employment taxes, sales tax, overtime, lottery, bonus, property tax, IRS withholding, and side-by-side state comparisons — all updated for the 2026 tax year.\"}],[\"$\",\"p\",null,{\"children\":\"Here's the thing that still drives us crazy: most Americans don't know their effective tax rate. They see deductions on their pay stub and just accept it. We want to change that. Not with jargon or lectures, but with a simple, honest tool that shows you exactly where your money goes.\"}]]}]]}]\n6:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-4 sm:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Free Calculators\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-calculator h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"1nb95v\",{\"width\":\"16\",\"height\":\"20\",\"x\":\"4\",\"y\":\"2\",\"rx\":\"2\"}],[\"$\",\"line\",\"x4nwl0\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"6\",\"y2\":\"6\"}],[\"$\",\"line\",\"wjye3r\",{\"x1\":\"16\",\"x2\":\"16\",\"y1\":\"14\",\"y2\":\"18\"}],[\"$\",\"path\",\"1m94wz\",{\"d\":\"M16 10h.01\"}],[\"$\",\"path\",\"1nrarc\",{\"d\":\"M12 10h.01\"}],[\"$\",\"path\",\"19clt8\",{\"d\":\"M8 10h.01\"}],[\"$\",\"path\",\"1etili\",{\"d\":\"M12 14h.01\"}],[\"$\",\"path\",\"6423bh\",{\"d\":\"M8 14h.01\"}],[\"$\",\"path\",\"mhygvu\",{\"d\":\"M12 18h.01\"}],[\"$\",\"path\",\"lrp35t\",{\"d\":\"M8 18h.01\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"64\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Free Calculators\"}]]}],[\"$\",\"div\",\"State Profiles\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"50\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"State Profiles\"}]]}],[\"$\",\"div\",\"Tax Year Data\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chart-column h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"c24i48\",{\"d\":\"M3 3v16a2 2 0 0 0 2 2h16\"}],[\"$\",\"path\",\"2bz60n\",{\"d\":\"M18 17V9\"}],[\"$\",\"path\",\"1frdt8\",{\"d\":\"M13 17V5\"}],[\"$\",\"path\",\"17ska0\",{\"d\":\"M8 17v-3\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Tax Year Data\"}]]}],[\"$\",\"div\",\"Data Stored\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"0\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Data Stored\"}]]}]]}]}]\n7:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground text-center mb-8\",\"children\":[\"What We \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Stand For\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"div\",\"We Get the Numbers Right\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"We Get the Numbers Right\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We've seen calculators that round your bracket up or just slap last year's rates on the page and hope nobody notices. We found one last month that was still showing 2024 federal brackets — in 2026. Every rate, bracket, and exemption on this site comes straight from IRS Publication 15-T or the state revenue department's own website. When they update, we update. Usually within 48 hours.\"}]]}],[\"$\",\"div\",\"Free. Period.\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-zap h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1xq2db\",{\"d\":\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Free. Period.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No sign-up wall. No 'premium tier.' No sneaky upsell after three calculations. We built TheTaxCalc because we believe understanding your own paycheck shouldn't cost you a dime. A friend of ours actually paid $15 to a tax calculator site before realizing it was just going to show him the same math he could've done himself. That's the kind of thing that made us want to build this. That's not changing.\"}]]}],[\"$\",\"div\",\"Your Data Stays Yours\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Your Data Stays Yours\"}]]}],\"$L16\"]}],\"$L17\"]}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":[\"States & \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Calculators\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We cover all 50 states with dedicated income tax calculators, plus sales tax data for all 50 states. Each state profile includes not just the income tax rate, but property tax context, sales tax data, and retirement-friendliness notes. Here are some of our most popular states:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L15\",\"Illinois\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Illinois\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"4.95% flat tax\"}]]}],[\"$\",\"$L15\",\"Texas\",{\"href\":\"/texas-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Texas\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0% state income tax\"}]]}],[\"$\",\"$L15\",\"Florida\",{\"href\":\"/florida-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Florida\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0% state income tax\"}]]}],[\"$\",\"$L15\",\"California\",{\"href\":\"/california-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"California\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"1%–13.3% progressive\"}]]}],[\"$\",\"$L15\",\"New York\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"New York\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"4%–10.9% + NYC tax\"}]]}],[\"$\",\"$L15\",\"Georgia\",{\"href\":\"/georgia-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Georgia\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"5.49% flat tax\"}]]}],[\"$\",\"$L15\",\"Virginia\",{\"href\":\"/virginia-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Virginia\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"2%–5.75% progressive\"}]]}],[\"$\",\"$L15\",\"Colorado\",{\"href\":\"/colorado-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Colorado\"}],\"$L18\"]}],\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}],\"$L1d\",\"$L1e\"]}]]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-6 w-6 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Our Tax Data\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed space-y-3\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We take accuracy seriously — not because we're perfectionists (okay, maybe a little), but because people make real financial decisions based on these numbers. Here's what our calculators use for the 2026 tax year:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc list-inside space-y-1 ml-2\",\"children\":[[\"$\",\"li\",null,{\"children\":\"2026 Federal income tax brackets (10% through 37%)\"}],[\"$\",\"li\",null,{\"children\":\"2026 Standard deductions by filing status\"}],[\"$\",\"li\",null,{\"children\":\"FICA rates: Social Security (6.2%) + Medicare (1.45%)\"}],[\"$\",\"li\",null,{\"children\":\"2026 Social Security wage cap: $184,500\"}],[\"$\",\"li\",null,{\"children\":\"Additional Medicare Tax: 0.9% above $200,000\"}],[\"$\",\"li\",null,{\"children\":\"State-specific tax rates and exemptions for IL, TX, FL, CA, NY\"}],[\"$\",\"li\",null,{\"children\":\"2026 401(k) contribution limits ($24,500 + catch-up)\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs mt-2\",\"children\":\"That said, our tools produce estimates. We can't account for every possible deduction, credit, or special circumstance in your life. If you're making a major financial decision, talk to a CPA — our calculators are a starting point, not the final word.\"}]]}]]}]\na:[\"$\",\"section\",null,{\"id\":\"contact\",\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8 text-center\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-mail h-8 w-8 text-emerald-400 mx-auto mb-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"132q7q\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"}],[\"$\",\"rect\",\"izxlao\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-3\",\"children\":\"Get in Touch\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-6 max-w-md mx-auto\",\"children\":\"Found a bug? Think our Illinois math is off? Want your state added? We actually read every email. Seriously.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/30 p-4 inline-block\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":[\"Email: \",[\"$\",\"$L1f\",null,{\"code\":\"contact|thetaxcalc.com\"}]]}]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"How We Verify Our Numbers\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We've caught mistakes on other tax calculator sites — brackets that were a year out of date, standard deductions that didn't reflect the latest IRS updates, state rates pulled from Wikipedia instead of the actual revenue department. We didn't want to be that site. So here's our process:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Go Straight to the Source\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":[\"Federal brackets come from\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/publications/p15\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"IRS Publication 15\"}],\" \",\"(Employer's Tax Guide) and\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/publications/p15t\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Publication 15-T\"}],\". Not a blog post summarizing them — the actual IRS documents. State rates come from each state's Department of Revenue directly. Illinois?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://revenue.illinois.gov/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"IDOR\"}],\". California?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.ftb.ca.gov/forms\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"FTB\"}],\". New York?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.tax.ny.gov/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"NYS Department of Taxation and Finance\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Cross-Check Everything\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We don't trust a single source. Every data point is verified against at least two independent references. Federal brackets get checked against both IRS publications and Congressional records. State rates are validated against official publications and reputable tax reference services. If there's a discrepancy, we dig until we find the authoritative answer.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Update Early, Not Late\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"As soon as the IRS or a state revenue department publishes new figures (usually late Q4 or early Q1), we incorporate them. We'd rather be early with the right numbers than wait and serve you last year's brackets. If you ever spot something that looks off, let us know — we'll investigate immediately.\"}]]}],\"$L20\"]}],\"$L21\"]}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Who's Behind This\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"TheTaxCalc is a small team of financial professionals and software engineers who got together because we shared one frustration: tax tools shouldn't be this hard to use. Some of us have backgrounds in accounting and financial planning. Others are engineers who've spent years building user-facing products. The combination works — we argue about tax brackets and UX in equal measure.\"}],[\"$\",\"p\",null,{\"children\":\"What we don't do is cut corners on the math. Every calculator goes through a review process where someone who actually understands the tax code checks the logic. Not just “does it compile?” — but “does this correctly apply the Illinois personal exemption?” and “are we handling the NYC tax threshold right?”        \"}],[\"$\",\"p\",null,{\"children\":\"And when we mess up? We fix it fast and tell you about it. We'd rather earn your trust with honesty than pretend we're infallible.\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 text-sm text-emerald-400 mt-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Last reviewed: January 2026\"}]]}]]}]]}]\nd:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Our Tax Experts\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-6\",\"children\":\"Every calculator and article on TheTaxCalc is written and reviewed by credentialed tax professionals. Their expertise covers the full range of topics our calculators address — from federal income tax and FICA to self-employment, retirement planning, and capital gains.\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 sm:grid-cols-1 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"rachel-mitchell\",{\"id\":\"rachel-mitchell\",\"className\":\"scroll-mt-24 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-6\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA — Lead Tax Analyst & Editorial Director\",\"width\":56,\"height\":56,\"className\":\"h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 mb-4\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-1\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-3\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-1.5\",\"children\":[[\"$\",\"span\",\"Federal Income Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Federal Income Tax\"}],[\"$\",\"span\",\"State Income Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"State Income Tax\"}],[\"$\",\"span\",\"FICA Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"FICA Tax\"}],[\"$\",\"span\",\"Payroll Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Payroll Tax\"}]]}],\"$L22\"]}],\"$L23\",\"$L24\"]}],\"$L25\"]}]\ne:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Editorial Policy & Trust\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-6\",\"children\":\"TheTaxCalc follows strict editorial standards because tax information directly impacts your financial decisions. Our content is created and reviewed under a formal editorial process that meets Google's E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness) guidelines for Your-Money-Or-Your-Life (YMYL) content.\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Credentialed Experts Only\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every calculator, guide, and FAQ is authored or reviewed by a credentialed tax professional — a CPA (Certified Public Accountant), EA (IRS Enrolled Agent), or CFP® (Certified Financial Planner). We do not publish anonymous content under generic bylines like “TheTaxCalc Team.” Every page links to a named author with a verifiable LinkedIn profile, professional credentials, and a transparent bio on this page.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Two-Person Review Process\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every page goes through a two-person review: the author writes and tests the calculator logic, then a second credentialed reviewer independently verifies the math, the tax bracket application, and the methodology. Disagreements are resolved by consulting primary sources (IRS publications, state revenue department websites) before publication.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[\"$L26\",\"$L27\"]}],\"$L28\",\"$L29\",\"$L2a\"]}],\"$L2b\"]}]\nf:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Authorship & Review Statement\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 space-y-4 text-sm text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Tax Calculator Pages:\"}],\"Authored by Rachel Mitchell, CPA (Lead Tax Analyst & Editorial Director). Calculation logic independently reviewed by David Chen, EA (Tax Research Director). Last comprehensive review: January 2026.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Self-Employment & 1099 Content:\"}],\"Authored by David Chen, EA. Reviewed by Rachel Mitchell, CPA. This content covers SE tax calculations, quarterly estimated payments, and independent contractor tax rules — areas where David's 15+ years of IRS representation experience directly applies.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Retirement & Investment Content:\"}],\" Authored by Sarah Johnson, CFP®. Reviewed by Rachel Mitchell, CPA. This includes 401(k) calculators, capital gains tax guides, and retirement planning articles.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"State Tax Pages:\"}],\"Authored by Rachel Mitchell, CPA, with state-specific review by our editorial team. Each state's brackets, deductions, and credits are verified against that state's revenue department publication.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Blog Articles & Guides:\"}],\"Authored by the credentialed expert most relevant to the topic. Every article displays the author's name, credentials, and review date at the top of the page.\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs italic text-muted-foreground/80 pt-2 border-t border-border/20\",\"children\":\"TheTaxCalc content is for informational and planning purposes only. It is not tax, legal, or financial advice. For advice specific to your situation, consult a qualified CPA, EA, or financial advisor.\"}]]}]]}]\n10:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-book-open h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1akyts\",{\"d\":\"M12 7v14\"}],[\"$\",\"path\",\"ruj8y\",{\"d\":\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Questions People Actually Ask Us\"}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is TheTaxCalc really free? What's the catch?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"No catch. We know that sounds suspicious — \\\"free\\\" usually means \\\"you're the product.\\\" But because all calculations run in your browser and we don't store any of your data, our server costs are minimal. No premium tiers, no paywalls, no \\\"unlock full results for $9.99.\\\" Just free calculators.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How accurate are the calculations?\"}],[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"We use the same data the IRS and state revenue departments publish — the 2026 brackets, standard deductions, FICA rates, the works. Every methodology is reviewed by tax professionals. But here's the honest answer: our tools give you solid estimates, not guarantees. Your actual tax depends on things we can't know — itemized deductions, credits, multiple income sources, life changes mid-year. For planning purposes, we're great. For filing your actual return? Talk to a CPA.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does TheTaxCalc store my salary or financial data?\"}],\"$L2c\"]}],\"$L2d\"]}],\"$L2e\",\"$L2f\",\"$L30\"]}]]}]\n11:[\"$\",\"section\",null,{\"className\":\"mb-12 border-t border-border/20 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-6\",\"children\":\"About TheTaxCalc — Resources\"}],[\"$\",\"di