\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"This one's personal. A few years back, one of those 'free' tax prep sites got caught selling user income data to data brokers. Like, your actual salary. So yeah — all the math runs right in your browser. Your numbers never touch our servers. We couldn't see them even if we wanted to. No accounts, no cookies on calculations, no way to tie results back to you.\\\"}]\\n3c:[\\\"$\\\",\\\"div\\\",\\\"Built for Real People\\\",{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-heart h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"c3ymky\\\",{\\\"d\\\":\\\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-semibold text-foreground\\\",\\\"children\\\":\\\"Built for Real People\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We're not just building for accountants. We're building for the teacher in Chicago who just got a job offer in Houston and wants to know if the $10K raise actually means more take-home. Or the freelancer in Brooklyn drowning in quarterly estimates. Or honestly, anyone who's looked at their pay stub and thought 'wait, that much?' Yeah — these tools are for you.\\\"}]]}]\\n3d:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"4.4% flat tax\\\"}]\\n3e:[\\\"$\\\",\\\"$L12\\\",\\\"Washington\\\",{\\\"href\\\":\\\"/washington-tax-calculator\\\",\\\"className\\\":\\\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\\\",\\\"children\\\":\\\"Washington\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"0% state income tax\\\"}]]}]\\n3f:[\\\"$\\\",\\\"$L12\\\",\\\"Pennsylvania\\\",{\\\"href\\\":\\\"/pennsylvania-tax-calculator\\\",\\\"className\\\":\\\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\\\",\\\"children\\\":\\\"Pennsylvania\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"3.07% flat tax\\\"}]]}]\\n40:[\\\"$\\\",\\\"$L12\\\",\\\"Ohio\\\",{\\\"href\\\":\\\"/ohio-tax-calculator\\\",\\\"className\\\":\\\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\\\",\\\"children\\\":\\\"Ohio\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"0%–3.5% progressive\\\"}]]}]\\n41:[\\\"$\\\",\\\"$L12\\\",\\\"New Jersey\\\",{\\\"hre