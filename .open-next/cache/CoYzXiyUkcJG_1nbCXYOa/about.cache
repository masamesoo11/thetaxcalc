}],[\\\"$\\\",\\\"path\\\",\\\"116196\\\",{\\\"d\\\":\\\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"df797q\\\",{\\\"d\\\":\\\"m9 14 2 2 4-4\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":\\\"How We Verify Our Numbers\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"We've caught mistakes on other tax calculator sites — brackets that were a year out of date, standard deductions that didn't reflect the latest IRS updates, state rates pulled from Wikipedia instead of the actual revenue department. We didn't want to be that site. So here's our process:\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-4 sm:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Go Straight to the Source\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":[\\\"Federal brackets come from\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.irs.gov/publications/p15\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"IRS Publication 15\\\"}],\\\" \\\",\\\"(Employer's Tax Guide) and\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.irs.gov/publications/p15t\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"Publication 15-T\\\"}],\\\". Not a blog post summarizing them — the actual IRS documents. State rates come from each state's Department of Revenue directly. Illinois?\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://revenue.illinois.gov/\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"IDOR\\\"}],\\\". California?\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.ftb.ca.gov/forms\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"FTB\\\"}],\\\". New York?\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"https://www.tax.ny.gov/\\\",\\\"target\\\":\\\"_blank\\\",\\\"rel\\\":\\\"noopener noreferrer\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"NYS Department of Taxation and Finance\\\"}],\\\".\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Cross-Check Everything\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We don't trust a single source. Every data point is verified against at least two independent references. Federal brackets get checked against both IRS publications and Congressional records. State rates are validated against official publications and reputable tax reference services. If there's a discrepancy, we dig until we find the authoritative answer.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Update Early, Not Late\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"As soon as the IRS or a state revenue department publishes new figures (usually late Q4 or early Q1), we incorporate them. We'd rather be early with the right numbers than wait and serve you last year's brackets. If you ever spot something that looks off, let us know — we'll investigate immediately.\\\"}]]}],\\\"$L45\\\"]}],\\\"$L46\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-12 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mb-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-users h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1yyitq\\\",{\\\"d\\\":\\\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"16gr8j\\\",{\\\"d\\\":\\\"M16 3.128a4 4 0 0 1 0 7.744\\\"}],[\\\"$\\\",\\\"path\\\",\\\"kshegd\\\",{\\\"d\\\":\\\"M22 21v-2a4 4 0 0 0-3-3.87\\\"}],[\\\"$\\\",\\\"circle\\\",\\\"nufk8\\\",{\\\"cx\\\":\\\"9\\\",\\\"cy\\\":\\\"7\\\",\\\"r\\\":\\\"4\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":\\\"Who's Behind This\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"TheTaxCalc is a small team of financial professionals and software engineers who got together because we shared one frustration: tax tools shouldn't be this hard to use. Some of us have backgrounds in accounting and financial planning. Others are engineers who've spent years building user-facing products. The combination works — we argue about tax brackets and UX in equal measure.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"What we don't do is cut corners on the math. Every calculator goes through a review process where someone who actually understands the tax code checks the logic. Not just “does it compile?” — but “does this correctly apply the Illinois personal exemption?” and “are we handling the NYC tax threshold right?”        \\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"And when we mess up? We fix it fast and tell you about it. We'd rather earn your trust with honesty than pretend we're infallible.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 text-sm text-emerald-400 mt-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-check h-4 w-4\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"dzmm74\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Last reviewed: January 2026\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2c:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",\\\"tgr4d6\\\",{\\\"width\\\":\\\"8\\\",\\\"height\\\":\\\"4\\\",\\\"x\\\":\\\"8\\\",\\\"y\\\":\\\"2\\\",\\\"rx\\\":\\\"1\\\",\\\"ry\\\":\\\"1\\\"}],[\\\"$\\\",\\\"path\\\",\\\"116196\\\",{\\\"d\\\":\\\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"df797q\\\",{\\\"d\\\":\\\"m9 14 2 2 4-4\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":\\\"Our Tax Experts\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-6\\\",\\\"children\\\":\\\"Every calculator and article on TheTaxCalc is written and reviewed by credentialed tax professionals. Their expertise covers the full range of topics our calculators address — from federal income tax and FICA to self-employment, retirement planning, and capital gains.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-6 sm:grid-cols-1 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"rachel-mitchell\\\",{\\\"id\\\":\\\"rachel-mitchell\\\",\\\"className\\\":\\\"scroll-mt-24 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"img\\\",null,{\\\"src\\\":\\\"https://thetaxcalc.com/author-rachel-mitchell.webp\\\",\\\"alt\\\":\\\"Rachel Mitchell, CPA — Lead Tax Analyst \\u0026 Editorial Director\\\",\\\"width\\\":56,\\\"height\\\":56,\\\"className\\\":\\\"h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 mb-4\\\",\\\"loading\\\":\\\"lazy\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center gap-2 mb-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-lg font-semibold text-foreground\\\",\\\"children\\\":\\\"Rachel Mitchell\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\\\",\\\"children\\\":\\\"CPA\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mb-3\\\",\\\"children\\\":[\\\"Lead Tax Analyst \\u0026 Editorial Director\\\",\\\", TheTaxCalc\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed mb-4\\\",\\\"children\\\":\\\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap gap-1.5\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"Federal Income Tax\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\\\",\\\"children\\\":\\\"Federal Income Tax\\\"}],[\\\"$\\\",\\\"span\\\",\\\"State Income Tax\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\\\",\\\"children\\\":\\\"State Income Tax\\\"}],[\\\"$\\\",\\\"span\\\",\\\"FICA Tax\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\\\",\\\"children\\\":\\\"FICA Tax\\\"}],[\\\"$\\\",\\\"span\\\",\\\"Payroll Tax\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\\\",\\\"children\\\":\\\"Payroll Tax\\\"}]]}],\\\"$L47\\\"]}],\\\"$L48\\\",\\\"$L49\\\"]}],\\\"$L4a\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"2d:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-12 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-shield h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"oel41y\\\",{\\\"d\\\":\\\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":\\\"Editorial Policy \\u0026 Trust\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-6\\\",\\\"children\\\":\\\"TheTaxCalc follows strict editorial standards because tax information directly impacts your financial decisions. Our content is created and reviewed under a formal editorial process that meets Google's E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness) guidelines for Your-Money-Or-Your-Life (YMYL) content.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-6 md:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",\\\"tgr4d6\\\",{\\\"width\\\":\\\"8\\\",\\\"height\\\":\\\"4\\\",\\\"x\\\":\\\"8\\\",\\\"y\\\":\\\"2\\\",\\\"rx\\\":\\\"1\\\",\\\"ry\\\":\\\"1\\\"}],[\\\"$\\\",\\\"path\\\",\\\"116196\\\",{\\\"d\\\":\\\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"df797q\\\",{\\\"d\\\":\\\"m9 14 2 2 4-4\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-base font-semibold text-foreground\\\",\\\"children\\\":\\\"Credentialed Experts Only\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Every calculator, guide, and FAQ is authored or reviewed by a credentialed tax professional — a CPA (Certified Public Accountant), EA (IRS Enrolled Agent), or CFP® (Certified Financial Planner). We do not publish anonymous content under generic bylines like “TheTaxCalc Team.” Every page links to a named author with a verifiable LinkedIn profile, professional credentials, and a transparent bio on this page.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-check h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"dzmm74\\\",{\\\"d\\\":\\\"m9 12 2 2 4-4\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-base font-semibold text-foreground\\\",\\\"children\\\":\\\"Two-Person Review Process\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Every page goes through a two-person review: the author writes and tests the calculator logic, then a second credentialed reviewer independently verifies the math, the tax bracket application, and the methodology. Disagreements are resolved by consulting primary sources (IRS publications, state revenue department websites) before publication.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[\\\"$L4b\\\",\\\"$L4c\\\"]}],\\\"$L4d\\\",\\\"$L4e\\\",\\\"$L4f\\\"]}],\\\"$L50\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"2e:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"rect\\\",\\\"tgr4d6\\\",{\\\"width\\\":\\\"8\\\",\\\"height\\\":\\\"4\\\",\\\"x\\\":\\\"8\\\",\\\"y\\\":\\\"2\\\",\\\"rx\\\":\\\"1\\\",\\\"ry\\\":\\\"1\\\"}],[\\\"$\\\",\\\"path\\\",\\\"116196\\\",{\\\"d\\\":\\\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\\\"}],[\\\"$\\\",\\\"path\\\",\\\"df797q\\\",{\\\"d\\\":\\\"m9 14 2 2 4-4\\\"}],\\\"$undefined\\\"]}]}],[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":\\\"Authorship \\u0026 Review Statement\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 space-y-4 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-foreground\\\",\\\"children\\\":\\\"Tax Calculator Pages:\\\"}],\\\"Authored by Rachel Mitchell, CPA (Lead Tax Analyst \\u0026 Editorial