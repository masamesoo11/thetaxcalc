order/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Capital Gains\"}]\n19:[\"$\",\"$L12\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"401(k)\"}]\n1a:[\"$\",\"$L12\",\"/blog\",{\"href\":\"/blog\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Blog\"}]\n1b:[\"$\",\"$L12\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}]\n1c:[\"$\",\"$L12\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}]\n1d:[\"$\",\"$L12\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}]\n1e:[\"$\",\"$L12\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}]\n1f:[\"$\",\"$L12\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]\n20:[\"$\",\"$L3a\",null,{}]\n22:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L12\",null,{\"href\":\"/\",\"className\":\"underline underline-offset-2 decoration-muted-foreground/40 hover:decoration-foreground hover:text-foreground transition-colors flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-house h-3.5 w-3.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"5wwlr5\",{\"d\":\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"}],[\"$\",\"path\",\"1d0kgt\",{\"d\":\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"hidden sm:inline\",\"children\":\"Home\"}]]}],[[\"$\",\"span\",\"0\",{\"className\":\"flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-3.5 w-3.5 text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"About\"}]]}]]]}]\n23:[\"$\",\"div\",null,{\"className\":\"mb-12 text-center\",\"children\":[[\"$\",\"div\",null,{\"className\":\"inline-flex items-center gap-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-4 py-1.5 text-sm text-emerald-400 mb-6\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users h-3.5 w-3.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}],\"About TheTaxCalc\"]}],[\"$\",\"h1\",null,{\"className\":\"text-4xl font-bold tracking-tight text-foreground sm:text-5xl\",\"children\":[\"Free \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Tax Calculators\"}],\" \",[\"$\",\"br\",null,{}],\"Built for You\"]}],[\"$\",\"p\",null,{\"className\":\"mx-auto mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed\",\"children\":\"We built TheTaxCalc because we were tired of tax calculators that felt like they were designed by the IRS itself — confusing, ugly, and somehow always trying to upsell you.\"}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-target h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"circle\",\"1vlfrh\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"6\"}],[\"$\",\"circle\",\"1c9p78\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"2\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Why We Built This\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"In 2022, one of our team members moved from Sacramento to Austin. Same salary ($115,000), same company — but suddenly his take-home pay jumped by over $8,700 a year. He knew Texas didn't have a state income tax, but actually seeing the number on a paycheck? That hit different. He'd been leaving nearly $725 a month on the table and didn't even realize it.\"}],[\"$\",\"p\",null,{\"children\":\"He went looking for a calculator that could have shown him this beforehand. What he found was frustrating: tools that required his email before showing results, calculators using outdated tax brackets, sites that looked like they hadn't been updated since 2015, and — worst of all — calculators that asked for his salary and then tried to sell him financial planning services.\"}],[\"$\",\"p\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"So we built the tool we wished existed.\"}],[\"$\",\"p\",null,{\"children\":\"TheTaxCalc started as a weekend project — a single paycheck calculator that actually used current tax data and didn't try to sell you anything. It turns out a lot of people wanted exactly that. Today we have 64 calculators covering paycheck estimation, mortgage amortization, 401(k) projections, capital gains, self-employment taxes, sales tax, overtime, lottery, bonus, property tax, IRS withholding, and side-by-side state comparisons — all updated for the 2026 tax year.\"}],[\"$\",\"p\",null,{\"children\":\"Here's the thing that still drives us crazy: most Americans don't know their effective tax rate. They see deductions on their pay stub and just accept it. We want to change that. Not with jargon or lectures, but with a simple, honest tool that shows you exactly where your money goes.\"}]]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-4 sm:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Free Calculators\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-calculator h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"1nb95v\",{\"width\":\"16\",\"height\":\"20\",\"x\":\"4\",\"y\":\"2\",\"rx\":\"2\"}],[\"$\",\"line\",\"x4nwl0\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"6\",\"y2\":\"6\"}],[\"$\",\"line\",\"wjye3r\",{\"x1\":\"16\",\"x2\":\"16\",\"y1\":\"14\",\"y2\":\"18\"}],[\"$\",\"path\",\"1m94wz\",{\"d\":\"M16 10h.01\"}],[\"$\",\"path\",\"1nrarc\",{\"d\":\"M12 10h.01\"}],[\"$\",\"path\",\"19clt8\",{\"d\":\"M8 10h.01\"}],[\"$\",\"path\",\"1etili\",{\"d\":\"M12 14h.01\"}],[\"$\",\"path\",\"6423bh\",{\"d\":\"M8 14h.01\"}],[\"$\",\"path\",\"mhygvu\",{\"d\":\"M12 18h.01\"}],[\"$\",\"path\",\"lrp35t\",{\"d\":\"M8 18h.01\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"64\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Free Calculators\"}]]}],[\"$\",\"div\",\"State Profiles\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"50\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"State Profiles\"}]]}],[\"$\",\"div\",\"Tax Year Data\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chart-column h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"c24i48\",{\"d\":\"M3 3v16a2 2 0 0 0 2 2h16\"}],[\"$\",\"path\",\"2bz60n\",{\"d\":\"M18 17V9\"}],[\"$\",\"path\",\"1frdt8\",{\"d\":\"M13 17V5\"}],[\"$\",\"path\",\"17ska0\",{\"d\":\"M8 17v-3\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Tax Year Data\"}]]}],[\"$\",\"div\",\"Data Stored\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400 mx-auto mb-2\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"0\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Data Stored\"}]]}]]}]}]\n26:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground text-center mb-8\",\"children\":[\"What We \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Stand For\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"div\",\"We Get the Numbers Right\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"We Get the Numbers Right\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We've seen calculators that round your bracket up or just slap last year's rates on the page and hope nobody notices. We found one last month that was still showing 2024 federal brackets — in 2026. Every rate, bracket, and exemption on this site comes straight from IRS Publication 15-T or the state revenue department's own website. When they update, we update. Usually within 48 hours.\"}]]}],[\"$\",\"div\",\"Free. Period.\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-zap h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1xq2db\",{\"d\":\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Free. Period.\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No sign-up wall. No 'premium tier.' No sneaky upsell after three calculations. We built TheTaxCalc because we believe understanding your own paycheck shouldn't cost you a dime. A friend of ours actually paid $15 to a tax calculator site before realizing it was just going to show him the same math he could've done himself. That's the kind of thing that made us want to build this. That's not changing.\"}]]}],[\"$\",\"div\",\"Your Data Stays Yours\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-globe h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"13o1zl\",{\"d\":\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"}],[\"$\",\"path\",\"9i4pu4\",{\"d\":\"M2 12h20\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Your Data Stays Yours\"}]]}],\"$L3b\"]}],\"$L3c\"]}]]}]\n27:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":[\"States & \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Calculators\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We cover all 50 states with dedicated income tax calculators, plus sales tax data for all 50 states. Each state profile includes not just the income tax rate, but property tax context, sales tax data, and retirement-friendliness notes. Here are some of our most popular states:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L12\",\"Illinois\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Illinois\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"4.95% flat tax\"}]]}],[\"$\",\"$L12\",\"Texas\",{\"href\":\"/texas-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Texas\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0% state income tax\"}]]}],[\"$\",\"$L12\",\"Florida\",{\"href\":\"/florida-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Florida\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0% state income tax\"}]]}],[\"$\",\"$L12\",\"California\",{\"href\":\"/california-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"California\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"1%–13.3% progressive\"}]]}],[\"$\",\"$L12\",\"New York\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"New York\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"4%–10.9% + NYC tax\"}]]}],[\"$\",\"$L12\",\"Georgia\",{\"href\":\"/georgia-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Georgia\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"5.49% flat tax\"}]]}],[\"$\",\"$L12\",\"Virginia\",{\"href\":\"/virginia-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Virginia\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"2%–5.75% progressive\"}]]}],[\"$\",\"$L12\",\"Colorado\",{\"href\":\"/colorado-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Colorado\"}],\"$L3d\"]}],\"$L3e\",\"$L3f\",\"$L40\",\"$L41\"]}],\"$L42\",\"$L43\"]}]]}]\n28:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-6 w-6 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Our Tax Data\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed space-y-3\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We take accuracy seriously — not because we're perfectionists (okay, maybe a little), but because people make real financial decisions based on these numbers. Here's what our calculators use for the 2026 tax year:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc list-inside space-y-1 ml-2\",\"children\":[[\"$\",\"li\",null,{\"children\":\"2026 Federal income tax brackets (10% through 37%)\"}],[\"$\",\"li\",null,{\"children\":\"2026 Standard deductions by filing status\"}],[\"$\",\"li\",null,{\"children\":\"FICA rates: Social Security (6.2%) + Medicare (1.45%)\"}],[\"$\",\"li\",null,{\"children\":\"2026 Social Security wage cap: $184,500\"}],[\"$\",\"li\",null,{\"children\":\"Additional Medicare Tax: 0.9% above $200,000\"}],[\"$\",\"li\",null,{\"children\":\"State-specific tax rates and exemptions for IL, TX, FL, CA, NY\"}],[\"$\",\"li\",null,{\"children\":\"2026 401(k) contribution limits ($24,500 + catch-up)\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-xs mt-2\",\"children\":\"That said, our tools produce estimates. We can't account for every possible deduction, credit, or special circumstance in your life. If you're making a major financial decision, talk to a CPA — our calculators are a starting point, not the final word.\"}]]}]]}]\n29:[\"$\",\"section\",null,{\"id\":\"contact\",\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8 text-center\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-mail h-8 w-8 text-emerald-400 mx-auto mb-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"132q7q\",{\"d\":\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"}],[\"$\",\"rect\",\"izxlao\",{\"x\":\"2\",\"y\":\"4\",\"width\":\"20\",\"height\":\"16\",\"rx\":\"2\"}],\"$undefined\"]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-3\",\"children\":\"Get in Touch\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground mb-6 max-w-md mx-auto\",\"children\":\"Found a bug? Think our Illinois math is off? Want your state added? We actually read every email. Seriously.\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/30 p-4 inline-block\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground\",\"children\":[\"Email: \",[\"$\",\"$L44\",null,{\"code\":\"contact|thetaxcalc.com\"}]]}]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-border/30 bg-card/50 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"How We Verify Our Numbers\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"We've caught mistakes on other tax calculator sites — brackets that were a year out of date, standard deductions that didn't reflect the latest IRS updates, state rates pulled from Wikipedia instead of the actual revenue department. We didn't want to be that site. So here's our process:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Go Straight to the Source\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":[\"Federal brackets come from\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/publications/p15\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"IRS Publication 15\"}],\" \",\"(Employer's Tax Guide) and\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/publications/p15t\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Publication 15-T\"}],\". Not a blog post summarizing them — the actual IRS documents. State rates come from each state's Department of Revenue directly. Illinois?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://revenue.illinois.gov/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"IDOR\"}],\". California?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.ftb.ca.gov/forms\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"FTB\"}],\". New York?\",\" \",[\"$\",\"a\",null,{\"href\":\"https://www.tax.ny.gov/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"NYS Department of Taxation and Finance\"}],\".\"]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Cross-Check Everything\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We don't trust a single source. Every data point is verified against at least two independent references. Federal brackets get checked against both IRS publications and Congressional records. State rates are validated against official publications and reputable tax reference services. If there's a discrepancy, we dig until we find the authoritative answer.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Update Early, Not Late\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"As soon as the IRS or a state revenue department publishes new figures (usually late Q4 or early Q1), we incorporate them. We'd rather be early with the right numbers than wait and serve you last year's brackets. If you ever spot something that looks off, let us know — we'll investigate immediately.\"}]]}],\"$L45\"]}],\"$L46\"]}]]}]\n2b:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-users h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1yyitq\",{\"d\":\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"}],[\"$\",\"path\",\"16gr8j\",{\"d\":\"M16 3.128a4 4 0 0 1 0 7.744\"}],[\"$\",\"path\",\"kshegd\",{\"d\":\"M22 21v-2a4 4 0 0 0-3-3.87\"}],[\"$\",\"circle\",\"nufk8\",{\"cx\":\"9\",\"cy\":\"7\",\"r\":\"4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Who's Behind This\"}]]}],[\"$\",\"div\",null,{\"className\":\"text-muted-foreground leading-relaxed space-y-4\",\"children\":[[\"$\",\"p\",null,{\"children\":\"TheTaxCalc is a small team of financial professionals and software engineers who got together because we shared one frustration: tax tools shouldn't be this hard to use. Some of us have backgrounds in accounting and financial planning. Others are engineers who've spent years building user-facing products. The combination works — we argue about tax brackets and UX in equal measure.\"}],[\"$\",\"p\",null,{\"children\":\"What we don't do is cut corners on the math. Every calculator goes through a review process where someone who actually understands the tax code checks the logic. Not just “does it compile?” — but “does this correctly apply the Illinois personal exemption?” and “are we handling the NYC tax threshold right?”        \"}],[\"$\",\"p\",null,{\"children\":\"And when we mess up? We fix it fast and tell you about it. We'd rather earn your trust with honesty than pretend we're infallible.\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 text-sm text-emerald-400 mt-2\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"children\":\"Last reviewed: January 2026\"}]]}]]}]]}]\n2c:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Our Tax Experts\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-6\",\"children\":\"Every calculator and article on TheTaxCalc is written and reviewed by credentialed tax professionals. Their expertise covers the full range of topics our calculators address — from federal income tax and FICA to self-employment, retirement planning, and capital gains.\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 sm:grid-cols-1 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"rachel-mitchell\",{\"id\":\"rachel-mitchell\",\"className\":\"scroll-mt-24 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-6\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA — Lead Tax Analyst & Editorial Director\",\"width\":56,\"height\":56,\"className\":\"h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 mb-4\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-1\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-3\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-1.5\",\"children\":[[\"$\",\"span\",\"Federal Income Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Federal Income Tax\"}],[\"$\",\"span\",\"State Income Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"State Income Tax\"}],[\"$\",\"span\",\"FICA Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"FICA Tax\"}],[\"$\",\"span\",\"Payroll Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Payroll Tax\"}]]}],\"$L47\"]}],\"$L48\",\"$L49\"]}],\"$L4a\"]}]\n2d:[\"$\",\"section\",null,{\"className\":\"mb-12 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Editorial Policy & Trust\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-6\",\"children\":\"TheTaxCalc follows strict editorial standards because tax information directly impacts your financial decisions. Our content is created and reviewed under a formal editorial process that meets Google's E-E-A-T (Experience, Expertise, Authoritativeness, Trustworthiness) guidelines for Your-Money-Or-Your-Life (YMYL) content.\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 md:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Credentialed Experts Only\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every calculator, guide, and FAQ is authored or reviewed by a credentialed tax professional — a CPA (Certified Public Accountant), EA (IRS Enrolled Agent), or CFP® (Certified Financial Planner). We do not publish anonymous content under generic bylines like “TheTaxCalc Team.” Every page links to a named author with a verifiable LinkedIn profile, professional credentials, and a transparent bio on this page.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Two-Person Review Process\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every page goes through a two-person review: the author writes and tests the calculator logic, then a second credentialed reviewer independently verifies the math, the tax bracket application, and the methodology. Disagreements are resolved by consulting primary sources (IRS publications, state revenue department websites) before publication.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[\"$L4b\",\"$L4c\"]}],\"$L4d\",\"$L4e\",\"$L4f\"]}],\"$L50\"]}]\n2e:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-clipboard-check h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"tgr4d6\",{\"width\":\"8\",\"height\":\"4\",\"x\":\"8\",\"y\":\"2\",\"rx\":\"1\",\"ry\":\"1\"}],[\"$\",\"path\",\"116196\",{\"d\":\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"}],[\"$\",\"path\",\"df797q\",{\"d\":\"m9 14 2 2 4-4\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Authorship & Review Statement\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 space-y-4 text-sm text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Tax Calculator Pages:\"}],\"Authored by Rachel Mitchell, CPA (Lead Tax Analyst & Editorial Director). Calculation logic independently reviewed by David Chen, EA (Tax Research Director). Last comprehensive review: January 2026.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Self-Employment & 1099 Content:\"}],\"Authored by David Chen, EA. Reviewed by Rachel Mitchell, CPA. This content covers SE tax calculations, quarterly estimated payments, and independent contractor tax rules — areas where David's 15+ years of IRS representation experience directly applies.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Retirement & Investment Content:\"}],\" Authored by Sarah Johnson, CFP®. Reviewed by Rachel Mitchell, CPA. This includes 401(k) calculators, capital gains tax guides, and retirement planning articles.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"State Tax Pages:\"}],\"Authored by Rachel Mitchell, CPA, with state-specific review by our editorial team. Each state's brackets, deductions, and credits are verified against that state's revenue department publication.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Blog Articles & Guides:\"}],\"Authored by the credentialed expert most relevant to the topic. Every article displays the author's name, credentials, and review date at the top of the page.\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs italic text-muted-foreground/80 pt-2 border-t border-border/20\",\"children\":\"TheTaxCalc content is for informational and planning purposes only. It is not tax, legal, or financial advice. For advice specific to your situation, consult a qualified CPA, EA, or financial advisor.\"}]]}]]}]\n2f:[\"$\",\"section\",null,{\"className\":\"mb-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-book-open h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1akyts\",{\"d\":\"M12 7v14\"}],[\"$\",\"path\",\"ruj8y\",{\"d\":\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"}],\"$undefined\"]}]}],[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"Questions People Actually Ask Us\"}]]}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is TheTaxCalc really free? What's the catch?\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"No catch. We know that sounds suspicious — \\\"free\\\" usually means \\\"you're the product.\\\" But because all calculations run in your browser and we don't store any of your data, our server costs are minimal. No premium tiers, no paywalls, no \\\"unlock full results for $9.99.\\\" Just free calculators.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How accurate are the calculations?\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"We use the same data the IRS and state revenue departments publish — the 2026 brackets, standard deductions, FICA rates, the works. Every methodology is reviewed by tax professionals. But here's the honest answer: our tools give you solid estimates, not guarantees. Your actual tax depends on things we can't know — itemized deductions, credits, multiple income sources, life changes mid-year. For planning purposes, we're great. For filing your actual return? Talk to a CPA.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does TheTaxCalc store my salary or financial data?\"}],\"$L51\"]}],\"$L52\"]}],\"$L53\",\"$L54\",\"$L55\"]}]]}]\n30:[\"$\",\"section\",null,{\"className\":\"mb-12 border-t border-border/20 pt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-6\",\"children\":\"About TheTaxCalc — Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-6 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground mb-3\",\"children\":\"Tax Calculators\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"$L12\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Paycheck Calculator\"]}],[\"$\",\"$L12\",\"/illinois-tax-calculator\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Illinois (4.95% flat)\"]}],[\"$\",\"$L12\",\"/texas-tax-calculator\",{\"href\":\"/texas-tax-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Texas (0% income tax)\"]}],[\"$\",\"$L12\",\"/florida-tax-calculator\",{\"href\":\"/florida-tax-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Florida (0% income tax)\"]}],[\"$\",\"$L12\",\"/california-tax-calculator\",{\"href\":\"/california-tax-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"California (1%–13.3%)\"]}],[\"$\",\"$L12\",\"/new-york-tax-calculator\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"New York (4%–10.9%)\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground mb-3\",\"children\":\"Salary After Tax\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2\",\"children\":[[\"$\",\"$L12\",\"/salary/50000\",{\"href\":\"/salary/50000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$50K\"}],[\"$\",\"$L12\",\"/salary/75000\",{\"href\":\"/salary/75000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$75K\"}],[\"$\",\"$L12\",\"/salary/100000\",{\"href\":\"/salary/100000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$100K\"}],[\"$\",\"$L12\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$150K\"}]]}],\"$L56\"]}],\"$L57\"]}]]}]\n31:[\"$\",\"div\",null,{\"className\":\"text-center\",\"children\":[\"$\",\"$L12\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all hover:scale-[1.02]\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-dollar-sign h-5 w-5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"line\",\"7eqyqh\",{\"x1\":\"12\",\"x2\":\"12\",\"y1\":\"2\",\"y2\":\"22\"}],[\"$\",\"path\",\"1b0p4s\",{\"d\":\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"}],\"$undefined\"]}],\"Try Our Paycheck Calculator\"]}]}]\n32:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0kxe9smv8dkyp.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n33:[\"$\",\"$L58\",null,{\"children\":[\"$\",\"$38\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@59\"}]}]\n3b:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"This one's personal. A few years back, one of those 'free' tax prep sites got caught selling user income data to data brokers. Like, your actual salary. So yeah — all the math runs right in your browser. Your numbers never touch our servers. We couldn't see them even if we wanted to. No accounts, no cookies on calculations, no way to tie results back to you.\"}]\n3c:[\"$\",\"div\",\"Built for Real People\",{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10\",\"children\":[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-heart h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"c3ymky\",{\"d\":\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"}],\"$undefined\"]}]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Built for Real People\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We're not just building for accountants. We're building for the teacher in Chicago who just got a job offer in Houston and wants to know if the $10K raise actually means more take-home. Or the freelancer in Brooklyn drowning in quarterly estimates. Or honestly, anyone who's looked at their pay stub and thought 'wait, that much?' Yeah — these tools are for you.\"}]]}]\n3d:[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"4.4% flat tax\"}]\n3e:[\"$\",\"$L12\",\"Washington\",{\"href\":\"/washington-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Washington\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0% state income tax\"}]]}]\n3f:[\"$\",\"$L12\",\"Pennsylvania\",{\"href\":\"/pennsylvania-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Pennsylvania\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"3.07% flat tax\"}]]}]\n40:[\"$\",\"$L12\",\"Ohio\",{\"href\":\"/ohio-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Ohio\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"0%–3.5% progressive\"}]]}]\n41:[\"$\",\"$L12\",\"New Jersey\",{\"href\":\"/new-jersey-tax-calculator\",\"className\":\"flex items-center justify-between rounded-lg bg-muted/20 p-3 hover:bg-muted/30 transition-colors group\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"New Jersey\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"1.4%–10.75% progressive\"}]]}]\n42:[\"$\",\"p\",null,{\"className\":\"mt-2\",\"children\":[\"We now cover all 50 states with dedicated income tax calculators — from zero-income-tax states (TX, FL, WA, NV, WY, AK, SD, NH, TN) to the highest-tax states in the country (CA, NY), with flat-tax states (IL, CO, IN, PA) and progressive states across the country. Plus, our \",[\"$\",\"$L12\",null,{\"href\":\"/sales-tax-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Sales Tax Calculator\"}],\" covers all 50 states with combined state + local rates.\"]}]\n43:[\"$\",\"p\",null,{\"children\":[\"Beyond state calculators, we also built tools for\",\" \",[\"$\",\"$L12\",null,{\"href\":\"/mortgage-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"mortgage amortization\"}],\" \",\"(with an extra payments feature that shows exactly how much interest you can save),\",\" \",[\"$\",\"$L12\",null,{\"href\":\"/401k-retirement-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"401(k) retirement projections\"}],\",\",\" \",[\"$\",\"$L12\",null,{\"href\":\"/capital-gains-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"capital gains tax estimation\"}],\",\",\" \",[\"$\",\"$L12\",null,{\"href\":\"/self-employment-tax-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"self-employment tax calculations\"}],\", and a\",\" \",[\"$\",\"$L12\",null,{\"href\":\"/relocation-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"relocation calculator\"}],\" \",\"that answers the question: “How much would I need to earn in State B to match my take-home pay in State A?”\"]}]\n45:[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-muted/20 p-4\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground mb-2\",\"children\":\"Professional Review\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every calculation methodology gets reviewed by tax professionals before it goes live. They check that our bracket logic, deduction rules, and FICA calculations follow current tax law. And when we find an error — it happens, we're human — we fix it and document what changed. No quiet corrections.\"}]]}]\n46:[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-amber-500/20 bg-amber-500/5 p-4 mt-2\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-sm text-amber-200/90 leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-amber-300\",\"children\":\"One more thing:\"}],\"TheTaxCalc gives you estimates, not tax advice. Our tools don't replace a CPA who knows your specific situation inside and out. Use us to plan and estimate — then talk to a professional when it's time to actually file.\"]}]}]\n47:[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"mt-4 inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\"}]}],\"LinkedIn Profile\"]}]\n48:[\"$\",\"div\",\"david-chen\",{\"id\":\"david-chen\",\"className\":\"scroll-mt-24 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-6\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-david-chen.webp\",\"alt\":\"David Chen, EA — Tax Research Director & IRS Practice Lead\",\"width\":56,\"height\":56,\"className\":\"h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 mb-4\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-1\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"David Chen\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"EA\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-3\",\"children\":[\"Tax Research Director & IRS Practice Lead\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"David Chen is an IRS Enrolled Agent (EA) with 15+ years of experience representing taxpayers before the IRS in audits, collections, and appeals. He specializes in self-employment tax, quarterly estimated payments, independent contractor classification, and IRS dispute resolution. David is a member of the National Association of Enrolled Agents (NAEA) and the California Society of Enrolled Agents. He holds a Master of Taxation (MTax) from San Jose State University and has completed advanced coursework in IRS Circular 230 ethics. David regularly contributes to tax policy analysis and has been quoted in publications including Tax Notes and the Wall Street Journal tax section.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-1.5\",\"children\":[[\"$\",\"span\",\"Self-Employment Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Self-Employment Tax\"}],[\"$\",\"span\",\"Estimated Tax Payments\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Estimated Tax Payments\"}],[\"$\",\"span\",\"IRS Representation\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"IRS Representation\"}],[\"$\",\"span\",\"Tax Audits\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Tax Audits\"}]]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/in/davidchenea/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"mt-4 inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\"}]}],\"LinkedIn Profile\"]}]]}]\n49:[\"$\",\"div\",\"sarah-johnson\",{\"id\":\"sarah-johnson\",\"className\":\"scroll-mt-24 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-6\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-sarah-johnson.webp\",\"alt\":\"Sarah Johnson, CFP® — Financial Planning Specialist & Retirement Tax Strategist\",\"width\":56,\"height\":56,\"className\":\"h-14 w-14 rounded-full object-cover ring-2 ring-emerald-500/30 mb-4\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-1\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground\",\"children\":\"Sarah Johnson\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CFP®\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-3\",\"children\":[\"Financial Planning Specialist & Retirement Tax Strategist\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Sarah Johnson is a CERTIFIED FINANCIAL PLANNER™ (CFP®) professional with over 10 years of experience helping individuals optimize their retirement savings, investment tax strategies, and long-term wealth building. She specializes in 401(k) optimization, Roth conversion strategies, capital gains harvesting, and required minimum distribution (RMD) planning. Sarah is a member of the Financial Planning Association (FPA) and holds the Chartered Retirement Planning Counselor (CRPC®) designation. She earned her BS in Finance from Indiana University and completed the CFP® certification program at Northwestern University. Sarah has presented at the FPA Annual Conference and contributes regularly to retirement planning publications.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-1.5\",\"children\":[[\"$\",\"span\",\"Retirement Planning\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Retirement Planning\"}],[\"$\",\"span\",\"401(k) Optimization\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"401(k) Optimization\"}],[\"$\",\"span\",\"Capital Gains Tax\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Capital Gains Tax\"}],[\"$\",\"span\",\"Investment Tax Strategy\",{\"className\":\"inline-flex items-center rounded-md bg-muted/30 px-2 py-0.5 text-[11px] text-muted-foreground\",\"children\":\"Investment Tax Strategy\"}]]}],[\"$\",\"a\",null,{\"href\":\"https://www.linkedin.com/in/sarahjohnsoncfp/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"mt-4 inline-flex items-center gap-1.5 text-xs text-emerald-400 hover:text-emerald-300 transition-colors\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"currentColor\",\"viewBox\":\"0 0 24 24\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"d\":\"M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z\"}]}],\"LinkedIn Profile\"]}]]}]\n4a:[\"$\",\"p\",null,{\"className\":\"mt-4 text-xs text-muted-foreground\",\"children\":\"All tax data and calculation methodologies on TheTaxCalc are reviewed by our expert team and verified against official IRS publications and state revenue department sources.\"}]\n4b:[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-book-open h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1akyts\",{\"d\":\"M12 7v14\"}],[\"$\",\"path\",\"ruj8y\",{\"d\":\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Primary Source Verification\"}]]}]\n4c:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We cite official sources for every tax figure: IRS Publication 15-T for federal withholding, IRS Rev. Proc. 2025-25 for 2026 inflation adjustments, state revenue department publications for state-specific rules, and the Social Security Administration for the annual wage base. Outdated or broken links are reviewed quarterly.\"}]\n4d:[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-zap h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"1xq2db\",{\"d\":\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Annual Update Cycle\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Tax brackets, standard deductions, FICA rates, and state tax rules are updated annually as soon as the IRS and state revenue departments publish new figures — usually in October–December for the upcoming tax year. Each page displays a “Last reviewed” date so you know exactly when the content was last verified. Mid-year legislative changes (like the 2025 overtime tax exemption) are published within 30 days of IRS guidance.\"}]]}]\n4e:[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-heart h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"c3ymky\",{\"d\":\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Corrections Policy\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"If we make a mistake, we fix it — fast and visibly. Reported errors in calculation logic are investigated within 48 hours. Confirmed errors are corrected, the page is republished with an updated review date, and a note explaining the change is added to our methodology page. We do not silently edit content after publication without disclosure.\"}]]}]\n4f:[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-shield h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"oel41y\",{\"d\":\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"}],\"$undefined\"]}],[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Conflict of Interest Policy\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"TheTaxCalc does not accept paid placements, sponsored calculator recommendations, or affiliate commissions from tax-preparation software companies. Our recommendations are based solely on what we believe serves the user. We display ads (Google AdSense) clearly labeled as advertising, separate from editorial content.\"}]]}]\n50:[\"$\",\"div\",null,{\"className\":\"mt-6 flex flex-wrap items-center gap-3 text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-emerald-400 border border-emerald-500/20\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-3 w-3\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],\" CPA-Reviewed\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-emerald-400 border border-emerald-500/20\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-3 w-3\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],\" E-E-A-T Compliant\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-emerald-400 border border-emerald-500/20\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-3 w-3\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],\" IRS Source-Verified\"]}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1.5 text-emerald-400 border border-emerald-500/20\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-check h-3 w-3\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"dzmm74\",{\"d\":\"m9 12 2 2 4-4\"}],\"$undefined\"]}],\" Updated for Tax Year 2026\"]}]]}]\n51:[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]\n52:[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Nope. When you type your salary into one of our calculators, that number stays in your browser. It never gets sent to our servers. We don't have accounts, we don't use tracking cookies on calculations, and we couldn't tie your data to you even if we wanted to — because we never see it.\"}]\n53:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Do you cover all 50 states?\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. We cover all 50 states with dedicated income tax calculators — from zero-income-tax states (TX, FL, WA, NV, WY, AK, SD, NH, TN) to the highest-tax states (CA, NY), plus flat-tax states (IL, CO, IN, PA, MI, MA) and progressive states across the country. Each state has its own calculator with dedicated brackets, exemptions, property tax data, and retirement considerations. We also cover all 50 states for sales tax calculations.\"}]]}]\n54:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"When do you update tax brackets?\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"As soon as the IRS and state revenue departments publish new figures — usually late Q4 or early Q1. We don't wait for tax season to start. If the IRS releases updated brackets in November, our calculators reflect them in November. Our 2026 data is current as of January 2026.\"}]]}]\n55:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I use this to file my taxes?\"}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"qrunsl\",{\"d\":\"m6 9 6 6 6-6\"}],\"$undefined\"]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Please don't. Our calculators are for estimation and planning — figuring out if that job offer in Florida really means more take-home pay, or how much you'd save with extra mortgage payments. When it's time to actually file, use real tax preparation software or work with a CPA who knows your situation. We're a starting point, not a substitute.\"}]]}]\n56:[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-2\",\"children\":[[\"$\",\"$L12\",null,{\"href\":\"/salary\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"All Salary Levels\"]}],[\"$\",\"$L12\",null,{\"href\":\"/compare\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Compare State Taxes\"]}]]}]\n57:[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground mb-3\",\"children\":\"Guides & More\"}],[\"$\",\"div\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"$L12\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"group flex items-center gap-2 text-sm tex