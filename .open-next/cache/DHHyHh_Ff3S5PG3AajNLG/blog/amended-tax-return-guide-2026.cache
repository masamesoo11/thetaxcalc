 lg:gap-8\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block lg:w-64 lg:shrink-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-24\",\"children\":[\"$\",\"$L28\",null,{\"entries\":[{\"id\":\"what-is-an-amended-tax-return\",\"text\":\"What Is an Amended Tax Return?\",\"level\":2},{\"id\":\"when-should-you-amend-your-tax-return\",\"text\":\"When Should You Amend Your Tax Return?\",\"level\":2},{\"id\":\"how-to-file-an-amended-return\",\"text\":\"How to File an Amended Return\",\"level\":2},{\"id\":\"step-1-gather-your-documents\",\"text\":\"Step 1: Gather Your Documents\",\"level\":3},{\"id\":\"step-2-complete-form-1040-x\",\"text\":\"Step 2: Complete Form 1040-X\",\"level\":3},{\"id\":\"step-3-include-updated-forms\",\"text\":\"Step 3: Include Updated Forms\",\"level\":3},{\"id\":\"step-4-file-electronically-or-by-mail\",\"text\":\"Step 4: File Electronically or by Mail\",\"level\":3},{\"id\":\"how-to-check-amended-tax-return-status\",\"text\":\"How to Check Amended Tax Return Status\",\"level\":2},{\"id\":\"online-tool\",\"text\":\"Online Tool\",\"level\":3},{\"id\":\"by-phone\",\"text\":\"By Phone\",\"level\":3},{\"id\":\"important-don-t-use-where-s-my-refund\",\"text\":\"Important: Don't Use \\\"Where's My Refund?\\\"\",\"level\":3},{\"id\":\"how-long-does-an-amended-return-take\",\"text\":\"How Long Does an Amended Return Take?\",\"level\":2},{\"id\":\"amended-return-deadlines\",\"text\":\"Amended Return Deadlines\",\"level\":2},{\"id\":\"does-amending-trigger-an-audit\",\"text\":\"Does Amending Trigger an Audit?\",\"level\":2},{\"id\":\"what-if-you-owe-more-tax\",\"text\":\"What If You Owe More Tax?\",\"level\":2},{\"id\":\"amending-for-obbba-tax-changes\",\"text\":\"Amending for OBBBA Tax Changes\",\"level\":2},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"related-resources\",\"text\":\"Related Resources\",\"level\":2},{\"id\":\"sources\",\"text\":\"Sources\",\"level\":2}]}]}]}],\"$L29\"]}],\"$L2a\"]}]\n24:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"IL Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/texas-tax-calculator\