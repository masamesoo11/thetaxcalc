,\"level\":2},{\"id\":\"questions-to-ask-a-potential-tax-preparer\",\"text\":\"Questions to Ask a Potential Tax Preparer\",\"level\":2},{\"id\":\"how-much-does-a-tax-preparer-cost\",\"text\":\"How Much Does a Tax Preparer Cost?\",\"level\":2},{\"id\":\"what-affects-the-cost\",\"text\":\"What Affects the Cost?\",\"level\":3},{\"id\":\"free-tax-preparation-options\",\"text\":\"Free Tax Preparation Options\",\"level\":2},{\"id\":\"vita-volunteer-income-tax-assistance\",\"text\":\"VITA (Volunteer Income Tax Assistance)\",\"level\":3},{\"id\":\"tce-tax-counseling-for-the-elderly\",\"text\":\"TCE (Tax Counseling for the Elderly)\",\"level\":3},{\"id\":\"irs-free-file\",\"text\":\"IRS Free File\",\"level\":3},{\"id\":\"how-to-verify-a-tax-preparer-s-credentials\",\"text\":\"How to Verify a Tax Preparer's Credentials\",\"level\":2},{\"id\":\"check-ptin\",\"text\":\"Check PTIN\",\"level\":3},{\"id\":\"verify-cpa-license\",\"text\":\"Verify CPA License\",\"level\":3},{\"id\":\"verify-ea-status\",\"text\":\"Verify EA Status\",\"level\":3},{\"id\":\"verify-attorney-license\",\"text\":\"Verify Attorney License\",\"level\":3},{\"id\":\"what-to-bring-to-your-tax-preparer\",\"text\":\"What to Bring to Your Tax Preparer\",\"level\":2},{\"id\":\"when-should-you-hire-a-tax-preparer-vs-use-software\",\"text\":\"When Should You Hire a Tax Preparer vs. Use Software?\",\"level\":2},{\"id\":\"use-tax-software-if\",\"text\":\"Use Tax Software If:\",\"level\":3},{\"id\":\"hire-a-tax-preparer-if\",\"text\":\"Hire a Tax Preparer If:\",\"level\":3},{\"id\":\"how-obbba-2026-changes-affect-tax-preparation\",\"text\":\"How OBBBA 2026 Changes Affect Tax Preparation\",\"level\":2},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"related-resources\",\"text\":\"Related Resources\",\"level\":2},{\"id\":\"sources\",\"text\":\"Sources\",\"level\":2}]}]}]}],\"$L29\"]}],\"$L2a\"]}]\n24:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 