en\":[\"$\",\"$Le\",null,{\"entries\":[{\"id\":\"types-of-tax-preparers-what-s-the-difference\",\"text\":\"Types of Tax Preparers: What's the Difference?\",\"level\":2},{\"id\":\"which-type-do-you-need\",\"text\":\"Which Type Do You Need?\",\"level\":3},{\"id\":\"how-to-find-the-best-tax-preparer-near-you\",\"text\":\"How to Find the Best Tax Preparer Near You\",\"level\":2},{\"id\":\"1-start-with-the-irs-directory\",\"text\":\"1. Start with the IRS Directory\",\"level\":3},{\"id\":\"2-check-professional-organizations\",\"text\":\"2. Check Professional Organizations\",\"level\":3},{\"id\":\"3-ask-for-referrals\",\"text\":\"3. Ask for Referrals\",\"level\":3},{\"id\":\"4-search-best-tax-preparer-near-me\",\"text\":\"4. Search \\\"Best Tax Preparer Near Me\\\"\",\"level\":3},{\"id\":\"red-flags-how-to-avoid-bad-tax-preparers\",\"text\":\"Red Flags: How to Avoid Bad Tax Preparers\",\"level\":2},{\"id\":\"questions-to-ask-a-potential-tax-preparer\",\"text\":\"Questions to Ask a Potential Tax Preparer\",\"level\":2},{\"id\":\"how-much-does-a-tax-preparer-cost\",\"text\":\"How Much Does a Tax Preparer Cost?\",\"level\":2},{\"id\":\"what-affects-the-cost\",\"text\":\"What Affects the Cost?\",\"level\":3},{\"id\":\"free-tax-preparation-options\",\"text\":\"Free Tax Preparation Options\",\"level\":2},{\"id\":\"vita-volunteer-income-tax-assistance\",\"text\":\"VITA (Volunteer Income Tax Assistance)\",\"level\":3},{\"id\":\"tce-tax-counseling-for-the-elderly\",\"text\":\"TCE (Tax Counseling for the Elderly)\",\"level\":3},{\"id\":\"irs-free-file\",\"text\":\"IRS Free File\",\"level\":3},{\"id\":\"how-to-verify-a-tax-preparer-s-credentials\",\"text\":\"How to Verify a Tax Preparer's Credentials\",\"level\":2},{\"id\":\"check-ptin\",\"text\":\"Check PTIN\",\"level\":3},{\"id\":\"verify-cpa-license\",\"text\":\"Verify CPA License\",\"level\":3},{\"id\":\"verify-ea-status\",\"text\":\"Verify EA Status\",\"level\":3},{\"id\":\"verify-attorney-license\",\"text\":\"Verify Attorney License\",\"level\":3},{\"id\":\"what-to-bring-to-your-tax-preparer\",\"text\":\"What to Bring to Your Tax Preparer\",\"level\":2},{\"id\":\"when-should-you-hire-a-tax-preparer-vs-use-software\",\"text\":\"When Should You Hire a Tax Preparer vs. Use Software?\",\"level\":2},{\"id\":\"use-tax-software-if\",\"text\":\"Use Tax Software If:\",\"level\":3},{\"id\":\"hire-a-tax-preparer-if\",\"text\":\"Hire a Tax Preparer If:\",\"level\":3},{\"id\":\"how-obbba-2026-changes-affect-tax-preparation\",\"text\":\"How OBBBA 2026 Changes Affect Tax Preparation\",\"level\":2},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"related-resources\",\"text\":\"Related Resources\",\"level\":2},{\"id\":\"sources\",\"text\":\"Sources\",\"level\":2}]}]}]}],\"$Lf\"]}],\"$L10\"]}]\n8:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\"