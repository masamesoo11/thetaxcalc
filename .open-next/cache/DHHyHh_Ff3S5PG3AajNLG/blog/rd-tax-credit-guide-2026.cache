\"r-d-tax-credit-qualification-criteria\",\"text\":\"R&D Tax Credit Qualification Criteria\",\"level\":2},{\"id\":\"1-permitted-purpose\",\"text\":\"1. Permitted Purpose\",\"level\":3},{\"id\":\"2-technological-in-nature\",\"text\":\"2. Technological in Nature\",\"level\":3},{\"id\":\"3-process-of-experimentation\",\"text\":\"3. Process of Experimentation\",\"level\":3},{\"id\":\"4-substantial-uncertainty\",\"text\":\"4. Substantial Uncertainty\",\"level\":3},{\"id\":\"what-expenses-qualify-for-r-d-credit\",\"text\":\"What Expenses Qualify for R&D Credit?\",\"level\":2},{\"id\":\"important-time-tracking\",\"text\":\"Important: Time Tracking\",\"level\":3},{\"id\":\"r-d-credit-for-startups-payroll-tax-offset\",\"text\":\"R&D Credit for Startups: Payroll Tax Offset\",\"level\":2},{\"id\":\"how-to-calculate-the-r-d-credit\",\"text\":\"How to Calculate the R&D Credit\",\"level\":2},{\"id\":\"common-industries-that-qualify\",\"text\":\"Common Industries That Qualify\",\"level\":2},{\"id\":\"documentation-requirements\",\"text\":\"Documentation Requirements\",\"level\":2},{\"id\":\"how-to-claim-the-r-d-credit\",\"text\":\"How to Claim the R&D Credit\",\"level\":2},{\"id\":\"state-r-d-credits\",\"text\":\"State R&D Credits\",\"level\":2},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"related-resources\",\"text\":\"Related Resources\",\"level\":2},{\"id\":\"sources\",\"text\":\"Sources\",\"level\":2}]}]}]}],\"$Le\"]}],\"$Lf\"]}]\n7:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n8:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"IL Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/texas-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"TX Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/florida-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"FL Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/self-employment-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Self-Employment\"}],[\"$\",\"$L3\",null,{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L3\",null,{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/compare\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare Salaries\"}],[\"$\",\"$L3\",null,{\"href\":\"/glossary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Glossary\"}],[\"$\",\"$L3\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Federal Tax Brackets\"}]]}]]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-border/50 bg-muted/30 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Popular Salary Calculations\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"Quick access to take-home pay estimates for common salary levels.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L3\",\"/salary/50000\",{\"href\":\"/salary/50000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$50,000\"}],[\"$\",\"$L3\",\"/salary/75000\",{\"href\":\"/salary/75000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$75,000\"}],[\"$\",\"$L3\",\"/salary/100000\",{\"href\":\"/salary/100000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$100,000\"}],[\"$\",\"$L3\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$150,000\"}],[\"$\",\"$L3\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$200,000\"}]]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L3\",\"obbba-tax-refund-impact-2026\",{\"href\":\"/blog/obbba-tax-refund-impact-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"July 4, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"OBBBA Tax Refund Impact 2026: How the New Tax Law Changes Your Refund\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"See exactly how the One Big Beautiful Bill Act (OBBBA) changes your 2026 tax refund. New SALT cap, doubled Child Tax Credit, tip/overtime deductions, and worked examples comparing OBBBA vs prior law.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"OBBBA 2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"OBBBA 2026\"}],[\"$\",\"span\",\"One Big Beautiful Bill Act\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"One Big Beautiful Bill Act\"}],[\"$\",\"span\",\"OBBBA tax refund\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"OBBBA tax refund\"}]]}]]}],[\"$\",\"$L3\",\"2026-self-employed-tax-refund-calculator\",{\"href\":\"/blog/2026-self-employed-tax-refund-calculator\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"July 4, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Self-Employed Tax Refund Calculator 2026: SE Tax, Quarterly Payments & Deductions\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete 2026 tax refund guide for self-employed workers, freelancers, and contractors. Calculate SE tax, quarterly estimated payments, business deductions, and your expected refund with worked examples.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"self-employed tax refund 2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"self-employed tax refund 2026\"}],[\"$\",\"span\",\"self-employment tax calculator\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"self-employment tax calculator\"}],\"$L10\"]}]]}],\"$L11\"]}]]}]\nb:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2d86c01f2aacd453.js\",\"async\":true}]\nc:[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@14\"}]}]\n15:T26f9,<p>The Research and Development (R&D) Tax Credit is one of the most valuable — and most overlooked — tax incentives available to U.S. businesses. Worth up to 10% of qualified research expenses, it can mean tens of thousands of dollars in savings for startups and established companies alike. Yet many businesses never claim it because they assume R&D means lab coats and test tubes.</p><p>In reality, if your company develops new software, improves manufacturing processes, or even creates better internal tools, you may qualify. This guide breaks down the R&D tax credit qualification criteria for startups in 2026.</p><h2 id=\"what-is-the-r-d-tax-credit\">What Is the R&D Tax Credit?</h2><p>The R&D Tax Credit (Internal Revenue Code Section 41) rewards companies for investing in research and development. It provides a <strong>dollar-for-dollar reduction</strong> in federal income tax liability for qualified research expenses (QREs).</p><p>For 2026, the credit is worth:</p><ul><li><strong>20% of QREs</strong> above a base amount (regular method)</li><li><strong>14% of QREs</strong> (alternative simplified method — more common for startups)</li></ul><h3 id=\"r-d-credit-under-obbba-2026\">R&D Credit Under OBBBA 2026</h3><p>The One Big Beautiful Bill Act (OBBBA) made the R&D tax credit <strong>permanent</strong> and preserved the ability for small businesses (under $5M gross receipts) to offset payroll taxes with the credit. This is critical for early-stage startups that don't yet have income tax liability.</p><h2 id=\"r-d-tax-credit-qualification-criteria\">R&D Tax Credit Qualification Criteria</h2><p>To qualify for the R&D tax credit, your activities must meet a <strong>four-part test</strong> established by the IRS:</p><h3 id=\"1-permitted-purpose\">1. Permitted Purpose</h3><p>The research must be intended to create a <strong>new or improved business component</strong> — a product, process, software, technique, or formula. The improvement can be in function, performance, reliability, or quality.</p><p><strong>Examples that qualify:</strong></p><ul><li>Developing a new mobile app feature</li><li>Improving manufacturing efficiency</li><li>Creating proprietary algorithms</li><li>Building internal software tools</li><li>Designing new product prototypes</li></ul><h3 id=\"2-technological-in-nature\">2. Technological in Nature</h3><p>The research must rely on <strong>principles of hard sciences</strong> — engineering, computer science, physics, chemistry, or biology. This means you must be solving technical problems, not just doing routine business work.</p><p><strong>Qualifies:</strong> Solving a scalability problem using distributed systems architecture <strong>Doesn't qualify:</strong> A/B testing marketing copy</p><h3 id=\"3-process-of-experimentation\">3. Process of Experimentation</h3><p>You must engage in a <strong>systematic process</strong> to evaluate alternatives. This includes:</p><ul><li>Hypothesis development</li><li>Testing and analysis</li><li>Refining based on results</li><li>Iterative development cycles (agile methodology counts)</li></ul><h3 id=\"4-substantial-uncertainty\">4. Substantial Uncertainty</h3><p>The activity must involve uncertainty about:</p><ul><li>Whether the development is <strong>possible</strong> (can we build this?)</li><li>How to <strong>achieve</strong> the desired result (which approach works?)</li><li>The <strong>optimal design</strong> (what's the best architecture?)</li></ul><p>If the solution is obvious or available off-the-shelf, it doesn't qualify.</p><h2 id=\"what-expenses-qualify-for-r-d-credit\">What Expenses Qualify for R&D Credit?</h2><p>Qualified Research Expenses (QREs) fall into three categories:</p><div class=\"table-wrapper\"><table><thead><tr><th>Category</th><th>What's Included</th><th>Typical % of Claim</th></tr></thead><tbody><tr><td><strong>Wages</strong></td><td>Engineers, developers, designers working directly on R&D</td><td>70-80%</td></tr><tr><td><strong>Supplies</strong></td><td>Materials consumed during testing and prototyping</td><td>5-10%</td></tr><tr><td><strong>Contract Research</strong></td><td>Third-party contractors doing qualified work</td><td>10-20%</td></tr></tbody></table></div><h3 id=\"important-time-tracking\">Important: Time Tracking</h3><p>For wages, only the time spent <strong>directly engaged in qualified research</strong> counts. The IRS expects you to have a reasonable method for tracking this — time sheets, project management tools, or estimates based on project allocation.</p><h2 id=\"r-d-credit-for-startups-payroll-tax-offset\">R&D Credit for Startups: Payroll Tax Offset</h2><p>Since 2016, qualifying small businesses can use the R&D credit to offset <strong>payroll tax liability</strong> (OASDI/Social Security) instead of income tax. This is game-changing for pre-revenue startups.</p><p><strong>Qualification for payroll tax offset:</strong></p><ul><li>Gross receipts under <strong>$5 million</strong> in the current year</li><li>No gross receipts more than 5 years ago (essentially, a startup under 5 years old)</li></ul><p><strong>Maximum offset:</strong> Up to <strong>$500,000</strong> per year in payroll taxes</p><p>This means a startup with no revenue but significant R&D spending can still benefit from the credit.</p><h2 id=\"how-to-calculate-the-r-d-credit\">How to Calculate the R&D Credit</h2><p>Most startups use the <strong>Alternative Simplified Credit (ASC)</strong> method because it's easier and often more favorable:</p><ol><li>Calculate average QREs from the prior 3 years</li><li>Multiply that average by 50%</li><li>Subtract step 2 from current-year QREs</li><li>Multiply the result by <strong>14%</strong></li></ol><p>If current QREs exceed the 50% base, the credit is 14% of the difference. If you have no prior 3-year history (common for new startups), the base is zero and the credit is 6% of QREs.</p><p><strong>Example: First-year startup</strong></p><ul><li>QREs (developer wages): $300,000</li><li>Prior 3-year average: $0 (new company)</li><li>Base amount: $0</li><li>Credit: $300,000 × 6% = <strong>$18,000</strong></li></ul><h2 id=\"common-industries-that-qualify\">Common Industries That Qualify</h2><p>You don't need to be a biotech company to claim R&D credit. These industries frequently qualify:</p><ul><li><strong>Software/SaaS</strong> — Building new features, scaling infrastructure, developing algorithms</li><li><strong>Manufacturing</strong> — Process improvements, new product design, automation</li><li><strong>Engineering</strong> — Structural design, prototyping, testing</li><li><strong>Agriculture</strong> — Crop yield improvement, new processing methods</li><li><strong>Financial Services</strong> — Quantitative modeling, trading algorithms</li><li><strong>Healthcare</strong> — Medical device development, health informatics</li></ul><h2 id=\"documentation-requirements\">Documentation Requirements</h2><p>The IRS doesn't require specific forms during the year, but you should maintain:</p><ol><li><strong>Project lists</strong> — What R&D projects were undertaken</li><li><strong>Time allocation</strong> — How employees divided time between projects</li><li><strong>Technical narratives</strong> — What uncertainties were being resolved</li><li><strong>Financial records</strong> — Wages, supplies, contractor invoices</li><li><strong>Contemporaneous evidence</strong> — Git commits, design docs, project tickets</li></ol><h2 id=\"how-to-claim-the-r-d-credit\">How to Claim the R&D Credit</h2><ol><li><strong>File Form 6765</strong> — Credit for Increasing Research Activities</li><li><strong>Attach to your business tax return</strong> (Form 1120, 1065, or 1040 Schedule C)</li><li><strong>For payroll tax offset</strong> — File Form 8974 and attach to Form 941</li></ol><p>We strongly recommend working with a CPA or R&D credit specialist for your first claim. The documentation requirements are strict, and IRS audits of R&D claims have increased.</p><h2 id=\"state-r-d-credits\">State R&D Credits</h2><p>Many states offer their own R&D tax credits in addition to the federal credit. States with notable R&D credits include:</p><ul><li><strong>California</strong> — 24% of QREs above base, or 15% flat</li><li><strong>New York</strong> — 9% of QREs above base</li><li><strong>Texas</strong> — 5% of QREs (no franchise tax for some)</li><li><strong>Massachusetts</strong> — 10% of QREs above base</li></ul><p>Check with your state's revenue department for specific rules.</p><h2 id=\"frequently-asked-questions\">Frequently Asked Questions</h2><p><strong>Do I need to be profitable to claim the R&D credit?</strong> No. Startups can carry the credit forward 20 years or use it to offset payroll taxes (if eligible).</p><p><strong>Can I claim R&D credit for previous years?</strong> Yes. You can amend returns going back 3 years to claim missed R&D credits.</p><p><strong>How much can a typical startup claim?</strong> Most software startups with 3-10 engineers can claim $20,000-$100,000+ annually in R&D credits.</p><p><strong>Is the R&D credit taxable income?</strong> No. It's a credit that reduces tax liability directly, not taxable income.</p><h2 id=\"related-resources\">Related Resources</h2><ul><li><a href=\"/self-employment-tax-calculator\">Self-Employment Tax Calculator</a> — SE tax with deductions</li><li><a href=\"/blog/2026-federal-tax-brackets-explained\">2026 Tax Brackets</a> — Federal income tax rates</li><li><a href=\"/obbba-tax-calculator\">OBBBA Tax Calculator</a> — 2026 tax law comparison</li><li><a href=\"/tax-refund-calculator\">Tax Refund Calculator</a> — Estimate your refund</li></ul><h2 id=\"sources\">Sources</h2><ol><li>IRS — Form 6765 Instructions (Credit for Increasing Research Activities)</li><li>IRS — Section 41(d) IRC (Research and Experimental Expenditures)</li><li>Treasury Regulations — Section 1.41-4 (Qualified Research)</li><li>Protecting Americans from Tax Hikes (PATH) Act of 2015</li></ol>e:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose-container\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}]}]\nf:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl mt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\",\"children\":\"← Back to Blog\"}]}]\n10:[\"$\",\"span\",\"SE tax 2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"SE tax 2026\"}]\n11:[\"$\",\"$L3\",\"2026-w2-tax-refund-calculator-guide\",{\"href\":\"/blog/2026-w2-tax-refund-calculator-guide\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"July 4, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"W-2 Employees: 2026 Tax Refund Calculator Guide With Exact Numbers\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete 2026 W-2 tax refund guide for employees. How to read your W-2, calculate federal withholding, apply 2026 brackets, and estimate your refund with worked examples.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"W-2 tax refund calculator 2026\",{\"className\":\"inline-flex items-center rounde