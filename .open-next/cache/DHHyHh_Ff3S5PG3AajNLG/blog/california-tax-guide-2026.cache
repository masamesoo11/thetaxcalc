d-500/30 transition-colors\",\"children\":\"FL Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/self-employment-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Self-Employment\"}],[\"$\",\"$L11\",null,{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L11\",null,{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/compare\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare Salaries\"}],[\"$\",\"$L11\",null,{\"href\":\"/glossary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Glossary\"}],[\"$\",\"$L11\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Federal Tax Brackets\"}]]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-border/50 bg-muted/30 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Popular Salary Calculations\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"Quick access to take-home pay estimates for common salary levels.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",\"/salary/50000\",{\"href\":\"/salary/50000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$50,000\"}],[\"$\",\"$L11\",\"/salary/75000\",{\"href\":\"/salary/75000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$75,000\"}],[\"$\",\"$L11\",\"/salary/100000\",{\"href\":\"/salary/100000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$100,000\"}],[\"$\",\"$L11\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$150,000\"}],[\"$\",\"$L11\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$200,000\"}]]}]]}]\n26:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L11\",\"new-york-tax-guide-2026\",{\"href\":\"/blog/new-york-tax-guide-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-800 dark:bg-violet-500/20 dark:text-violet-400 border-violet-300 dark:border-violet-500/30\",\"children\":\"State Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 19, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"New York State Taxes 2026: NYC Tax, Filing, and What You Owe\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete guide to New York taxes in 2026. NYC tax rates, state income tax brackets, estate tax, and filing.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"new york tax calculator\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"new york tax calculator\"}],[\"$\",\"span\",\"nyc tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"nyc tax\"}],[\"$\",\"span\",\"york state taxes\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"york state taxes\"}]]}]]}],[\"$\",\"$L11\",\"texas-tax-guide-2026\",{\"href\":\"/blog/texas-tax-guide-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-800 dark:bg-violet-500/20 dark:text-violet-400 border-violet-300 dark:border-violet-500/30\",\"children\":\"State Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 19, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Texas Tax Guide 2026: No Income Tax, But What About Property and Sales Tax?\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Texas has no state income tax, but property tax is among the highest. Complete guide to Texas taxes in 2026.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"texas tax calculator\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"texas tax calculator\"}],[\"$\",\"span\",\"income tax in texas\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"income tax in texas\"}],[\"$\",\"span\",\"taxable income\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"taxable income\"}]]}]]}],[\"$\",\"$L11\",\"washington-tax-guide-2026\",{\"href\":\"/blog/washington-tax-guide-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\"]}]]}]]}]\n2e:T3ac0,<p>California has the highest top marginal income tax rate in the country, and understanding how much you'll actually pay can feel overwhelming. But once you break it down into income tax, sales tax, and local rates, the picture becomes much clearer. Let's walk through everything you need to know about the tax amount in California for 2026.</p><h2 id=\"california-income-tax-rates-for-2026\">California Income Tax Rates for 2026</h2><p>California uses a progressive income tax system with ten brackets, ranging from 1% to 13.3%. Unlike states with a flat tax, California's system means the more you earn, the higher your marginal rate — but only on the income within each bracket.</p><h3 id=\"2026-california-income-tax-brackets-single-filer\">2026 California Income Tax Brackets (Single Filer)</h3><div class=\"table-wrapper\"><table><thead><tr><th>Tax Rate</th><th>Taxable Income Range</th></tr></thead><tbody><tr><td>1%</td><td>$0 – $10,756</td></tr><tr><td>2%</td><td>$10,757 – $25,499</td></tr><tr><td>4%</td><td>$25,500 – $40,245</td></tr><tr><td>6%</td><td>$40,246 – $55,866</td></tr><tr><td>8%</td><td>$55,867 – $70,606</td></tr><tr><td>9.3%</td><td>$70,607 – $360,659</td></tr><tr><td>10.3%</td><td>$360,660 – $432,787</td></tr><tr><td>11.3%</td><td>$432,788 – $721,314</td></tr><tr><td>12.3%</td><td>$721,315 – $1,000,000</td></tr><tr><td>13.3%</td><td>Over $1,000,000</td></tr></tbody></table></div><p>The income tax rate you pay depends on where your income falls within these brackets. A single filer making $75,000 doesn't pay 9.3% on everything — they pay 1% on the first $10,756, 2% on the next portion, and so on. The result is an effective rate much lower than the top marginal rate.</p><p>Use our <a href=\"/california-tax-calculator\">California tax calculator</a> to see your exact take-home pay after all California taxes.</p><h2 id=\"understanding-district-taxes-in-california\">Understanding District Taxes in California</h2><p>Here's something that catches a lot of people off guard: California has voter-approved <strong>district taxes</strong> that add to the state income tax rate. These are additional taxes passed by local voters to fund specific programs, and they vary by location.</p><p>As of 2026, most California residents pay an additional 1% to 2% in district taxes on top of the state income tax rate. The rates range from 0% in some areas to over 3% in others. When you see the rates range across the state, it's because different districts have approved different measures.</p><p>If you live in Los Angeles, San Francisco, or most major cities, expect to pay at least 1% extra in district taxes. This is separate from — and in addition to — the state income tax brackets shown above.</p><h2 id=\"california-sales-tax-rate-what-you-pay-at-the-register\">California Sales Tax Rate: What You Pay at the Register</h2><p>California's state sales tax rate is 7.25%, which is already among the highest in the nation. But that's just the state portion. Local sales tax add-ons can push the total much higher.</p><h3 id=\"combined-sales-tax-rates-in-major-california-cities\">Combined Sales Tax Rates in Major California Cities</h3><div class=\"table-wrapper\"><table><thead><tr><th>City</th><th>Combined Sales Tax Rate</th></tr></thead><tbody><tr><td>Los Angeles</td><td>9.5%</td></tr><tr><td>San Francisco</td><td>8.625%</td></tr><tr><td>San Diego</td><td>7.75%</td></tr><tr><td>San Jose</td><td>9.375%</td></tr><tr><td>Sacramento</td><td>8.75%</td></tr></tbody></table></div><p>The local sales tax varies by city and county because voters in each area can approve additional sales tax measures. This is why the sales tax rate you pay in one city can be significantly different from a neighboring city.</p><p>Some items are exempt from sales tax in California, including most groceries (unprepared food), prescription drugs, and certain clothing items. But restaurant meals, electronics, and most retail purchases are fully taxable.</p><h2 id=\"city-tax-and-additional-local-taxes\">City Tax and Additional Local Taxes</h2><p>Beyond income tax and sales tax, some California cities impose additional taxes. San Francisco, for example, has several special taxes including a gross receipts tax for businesses and various parcel taxes for property owners. These city tax measures are typically voter-approved and fund specific municipal services.</p><p>If you're a business owner in California, you'll also need to consider the state's $800 minimum franchise tax for LLCs and corporations, plus any local business license taxes.</p><h2 id=\"how-to-calculate-your-total-tax-amount-in-california\">How to Calculate Your Total Tax Amount in California</h2><p>To figure out your total tax burden in California, you need to add up:</p><ol><li><strong>Federal income tax</strong> (based on federal brackets)</li><li><strong>FICA taxes</strong> (Social Security 6.2% + Medicare 1.45%)</li><li><strong>California state income tax</strong> (1% to 13.3% based on brackets)</li><li><strong>District taxes</strong> (0% to 3% depending on location)</li><li><strong>Sales tax</strong> (7.25% to 10.5% depending on city, on taxable purchases)</li><li><strong>Property tax</strong> (approximately 0.71% average effective rate)</li></ol><p>For a single person earning $75,000 in Los Angeles, the breakdown looks roughly like this:</p><ul><li>Federal income tax: ~$11,414</li><li>FICA: ~$5,738</li><li>California state income tax: ~$3,200</li><li>District taxes: ~$750</li><li>Sales tax (estimated): ~$2,000</li><li><strong>Total tax burden</strong>: ~$23,102 (about 30.8% of gross income)</li></ul><h2 id=\"california-tax-credits-you-should-know-about\">California Tax Credits You Should Know About</h2><p>California offers several tax credits that can reduce your state tax bill:</p><ul><li><strong>California Earned Income Tax Credit</strong>: Similar to the federal EITC, for low-to-moderate income workers</li><li><strong>Young Child Tax Credit</strong>: Up to $1,083 for families with children under 6</li><li><strong>Renter's Credit</strong>: $60 (single) or $120 (married) for qualified renters</li><li><strong>College Access Tax Credit</strong>: For contributions to California college funds</li></ul><p>These credits are in addition to federal tax credits, and they can significantly reduce your overall tax burden.</p><h2 id=\"state-and-local-tax-deduction-cap\">State and Local Tax Deduction Cap</h2><p>Remember that the federal Tax Cuts and Jobs Act capped the state and local tax (SALT) deduction at $10,000. This means even if you pay $15,000 in California state income tax and property tax combined, you can only deduct $10,000 on your federal return. This cap hits California residents particularly hard because of the high state and local tax rates.</p><h2 id=\"comparing-california-to-other-states\">Comparing California to Other States</h2><p>California's total tax burden is among the highest in the nation. A single person earning $75,000 in California pays roughly $3,200 in state income tax alone, while the same person in Texas or Washington would pay $0 in state income tax. Use our <a href=\"/compare\">comparison tools</a> to see how California stacks up against other states.</p><p>The trade-off, of course, is that California offers high wages, strong job markets, and extensive public services. But if you're considering a move, the tax savings from relocating to a no-income-tax state can be substantial — often $5,000 to $15,000+ per year.</p><h2 id=\"plan-your-california-taxes\">Plan Your California Taxes</h2><p>Use our <a href=\"/california-tax-calculator\">California Tax Calculator</a> to get an accurate estimate of your take-home pay after all California taxes. The calculator factors in state income tax, district taxes, and FICA to give you the full picture.</p><h2 id=\"california-tax-rates-2025-vs-2026-what-changed\">California Tax Rates 2025 vs 2026: What Changed?</h2><p>If you're comparing California tax rates 2025 with 2026, the brackets haven't changed structurally — California still uses the same ten-bracket progressive system. However, the income thresholds for each bracket are adjusted annually for inflation.</p><p>The California tax rate schedule 2026 reflects slightly higher bracket thresholds than 2025, meaning some filers will pay slightly less tax on the same income. The standard deduction and personal exemption also increased marginally.</p><h3 id=\"key-california-tax-rate-schedule-changes\">Key California Tax Rate Schedule Changes</h3><p>For 2026, the California standard deduction is approximately $5,540 (single) and $11,080 (married filing jointly), up from $5,363 (single) and $10,726 (MFJ) in 2025.</p><p>If you filed using California tax rates 2025 and want to compare, your 2026 bill should be very similar — possibly a few hundred dollars lower on the same income.</p><h2 id=\"los-angeles-sales-tax-and-san-francisco-income-tax\">Los Angeles Sales Tax and San Francisco Income Tax</h2><p>California's local taxes vary significantly by city. Here's what you need to know about the two biggest markets:</p><h3 id=\"los-angeles-sales-tax\">Los Angeles Sales Tax</h3><p>Los Angeles sales tax is currently 9.5% (combined state + county + local). This is one of the highest rates in California. If you're shopping in LA, expect to pay nearly 10% on most retail purchases. The Los Angeles sales tax funds county transportation, local schools, and city services.</p><h3 id=\"san-francisco-income-tax\">San Francisco Income Tax</h3><p>San Francisco doesn't have a separate city income tax (unlike NYC). However, San Francisco income tax is effectively the California state income tax plus any district taxes that apply to SF residents. The combined state + district rate for San Francisco is approximately 1.5% additional on top of the state brackets.</p><p>San Francisco also imposes a Gross Receipts Tax on businesses, which is separate from personal income tax. Use our <a href=\"/california-tax-calculator\">California tax calculator</a> to see your exact SF tax burden.</p><h2 id=\"california-sales-tax-on-cars-by-county-and-by-zip-code\">California Sales Tax on Cars, by County, and by Zip Code</h2><h3 id=\"california-sales-tax-on-cars\">California Sales Tax on Cars</h3><p>California sales tax on cars follows the same rate as general sales tax, based on where you register the vehicle (not where you buy it). So if you live in Los Angeles (9.5%), you pay 9.5% sales tax on a car purchase, even if you buy it in a lower-tax county. This can add thousands to your car purchase — on a $40,000 vehicle in LA, that's $3,800 in sales tax.</p><h3 id=\"california-sales-tax-by-county\">California Sales Tax by County</h3><p>California sales tax by county ranges from 7.25% (base state rate in some rural areas) to 10.75% (in some Bay Area cities). The variation comes from voter-approved local measures. Here's a quick reference:</p><ul><li><strong>Los Angeles County</strong>: 9.5%</li><li><strong>San Francisco County</strong>: 8.625%</li><li><strong>San Diego County</strong>: 7.75%</li><li><strong>Orange County</strong>: 7.75% - 8.25%</li><li><strong>Alameda County</strong>: 10.75% (highest)</li></ul><h3 id=\"california-sales-tax-by-zip-code\">California Sales Tax by Zip Code</h3><p>For exact California sales tax by zip code, the CDTFA (California Department of Tax and Fee Administration) provides an official lookup tool. Rates can vary even within the same city, so always verify your specific zip code. Our <a href=\"/sales-tax-calculator\">sales tax calculator</a> handles this automatically.</p><h2 id=\"california-tax-calculator-for-1099-and-self-employed-workers\">California Tax Calculator for 1099 and Self-Employed Workers</h2><p>If you receive a 1099 or are self-employed in California, your tax situation is more complex. You'll pay:</p><ol><li><strong>Federal income tax</strong> (based on federal brackets)</li><li><strong>Self-employment tax</strong> (15.3% on 92.35% of net income)</li><li><strong>California state income tax</strong> (1% to 13.3% based on brackets)</li><li><strong>California district taxes</strong> (varies by location)</li></ol><p>A tax calculator California 1099 tool should factor in all four layers. Use our <a href=\"/self-employment-tax-calculator\">self-employment tax calculator</a> for the federal + SE tax portion, then add California state tax using our <a href=\"/california-tax-calculator\">California tax calculator</a>.</p><p>For a $100,000 1099 income in California (single filer in Los Angeles):</p><ul><li>Federal income tax: ~$14,000</li><li>Self-employment tax: ~$14,100</li><li>California state income tax: ~$6,800</li><li>District taxes: ~$1,000</li><li><strong>Total tax</strong>: ~$35,900 (about 35.9% of income)</li></ul><h2 id=\"frequently-asked-questions-about-california-taxes\">Frequently Asked Questions About California Taxes</h2><h3 id=\"how-much-is-100-000-income-taxed-in-california\">How much is $100,000 income taxed in California?</h3><p>On $100,000 income in California (single filer), you'll pay approximately $6,800 in state income tax, plus $14,000 in federal income tax, and $7,650 in FICA. Your total tax burden is about $28,450, leaving you with roughly $71,550 in take-home pay. Use our <a href=\"/california-tax-calculator\">California tax calculator</a> for exact numbers.</p><h3 id=\"how-much-is-california-state-tax-on-200-000-income\">How much is California state tax on $200,000 income?</h3><p>On $200,000 income in California (single filer), state income tax alone is approximately $17,500. Add federal tax (~$42,000), FICA (~$10,500), and district taxes (~$2,000), and your total tax burden is roughly $72,000 — about 36% of your income.</p><h3 id=\"how-much-is-70-000-a-year-after-taxes-in-california\">How much is $70,000 a year after taxes in California?</h3><p>On $70,000 salary in California (single filer in LA), your take-home pay is approximately $50,500 after federal tax ($8,900), FICA ($5,355), state tax ($2,900), and district taxes ($350). That's an effective tax rate of about 27.8%.</p><h3 id=\"is-california-sales-tax-10\">Is California sales tax 10%?</h3><p>California sales tax can reach 10% or higher in some cities. The state base rate is 7.25%, but local add-ons push the combined rate to 10.75% in some areas (like Albany in Alameda County). Most major cities are between 8.5% and 9.75%.</p><h3 id=\"does-california-have-a-50-income-tax\">Does California have a 50% income tax?</h3><p>No, California does not have a 50% income tax. The top marginal state rate is 13.3%, which applies to income over $1,000,000. However, when combined with the 37% federal top rate, the total marginal rate for very high earners can exceed 50% on the top dollars earned.</p><h3 id=\"are-california-taxes-high\">Are California taxes high?</h3><p>Yes, California has the highest top marginal income tax rate in the nation (13.3%) and above-average sales tax rates. The overall tax burden in California is approximately 11.49% of income, ranking among the top 5 highest-tax states in the US.</p>28:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose-container\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2e\"}}]}]\n29:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl mt-8\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/blog\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\",\"children\":\"← Back to Blog\"}]}]\n2a:[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-800 dark:bg-violet-500/20 dark:text-violet-400 border-violet-300 dark:border-violet-500/30\",\"children\":\"State Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 19, 2026\"}]]}]\n2b:[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Washington State Tax Guide 2026: No Income Tax, But High Sales Tax\"}]\n2c:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete guide to Washington state taxes in 2026. No income tax, but sales tax up to 10.25%.\"}]\n2d:[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"washington tax calculator\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"washington tax calculator\"}],[\"$\",\"span\",\"tax calculator washington\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"tax calculator washington\"}],[\"$\",\"span\",\"washington sales tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"washington sales tax\"}]]}]\n1c:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2f:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n1a:null\n1e:[[\"$\",\"title\",\"0\",{\"children\":\"California Tax Guide 2026: Income Tax, Sales Tax & Local Rates | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Complete guide to California taxes in 2026. Income tax rates 1%-13.3%, sales tax rates by city, district taxes.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\