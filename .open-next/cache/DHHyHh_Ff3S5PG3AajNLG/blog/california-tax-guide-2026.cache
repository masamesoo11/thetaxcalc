\",\"type\":\"font/woff2\"}]\n3:T670,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}0:{\"P\":null,\"b\":\"DHHyHh_Ff3S5PG3AajNLG\",\"c\":[\"\",\"blog\",\"california-tax-guide-2026\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"blog\",{\"c