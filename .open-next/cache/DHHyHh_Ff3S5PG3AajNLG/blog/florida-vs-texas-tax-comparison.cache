 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n23:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"IL Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/texas-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"TX Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/florida-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"FL Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/self-employment-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Self-Employment\"}],[\"$\",\"$L11\",null,{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L11\",null,{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/compare\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare Salaries\"}],[\"$\",\"$L11\",null,{\"href\":\"/glossary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Glossary\"}],[\"$\",\"$L11\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Federal Tax Brackets\"}]]}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-border/50 bg-muted/30 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Popular Salary Calculations\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"Quick access to take-home pay estimates for common salary levels.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",\"/salary/50000\",{\"href\":\"/salary/50000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$50,000\"}],[\"$\",\"$L11\",\"/salary/75000\",{\"href\":\"/salary/75000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$75,000\"}],[\"$\",\"$L11\",\"/salary/100000\",{\"href\":\"/salary/100000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$100,000\"}],[\"$\",\"$L11\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$150,000\"}],[\"$\",\"$L11\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$200,000\"}]]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L11\",\"why-texas-has-no-income-tax\",{\"href\":\"/blog/why-texas-has-no-income-tax\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-violet-100 text-violet-800 dark:bg-violet-500/20 dark:text-violet-400 border-violet-300 dark:border-violet-500/30\",\"children\":\"State Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"May 26, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Why Texas Has No Income Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"How Texas funds its government without a personal income tax, and what it means for residents in terms of property taxes and overall tax burden.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"texas\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"texas\"}],[\"$\",\"span\",\"no income tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"no income tax\"}],[\"$\",\"span\",\"property tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"property tax\"}]]}]]}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl mt-8\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/blog\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\",\"children\":\"← Back to Blog\"}]}]\n1c:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],