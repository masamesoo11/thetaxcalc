nline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"inflation adjustments\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-5xl lg:flex lg:gap-8\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block lg:w-64 lg:shrink-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-24\",\"children\":[\"$\",\"$Le\",null,{\"entries\":[{\"id\":\"how-federal-tax-brackets-actually-work\",\"text\":\"How Federal Tax Brackets Actually Work\",\"level\":2},{\"id\":\"a-real-world-example\",\"text\":\"A Real-World Example\",\"level\":3},{\"id\":\"2026-federal-income-tax-brackets-for-single-filers\",\"text\":\"2026 Federal Income Tax Brackets for Single Filers\",\"level\":2},{\"id\":\"2026-federal-tax-brackets-for-married-filing-jointly\",\"text\":\"2026 Federal Tax Brackets for Married Filing Jointly\",\"level\":2},{\"id\":\"2026-standard-deduction-your-first-tax-break\",\"text\":\"2026 Standard Deduction: Your First Tax Break\",\"level\":2},{\"id\":\"tax-deductions-vs-tax-credits-what-s-the-difference\",\"text\":\"Tax Deductions vs. Tax Credits: What's the Difference?\",\"level\":2},{\"id\":\"how-inflation-adjustments-affect-your-taxes\",\"text\":\"How Inflation Adjustments Affect Your Taxes\",\"level\":2},{\"id\":\"filing-your-tax-returns-what-you-need-to-know\",\"text\":\"Filing Your Tax Returns: What You Need to Know\",\"level\":2},{\"id\":\"state-and-local-taxes-don-t-forget-these\",\"text\":\"State and Local Taxes: Don't Forget These\",\"level\":2},{\"id\":\"take-control-of-your-2026-taxes\",\"text\":\"Take Control of Your 2026 Taxes\",\"level\":2},{\"id\":\"irs-2026-tax-brackets-compared-to-2025-what-changed\",\"text\":\"IRS 2026 Tax Brackets Compared to 2025: What Changed?\",\"level\":2},{\"id\":\"key-changes-from-2025-to-2026\",\"text\":\"Key Changes from 2025 to 2026\",\"level\":3},{\"id\":\"capital-gains-tax-brackets-2026\",\"text\":\"Capital Gains Tax Brackets 2026\",\"level\":2},{\"id\":\"long-term-capital-gains-rates-for-2026\",\"text\":\"Long-Term Capital Gains Rates for 2026\",\"level\":3},{\"id\":\"social-security-tax-rate-for-2026\",\"text\":\"Social Security Tax Rate for 2026\",\"level\":2},{\"id\":\"2026-fica-tax-rates\",\"text\":\"2026 FICA Tax Rates\",\"level\":3},{\"id\":\"looking-ahead-tax-brackets-2027\",\"text\":\"Looking Ahead: Tax Brackets 2027\",\"level\":2}]}]}]}],\"$Lf\"]}],\"$L10\"]}]\n8:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-wh