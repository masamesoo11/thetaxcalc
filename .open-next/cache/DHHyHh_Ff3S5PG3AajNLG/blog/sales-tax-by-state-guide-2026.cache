",\"text\":\"4. Oregon (OR)\",\"level\":3},{\"id\":\"5-alaska-ak\",\"text\":\"5. Alaska (AK)\",\"level\":3},{\"id\":\"the-highest-sales-tax-states-in-2026\",\"text\":\"The Highest Sales Tax States in 2026\",\"level\":2},{\"id\":\"1-louisiana-combined-rate-up-to-11-45\",\"text\":\"1. Louisiana — Combined Rate Up to 11.45%\",\"level\":3},{\"id\":\"2-tennessee-combined-rate-up-to-9-75\",\"text\":\"2. Tennessee — Combined Rate Up to 9.75%\",\"level\":3},{\"id\":\"3-arkansas-combined-rate-up-to-11-25\",\"text\":\"3. Arkansas — Combined Rate Up to 11.25%\",\"level\":3},{\"id\":\"4-washington-combined-rate-up-to-10-5\",\"text\":\"4. Washington — Combined Rate Up to 10.5%\",\"level\":3},{\"id\":\"5-alabama-combined-rate-up-to-11-0\",\"text\":\"5. Alabama — Combined Rate Up to 11.0%\",\"level\":3},{\"id\":\"top-10-states-by-average-combined-sales-tax-rate\",\"text\":\"Top 10 States by Average Combined Sales Tax Rate\",\"level\":3},{\"id\":\"how-combined-sales-tax-rates-work\",\"text\":\"How Combined Sales Tax Rates Work\",\"level\":2},{\"id\":\"why-combined-rates-vary-so-much-within-a-state\",\"text\":\"Why Combined Rates Vary So Much Within a State\",\"level\":3},{\"id\":\"tax-exempt-items-by-category\",\"text\":\"Tax-Exempt Items by Category\",\"level\":2},{\"id\":\"groceries\",\"text\":\"Groceries\",\"level\":3},{\"id\":\"prescription-drugs\",\"text\":\"Prescription Drugs\",\"level\":3},{\"id\":\"clothing\",\"text\":\"Clothing\",\"level\":3},{\"id\":\"other-common-exemptions\",\"text\":\"Other Common Exemptions\",\"level\":3},{\"id\":\"how-to-calculate-sales-tax\",\"text\":\"How to Calculate Sales Tax\",\"level\":2},{\"id\":\"the-basic-formula\",\"text\":\"The Basic Formula\",\"level\":3},{\"id\":\"example-1-simple-calculation\",\"text\":\"Example 1: Simple Calculation\",\"level\":3},{\"id\":\"example-2-large-purchase-with-special-district-tax\",\"text\":\"Example 2: Large Purchase with Special District Tax\",\"level\":3},{\"id\":\"example-3-tax-exempt-items-in-the-same-t