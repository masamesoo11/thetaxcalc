nk\",\"28\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"29\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2d\",\"30\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n3:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"\"]\nd:I[45026,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"BlogTableOfContents\"]\n11:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n12:\"$Sreact.suspense\"\n2:Tade,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026#article\",\"@type\":\"Article\",\"headline\":\"Sales Tax by State: Complete Guide to US Tax Rates in 2026\",\"description\":\"Complete guide to sales tax rates for all 50 US states in 2026. State rates, local rates, combined rates, tax-exempt items, and how to calculate sales tax. Free calculator included.\",\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/opengraph-image.png\",\"width\":1200,\"height\":630},\"datePublished\":\"2026-06-01T12:00:00.000Z\",\"dateModified\":\"2026-06-01T12:00:00.000Z\",\"author\":{\"@id\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026\"},\"keywords\":[\"sales tax\",\"state sales tax\",\"sales tax rates\",\"sales tax calculator\",\"tax by state\",\"2026\"],\"wordCount\":4326,\"articleSection\":\"Tax Guide\"},{\"@id\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://thetaxcalc.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Sales Tax by State: Complete Guide to US Tax Rates in 2026\",\"item\":\"https://thetaxcalc.com/blog/sales-tax-by-state-guide-2026\"}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\