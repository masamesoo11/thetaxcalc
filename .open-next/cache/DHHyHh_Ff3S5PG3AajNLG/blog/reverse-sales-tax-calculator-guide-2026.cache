\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"9\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"10\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"11\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026\"}],[\"$\",\"meta\",\"12\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:title\",\"content\":\"Reverse Sales Tax Calculator: Calculate Pre-Tax Price (2026) | TheTaxCalc\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:description\",\"content\":\"Free reverse sales tax calculator guide. Calculate pre-tax price from any total. Formula, examples by state, and common mistakes to avoid. Updated for 2026.\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:alt\",\"content\":\"Reverse Sales Tax Calculator: Calculate Pre-Tax Price (2026) | TheTaxCalc\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"22\",{\"property\":\"article:published_time\",\"content\":\"2026-07-08T07:00:00.000Z\"}],[\"$\",\"meta\",\"23\",{\"property\":\"ar