\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"22\",{\"property\":\"article:published_time\",\"content\":\"2026-07-08T07:00:00.000Z\"}],[\"$\",\"meta\",\"23\",{\"property\":\"article:modified_time\",\"content\":\"2026-07-08T07:00:00.000Z\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:title\",\"content\":\"Reverse Sales Tax Calculator: Calculate Pre-Tax Price (2026) | TheTaxCalc\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:description\",\"content\":\"Free reverse sales tax calculator guide. Calculate pre-tax price from any total. Formula, examples by state, and common mistakes to avoid. Updated for 2026.\"}],[\"$\",\"meta\",\"27\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"28\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"29\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2f\",\"30\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n3:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"\"]\nf:I[45026,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"BlogTableOfContents\"]\n14:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n15:\"$Sreact.suspense\"\n2:Tb27,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026#article\",\"@type\":\"Article\",\"headline\":\"Reverse Sales Tax Calculator: How to Calculate Pre-Tax Price\",\"description\":\"Free reverse sales tax calculator guide. Calculate pre-tax price from any total. Formula, examples by state, and common mistakes to avoid.\",\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/opengraph-image.png\",\"width\":1200,\"height\":630},\"datePublished\":\"2026-07-08T07:00:00.000Z\",\"dateModified\":\"2026-07-08T07:00:00.000Z\",\"author\":{\"@id\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026\"},\"keywords\":[\"reverse sales tax calculator\",\"reverse tax calculator\",\"pre-tax price\",\"sales tax calculation\",\"reverse sales tax 2026\",\"tax inclusive pricing\"],\"wordCount\":1297,\"articleSection\":\"Tax Guide\"},{\"@id\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://thetaxcalc.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Reverse Sales Tax Calculator: How to Calculate Pre-Tax Price\",\"item\":\"https://thetaxcalc.com/blog/reverse-sales-tax-calculator-guide-2026\"}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],\"$L4\",\"$L5\",\"$L6\",\"$L7\"]}],\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\"]}],[\"$Ld\"],\"$Le\"]}],\"loading\":null,\"isPartial\":false}\n4:[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}]\n5:[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Blog\"}]\n6:[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}]\n7:[\"$\",\"span\",null,{\"className\":\"truncate text-foreground font-medium max-w-[200px] sm:max-w-none\",\"children\":\"Reverse Sales Tax Calculator: How to Calculate Pre-Tax Price\"}]\n8:[\"$\",\"article\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"div