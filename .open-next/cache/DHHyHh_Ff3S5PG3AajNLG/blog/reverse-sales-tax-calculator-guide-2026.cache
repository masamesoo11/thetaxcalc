:gap-8\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block lg:w-64 lg:shrink-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-24\",\"children\":[\"$\",\"$L29\",null,{\"entries\":[{\"id\":\"what-is-a-reverse-sales-tax-calculator\",\"text\":\"What Is a Reverse Sales Tax Calculator?\",\"level\":2},{\"id\":\"the-reverse-sales-tax-formula\",\"text\":\"The Reverse Sales Tax Formula\",\"level\":2},{\"id\":\"example-calculation\",\"text\":\"Example Calculation\",\"level\":3},{\"id\":\"reverse-sales-tax-by-state\",\"text\":\"Reverse Sales Tax by State\",\"level\":2},{\"id\":\"states-with-no-sales-tax\",\"text\":\"States with No Sales Tax\",\"level\":2},{\"id\":\"how-to-use-a-reverse-tax-calculator\",\"text\":\"How to Use a Reverse Tax Calculator\",\"level\":2},{\"id\":\"finding-your-local-sales-tax-rate\",\"text\":\"Finding Your Local Sales Tax Rate\",\"level\":3},{\"id\":\"reverse-tax-for-businesses\",\"text\":\"Reverse Tax for Businesses\",\"level\":2},{\"id\":\"1-sales-tax-filing\",\"text\":\"1. Sales Tax Filing\",\"level\":3},{\"id\":\"2-expense-tracking\",\"text\":\"2. Expense Tracking\",\"level\":3},{\"id\":\"3-pricing-strategy\",\"text\":\"3. Pricing Strategy\",\"level\":3},{\"id\":\"4-receipt-auditing\",\"text\":\"4. Receipt Auditing\",\"level\":3},{\"id\":\"reverse-sales-tax-calculator-tool\",\"text\":\"Reverse Sales Tax Calculator Tool\",\"level\":2},{\"id\":\"quick-reference-table\",\"text\":\"Quick Reference Table\",\"level\":3},{\"id\":\"common-mistakes-in-reverse-tax-calculation\",\"text\":\"Common Mistakes in Reverse Tax Calculation\",\"level\":2},{\"id\":\"mistake-1-subtracting-the-percentage\",\"text\":\"Mistake 1: Subtracting the Percentage\",\"level\":3},{\"id\":\"mistake-2-using-the-wrong-rate\",\"text\":\"Mistake 2: Using the Wrong Rate\",\"level\":3},{\"id\":\"mistake-3-rounding-errors\",\"text\":\"Mistake 3: Rounding Errors\",\"level\":3},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"related-resources\",\"text\":\"Related Resources\",\"level\":2},{\"id\":\"sources\",\"text\":\"Sources\",\"level\":2}]}]}]}],\"$L2a\"]}],\"$L2b\"]}]\n25:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n26:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foregroun