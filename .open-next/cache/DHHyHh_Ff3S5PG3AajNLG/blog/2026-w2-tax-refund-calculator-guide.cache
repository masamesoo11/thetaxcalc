0 transition-colors line-clamp-2 mb-1.5\\\",\\\"children\\\":\\\"2026 Federal Tax Brackets: Complete Guide to US Income Tax Rates \\u0026 Slabs\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground line-clamp-2\\\",\\\"children\\\":\\\"Complete guide to 2026 federal income tax brackets, standard deductions, tax credits, and how inflation adjustments affect your tax bill.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-2 flex flex-wrap gap-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"federal tax brackets 2026\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"federal tax brackets 2026\\\"}],[\\\"$\\\",\\\"span\\\",\\\"income tax slab in usa\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"income tax slab in usa\\\"}],[\\\"$\\\",\\\"span\\\",\\\"federal income tax rates\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"federal income tax rates\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"])</script><script>self.__next_f.push([1,\"36:I[27201,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/61cc43b3d7ad2990.js\\\"],\\\"IconMark\\\"]\\n1a:null\\n\"])</script><script>self.__next_f.push([1,\"1e:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"W-2 Employees: 2026 Tax Refund Calculator Guide With Exact Numbers | TheTaxCalc\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Complete 2026 W-2 tax refund guide fo