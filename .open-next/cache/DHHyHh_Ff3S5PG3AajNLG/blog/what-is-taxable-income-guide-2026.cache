,\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$150,000\"}],[\"$\",\"$L3\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$200,000\"}]]}]]}]\nb:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L3\",\"hourly-wage-after-tax-questions-2026\",{\"href\":\"/blog/hourly-wage-after-tax-questions-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 21, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Hourly Wage After Tax Questions Answered (2026 Calculator)\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"How much tax is taken out of a $300 paycheck? How much is $20/hour after taxes? $21/hour annually? $1200/week? Exact numbers for common wages with free calculator.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"hourly\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"hourly\"}],[\"$\",\"span\",\"wage\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"wage\"}],[\"$\",\"span\",\"after\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"after\"}]]}]]}],[\"$\",\"$L3\",\"take-home-pay-calculator-guide-2026\",{\"href\":\"/blog/take-home-pay-calculator-guide-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 21, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Take Home Pay Calculator 2026: How Much You Actually Keep\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete take-home pay guide for 2026. Calculate your net pay after federal, FICA, and state taxes. Real examples for every state. Free calculator, no signup.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"take\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"take\"}],[\"$\",\"span\",\"home\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"home\"}],[\"$\",\"span\",\"pay\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"pay\"}]]}]]}],[\"$\",\"$L3\",\"sales-tax-by-state-guide-2026\",{\"href\":\"/blog/sales-tax-by-state-guide-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[\"$L11\",\"$L12\",\"$L13\",\"$L14\"]}]]}]]}]\nc:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2d86c01f2aacd453.js\",\"async\":true}]\nd:[\"$\",\"$L15\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@17\"}]}]\n18:T29c1,<p>\"What do you get taxed on?\" is one of the most common tax questions in America. The answer is more complex than you might think — some income is fully taxable, some is partially taxable, and some is completely tax-free. This 2026 guide explains every type of taxable and tax-exempt income, with clear examples.</p><h2 id=\"official-source\">Official Source</h2><p>Taxable income rules are defined by the IRS in <a href=\"https://www.irs.gov/publications/p525\" rel=\"noopener noreferrer\">Publication 525</a> and <a href=\"https://www.irs.gov/publications/p17\" rel=\"noopener noreferrer\">Publication 17</a>. Tax-exempt income is listed in <a href=\"https://www.irs.gov/publications/p525#en_US_2024_publink1000229723\" rel=\"noopener noreferrer\">IRS Publication 525, Chapter 2</a>.</p><h2 id=\"what-items-do-you-pay-taxes-on\">What Items Do You Pay Taxes On?</h2><h3 id=\"fully-taxable-income\">Fully Taxable Income</h3><p>These income types are 100% subject to federal income tax:</p><ol><li><strong>Wages and salaries</strong> — All employment income (W-2)</li><li><strong>Self-employment income</strong> — 1099 income, freelance, contractor (minus business expenses)</li><li><strong>Bonuses and commissions</strong> — Taxed as ordinary income</li><li><strong>Tips</strong> — All tips over $20/month per employer</li><li><strong>Vacation pay</strong> — Taxed as wages</li><li><strong>Severance pay</strong> — Taxed as wages</li><li><strong>Unemployment compensation</strong> — Fully taxable at federal level (some states exempt)</li><li><strong>Capital gains</strong> — Profit from selling investments (short-term at ordinary rates, long-term at 0/15/20%)</li><li><strong>Dividends</strong> — Qualified (15/20%) and ordinary (ordinary income rate)</li><li><strong>Interest income</strong> — Bank interest, bond interest (some municipal bonds exempt)</li><li><strong>Rental income</strong> — Rent received (minus expenses)</li><li><strong>Pension income</strong> — Most pensions are fully taxable</li><li><strong>401(k)/Traditional IRA withdrawals</strong> — Fully taxable as ordinary income</li><li><strong>Annuities</strong> — Portion of annuity payments (depends on basis)</li><li><strong>Gambling winnings</strong> — Fully taxable (lottery, casino, sports betting)</li><li><strong>Alimony received</strong> — Taxable for divorces finalized after 2018</li><li><strong>Jury duty pay</strong> — Taxable as miscellaneous income</li><li><strong>Prizes and awards</strong> — Fair market value is taxable</li><li><strong>Cancellation of debt</strong> — Generally taxable (exceptions exist)</li><li><strong>Royalties</strong> — Taxable as ordinary income</li></ol><h3 id=\"partially-taxable-income\">Partially Taxable Income</h3><ol><li><strong>Social Security benefits</strong> — 0%, 50%, or 85% taxable depending on combined income</li><li><strong>Annuities</strong> — Only the earnings portion is taxable (return of principal is tax-free)</li><li><strong>Non-qualified dividends</strong> — Taxed at ordinary rate (qualified at lower rate)</li><li><strong>Scholarships</strong> — Tuition/fees tax-free; room/board taxable</li></ol><h2 id=\"what-income-is-exempt-from-taxes\">What Income Is Exempt From Taxes?</h2><h3 id=\"tax-free-income-federal\">Tax-Free Income (Federal)</h3><p>These income types are <strong>not subject to federal income tax</strong>:</p><ol><li><strong>Roth IRA withdrawals</strong> — Qualified withdrawals (59.5+ and 5-year rule) are 100% tax-free</li><li><strong>Roth 401(k) withdrawals</strong> — Same as Roth IRA</li><li><strong>Municipal bond interest</strong> — Interest from state/local government bonds is federal tax-free</li><li><strong>Social Security</strong> (low income) — If combined income < $25,000 (single) or $32,000 (married)</li><li><strong>Veterans' benefits</strong> — Disability compensation, pensions, and education benefits</li><li><strong>Workers' compensation</strong> — Job-related injury/illness benefits</li><li><strong>Child support payments</strong> — Not taxable to the recipient</li><li><strong>Gifts received</strong> — Gifts under $18,000/year per giver (2026)</li><li><strong>Inheritances</strong> — No federal income tax on inherited money</li><li><strong>Life insurance proceeds</strong> — Not taxable as income to beneficiary</li><li><strong>Scholarships</strong> — Tuition, fees, books, supplies (not room/board)</li><li><strong>Welfare benefits</strong> — Public assistance payments</li><li><strong>Supplemental Security Income (SSI)</strong> — Not taxable</li><li><strong>Foster care payments</strong> — For qualified foster individuals</li><li><strong>Disability insurance</strong> — If premiums paid with after-tax dollars</li><li><strong>IRS tax refunds</strong> — Federal tax refunds are not taxable income</li><li><strong>Combat pay</strong> — Military pay earned in a combat zone</li><li><strong>Foreign income exclusion</strong> — Up to $130,000 (2026) if living abroad</li><li><strong>Home sale exclusion</strong> — Up to $250,000 (single) / $500,000 (married) profit tax-free</li><li><strong>HSA withdrawals</strong> — For qualified medical expenses</li></ol><h2 id=\"what-are-the-12-types-of-taxes-in-the-us\">What Are the 12 Types of Taxes in the US?</h2><div class=\"table-wrapper\"><table><thead><tr><th>#</th><th>Tax Type</th><th>Who Pays</th><th>Rate</th></tr></thead><tbody><tr><td>1</td><td>Federal income tax</td><td>All earners</td><td>10-37%</td></tr><tr><td>2</td><td>State income tax</td><td>Residents of 41 states</td><td>0-13.3%</td></tr><tr><td>3</td><td>FICA (Social Security)</td><td>All employees</td><td>6.2% (employer matches)</td></tr><tr><td>4</td><td>Medicare tax</td><td>All employees</td><td>1.45% (employer matches)</td></tr><tr><td>5</td><td>State sales tax</td><td>Consumers in 45 states</td><td>0-9.56%</td></tr><tr><td>6</td><td>Property tax</td><td>Property owners</td><td>0.28-2.49%</td></tr><tr><td>7</td><td>Capital gains tax</td><td>Investors</td><td>0/15/20%</td></tr><tr><td>8</td><td>Estate tax</td><td>Estates over $13.99M</td><td>40%</td></tr><tr><td>9</td><td>Gift tax</td><td>Gifts over $18,000/year</td><td>18-40%</td></tr><tr><td>10</td><td>Excise tax</td><td>Consumers (gas, alcohol, tobacco)</td><td>Varies</td></tr><tr><td>11</td><td>Self-employment tax</td><td>Self-employed</td><td>15.3%</td></tr><tr><td>12</td><td>Corporate income tax</td><td>C-Corporations</td><td>21% (federal)</td></tr></tbody></table></div><h2 id=\"what-is-the-minimum-salary-to-pay-income-tax\">What Is the Minimum Salary to Pay Income Tax?</h2><p>You must file a tax return (and potentially pay tax) if your income exceeds:</p><div class=\"table-wrapper\"><table><thead><tr><th>Filing Status</th><th>2026 Filing Threshold</th><th>Standard Deduction</th></tr></thead><tbody><tr><td>Single (under 65)</td><td>$16,100</td><td>$16,100</td></tr><tr><td>Single (65+)</td><td>$17,700</td><td>$17,700</td></tr><tr><td>Married Filing Jointly (both under 65)</td><td>$32,200</td><td>$32,200</td></tr><tr><td>Married Filing Jointly (one 65+)</td><td>$33,500</td><td>$33,500</td></tr><tr><td>Head of Household (under 65)</td><td>$24,150</td><td>$24,150</td></tr></tbody></table></div><p><strong>If your income is below the standard deduction, you owe $0 federal income tax.</strong></p><p>However, you may still owe FICA (7.65%) regardless of income level, and state tax thresholds may differ.</p><h2 id=\"what-income-pays-37-in-taxes\">What Income Pays 37% in Taxes?</h2><p>The 37% federal tax bracket applies to taxable income over <strong>$626,350</strong> (single filer) or <strong>$751,600</strong> (married filing jointly) in 2026.</p><p><strong>Important</strong>: Only the income ABOVE $626,350 is taxed at 37%. Income below that is taxed at lower rates. A single filer making $700,000 doesn't pay 37% on all $700,000 — only on the $73,650 above the threshold.</p><h2 id=\"what-is-the-60-trap\">What Is the 60% Trap?</h2><p>The \"60% trap\" (or \"tax torpedo\") refers to the situation where retirees face a <strong>marginal tax rate of 40.7% or higher</strong> (instead of the expected 22%) due to Social Security taxation:</p><ol><li>Retiree withdraws from 401(k) → increases taxable income</li><li>Higher income triggers 85% of Social Security to become taxable</li><li>Each additional dollar of 401(k) withdrawal triggers ~$0.85 of Social Security tax</li><li>Effective marginal rate jumps from 22% to <strong>40.7%</strong></li></ol><p><strong>How to avoid it</strong>: Withdraw from Roth accounts (tax-free) to avoid increasing taxable income, or spread withdrawals across multiple years.</p><h2 id=\"what-are-10-types-of-taxable-income\">What Are 10 Types of Taxable Income?</h2><ol><li>Wages and salaries</li><li>Self-employment income</li><li>Investment income (dividends, interest, capital gains)</li><li>Rental income</li><li>Pension and retirement distributions (401k, IRA)</li><li>Social Security benefits (if income exceeds thresholds)</li><li>Unemployment compensation</li><li>Gambling and lottery winnings</li><li>Alimony received (for post-2018 divorces)</li><li>Prizes and awards</li></ol><h2 id=\"can-i-gift-money-to-my-wife\">Can I Gift Money to My Wife?</h2><p><strong>Yes, completely tax-free.</strong> Transfers between spouses are exempt from gift tax. You can transfer any amount to your spouse without tax consequences, as long as:</p><ul><li>Your spouse is a US citizen (unlimited exemption)</li><li>Your spouse is a non-citizen (annual limit of $190,000 in 2026)</li></ul><p>Gifts to others (children, friends) are subject to the $18,000 annual gift exclusion per person.</p><h2 id=\"how-do-i-know-if-i-have-to-pay-taxes\">How Do I Know If I Have to Pay Taxes?</h2><p>You need to file a federal tax return if ANY of these apply:</p><ol><li>Your gross income exceeds the filing threshold ($16,100 single, $32,200 married)</li><li>You had self-employment income of $400 or more</li><li>You owe special taxes (AMT, additional Medicare, household employment)</li><li>You received advance premium tax credits (ACA marketplace)</li><li>You had wages of $108.28 or more from a church</li></ol><p>Even if you don't owe tax, you should file if you're eligible for refundable credits (EITC, Child Tax Credit).</p><h2 id=\"related-resources\">Related Resources</h2><ul><li><a href=\"/paycheck-calculator\">Paycheck Calculator</a></li><li><a href=\"/federal-tax-brackets\">Federal Tax Brackets</a></li><li><a href=\"/blog/how-much-tax-will-i-owe-2026\">How Much Tax Will I Owe?</a></li><li><a href=\"/blog/free-tax-calculator-no-signup-2026\">Free Tax Calculator — No Signup</a></li><li><a href=\"/glossary\">Tax Glossary</a></li></ul>f:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose-container\",\"dangerouslySetInnerHTML\":{\"__html\":\"$18\"}}]}]\n10:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl mt-8\",\"children\":[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\",\"children\":\"← Back to Blog\"}]}]\n11:[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"June 1, 2026\"}]]}]\n12:[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"Sales Tax by State: Complete Guide to US Tax Rates in 2026\"}]\n13:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete guide to sales tax rates for all 50 US states in 2026. State rates, local rates, combined rates, tax-exempt items, and how to calculate sales tax. Free calculator included.\"}]\n14:[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"sales tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"sales tax\"}],[\"$\",\"span\",\"state sales tax\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"state sales tax\"}],[\"$\",\"span\",\"sales tax rates\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"sales tax rates\"}]]}]\n17:null\n","/blog/$d$slug":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_