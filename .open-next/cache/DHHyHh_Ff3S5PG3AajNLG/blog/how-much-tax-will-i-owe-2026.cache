03c/td\\u003e\\u003ctd\\u003e$3,919\\u003c/td\\u003e\\u003ctd\\u003e$3,825\\u003c/td\\u003e\\u003ctd\\u003e$1,500\\u003c/td\\u003e\\u003ctd\\u003e$9,244\\u003c/td\\u003e\\u003ctd\\u003e18.5%\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e$75,000\\u003c/td\\u003e\\u003ctd\\u003e$7,671\\u003c/td\\u003e\\u003ctd\\u003e$5,738\\u003c/td\\u003e\\u003ctd\\u003e$2,250\\u003c/td\\u003e\\u003ctd\\u003e$15,659\\u003c/td\\u003e\\u003ctd\\u003e20.9%\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e$100,000\\u003c/td\\u003e\\u003ctd\\u003e$13,382\\u003c/td\\u003e\\u003ctd\\u003e$7,650\\u003c/td\\u003e\\u003ctd\\u003e$3,000\\u003c/td\\u003e\\u003ctd\\u003e$24,032\\u003c/td\\u003e\\u003ctd\\u003e24.0%\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e$150,000\\u003c/td\\u003e\\u003ctd\\u003e$26,402\\u003c/td\\u003e\\u003ctd\\u003e$11,475\\u003c/td\\u003e\\u003ctd\\u003e$4,500\\u003c/td\\u003e\\u003ctd\\u003e$42,377\\u003c/td\\u003e\\u003ctd\\u003e28.3%\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e$200,000\\u003c/td\\u003e\\u003ctd\\u003e$40,822\\u003c/td\\u003e\\u003ctd\\u003e$12,921\\u003c/td\\u003e\\u003ctd\\u003e$6,000\\u003c/td\\u003e\\u003ctd\\u003e$59,743\\u003c/td\\u003e\\u003ctd\\u003e29.9%\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003eUse our free \\u003ca href=\\\"/paycheck-calculator\\\"\\u003e2026 tax calculator\\u003c/a\\u003e for personalized numbers.\\u003c/p\\u003e\\u003ch2 id=\\\"step-1-calculate-your-federal-income-tax\\\"\\u003eStep 1: Calculate Your Federal Income Tax\\u003c/h2\\u003e\\u003cp\\u003eFederal income tax uses a progressive bracket system. The 2026 brackets for single filers: 10% ($0-$11,925), 12% ($11,926-$48,475), 22% ($48,476-$103,350), 24% ($103,351-$197,300), 32% ($197,301-$250,525), 35% ($250,526-$626,350), 37% (over $626,350).\\u003c/p\\u003e\\u003ch2 id=\\\"step-2-add-fica-payroll-taxes-7-65\\\"\\u003eStep 2: Add FICA Payroll Taxes (7.65%)\\u003c/h2\\u003e\\u003cp\\u003eFICA funds Social Security (6.2% up to $184,500 wage base) and Medicare (1.45%, no cap). Total: 7.65% of gross wages.\\u003c/p\\u003e\\u003ch2 id=\\\"step-3-calculate-state-income-tax\\\"\\u003eStep 3: Calculate State Income Tax\\u003c/h2\\u003e\\u003cp\\u003eEight states have no income tax: Alaska, Florida, Nevada, South Dakota, Tennessee, Texas, Washington, Wyoming. Other states range from 1% (North Dakota) to 13.3% (California).\\u003c/p\\u003e\\u003ch2 id=\\\"step-4-subtract-pre-tax-deductions\\\"\\u003eStep 4: Subtract Pre-Tax Deductions\\u003c/h2\\u003e\\u003cp\\u003e401(k) up to $24,500, Traditional IRA up to $7,000, HSA up to $4,400 (self). These lower your taxable income.\\u003c/p\\u003e\\u003ch2 id=\\\"step-5-apply-tax-credits\\\"\\u003eStep 5: Apply Tax Credits\\u003c/h2\\u003e\\u003cp\\u003eChild Tax Credit ($2,000/child), EITC (up to $7,430), American Opportunity Credit ($2,500/student), Saver's Credit ($1,000).\\u003c/p\\u003e\\u003ch2 id=\\\"step-6-calculate-your-total-tax-bill\\\"\\u003eStep 6: Calculate Your Total Tax Bill\\u003c/h2\\u003e\\u003cp\\u003eTotal Tax = Federal Income Tax + FICA + State Income Tax - Tax Credits\\u003c/p\\u003e\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-container\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$2f\\\"}}]}]\\n2a:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\\\",\\\"children\\\":\\\"← Back to Blog\\\"}]}]\\n2b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 mb-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"classNam