"className\\\":\\\"flex items-center gap-2 mb-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\\\",\\\"children\\\":\\\"Tax Guide\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-[10px] text-muted-foreground\\\",\\\"children\\\":\\\"June 21, 2026\\\"}]]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\\\",\\\"children\\\":\\\"Take Home Pay Calculator 2026: How Much You Actually Keep\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground line-clamp-2\\\",\\\"children\\\":\\\"Complete take-home pay guide for 2026. Calculate your net pay after federal, FICA, and state taxes. Real examples for every state. Free calculator, no signup.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-2 flex flex-wrap gap-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",\\\"take\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"take\\\"}],[\\\"$\\\",\\\"span\\\",\\\"home\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"home\\\"}],[\\\"$\\\",\\\"span\\\",\\\"pay\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"pay\\\"}]]}]]}],[\\\"$\\\",\\\"$L11\\\",\\\"hourly-wage-after-tax-questions-2026\\\",{\\\"href\\\":\\\"/blog/hourly-wage-after-tax-questions-2026\\\",\\\"className\\\":\\\"group rounded-xl border border-border/50 bg-card p-5 hover:border