children\":[\"$\",\"$Ld\",null,{\"entries\":[{\"id\":\"why-bonuses-feel-like-they-re-taxed-higher\",\"text\":\"Why Bonuses Feel Like They're Taxed Higher\",\"level\":2},{\"id\":\"the-percentage-method-the-22-flat-federal-rate\",\"text\":\"The Percentage Method: The 22% Flat Federal Rate\",\"level\":2},{\"id\":\"the-1-million-exception-37-withholding\",\"text\":\"The $1 Million Exception: 37% Withholding\",\"level\":3},{\"id\":\"why-most-employers-use-the-percentage-method\",\"text\":\"Why Most Employers Use the Percentage Method\",\"level\":3},{\"id\":\"the-aggregate-method-how-it-works-with-regular-wages\",\"text\":\"The Aggregate Method: How It Works With Regular Wages\",\"level\":2},{\"id\":\"when-the-aggregate-method-actually-helps\",\"text\":\"When the Aggregate Method Actually Helps\",\"level\":3},{\"id\":\"which-method-saves-more-money-a-comparison\",\"text\":\"Which Method Saves More Money? A Comparison\",\"level\":2},{\"id\":\"fica-on-bonuses-social-security-medicare\",\"text\":\"FICA on Bonuses: Social Security + Medicare\",\"level\":2},{\"id\":\"state-income-tax-on-bonuses\",\"text\":\"State Income Tax on Bonuses\",\"level\":2},{\"id\":\"year-end-bonus-strategies\",\"text\":\"Year-End Bonus Strategies\",\"level\":2},{\"id\":\"1-defer-your-bonus-to-january\",\"text\":\"1. Defer Your Bonus to January\",\"level\":3},{\"id\":\"2-boost-your-401-k-contribution\",\"text\":\"2. Boost Your 401(k) Contribution\",\"level\":3},{\"id\":\"3-fund-an-ira\",\"text\":\"3. Fund an IRA\",\"level\":3},{\"id\":\"4-make-charitable-donations\",\"text\":\"4. Make Charitable Donations\",\"level\":3},{\"id\":\"5-adjust-your-w-4-after-the-bonus\",\"text\":\"5. Adjust Your W-4 After the Bonus\",\"level\":3},{\"id\":\"real-examples-5k-10k-and-25k-bonuses\",\"text\":\"Real Examples: $5K, $10K, and $25K Bonuses\",\"level\":2},{\"id\":\"example-1-5-000-bonus\",\"text\":\"Example 1: $5,000 Bonus\",\"level\":3},{\"id\":\"example-2-10-000-bonus\",\"text\":\"Example 2: $10,000 Bonus\",\"leve