{\"id\":\"real-examples-5k-10k-and-25k-bonuses\",\"text\":\"Real Examples: $5K, $10K, and $25K Bonuses\",\"level\":2},{\"id\":\"example-1-5-000-bonus\",\"text\":\"Example 1: $5,000 Bonus\",\"level\":3},{\"id\":\"example-2-10-000-bonus\",\"text\":\"Example 2: $10,000 Bonus\",\"level\":3},{\"id\":\"example-3-25-000-bonus\",\"text\":\"Example 3: $25,000 Bonus\",\"level\":3},{\"id\":\"high-earner-example-150-000-bonus-on-250-000-salary\",\"text\":\"High-Earner Example: $150,000 Bonus on $250,000 Salary\",\"level\":3},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"are-bonuses-taxed-differently-than-regular-income\",\"text\":\"Are bonuses taxed differently than regular income?\",\"level\":3},{\"id\":\"can-i-ask-my-employer-to-use-the-percentage-method-instead-of-the-aggregate-method\",\"text\":\"Can I ask my employer to use the percentage method instead of the aggregate method?\",\"level\":3},{\"id\":\"will-i-get-a-refund-on-my-bonus-taxes\",\"text\":\"Will I get a refund on my bonus taxes?\",\"level\":3},{\"id\":\"do-i-need-to-pay-estimated-taxes-on-a-bonus\",\"text\":\"Do I need to pay estimated taxes on a bonus?\",\"level\":3},{\"id\":\"are-signing-bonuses-taxed-the-same-way\",\"text\":\"Are signing bonuses taxed the same way?\",\"level\":3},{\"id\":\"what-if-my-bonus-pushes-me-into-a-higher-tax-bracket\",\"text\":\"What if my bonus pushes me into a higher tax bracket?\",\"level\":3},{\"id\":\"are-bonuses-subject-to-state-taxes\",\"text\":\"Are bonuses subject to state taxes?\",\"level\":3},{\"id\":\"can-i-contribute-my-bonus-to-my-401-k\",\"text\":\"Can I contribute my bonus to my 401(k)?\",\"level\":3},{\"id\":\"what-happens-if-i-leave-my-job-after-receiving-a-bonus\",\"text\":\"What happens if I leave my job after receiving a bonus?\",\"level\":3},{\"id\":\"the-bottom-line\",\"text\":\"The Bottom Line\",\"level\":2}]}]}]}],\"$L28\"]}],\"$L29\"]}]\n23:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":