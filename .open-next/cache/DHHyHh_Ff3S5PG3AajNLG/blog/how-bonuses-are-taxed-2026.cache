"28\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"29\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2c\",\"30\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n3:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"\"]\nd:I[45026,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/2d86c01f2aacd453.js\"],\"BlogTableOfContents\"]\n11:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n12:\"$Sreact.suspense\"\n2:Tab3,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026#article\",\"@type\":\"Article\",\"headline\":\"How Are Bonuses Taxed in 2026? The 22% Flat Rate Explained\",\"description\":\"Complete guide to bonus taxation in 2026. Understand the 22% flat rate vs aggregate method, FICA on bonuses, and state taxes. Free bonus tax calculator.\",\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/opengraph-image.png\",\"width\":1200,\"height\":630},\"datePublished\":\"2026-06-01T12:00:00.000Z\",\"dateModified\":\"2026-06-01T12:00:00.000Z\",\"author\":{\"@id\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026\"},\"keywords\":[\"bonus tax\",\"supplemental wage tax\",\"22% flat rate\",\"aggregate method\",\"bonus calculator\",\"2026\"],\"wordCount\":3090,\"articleSection\":\"Tax Guide\"},{\"@id\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://thetaxcalc.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How Are Bonuses Taxed in 2026? The 22% Flat Rate Explained\",\"item\":\"https://thetaxcalc.com/blog/how-bonuses-are-taxed-2026\"}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Blog\"}],\"$L4\",\"$L5\"]}],\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\"]}],[\"$Lb\"],\"$Lc\"]}],\"loading\":null,\"isPartial\":false}\n4:[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}]\n5:[\"$\",\"span\",null,{\"className\":\"truncate text-foreground font-medium max-w-[200px] sm:max-w-none\",\"children\":\"How Are Bonuses Taxed in 2026? The 22% Flat Rate Explained\"}]\n6:[\"$\",\"article\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl space-y-4 mb-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],false]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl leading-tight\",\"children\":\"How Are Bonuses Taxed in 2026? The 22% Flat Rate Explained\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-base text-muted-foreground\",\"children\":\"A CPA-reviewed guide by Rachel Mitchell, CPA — updated for 2026 tax year\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed\",\"children\":\"Complete guide to bonus taxation in 2026. Understand the 22% flat rate vs aggregate metho