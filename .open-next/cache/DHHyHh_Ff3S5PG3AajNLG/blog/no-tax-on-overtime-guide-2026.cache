x-2.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border border-amber-300 bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/20 dark:text-amber-400\",\"children\":\"Featured\"}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl leading-tight\",\"children\":\"No Tax on Overtime: How the New Law Saves You Money (2025–2028)\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-base text-muted-foreground\",\"children\":\"A CPA-reviewed guide by Rachel Mitchell, CPA — updated for 2026 tax year\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed\",\"children\":\"Complete guide to the No Tax on Overtime law for 2025-2028. Calculate your savings, understand eligibility, and see how FICA and state taxes still apply. Free calculator.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-4 text-sm text-muted-foreground border-b border-border/30 pb-4\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"By \",\"Rachel Mitchell\",\", \",\"CPA\"]}],[\"$\",\"span\",null,{\"children\":[\"$\",\"time\",null,{\"dateTime\":\"2026-06-01T12:00:00.000Z\",\"children\":\"June 1, 2026\"}]}],false,[\"$\",\"span\",null,{\"children\":[20,\" min read\"]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"span\",\"no tax on overtime\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"no tax on overtime\"}],[\"$\",\"span\",\"overtime tax exemption\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"overtime tax exemption\"}],[\"$\",\"span\",\"overtime pay\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"overtime pay\"}],[\"$\",\"span\",\"OT tax savings\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"OT tax savings\"}],[\"$\",\"span\",\"trump tax law\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"trump tax law\"}],[\"$\",\"span\",\"2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/50 px-2.5 py-0.5 text-[10px] text-muted-foreground\",\"children\":\"2026\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-5xl lg:flex lg:gap-8\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"hidden lg:block lg:w-64 lg:shrink-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-24\",\"children\":[\"$\",\"$Le\",null,{\"entries\":[{\"id\":\"what-is-the-no-tax-on-overtime-law\",\"text\":\"What Is the No Tax on Overtime Law?\",\"level\":2},{\"id\":\"why-was-this-law-passed\",\"text\":\"Why Was This Law Passed?\",\"level\":3},{\"id\":\"who-qualifies-for-the-overtime-tax-exemption\",\"text\":\"Who Qualifies for the Overtime Tax Exemption?\",\"level\":2},{\"id\":\"you-qualify-if\",\"text\":\"You Qualify If:\",\"level\":3},{\"id\":\"you-do-not-qualify-if\",\"text\":\"You Do NOT Qualify If:\",\"level\":3},{\"id\":\"what-about-salaried-non-exempt-workers\",\"text\":\"What About Salaried Non-Exempt Workers?\",\"level\":3},{\"id\":\"what-s-exempt-vs-what-s-not-exempt\",\"text\":\"What's Exempt vs. What's NOT Exempt\",\"level\":2},{\"id\":\"exempt-from-tax-you-don-t-pay\",\"text\":\"✅ EXEMPT from Tax (You Don't Pay)\",\"level\":3},{\"id\":\"not-exempt-from-tax-you-still-pay\",\"text\":\"❌ NOT Exempt from Tax (You Still Pay)\",\"level\":3},{\"id\":\"how-much-do-you-actually-save-real-examples\",\"text\":\"How Much Do You Actually Save? — Real Examples\",\"level\":2},{\"id\":\"example-1-50-000-base-salary-5-hours-ot-week\",\"text\":\"Example 1: $50,000 Base Salary, 5 Hours OT/Week\",\"level\":3},{\"id\":\"example-2-35-000-base-salary-10-hours-ot-week\",\"text\":\"Example 2: $35,000 Base Salary, 10 Hours OT/Week\",\"level\":3},{\"id\":\"example-3-75-000-base-salary-8-hours-ot-week\",\"text\":\"Example 3: $75,000 Base Salary, 8 Hours OT/Week\",\"level\":3},{\"id\":\"the-sunset-date-what-happens-after-2028\",\"text\":\"The Sunset Date: What Happens After 2028?\",\"level\":2},{\"id\":\"what-should-you-do-about-the-sunset\",\"text\":\"What Should You Do About the Sunset?\",\"level\":3},{\"id\":\"state-by-state-impact-where-you-live-matters\",\"text\":\"State-by-State Impact: Where You Live Matters\",\"level\":2},{\"id\":\"states-with-no-income-tax-maximum-benefit\",\"text\":\"States With No Income Tax (Maximum Benefit)\",\"level\":3},{\"id\":\"states-with-income-tax-reduced-benefit\",\"text\":\"States With Income Tax (Reduced Benefit)\",\"level\":3},{\"id\":\"states-that-may-pass-matching-exemptions\",\"text\":\"States That May Pass Matching Exemptions\",\"level\":3},{\"id\":\"before-vs-after-a-side-by-side-comparison\",\"text\":\"Before vs. After: A Side-by-Side Comparison\",\"level\":2},{\"id\":\"in-texas-no-state-income-tax\",\"text\":\"In Texas (No State Income Tax)\",\"level\":3},{\"id\":\"in-california-high-state-income-tax\",\"text\":\"In California (High State Income Tax)\",\"level\":3},{\"id\":\"how-to-make-sure-you-re-getting-the-exemption\",\"text\":\"How to Make Sure You're Getting the Exemption\",\"level\":2},{\"id\":\"common-misconceptions\",\"text\":\"Common Misconceptions\",\"level\":2},{\"id\":\"impact-on-tax-brackets-and-withholding\",\"text\":\"Impact on Tax Brackets and Withholding\",\"level\":2},{\"id\":\"the-bigger-picture-how-this-fits-into-your-overall-tax-strategy\",\"text\":\"The Bigger Picture: How This Fits Into Your Overall Tax Strategy\",\"level\":2},{\"id\":\"retirement-contributions\",\"text\":\"Retirement Contributions\",\"level\":3},{\"id\":\"earned-income-tax-credit-eitc\",\"text\":\"Earned Income Tax Credit (EITC)\",\"level\":3},{\"id\":\"student-loan-payments\",\"text\":\"Student Loan Payments\",\"level\":3},{\"id\":\"health-insurance-subsidies\",\"text\":\"Health Insurance Subsidies\",\"level\":3},{\"id\":\"frequently-asked-questions\",\"text\":\"Frequently Asked Questions\",\"level\":2},{\"id\":\"does-the-no-tax-on-overtime-law-apply-to-me-if-i-m-self-employed\",\"text\":\"Does the No Tax on Overtime law apply to me if I'm self-employed?\",\"level\":3},{\"id\":\"is-overtime-really-exempt-from-all-federal-taxes\",\"text\":\"Is overtime really exempt from ALL federal taxes?\",\"level\":3},{\"id\":\"what-if-my-employer-pays-overtime-at-2x-instead-of-1-5x\",\"text\":\"What if my employer pays overtime at 2x instead of 1.5x?\",\"level\":3},{\"id\":\"does-this-apply-to-state-income-tax-too\",\"text\":\"Does this apply to state income tax too?\",\"level\":3},{\"id\":\"what-happens-when-the-law-expires-in-2028\",\"text\":\"What happens when the law expires in 2028?\",\"level\":3},{\"id\":\"how-do-i-know-if-i-m-classified-as-exempt-or-non-exempt\",\"text\":\"How do I know if I'm classified as exempt or non-exempt?\",\"level\":3},{\"id\":\"will-this-exemption-affect-my-tax-refund\",\"text\":\"Will this exemption affect my tax refund?\",\"level\":3},{\"id\":\"can-i-claim-this-exemption-on-my-tax-return-if-my-employer-didn-t-apply-it\",\"text\":\"Can I claim this exemption on my tax return if my employer didn't apply it?\",\"level\":3},{\"id\":\"does-overtime-pay-count-toward-the-social-security-wage-base\",\"text\":\"Does overtime pay count toward the Social Security wage base?\",\"level\":3},{\"id\":\"final-thoughts\",\"text\":\"Final Thoughts\",\"level\":2}]}]}]}],\"$Lf\"]}],\"$L10\"]}]\n8:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n9:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Try Our Tax Calculators\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mb-4\",\"children\":\"See exactly how much you'll take home after all taxes and deductions.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"IL Calculator\"}],[\"$\",\"$L3\",null,{\"href\":\"/texas-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm fon