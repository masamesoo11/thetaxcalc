fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n15:\"$Sreact.suspense\"\n2:Taa5,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026#article\",\"@type\":\"Article\",\"headline\":\"Inheritance Tax Questions Answered (2026 Rules)\",\"description\":\"Complete FAQ guide to inheritance tax in 2026. How much is inheritance tax, estate vs inheritance tax, state rules, and how to calculate.\",\"image\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/opengraph-image.png\",\"width\":1200,\"height\":630},\"datePublished\":\"2026-06-21T13:00:00.000Z\",\"dateModified\":\"2026-06-21T13:00:00.000Z\",\"author\":{\"@id\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026\"},\"keywords\":[\"inheritance\",\"tax\",\"questions\",\"2026\",\"tax questions\",\"tax faq\",\"2026 tax rules\",\"tax faq 2026\"],\"wordCount\":882,\"articleSection\":\"Tax Guide\"},{\"@id\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Blog\",\"item\":\"https://thetaxcalc.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Inheritance Tax Questions Answered (2026 Rules)\",\"item\":\"https://thetaxcalc.com/blog/inheritance-tax-questions-2026\"}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Blog\"}],\"$L4\",\"$L5\"]}],\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\"]}],[\"$Lb\"],\"$Lc\"]}],\"loading\":null,\"isPartial\":false}\n4:[\"$\",\"span\",null,{\"className\":\"text-muted