\\":\\\"flex flex-wrap gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/paycheck-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-700 transition-colors\\\",\\\"children\\\":\\\"Paycheck Calculator\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/illinois-tax-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"IL Calculator\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/texas-tax-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"TX Calculator\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/florida-tax-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"FL Calculator\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/self-employment-tax-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Self-Employment\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/relocation-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Compare States\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/salary\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Salary Calculator\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/compare\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Compare Salaries\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/glossary\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Tax Glossary\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/federal-tax-brackets\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Federal Tax Brackets\\\"}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"25:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-8 rounded-xl border border-border/50 bg-muted/30 p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-lg font-bold text-foreground mb-3\\\",\\\"children\\\":\\\"Popular Salary Calculations\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mb-4\\\",\\\"children\\\":\\\"Quick access to take-home pay estimates for common salary levels.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",\\\"/salary/50000\\\",{\\\"href\\\":\\\"/salary/50000\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":\\\"$$50,000\\\"}],[\\\"$\\\"