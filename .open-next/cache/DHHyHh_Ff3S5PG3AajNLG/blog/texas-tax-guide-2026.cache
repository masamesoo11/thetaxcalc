-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"FL Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/self-employment-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Self-Employment\"}],[\"$\",\"$L11\",null,{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L11\",null,{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Calculator\"}],[\"$\",\"$L11\",null,{\"href\":\"/compare\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare Salaries\"}],[\"$\",\"$L11\",null,{\"href\":\"/glossary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Glossary\"}],[\"$\",\"$L11\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/30 transition-colors\",\"children\":\"Federal Tax Brackets\"}]]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-8 rounded-xl border border-border/50 bg-muted/30 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bol