500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$100,000\"}],[\"$\",\"$L11\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$150,000\"}],[\"$\",\"$L11\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-foreground hover:border-emerald-500/40 hover:bg-emerald-500/10 transition-colors\",\"children\":\"$$200,000\"}]]}]]}]\n29:[\"$\",\"section\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L11\",\"2026-federal-tax-brackets-explained\",{\"href\":\"/blog/2026-federal-tax-brackets-explained\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"May 26, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"2026 Tax Brackets: IRS Income Tax Brackets 2026 Explained\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"Complete guide to the IRS 2026 tax brackets — income tax brackets 2026, marginal tax rate, federal income tax rates, adjusted gross income, and tax credits for married couples filing jointly.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"federal\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"federal\"}],[\"$\",\"span\",\"tax brackets\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"tax brackets\"}],[\"$\",\"span\",\"2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"2026\"}]]}]]}],[\"$\",\"$L11\",\"obbba-tax-refund-impact-2026\",{\"href\":\"/blog/obbba-tax-refund-impact-2026\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-full border px-2 py-0.5 text-[10px] font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-400 border-emerald-300 dark:border-emerald-500/30\",\"children\":\"Tax Guide\"}],[\"$\",\"span\",null,{\"className\":\"text-[10px] text-muted-foreground\",\"children\":\"July 4, 2026\"}]]}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors line-clamp-2 mb-1.5\",\"children\":\"OBBBA Tax Refund Impact 2026: How the New Tax Law Changes Your Refund\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground line-clamp-2\",\"children\":\"See exactly how the One Big Beautiful Bill Act (OBBBA) changes your 2026 tax refund. New SALT cap, doubled Child Tax Credit, tip/overtime deductions, and worked examples comparing OBBBA vs prior law.\"}],[\"$\",\"div\",null,{\"className\":\"mt-2 flex flex-wrap gap-1\",\"children\":[[\"$\",\"span\",\"OBBBA 2026\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"OBBBA 2026\"}],[\"$\",\"span\",\"One Big Beautiful Bill Act\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"One Big Beautiful Bill Act\"}],[\"$\",\"span\",\"OBBBA tax refund\",{\"className\":\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\",\"children\":\"OBBBA tax refund\"}]]}]]}],\"$L2d\"]}]]}]\n2e:T2847,<p>Understanding your federal income tax rate is the foundation of financial planning. Whether you're negotiating a salary, planning retirement contributions, or estimating your refund, knowing exactly how much federal tax you'll owe is essential. This guide walks you through how to calculate your federal income tax rate for 2026, with examples, brackets, and a free calculator.</p><h2 id=\"what-is-the-federal-income-tax-rate\">What Is the Federal Income Tax Rate?</h2><p>The federal income tax rate is the percentage of your taxable income that goes to the IRS. The U.S. uses a <strong>progressive tax system</strong> with seven brackets, meaning different portions of your income are taxed at different rates — from 10% on your first dollars earned up to 37% on income over $609,350.</p><p>Your actual federal tax rate depends on:</p><ul><li><strong>Filing status</strong> (Single, Married Filing Jointly, Head of Household)</li><li><strong>Taxable income</strong> (gross income minus deductions)</li><li><strong>Tax credits</strong> (Child Tax Credit, education credits, etc.)</li></ul><h2 id=\"2026-federal-income-tax-brackets\">2026 Federal Income Tax Brackets</h2><p>Under the One Big Beautiful Bill Act (OBBBA), the TCJA brackets were made permanent for 2026:</p><h3 id=\"single-filers\">Single Filers</h3><div class=\"table-wrapper\"><table><thead><tr><th>Rate</th><th>Income Range</th></tr></thead><tbody><tr><td>10%</td><td>$0 – $11,925</td></tr><tr><td>12%</td><td>$11,926 – $47,750</td></tr><tr><td>22%</td><td>$47,751 – $100,525</td></tr><tr><td>24%</td><td>$100,526 – $191,950</td></tr><tr><td>32%</td><td>$191,951 – $243,725</td></tr><tr><td>35%</td><td>$243,726 – $609,350</td></tr><tr><td>37%</td><td>$609,351+</td></tr></tbody></table></div><h3 id=\"married-filing-jointly\">Married Filing Jointly</h3><div class=\"table-wrapper\"><table><thead><tr><th>Rate</th><th>Income Range</th></tr></thead><tbody><tr><td>10%</td><td>$0 – $23,850</td></tr><tr><td>12%</td><td>$23,851 – $95,500</td></tr><tr><td>22%</td><td>$95,501 – $201,050</td></tr><tr><td>24%</td><td>$201,051 – $383,900</td></tr><tr><td>32%</td><td>$383,901 – $487,450</td></tr><tr><td>35%</td><td>$487,451 – $731,200</td></tr><tr><td>37%</td><td>$731,201+</td></tr></tbody></table></div><h3 id=\"head-of-household\">Head of Household</h3><div class=\"table-wrapper\"><table><thead><tr><th>Rate</th><th>Income Range</th></tr></thead><tbody><tr><td>10%</td><td>$0 – $17,000</td></tr><tr><td>12%</td><td>$17,001 – $64,850</td></tr><tr><td>22%</td><td>$64,851 – $103,350</td></tr><tr><td>24%</td><td>$103,351 – $197,300</td></tr><tr><td>32%</td><td>$197,301 – $250,500</td></tr><tr><td>35%</td><td>$250,501 – $609,350</td></tr><tr><td>37%</td><td>$609,351+</td></tr></tbody></table></div><h2 id=\"2026-standard-deductions\">2026 Standard Deductions</h2><p>Before applying the brackets, you subtract the standard deduction from your gross income:</p><div class=\"table-wrapper\"><table><thead><tr><th>Filing Status</th><th>Standard Deduction</th></tr></thead><tbody><tr><td>Single</td><td>$16,100</td></tr><tr><td>Married Filing Jointly</td><td>$32,200</td></tr><tr><td>Head of Household</td><td>$24,150</td></tr></tbody></table></div><h2 id=\"how-to-calculate-federal-income-tax-step-by-step\">How to Calculate Federal Income Tax Step by Step</h2><h3 id=\"step-1-determine-gross-income\">Step 1: Determine Gross Income</h3><p>Add all taxable income sources: wages, salary, self-employment income, interest, dividends, etc.</p><h3 id=\"step-2-subtract-pre-tax-deductions\">Step 2: Subtract Pre-Tax Deductions</h3><ul><li>401(k) contributions (up to $24,500 in 2026)</li><li>HSA contributions (up to $4,300 single / $8,550 family)</li><li>Traditional IRA contributions (up to $7,000)</li><li>Health insurance premiums (if self-employed)</li></ul><h3 id=\"step-3-subtract-the-standard-deduction\">Step 3: Subtract the Standard Deduction</h3><p>Or itemize if your total itemized deductions exceed the standard amount.</p><h3 id=\"step-4-apply-tax-brackets-progressively\">Step 4: Apply Tax Brackets Progressively</h3><p>Tax each portion of income at the corresponding bracket rate.</p><h3 id=\"step-5-subtract-tax-credits\">Step 5: Subtract Tax Credits</h3><ul><li>Child Tax Credit: $2,200 per qualifying child</li><li>Earned Income Tax Credit (EITC): Up to $7,830</li><li>Education credits: Up to $2,500</li></ul><h3 id=\"step-6-add-fica-tax\">Step 6: Add FICA Tax</h3><ul><li>Social Security (OASDI): 6.2% up to $184,500</li><li>Medicare: 1.45% (no cap)</li><li>Additional Medicare: 0.9% on earnings over $200,000</li></ul><h2 id=\"federal-income-tax-calculation-example\">Federal Income Tax Calculation Example</h2><p><strong>Scenario</strong>: Single filer, $85,000 salary, $5,000 401(k) contribution</p><p><strong>Step 1</strong>: Gross income = $85,000</p><p><strong>Step 2</strong>: Subtract 401(k) = $85,000 − $5,000 = $80,000</p><p><strong>Step 3</strong>: Subtract standard deduction = $80,000 − $16,100 = <strong>$63,900 taxable income</strong></p><p><strong>Step 4</strong>: Apply brackets:</p><ul><li>10% on first $11,925 = $1,192.50</li><li>12% on $11,926–$47,750 = $4,318.50</li><li>22% on $47,751–$63,900 = $3,552.75</li><li><strong>Federal income tax = $9,063.75</strong></li></ul><p><strong>Step 5</strong>: No credits (assume no children)</p><p><strong>Step 6</strong>: FICA = $85,000 × 7.65% = $6,502.50</p><p><strong>Total tax</strong>: $9,063.75 + $6,502.50 = <strong>$15,566.25</strong></p><p><strong>Effective federal tax rate</strong>: $9,063.75 ÷ $85,000 = <strong>10.7%</strong></p><p><strong>Marginal tax rate</strong>: <strong>22%</strong> (the rate on your last dollar earned)</p><p>Use our <a href=\"/paycheck-calculator\">paycheck calculator</a> to calculate this automatically for all 50 states.</p><h2 id=\"marginal-vs-effective-tax-rate\">Marginal vs. Effective Tax Rate</h2><h3 id=\"marginal-tax-rate\">Marginal Tax Rate</h3><p>The rate applied to your <strong>last dollar</strong> of taxable income. If you're a single filer making $63,900, your marginal rate is 22% because that's the bracket your top dollar falls into.</p><h3 id=\"effective-tax-rate\">Effective Tax Rate</h3><p>Your <strong>average</strong> tax rate — total tax divided by total income. For the example above, $9,063.75 ÷ $85,000 = 10.7%. Your effective rate is always lower than your marginal rate.</p><h3 id=\"why-this-matters\">Why This Matters</h3><ul><li><strong>Marginal rate</strong> determines the value of additional deductions (e.g., contributing $1,000 more to your 401(k) saves you $220 at the 22% marginal rate)</li><li><strong>Effective rate</strong> shows your overall tax burden</li></ul><h2 id=\"how-obbba-affects-2026-federal-tax-rates\">How OBBBA Affects 2026 Federal Tax Rates</h2><p>The One Big Beautiful Bill Act made several changes that affect your federal income tax calculation:</p><div class=\"table-wrapper\"><table><thead><tr><th>OBBBA Provision</th><th>Impact on Tax Calculation</th></tr></thead><tbody><tr><td>TCJA brackets permanent</td><td>Prevents reversion to higher pre-TCJA rates</td></tr><tr><td>SALT cap raised to $40,400</td><td>Larger deduction for itemizers in high-tax states</td></tr><tr><td>Child Tax Credit doubled to $2,200</td><td>Reduces tax for families with children</td></tr><tr><td>Tip income deduction</td><td>New above-the-line deduction for tipped workers</td></tr><tr><td>Overtime pay deduction</td><td>New deduction for hourly workers</td></tr><tr><td>Senior deduction ($2,000)</td><td>Additional deduction for taxpayers 65+</td></tr><tr><td>QBI deduction (20%) permanent</td><td>Reduces tax for self-employed and small business</td></tr></tbody></table></div><p>Use our <a href=\"/obbba-tax-calculator\">OBBBA tax calculator</a> to compare your taxes under OBBBA vs prior law.</p><h2 id=\"federal-income-tax-rate-calculator\">Federal Income Tax Rate Calculator</h2><p>Our <a href=\"/paycheck-calculator\">paycheck calculator</a> functions as a complete federal income tax rate calculator:</p><ol><li>Enter your gross salary</li><li>Select your filing status</li><li>Choose your state</li><li>Add pre-tax deductions (401(k), HSA)</li><li>View your federal tax, FICA, state tax, and take-home pay</li></ol><p>The calculator applies all 2026 federal brackets, standard deductions, and FICA rates automatically.</p><h2 id=\"frequently-asked-questions\">Frequently Asked Questions</h2><p><strong>What is the federal income tax rate for 2026?</strong> The federal income tax rate ranges from 10% to 37% depending on your income and filing status. Most middle-income earners fall in the 12% or 22% bracket.</p><p><strong>How do I find my marginal tax rate?</strong> Look at the 2026 bracket tables above and find the range that includes your taxable income (after deductions). The rate for that range is your marginal rate.</p><p><strong>What is the standard deduction for 2026?</strong> $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household.</p><p><strong>How much federal tax do I pay on $75,000?</strong> A single filer making $75,000 with the standard deduction pays approximately $7,670 in federal income tax (effective rate ~10.2%), plus $5,738 in FICA tax.</p><p><strong>Did the OBBBA change tax brackets for 2026?</strong> The OBBBA made the existing TCJA brackets permanent, preventing them from reverting to higher pre-TCJA rates. It also raised the SALT cap and doubled the Child Tax Credit.</p><h2 id=\"related-resources\">Related Resources</h2><ul><li><a href=\"/paycheck-calculator\">Paycheck Calculator</a> — Federal + state + FICA in one tool</li><li><a href=\"/obbba-tax-calculator\">OBBBA Tax Calculator</a> — 2026 vs prior law comparison</li><li><a href=\"/blog/2026-federal-tax-brackets-explained\">2026 Tax Brackets Guide</a> — Complete bracket reference</li><li><a href=\"/blog/oasdi-tax-explained-2026\">OASDI Tax Explained</a> — Social Security tax details</li><li><a href=\"/tax-refund-calculator\">Tax Refund Calculator</a> — Estimate your refund</li></ul><h2 id=\"sources\">Sources</h2><ol><li>IRS — Revenue Procedure 2025-25 (2026 Tax Brackets)</li><li>IRS — Publication 505 (Tax Withholding and Estimated Tax)</li><li>IRS — Form 1040 Instructions (2026)</li><li>One Big Beautiful Bill Act (P.L. 119-1)</li></ol>2b:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose-container\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2e\"}}]}]\n2c:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl mt-8\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/blog\",\"className\":\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\",\"children\":\"← Back to Blog\"}]}]\n2d:[\"$\",\"$L11\",\"2026-self-employed-tax-refund-calculator\",{\"href\":\"/blog/2026-self-employed-tax-refund-calculator\",\"className\":\"group rounded-xl border border-border/50 bg-card p-5 hover:border-emerald-500/30 hover:shadow-md transition-all\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-ce