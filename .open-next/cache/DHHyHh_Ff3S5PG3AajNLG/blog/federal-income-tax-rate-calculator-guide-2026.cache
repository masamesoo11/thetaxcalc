",\\\"One Big Beautiful Bill Act\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"One Big Beautiful Bill Act\\\"}],[\\\"$\\\",\\\"span\\\",\\\"OBBBA tax refund\\\",{\\\"className\\\":\\\"inline-flex items-center rounded-full border border-border/30 px-1.5 py-0.5 text-[9px] text-muted-foreground\\\",\\\"children\\\":\\\"OBBBA tax refund\\\"}]]}]]}],\\\"$L2d\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2e:T2847,\"])</script><script>self.__next_f.push([1,\"\\u003cp\\u003eUnderstanding your federal income tax rate is the foundation of financial planning. Whether you're negotiating a salary, planning retirement contributions, or estimating your refund, knowing exactly how much federal tax you'll owe is essential. This guide walks you through how to calculate your federal income tax rate for 2026, with examples, brackets, and a free calculator.\\u003c/p\\u003e\\u003ch2 id=\\\"what-is-the-federal-income-tax-rate\\\"\\u003eWhat Is the Federal Income Tax Rate?\\u003c/h2\\u003e\\u003cp\\u003eThe federal income tax rate is the percentage of your taxable income that goes to the IRS. The U.S. uses a \\u003cstrong\\u003eprogressive tax system\\u003c/strong\\u003e with seven brackets, meaning different portions of your income are taxed at different rates — from 10% on your first dollars earned up to 37% on income over $609,350.\\u003c/p\\u003e\\u003cp\\u003eYour actual federal tax rate depends on:\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFiling status\\u003c/strong\\u003e (Single, Married Filing Jointly, Head of Household)\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eTaxable income\\u003c/strong\\u003e (gross income minus deductions)\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eTax credits\\u003c/strong\\u003e (Child Tax Credit, education credits, etc.)\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch2 id=\\\"2026-federal-income-tax-brackets\\\"\\u003e2026 Federal Income Tax Brackets\\u003c/h2\\u003e\\u003cp\\u003eUnder the One Big Beautiful Bill Act (OBBBA), the TCJA brackets were made permanent for 2026:\\u003c/p\\u003e\\u003ch3 id=\\\"single-filers\\\"\\u003eSingle Filers\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\u003cth\\u003eRate\\u003c/th\\u003e\\u003cth\\u003eIncome Range\\u003c/th\\u003e\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\u003ctr\\u003e\\u003ctd\\u003e10%\\u003c/td\\u003e\\u003ctd\\u003e$0 – $11,925\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e12%\\u003c/td\\u003e\\u003ctd\\u003e$11,926 – $47,750\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e22%\\u003c/td\\u003e\\u003ctd\\u003e$47,751 – $100,525\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e24%\\u003c/td\\u003e\\u003ctd\\u003e$100,526 – $191,950\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e32%\\u003c/td\\u003e\\u003ctd\\u003e$191,951 – $243,725\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e35%\\u003c/td\\u003e\\u003ctd\\u003e$243,726 – $609,350\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e37%\\u003c/td\\u003e\\u003ctd\\u003e$609,351+\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch3 id=\\\"married-filing-jointly\\\"\\u003eMarried Filing Jointly\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\u003cth\\u003eRate\\u003c/th\\u003e\\u003cth\\u003eIncome Range\\u003c/th\\u003e\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\u003ctr\\u003e\\u003ctd\\u003e10%\\u003c/td\\u003e\\u003ctd\\u003e$0 – $23,850\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e12%\\u003c/td\\u003e\\u003ctd\\u003e$23,851 – $95,500\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e22%\\u003c/td\\u003e\\u003ctd\\u003e$95,501 – $201,050\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e24%\\u003c/td\\u003e\\u003ctd\\u003e$201,051 – $383,900\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e32%\\u003c/td\\u003e\\u003ctd\\u003e$383,901 – $487,450\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e35%\\u003c/td\\u003e\\u003ctd\\u003e$487,451 – $731,200\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e37%\\u003c/td\\u003e\\u003ctd\\u003e$731,201+\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch3 id=\\\"head-of-household\\\"\\u003eHead of Household\\u003c/h3\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\u003cth\\u003eRate\\u003c/th\\u003e\\u003cth\\u003eIncome Range\\u003c/th\\u003e\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\u003ctr\\u003e\\u003ctd\\u003e10%\\u003c/td\\u003e\\u003ctd\\u003e$0 – $17,000\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e12%\\u003c/td\\u003e\\u003ctd\\u003e$17,001 – $64,850\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e22%\\u003c/td\\u003e\\u003ctd\\u003e$64,851 – $103,350\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e24%\\u003c/td\\u003e\\u003ctd\\u003e$103,351 – $197,300\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e32%\\u003c/td\\u003e\\u003ctd\\u003e$197,301 – $250,500\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e35%\\u003c/td\\u003e\\u003ctd\\u003e$250,501 – $609,350\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003e37%\\u003c/td\\u003e\\u003ctd\\u003e$609,351+\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch2 id=\\\"2026-standard-deductions\\\"\\u003e2026 Standard Deductions\\u003c/h2\\u003e\\u003cp\\u003eBefore applying the brackets, you subtract the standard deduction from your gross income:\\u003c/p\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\u003cth\\u003eFiling Status\\u003c/th\\u003e\\u003cth\\u003eStandard Deduction\\u003c/th\\u003e\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\u003ctr\\u003e\\u003ctd\\u003eSingle\\u003c/td\\u003e\\u003ctd\\u003e$16,100\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eMarried Filing Jointly\\u003c/td\\u003e\\u003ctd\\u003e$32,200\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eHead of Household\\u003c/td\\u003e\\u003ctd\\u003e$24,150\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003ch2 id=\\\"how-to-calculate-federal-income-tax-step-by-step\\\"\\u003eHow to Calculate Federal Income Tax Step by Step\\u003c/h2\\u003e\\u003ch3 id=\\\"step-1-determine-gross-income\\\"\\u003eStep 1: Determine Gross Income\\u003c/h3\\u003e\\u003cp\\u003eAdd all taxable income sources: wages, salary, self-employment income, interest, dividends, etc.\\u003c/p\\u003e\\u003ch3 id=\\\"step-2-subtract-pre-tax-deductions\\\"\\u003eStep 2: Subtract Pre-Tax Deductions\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e401(k) contributions (up to $24,500 in 2026)\\u003c/li\\u003e\\u003cli\\u003eHSA contributions (up to $4,300 single / $8,550 family)\\u003c/li\\u003e\\u003cli\\u003eTraditional IRA contributions (up to $7,000)\\u003c/li\\u003e\\u003cli\\u003eHealth insurance premiums (if self-employed)\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch3 id=\\\"step-3-subtract-the-standard-deduction\\\"\\u003eStep 3: Subtract the Standard Deduction\\u003c/h3\\u003e\\u003cp\\u003eOr itemize if your total itemized deductions exceed the standard amount.\\u003c/p\\u003e\\u003ch3 id=\\\"step-4-apply-tax-brackets-progressively\\\"\\u003eStep 4: Apply Tax Brackets Progressively\\u003c/h3\\u003e\\u003cp\\u003eTax each portion of income at the corresponding bracket rate.\\u003c/p\\u003e\\u003ch3 id=\\\"step-5-subtract-tax-credits\\\"\\u003eStep 5: Subtract Tax Credits\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003eChild Tax Credit: $2,200 per qualifying child\\u003c/li\\u003e\\u003cli\\u003eEarned Income Tax Credit (EITC): Up to $7,830\\u003c/li\\u003e\\u003cli\\u003eEducation credits: Up to $2,500\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch3 id=\\\"step-6-add-fica-tax\\\"\\u003eStep 6: Add FICA Tax\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003eSocial Security (OASDI): 6.2% up to $184,500\\u003c/li\\u003e\\u003cli\\u003eMedicare: 1.45% (no cap)\\u003c/li\\u003e\\u003cli\\u003eAdditional Medicare: 0.9% on earnings over $200,000\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch2 id=\\\"federal-income-tax-calculation-example\\\"\\u003eFederal Income Tax Calculation Example\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eScenario\\u003c/strong\\u003e: Single filer, $85,000 salary, $5,000 401(k) contribution\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 1\\u003c/strong\\u003e: Gross income = $85,000\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 2\\u003c/strong\\u003e: Subtract 401(k) = $85,000 − $5,000 = $80,000\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 3\\u003c/strong\\u003e: Subtract standard deduction = $80,000 − $16,100 = \\u003cstrong\\u003e$63,900 taxable income\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 4\\u003c/strong\\u003e: Apply brackets:\\u003c/p\\u003e\\u003cul\\u003e\\u003cli\\u003e10% on first $11,925 = $1,192.50\\u003c/li\\u003e\\u003cli\\u003e12% on $11,926–$47,750 = $4,318.50\\u003c/li\\u003e\\u003cli\\u003e22% on $47,751–$63,900 = $3,552.75\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eFederal income tax = $9,063.75\\u003c/strong\\u003e\\u003c/li\\u003e\\u003c/ul\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 5\\u003c/strong\\u003e: No credits (assume no children)\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eStep 6\\u003c/strong\\u003e: FICA = $85,000 × 7.65% = $6,502.50\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eTotal tax\\u003c/strong\\u003e: $9,063.75 + $6,502.50 = \\u003cstrong\\u003e$15,566.25\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eEffective federal tax rate\\u003c/strong\\u003e: $9,063.75 ÷ $85,000 = \\u003cstrong\\u003e10.7%\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eMarginal tax rate\\u003c/strong\\u003e: \\u003cstrong\\u003e22%\\u003c/strong\\u003e (the rate on your last dollar earned)\\u003c/p\\u003e\\u003cp\\u003eUse our \\u003ca href=\\\"/paycheck-calculator\\\"\\u003epaycheck calculator\\u003c/a\\u003e to calculate this automatically for all 50 states.\\u003c/p\\u003e\\u003ch2 id=\\\"marginal-vs-effective-tax-rate\\\"\\u003eMarginal vs. Effective Tax Rate\\u003c/h2\\u003e\\u003ch3 id=\\\"marginal-tax-rate\\\"\\u003eMarginal Tax Rate\\u003c/h3\\u003e\\u003cp\\u003eThe rate applied to your \\u003cstrong\\u003elast dollar\\u003c/strong\\u003e of taxable income. If you're a single filer making $63,900, your marginal rate is 22% because that's the bracket your top dollar falls into.\\u003c/p\\u003e\\u003ch3 id=\\\"effective-tax-rate\\\"\\u003eEffective Tax Rate\\u003c/h3\\u003e\\u003cp\\u003eYour \\u003cstrong\\u003eaverage\\u003c/strong\\u003e tax rate — total tax divided by total income. For the example above, $9,063.75 ÷ $85,000 = 10.7%. Your effective rate is always lower than your marginal rate.\\u003c/p\\u003e\\u003ch3 id=\\\"why-this-matters\\\"\\u003eWhy This Matters\\u003c/h3\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003cstrong\\u003eMarginal rate\\u003c/strong\\u003e determines the value of additional deductions (e.g., contributing $1,000 more to your 401(k) saves you $220 at the 22% marginal rate)\\u003c/li\\u003e\\u003cli\\u003e\\u003cstrong\\u003eEffective rate\\u003c/strong\\u003e shows your overall tax burden\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch2 id=\\\"how-obbba-affects-2026-federal-tax-rates\\\"\\u003eHow OBBBA Affects 2026 Federal Tax Rates\\u003c/h2\\u003e\\u003cp\\u003eThe One Big Beautiful Bill Act made several changes that affect your federal income tax calculation:\\u003c/p\\u003e\\u003cdiv class=\\\"table-wrapper\\\"\\u003e\\u003ctable\\u003e\\u003cthead\\u003e\\u003ctr\\u003e\\u003cth\\u003eOBBBA Provision\\u003c/th\\u003e\\u003cth\\u003eImpact on Tax Calculation\\u003c/th\\u003e\\u003c/tr\\u003e\\u003c/thead\\u003e\\u003ctbody\\u003e\\u003ctr\\u003e\\u003ctd\\u003eTCJA brackets permanent\\u003c/td\\u003e\\u003ctd\\u003ePrevents reversion to higher pre-TCJA rates\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eSALT cap raised to $40,400\\u003c/td\\u003e\\u003ctd\\u003eLarger deduction for itemizers in high-tax states\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eChild Tax Credit doubled to $2,200\\u003c/td\\u003e\\u003ctd\\u003eReduces tax for families with children\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eTip income deduction\\u003c/td\\u003e\\u003ctd\\u003eNew above-the-line deduction for tipped workers\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eOvertime pay deduction\\u003c/td\\u003e\\u003ctd\\u003eNew deduction for hourly workers\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eSenior deduction ($2,000)\\u003c/td\\u003e\\u003ctd\\u003eAdditional deduction for taxpayers 65+\\u003c/td\\u003e\\u003c/tr\\u003e\\u003ctr\\u003e\\u003ctd\\u003eQBI deduction (20%) permanent\\u003c/td\\u003e\\u003ctd\\u003eReduces tax for self-employed and small business\\u003c/td\\u003e\\u003c/tr\\u003e\\u003c/tbody\\u003e\\u003c/table\\u003e\\u003c/div\\u003e\\u003cp\\u003eUse our \\u003ca href=\\\"/obbba-tax-calculator\\\"\\u003eOBBBA tax calculator\\u003c/a\\u003e to compare your taxes under OBBBA vs prior law.\\u003c/p\\u003e\\u003ch2 id=\\\"federal-income-tax-rate-calculator\\\"\\u003eFederal Income Tax Rate Calculator\\u003c/h2\\u003e\\u003cp\\u003eOur \\u003ca href=\\\"/paycheck-calculator\\\"\\u003epaycheck calculator\\u003c/a\\u003e functions as a complete federal income tax rate calculator:\\u003c/p\\u003e\\u003col\\u003e\\u003cli\\u003eEnter your gross salary\\u003c/li\\u003e\\u003cli\\u003eSelect your filing status\\u003c/li\\u003e\\u003cli\\u003eChoose your state\\u003c/li\\u003e\\u003cli\\u003eAdd pre-tax deductions (401(k), HSA)\\u003c/li\\u003e\\u003cli\\u003eView your federal tax, FICA, state tax, and take-home pay\\u003c/li\\u003e\\u003c/ol\\u003e\\u003cp\\u003eThe calculator applies all 2026 federal brackets, standard deductions, and FICA rates automatically.\\u003c/p\\u003e\\u003ch2 id=\\\"frequently-asked-questions\\\"\\u003eFrequently Asked Questions\\u003c/h2\\u003e\\u003cp\\u003e\\u003cstrong\\u003eWhat is the federal income tax rate for 2026?\\u003c/strong\\u003e The federal income tax rate ranges from 10% to 37% depending on your income and filing status. Most middle-income earners fall in the 12% or 22% bracket.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eHow do I find my marginal tax rate?\\u003c/strong\\u003e Look at the 2026 bracket tables above and find the range that includes your taxable income (after deductions). The rate for that range is your marginal rate.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eWhat is the standard deduction for 2026?\\u003c/strong\\u003e $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eHow much federal tax do I pay on $75,000?\\u003c/strong\\u003e A single filer making $75,000 with the standard deduction pays approximately $7,670 in federal income tax (effective rate ~10.2%), plus $5,738 in FICA tax.\\u003c/p\\u003e\\u003cp\\u003e\\u003cstrong\\u003eDid the OBBBA change tax brackets for 2026?\\u003c/strong\\u003e The OBBBA made the existing TCJA brackets permanent, preventing them from reverting to higher pre-TCJA rates. It also raised the SALT cap and doubled the Child Tax Credit.\\u003c/p\\u003e\\u003ch2 id=\\\"related-resources\\\"\\u003eRelated Resources\\u003c/h2\\u003e\\u003cul\\u003e\\u003cli\\u003e\\u003ca href=\\\"/paycheck-calculator\\\"\\u003ePaycheck Calculator\\u003c/a\\u003e — Federal + state + FICA in one tool\\u003c/li\\u003e\\u003cli\\u003e\\u003ca href=\\\"/obbba-tax-calculator\\\"\\u003eOBBBA Tax Calculator\\u003c/a\\u003e — 2026 vs prior law comparison\\u003c/li\\u003e\\u003cli\\u003e\\u003ca href=\\\"/blog/2026-federal-tax-brackets-explained\\\"\\u003e2026 Tax Brackets Guide\\u003c/a\\u003e — Complete bracket reference\\u003c/li\\u003e\\u003cli\\u003e\\u003ca href=\\\"/blog/oasdi-tax-explained-2026\\\"\\u003eOASDI Tax Explained\\u003c/a\\u003e — Social Security tax details\\u003c/li\\u003e\\u003cli\\u003e\\u003ca href=\\\"/tax-refund-calculator\\\"\\u003eTax Refund Calculator\\u003c/a\\u003e — Estimate your refund\\u003c/li\\u003e\\u003c/ul\\u003e\\u003ch2 id=\\\"sources\\\"\\u003eSources\\u003c/h2\\u003e\\u003col\\u003e\\u003cli\\u003eIRS — Revenue Procedure 2025-25 (2026 Tax Brackets)\\u003c/li\\u003e\\u003cli\\u003eIRS — Publication 505 (Tax Withholding and Estimated Tax)\\u003c/li\\u003e\\u003cli\\u003eIRS — Form 1040 Instructions (2026)\\u003c/li\\u003e\\u003cli\\u003eOne Big Beautiful Bill Act (P.L. 119-1)\\u003c/li\\u003e\\u003c/ol\\u003e\"])</script><script>self.__next_f.push([1,\"2b:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl lg:mx-0 lg:flex-1\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-container\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$2e\\\"}}]}]\\n2c:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-3xl mt-8\\\",\\\"children\\\":[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground transition-colors\\\",\\\"children\\\":\\\"← Back to Blog\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"2d:[\\\"$\\\",\\\"$L11\\\",\\\"2026-self-employed-tax-refund-calculator\\