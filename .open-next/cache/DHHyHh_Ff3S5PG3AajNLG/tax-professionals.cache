/_next/static/chunks/5552623386487b15.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>For Tax Professionals — CPAs, EAs &amp; Tax Preparers | TheTaxCalc</title><meta name=\"description\" content=\"Free tools for tax professionals. Embeddable calculators, 2026 federal and state tax data, methodology, and client-ready tools for CPAs and EAs. No cost.\"/><link rel=\"author\" href=\"https://thetaxcalc.com/about#rachel-mitchell\"/><meta name=\"author\" content=\"Rachel Mitchell, CPA\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"finance\"/><meta name=\"classification\" content=\"Tax Calculator\"/><link rel=\"canonical\" href=\"https://thetaxcalc.com/tax-professionals\"/><meta name=\"google-site-verification\" content=\"verify_google_site_verification_token\"/><meta property=\"og:title\" content=\"For Tax Professionals — CPAs, EAs &amp; Tax Preparers\"/><meta property=\"og:description\" content=\"Free calculators, tax data, and embeddable widgets for CPAs, Enrolled Agents, and tax preparers. Updated for 2026.\"/><meta property=\"og:url\" content=\"https://thetaxcalc.com/tax-professionals\"/><meta property=\"og:site_name\" content=\"TheTaxCalc\"/><meta property=\"og:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"TheTaxCalc — Free Tools for Tax Professionals, CPAs, and EAs\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"For Tax Professionals — CPAs, EAs &amp; Tax Preparers\"/><meta name=\"twitter:description\" content=\"Free calculators, tax data, and embeddable widgets for CPAs and tax preparers.\"/><meta name=\"twitter:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script data-cfasync=\"false\">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-KWWRJFPZ');</script><script data-cfasync=\"false\">\n                  window.dataLayer = window.dataLayer || [];\n                  function gtag(){dataLayer.push(arguments);}\n                  gtag('js', new Date());\n                  gtag('config', 'G-9SEBTKFT61');\n                </script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}</script><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased bg-background text-foreground\"><div hidden=\"\"><!--$--><!--/$--></div><a href=\"#main-content\" class=\"sr-only focus:not-sr-only focus