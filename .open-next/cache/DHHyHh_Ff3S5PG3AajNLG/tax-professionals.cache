t-tax-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Self-Employment Tax Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"SE tax, deduction for employer portion, and quarterly estimate planning for Schedule C clients.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/capital-gains-calculator\\\",{\\\"href\\\":\\\"/capital-gains-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Capital Gains Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Short-term and long-term CG rates with NIIT — for investment and home sale scenarios.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/home-sale-tax-calculator\\\",{\\\"href\\\":\\\"/home-sale-tax-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Home Sale Tax Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Section 121 exclusion, depreciation recapture, and basis adjustment in one tool.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/irs-withholding-calculator\\\",{\\\"href\\\":\\\"/irs-withholding-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"IRS Withholding (W-4) Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Help clients avoid surprises at year-end by tuning their W-4 withholding.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/compare\\\",{\\\"href\\\":\\\"/compare\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[\\\"$L26\\\",\\\"$L27\\\"]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Credentialed Authors \\u0026 Reviewers\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-4\\\",\\\"children\\\":\\\"Every blog article and calculator methodology on TheTaxCalc is written or reviewed by a credentialed tax professional. Our author team includes CPAs, Enrolled Agents, and a former IRS revenue agent. Every page is dated and timestamped so you can verify that the information is current. We also publish a full author bio page for each contributor, with their credentials and a link to their firm or LinkedIn profile.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":[\\\"If you are a CPA, EA, or tax attorney interested in writing for TheTaxCalc — whether a single guest article or a recurring column — we would love to hear from you. Guest authors retain full byline credit, can include a link to their firm, and help shape the conversation around tax literacy. Email\\\",\\\" \\\",[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"mailto:hello@thetaxcalc.com\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"hello@thetaxcalc.com\\\"}],\\\" \\\",\\\"to discuss.\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1d:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6\\\",\\\"children\\\":\\\"FAQ for Tax Professionals\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Is TheTaxCalc free for tax professionals to use?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Is TheTaxCalc free for tax professionals to use?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Yes. Every calculator, data page, and resource on TheTaxCalc is free for tax professionals, including CPAs, Enrolled Agents, tax attorneys, and non-credentialed preparers. There are no premium tiers, no per-client fees, and no usage caps. You can use our tools during client meetings, link to our calculators in client emails, or embed them on your firm website at no cost. We do not collect your clients' financial information — every calculation runs in the browser.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Can I embed TheTaxCalc calculators on my firm website?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Can I embed TheTaxCalc calculators on my firm website?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Yes. We provide embeddable calculator widgets for paycheck estimation, tax refund estimation, mortgage amortization, capital gains, and more. The widgets are free, white-labeled (no TheTaxCalc branding required if you prefer), and run entirely client-side so no data ever passes through your servers. Visit our widgets page to grab the embed code, or contact us if you need a custom integration. Embedding is a great way to add value to your firm website without building calculators yourself.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"How do you source your 2026 tax data?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"How do you source your 2026 tax data?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We source every figure from the official IRS publications (Rev. Proc. 2025-25 for inflation-adjusted brackets, Publication 15-T for withholding tables, Publication 972 for the Child Tax Credit), the Social Security Administration for the FICA wage base ($184,500 for 2026), and each state's Department of Revenue for state income tax brackets, standard deductions, and personal exemptions. Our full methodology is published at /methodology and is updated within 48 hours of any official change. We also cite the One Big Beautiful Bill Act (P.L. 119-1) for OBBBA provisions.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Can I use TheTaxCalc calculators during client meetings?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Can I use TheTaxCalc calculators during client meetings?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Absolutely. Many tax professionals project our paycheck calculator or state comparison tool on a screen during client meetings to illustrate the impact of a salary increase, a relocation, or a filing-status change. Because calculations run client-side, the page loads instantly and works without an internet connection once cached. You can also share links to specific calculator scenarios with clients before or after meetings. There are no per-meeting or per-client fees — use it as often as you like.\\\"}]]}],\\\"$L28\\\",\\\"$L29\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1e:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-3\\\",\\\"children\\\":\\\"Have a Question or Request?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-4 max-w-2xl mx-auto\\\",\\\"children\\\":\\\"Whether you need a calculator type we don’t offer, want to embed a widget on your firm site, or want to write for us — we want to hear from you.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"mailto:hello@thetaxcalc.com\\\",\\\"className\\\":\\\"inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-500 px-6 py-3 text-sm font-medium text-white hover:from-emerald-500 hover:to-emerald-400 transition-colors\\\",\\\"children\\\":\\\"Contact Our Team\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-sm text-muted-foreground\\\",\\\"children\\\":[\\\"Or explore our\\\",\\\" \\\",[\\\"$\\\",\\\"$L10\\\",null,{\\\"href\\\":\\\"/methodology\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"methodology page\\\"}],\\\" \\\",\\\"and\\\",\\\" \\\",[\\\"$\\\",\\\"$L10\\\",null,{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"about page\\\"}],\\\" \\\",\\\"to learn more.\\\"]}]]}]}]\\n1f:[\\\"$\\\",\\\"$L2a\\\",null,{\\\"children\\\":[\\\"$\\\",\\\"$23\\\",null,{\\\"name\\\":\\\"Next.MetadataOutlet\\\",\\\"children\\\":\\\"$@2b\\\"}]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"State Comparison Tool\\\"}]\\n27:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Compare any two states side-by-side on income tax, property tax, and sales tax.\\\"}]\\n28:[\\\"$\\\",\\\"div\\\",\\\"Do you offer an API for tax calculation data?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Do you offer an API for tax calculation data?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Not currently. All of our calculators run client-side in JavaScript, and the underlying tax data is published openly on our tax data page and methodology page. If you need bulk access to our federal or state tax bracket data for an internal tool, you can scrape the data tables directly or contact us at hello@thetaxcalc.com to discuss a data export. We do not currently offer a paid or free API endpoint, but we are evaluating demand for one.\\\"}]]}]\\n29:[\\\"$\\\",\\\"div\\\",\\\"How can tax professionals contribute to TheTaxCalc?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"How can tax professionals contribute to TheTaxCalc?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We welcome contributions from credentialed tax professionals. You can submit corrections or updates via email, write guest articles for our blog (we attribute every piece to a credentialed author), or volunteer to review new calculators before they go live. CPAs and EAs who contribute regularly are listed on our authors page with their credentials and a link to their firm. If you would like to contribute, email hello@thetaxcalc.com with your credentials and the topic you would like to cover.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"21:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"])</script><script>self.__next_f.push([1,\"2c:I[27201,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/61cc43b3d7ad2990.js\\\"],\\\"IconMark\\\"]\\n\"])</script><script>self.__next_f.push([1,\"24:[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"For Tax Professionals — CPAs, EAs \\u0026 Tax Preparers | TheTaxCalc\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Free tools for tax professionals. Embeddable calculators, 2026 federal and state tax data, methodology, and client-ready tools for CPAs and EAs. No cost.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"author\\\",\\\"href\\\":\\\"https://thetaxcalc.com/about#rachel-mitchell\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"Rachel Mitchell, CPA\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"TheTaxCalc\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"TheTaxCalc\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"googlebot\\\",\\\"content\\\":\\\"index, follow, max-video-preview:-1, max-image-preview:large, max-sni