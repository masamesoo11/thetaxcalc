/30 transition-colors\",\"children\":\"Blog\"}],[\"$\",\"$L10\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}],[\"$\",\"$L10\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L10\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}],[\"$\",\"$L10\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L10\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n14:[\"$\",\"$L25\",null,{}]\n16:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"For Tax Professionals\"}]]}]\n17:[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"For Tax Professionals — Free Tools for CPAs, EAs & Preparers\"}]\n18:[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed mb-8\",\"children\":\"TheTaxCalc is used by Certified Public Accountants, Enrolled Agents, tax attorneys, and non-credentialed preparers across the country. Every calculator on our site is free for professional use — during client meetings, in research, embedded on firm websites, and in continuing education materials. No sign-up, no per-client fees, no data collection.\"}]\n19:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"What We Offer Professionals\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Embeddable Calculator Widgets\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Add a free paycheck, mortgage, or tax refund calculator to your firm website. White-labeled, mobile-responsive, and entirely client-side — your clients’ data never touches your servers or ours.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"All 50 State Tax Profiles\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Each state has its own calculator with current 2026 brackets, standard deductions, and personal exemptions — sourced from each state’s Department of Revenue. Perfect for multi-state return preparation and client relocations.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"2026 OBBBA Comparison Tool\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA tax calculator compares your clients’ 2026 federal income tax under the new One Big Beautiful Bill Act against what they would have paid if the TCJA had sunset. Includes the $40,400 SALT cap, $2,200 CTC, and tip/overtime deductions.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Full Published Methodology\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every formula, source, and assumption is documented on our methodology page. Cite us in client memos, share the link with skeptical clients, or use our data tables in your own research. All sources are official IRS, SSA, and state revenue department publications.\"}]]}]]}]]}]\n1a:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Why Tax Professionals Use TheTaxCalc\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"Professional preparers tell us they use TheTaxCalc for three reasons. First, our calculators load instantly and work without an account — perfect for showing a client the impact of a salary increase or a relocation mid-meeting. Second, our data is current and fully sourced. We update federal figures within 48 hours of any IRS publication, and our state data is sourced directly from each state’s revenue department. Third, because all calculations run client-side, there are no data privacy concerns about client income passing through a third-party server.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Many firms also use our free embeddable widgets to add interactive calculators to their own websites without paying for a vendor solution. The widgets can be styled to match your firm’s brand, and there is no per-visitor fee or usage cap. If you need a calculator type we don’t currently offer, we accept requests and often build requested tools within a few weeks.\"}]]}]\n1b:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Most-Used Calculators for Professionals\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L10\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Paycheck Calculator (50 States)\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Show clients their take-home pay in any state — useful for relocations and offer evaluation.\"}]]}],[\"$\",\"$L10\",\"/obbba-tax-calculator\",{\"href\":\"/obbba-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"OBBBA Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare 2026 federal tax under OBBBA vs prior law. Includes SALT cap, CTC, tip & overtime.\"}]]}],[\"$\",\"$L10\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Quick refund estimate based on withholding, credits, and filing status.\"}]]}],[\"$\",\"$L10\",\"/self-employment-tax-calculator\",{\"href\":\"/self-employment-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Self-Employment Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"SE tax, deduction for employer portion, and quarterly estimate planning for Schedule C clients.\"}]]}],[\"$\",\"$L10\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Capital Gains Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Short-term and long-term CG rates with NIIT — for investment and home sale scenarios.\"}]]}],[\"$\",\"$L10\",\"/home-sale-tax-calculator\",{\"href\":\"/home-sale-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Home Sale Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Section 121 exclusion, depreciation recapture, and basis adjustment in one tool.\"}]]}],[\"$\",\"$L10\",\"/irs-withholding-calculator\",{\"href\":\"/irs-withholding-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"IRS Withholding (W-4) Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Help clients avoid surprises at year-end by tuning their W-4 withholding.\"}]]}],[\"$\",\"$L10\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[\"$L26\",\"$L27\"]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Credentialed Authors & Reviewers\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"Every blog article and calculator methodology on TheTaxCalc is written or reviewed by a credentialed tax professional. Our author team includes CPAs, Enrolled Agents, and a former IRS revenue agent. Every page is dated and timestamped so you can verify that the information is current. We also publish a full author bio page for each contributor, with their credentials and a link to their firm or LinkedIn profile.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"If you are a CPA, EA, or tax attorney interested in writing for TheTaxCalc — whether a single guest article or a recurring column — we would love to hear from you. Guest authors retain full byline credit, can include a link to their firm, and help shape the conversation around tax literacy. Email\",\" \",[\"$\",\"a\",null,{\"href\":\"mailto:hello@thetaxcalc.com\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"hello@thetaxcalc.com\"}],\" \",\"to discuss.\"]}]]}]\n1d:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"FAQ for Tax Professionals\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"Is TheTaxCalc free for tax professionals to use?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Is TheTaxCalc free for tax professionals to use?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Every calculator, data page, and resource on TheTaxCalc is free for tax professionals, including CPAs, Enrolled Agents, tax attorneys, and non-credentialed preparers. There are no premium tiers, no per-client fees, and no usage caps. You can use our tools during client meetings, link to our calculators in client emails, or embed them on your firm website at no cost. We do not collect your clients' financial information — every calculation runs in the browser.\"}]]}],[\"$\",\"div\",\"Can I embed TheTaxCalc calculators on my firm website?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Can I embed TheTaxCalc calculators on my firm website?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. We provide embeddable calculator widgets for paycheck estimation, tax refund estimation, mortgage amortization, capital gains, and more. The widgets are free, white-labeled (no TheTaxCalc branding required if you prefer), and run entirely client-side so no data ever passes through your servers. Visit our widgets page to grab the embed code, or contact us if you need a custom integration. Embedding is a great way to add value to your firm website without building calculators yourself.\"}]]}],[\"$\",\"div\",\"How do you source your 2026 tax data?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How do you source your 2026 tax data?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We source every figure from the official IRS publications (Rev. Proc. 2025-25 for inflation-adjusted brackets, Publication 15-T for withholding tables, Publication 972 for the Child Tax Credit), the Social Security Administration for the FICA wage base ($184,500 for 2026), and each state's Department of Revenue for state income tax brackets, standard deductions, and personal exemptions. Our full methodology is published at /methodology and is updated within 48 hours of any official change. We also cite the One Big Beautiful Bill Act (P.L. 119-1) for OBBBA provisions.\"}]]}],[\"$\",\"div\",\"Can I use TheTaxCalc calculators during client meetings?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Can I use TheTaxCalc calculators during client meetings?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Absolutely. Many tax professionals project our paycheck calculator or state comparison tool on a screen during client meetings to illustrate the impact of a salary increase, a relocation, or a filing-status change. Because calculations run client-side, the page loads instantly and works without an internet connection once cached. You can also share links to specific calculator scenarios with clients before or after meetings. There are no per-meeting or per-client fees — use it as often as you like.\"}]]}],\"$L28\",\"$L29\"]}]]}]\n1e:[\"$\",\"section\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 text-center\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-3\",\"children\":\"Have a Question or Request?\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4 max-w-2xl mx-auto\",\"children\":\"Whether you need a calculator type we don’t offer, want to embed a widget on your firm site, or want to write for us — we want to hear from you.\"}],[\"$\",\"a\",null,{\"href\":\"mailto:hello@thetaxcalc.com\",\"className\":\"inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-500 px-6 py-3 text-sm font-medium text-white hover:from-emerald-500 hover:to-emerald-400 transition-colors\",\"children\":\"Contact Our Team\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground\",\"children\":[\"Or explore our\",\" \",[\"$\",\"$L10\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"methodology page\"}],\" \",\"and\",\" \",[\"$\",\"$L10\",null,{\"href\":\"/about\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"about page\"}],\" \",\"to learn more.\"]}]]}]}]\n1f:[\"$\",\"$L2a\",null,{\"children\":[\"$\",\"$23\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2b\"}]}]\n26:[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"State Comparison Tool\"}]\n27:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare any two states side-by-side on income tax, property tax, and sales tax.\"}]\n28:[\"$\",\"div\",\"Do you offer an API for tax calculation data?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Do you offer an API for tax calculation data?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Not currently. All of our calculators run client-side in JavaScript, and the underlying tax data is published openly on our tax data page and methodology page. If you need bulk access to our federal or state tax bracket data for an internal tool, you can scrape the data tables directly or contact us at hello@thetaxcalc.com to discuss a data export. We do not currently offer a paid or free API endpoint, but we are evaluating demand for one.\"}]]}]\n29:[\"$\",\"div\",\"How can tax professionals contribute to TheTaxCalc?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How can tax professionals contribute to TheTaxCalc?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We welcome contributions from credentialed tax professionals. You can submit corrections or updates via email, write guest articles for our blog (we attribute every piece to a credentialed author), or volunteer to review new calculators before they go live. CPAs and EAs who contribute regularly are listed on our authors page with their credentials and a link to their firm. If you would like to contribute, email hello@thetaxcalc.com with your credentials and the topic you would like to cover.\"}]]}]\n21:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2c:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n24:[[\"$\",\"title\",\"0\",{\"children\":\"For Tax Professionals — CPAs, EAs & Tax Preparers | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Free tools for tax professionals. Embeddable calculators, 2026 federal and state tax data, methodology, and client-ready tools for CPAs and EAs. No cost.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/tax-professionals\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"For Tax Professionals — CPAs, EAs & Tax Preparers\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Free calculators, tax data, and embeddable widgets for CPAs, Enrolled Agents, and tax preparers. Updated for 2026.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/tax-professionals\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:alt\",\"content\":\"TheTaxCalc — Free Tools for Tax Professionals, CPAs, and EAs\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"For Tax Professionals — CPAs, EAs & Tax Preparers\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"Free calculators, tax data, and embeddable widgets for CPAs and tax preparers.\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"26\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2c\",\"27\",{}]]\n2b:null\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/34d933785a17edf3.css\",\"style\"]\n:HL[\"/_next/static/chunks/bfd6eb476abf7f9c.css\",\"style\"]\n:HL[\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"tree\":{\"name\":\"\",\"paramType\":null,\"paramKey\":\"\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"tax-professionals\",\"paramType\":null,\"paramKey\":\"tax-professionals\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"paramType\":null,\"paramKey\":\"__PAGE__\",\"hasRuntimePrefetch\":false,\"slots\":null,\"isRootLayout\":false}},\"isRootLayout\":false}},\"isRootLayout\":true},\"staleTime\":300}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"ClientAnalytics\"]\n8:I[63491,[\"/_next/static/chunks/c322938c6693d41b.js\"],\"default\"]\n:HL[\"/_next/static/chunks/34d933785a17edf3.css\",\"style\"]\n:HL[\"/_next/static/chunks/bfd6eb476abf7f9c.css\",\"style\"]\n:HL[\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n3:T670,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https:/