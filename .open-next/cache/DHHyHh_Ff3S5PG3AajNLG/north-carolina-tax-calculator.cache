ext/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"LinkToUs\"]\n2:T176a,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#webpage\",\"@type\":\"WebPage\",\"url\":\"https://thetaxcalc.com/north-carolina-tax-calculator\",\"name\":\"North Carolina Tax Calculator 2026\",\"description\":\"Free North Carolina paycheck calculator with 4.5% flat state income tax for 2026 take-home pay estimates.\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-06-25\",\"author\":{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#author\"}},{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"North Carolina Tax Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"North Carolina Tax Calculator 2026\",\"url\":\"https://thetaxcalc.com/north-carolina-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/north-carolina-tax-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/north-carolina-tax-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much is North Carolina state income tax in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"North Carolina uses a flat 4.5% rate on all taxable income — one rate, no brackets, simple math. The rate has been gradually coming down over the years and is now one of the lower flat rates in the Southeast. Whether that's good or bad depends on your income, but compared to progressive states where the top rate can exceed 9%, 4.5% looks pretty reasonable.\"}},{\"@type\":\"Question\",\"name\":\"What is the North Carolina standard deduction for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"$12,750 for single filers, $25,500 for married filing jointly, and $19,125 for head of household. These are actually pretty generous compared to neighboring states — Georgia only offers $5,400 single / $7,100 married, and South Carolina doesn't have its own standard deduction at all. The NC standard deduction is subtracted from your federal AGI before the 4.5% rate applies.\"}},{\"@type\":\"Question\",\"name\":\"Does North Carolina have a personal exemption?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nope. North Carolina eliminated personal exemptions a while back. Your only deduction before the flat rate is the standard deduction. But honestly, with a $12,750 standard deduction for single filers, you're already getting a bigger break than states like Illinois ($2,775 personal exemption, no standard deduction) or Michigan ($5,500 personal exemption, no standard deduction).\"}},{\"@type\":\"Question\",\"name\":\"Does North Carolina tax Social Security benefits?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, North Carolina does not tax Social Security benefits. The state also doesn't tax most pension income for retirees who meet certain requirements. Combined with the low 4.5% flat rate and that generous standard deduction, North Carolina is actually one of the more tax-friendly states in the Southeast for retirees — especially compared to Georgia's 5.49% rate.\"}},{\"@type\":\"Question\",\"name\":\"How does North Carolina compare to neighboring states for taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"North Carolina's 4.5% flat rate is lower than Georgia's 5.49% and Virginia's top rate of 5.75%. South Carolina has a top rate of 6.4% but uses the federal standard deduction, while Tennessee and Florida have zero income tax. Property taxes in NC are quite reasonable at about 0.82% average effective rate, and the combined sales tax averages around 7.1% (4.75% state + local). Overall, NC sits in a nice middle ground — not as tax-free as Florida or Tennessee, but definitely on the lower end for states that do have income tax.\"}},{\"@type\":\"Question\",\"name\":\"Is North Carolina tax-friendly for retirees?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Surprisingly, yes. No tax on Social Security, low flat income tax rate, generous standard deductions, and moderate property taxes. The 4.5% rate on non-Social Security income is well below what you'd pay in most Northeastern or Midwestern states. And if you're a married couple filing jointly, that $25,500 standard deduction shields a big chunk of your retirement income from state tax entirely. North Carolina's been attracting a lot of retirees for good reason.\"}}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],[\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"],\"$Le\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"North Carolina\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$L10\",null,{\"url\":\"https://thetaxcalc.com/north-carolina-tax-calculator\",\"title\":\"North Carolina Tax Calculator 2026 | 4.5% Flat Rate\",\"description\":\"Free North Carolina tax calculator 2026. Take-home pay after 4.5% flat tax and $12,750 standard deduction. No sign-up.\"}]}]\n5:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Free North Carolina Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Calculate your 2026 North Carolina take-home pay after 4.5% flat state tax, federal tax & FICA. Standard deduction $12,750. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":\"Last reviewed: January 2026 · Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]\n6:[\"$\",\"$L11\",null,{\"componentKey\":\"northcarolina\"}]\n7:[\"$\",\"$L12\",null,{\"calculatorType\":\"northcarolina\",\"calculatorSlug\":\"north-carolina-tax-calculator\"}]\n8:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"Related Tools & Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$Lf\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💵\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Full take-home pay breakdown\"}]]}]]}],[\"$\",\"$Lf\",\"/georgia-tax-calculator\",{\"href\":\"/georgia-tax-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏠\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Georgia Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare GA 5.49% vs NC 4.5%\"}]]}]]}],[\"$\",\"$Lf\",\"/relocation-calculator\",{\"href\":\"/relocation-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📊\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Relocation Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare NC to other states\"}]]}]]}],[\"$\",\"$Lf\",\"/salary\",{\"href\":\"/salary\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Salary After Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home pay at every level\"}]]}]]}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"North Carolina charges a flat 4.5% income tax rate for 2026. One rate, no brackets, no surprises. The state has been steadily reducing its flat rate over the past few years, dropping from 5.25% down to the current 4.5%. North Carolina offers a standard deduction of $12,750 for single filers and $25,500 for married filing jointly — that's one of the highest state standard deductions in the country, which softens the impact of the flat rate considerably.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Let's run the numbers. A single person earning $75,000: after the $12,750 standard deduction, taxable income is $62,250. North Carolina tax comes to $2,801.25. Add federal tax and FICA, and you're looking at roughly $58,500 take-home. That's competitive with most flat-tax states, and the generous standard deduction means lower-income earners pay very little state tax.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"North Carolina doesn't tax Social Security benefits at the state level, which is good news for retirees. Property taxes average about 0.82% — quite reasonable. The combined state and local sales tax averages around 7.1%. Compared to <a href=\\\"/georgia-tax-calculator\\\">Georgia's 5.49%</a> or <a href=\\\"/illinois-tax-calculator\\\">Illinois' 4.95%</a>, North Carolina's 4.5% rate is actually the lowest among neighboring flat-tax states. <a href=\\\"/relocation-calculator\\\">Run the relocation calculator</a> to compare for your specific salary.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\",\"children\":\"NC State Tax = (Gross Income − NC Standard Deduction) × 4.5%\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Step-by-Step\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":1}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract NC standard deduction ($12,750 single / $25,500 married) from gross income\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":2}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply NC flat 4.5% rate to state taxable income\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}],\"$L13\"]}],\"$L14\",\"$L15\"]}]]}],\"$L16\",\"$L17\"]}]]}],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/6bcaf73165d03f74.js\",\"async\":true}]\nb:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"async\":true}]\nc:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/474ace38d7992a17.js\",\"async\":true}]\nd:[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/c9e031433494c7b2.js\",\"async\":true}]\ne:[\"$\",\"$L20\",null,{\"children\":[\"$\",\"$21\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@22\"}]}]\n13:[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Add federal tax (10%–37% progressive brackets) and FICA (7.65%)\"}]\n14:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":4}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract pre-tax deductions (401(k), HSA) from both federal and state calculations\"}]]}]\n15:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":5}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Sum all taxes and subtract from gross pay for net take-home\"}]]}]\n16:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Example\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"$$75,000 salary, single in NC: NC deduction $12,750. NC taxable = $62,250. NC tax = $2,801. Federal ≈ $7,670. FICA = $5,738. Net ≈ $58,791.\"}]]}]\n17:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"For detailed data sources and full methodology, see our \",[\"$\",\"$Lf\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Methodology & Data Sources\"}],\" page.\"]}]\n18:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Key Rates & Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"NC Flat Tax Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/