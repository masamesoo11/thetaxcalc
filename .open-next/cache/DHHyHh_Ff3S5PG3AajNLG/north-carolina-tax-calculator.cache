\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📝 Tax Guides & Blog\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Expert tax tips & guides\"}]]}]]}]]}]\n22:null\n23:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does North Carolina tax Social Security benefits?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"No, North Carolina does not tax Social Security benefits. The state also doesn't tax most pension income for retirees who meet certain requirements. Combined with the low 4.5% flat rate and that generous standard deduction, North Carolina is actually one of the more tax-friendly states in the Southeast for retirees — especially compared to Georgia's 5.49% rate.\"}]]}]\n24:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How does North Carolina compare to neighboring states for taxes?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"North Carolina's 4.5% flat rate is lower than Georgia's 5.49% and Virginia's top rate of 5.75%. South Carolina has a top rate of 6.4% but uses the federal standard deduction, while Tennessee and Florida have zero income tax. Property taxes in NC are quite reasonable at about 0.82% average effective rate, and the combined sales tax averages around 7.1% (4.75% state + local). Overall, NC sits in a nice middle ground — not as tax-free as Florida or Tennessee, but definitely on the lower end for states that do have income tax.\"}]]}]\n25:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is North Carolina tax-friendly for retirees?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Surprisingly, yes. No tax on Social Security, low flat income tax rate, generous standard deductions, and moderate property taxes. The 4.5% rate on non-Social Security income is well below what you'd pay in most Northeastern or Midwestern states. And if you're a married couple filing jointly, that $25,500 standard deduction shields a big chunk of your retirement income from state tax entirely. North Carolina's been attracting a lot of retirees for good reason.\"}]]}]\n27:[\"$\",\"$Lf\",\"colorado-tax-calculator\",{\"href\":\"/colorado-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-3 py-1.5 text-sm hover:bg-accent/50 transition-colors\",\"children\":[\"Colorado\",[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"(\",\"4.4%\",\")\"]}]]}]\n28:[\"$\",\"$Lf\",\"arizona-tax-calculator\",{\"href\":\"/arizona-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-3 py-1.5 text-sm hover:bg-accent/50 transition-colors\",\"children\":[\"Arizona\",[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"(\",\"2.5%\",\")\"]}]]}]\n29:[\"$\",\"$Lf\",\"washington-tax-calculator\",{\"href\":\"/washington-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-3 py-1.5 text-sm hover:bg-accent/50 transition-colors\",\"children\":[\"Washington\",[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"(\",\"0%\",\")\"]}]]}]\n2a:[\"$\",\"$Lf\",\"massachusetts-tax-calculator\",{\"href\":\"/massachusetts-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-3 py-1.5 text-sm hover:bg-accent/50 transition-colors\",\"children\":[\"Massachusetts\",[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"(\",\"5%/9%\",\")\"]}]]}]\n2b:[\"$\",\"$Lf\",\"indiana-tax-calculator\",{\"href\":\"/indiana-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-border/50 px-3 py-1.5 text-sm hover:bg-accent/50 trans