",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Georgia Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare GA 5.49% vs NC 4.5%\"}]]}]]}],[\"$\",\"$L10\",\"/relocation-calculator\",{\"href\":\"/relocation-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📊\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Relocation Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare NC to other states\"}]]}]]}],[\"$\",\"$L10\",\"/salary\",{\"href\":\"/salary\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Salary After Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home pay at every level\"}]]}]]}]]}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"North Carolina charges a flat 4.5% income tax rate for 2026. One rate, no brackets, no surprises. The state has been steadily reducing its flat rate over the past few years, dropping from 5.25% down to the current 4.5%. North Carolina offers a standard deduction of $12,750 for single filers and $25,500 for married filing jointly — that's one of the highest state standard deductions in the country, which softens the impact of the flat rate considerably.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Let's run the numbers. A single person earning $75,000: after the $12,750 standard deduction, taxable income is $62,250. North Carolina tax comes to $2,801.25. Add federal tax and FICA, and you're looking at roughly $58,500 take-home. That's competitive with most flat-tax states, and the generous standard deduction means lower-income earners pay very little state tax.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"North Carolina doesn't tax Social Security benefits at the state level, which is good news for retirees. Property taxes average about 0.82% — quite reasonable. The combined state and local sales tax averages around 7.1%. Compared to <a href=\\\"/georgia-tax-calculator\\\">Georgia's 5.49%</a> or <a href=\\\"/illinois-tax-calculator\\\">Illinois' 4.95%</a>, North Carolina's 4.5% rate is actually the lowest among neighboring flat-tax states. <a href=\\\"/relocation-calculator\\\">Run the relocation calculator</a> to compare for your specific salary.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\",\"children\":\"NC State Tax = (Gross Income − NC Standard Deduction) × 4.5%\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Step-by-Step\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":1}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract NC standard deduction ($12,750 single / $25,500 married) from gross income\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":2}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply NC flat 4.5% rate to state taxable income\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}],\"$L29\"]}],\"$L2a\",\"$L2b\"]}]]}],\"$L2c\",\"$L2d\"]}]]}],\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\"]}]\n39:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"LinkToUs\"]\n29:[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Add federal tax (10%–37% progressive brackets) and FICA (7.65%)\"