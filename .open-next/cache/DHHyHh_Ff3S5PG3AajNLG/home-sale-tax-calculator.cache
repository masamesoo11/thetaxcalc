old uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"NIIT Rate\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"3.8%\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Residency Test\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Residency Test\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"2 of 5 years\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"0% Rate Threshold (Single)\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"0% Rate Threshold (Single)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"~$47,000 taxable income\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"0% Rate Threshold (MFJ)\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"0% Rate Threshold (MFJ)\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"~$94,000 taxable income\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2d:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6\\\",\\\"children\\\":\\\"Home Sale Tax Calculator FAQ\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"How much capital gains tax will I pay when I sell my house?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"It depends on your profit, filing status, and how long you lived in the home. If it's your primary residence and you meet the 2-of-5-year test, you can exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain. Any remaining gain is taxed at long-term capital gains rates: 0%, 15%, or 20%, depending on your taxable income. High earners may also pay an additional 3.8% Net Investment Income Tax (NIIT).\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"What is the Section 121 primary residence exclusion?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Section 121 of the Internal Revenue Code lets you exclude up to $250,000 of capital gains from the sale of your primary residence if you're single, or $500,000 if married filing jointly. To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. You can only use this exclusion once every 2 years.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"What if I don't meet the 2-of-5-year residency test?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"If you don't meet the full 2-year residency requirement, you may qualify for a partial exclusion if the sale was due to a change in employment, health reasons, or unforeseen circumstances (like divorce or natural disaster). The partial exclusion is prorated based on the time you lived in the home. For example, if you lived there 1 year out of 5, you'd get half the exclusion: $125,000 (single) or $250,000 (MFJ).\\\"}]]}],\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",\\\"$L36\\\",\\\"$L37\\\",\\\"$L38\\\",\\\"$L39\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2e:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-lg font-semibold text-foreground mb-4\\\",\\\"children\\\":\\\"Related Calculators\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",\\\"capital-gains-calculator\\\",{\\\"href\\\":\\\"/capital-gains-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-3.5 w-3.5\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M13 7l5 5m0 0l-5 5m5-5H6\\\"}]}],\\\"Capital Gains Calculator\\\"]}],[\\\"$\\\",\\\"$L10\\\",\\\"property-tax-calculator\\\",{\\\"href\\\":\\\"/property-tax-calculator\\\",\\\"className\\\":\\\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\\\",\\\"chil