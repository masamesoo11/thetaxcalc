lary Explorer\"}],[\"$\",\"$L10\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L10\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n14:[\"$\",\"$L1d\",null,{}]\n1e:T2a04,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Home Sale Tax Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#webpage\",\"@type\":\"WebPage\",\"name\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"description\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on the sale of your home, rental property, or second home. Includes $250K/$500K exclusion, cost basis, and depreciation recapture.\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-02-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"Home Sale Tax Calculator\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#howto\",\"@type\":\"HowTo\",\"name\":\"How to Calculate Capital Gains on a Home Sale\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Determine your cost basis\",\"text\":\"Add your purchase price to capital improvements and subtract any depreciation claimed. This gives you the adjusted cost basis of the property.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Calculate your capital gain\",\"text\":\"Subtract your adjusted cost basis and selling costs (commissions, closing costs) from the sale price. The result is your total capital gain.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Apply the primary residence exclusion\",\"text\":\"If you lived in the home for 2 of the last 5 years, subtract $250,000 (single) or $500,000 (MFJ) from the gain. Partial exclusion if under 2 years.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Calculate tax on the remaining gain\",\"text\":\"Apply the long-term capital gains rate (0%, 15%, or 20%) to the taxable gain. Add 3.8% NIIT if your income exceeds $200K/$250K.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Add depreciation recapture tax\",\"text\":\"If you claimed depreciation (rental property), multiply the accumulated depreciation by 25%. Add this to your capital gains tax for the total tax owed.\"}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much capital gains tax will I pay when I sell my house?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on your profit, filing status, and how long you lived in the home. If it's your primary residence and you meet the 2-of-5-year test, you can exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain. Any remaining gain is taxed at long-term capital gains rates: 0%, 15%, or 20%, depending on your taxable income. High earners may also pay an additional 3.8% Net Investment Income Tax (NIIT).\"}},{\"@type\":\"Question\",\"name\":\"What is the Section 121 primary residence exclusion?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Section 121 of the Internal Revenue Code lets you exclude up to $250,000 of capital gains from the sale of your primary residence if you're single, or $500,000 if married filing jointly. To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. You can only use this exclusion once every 2 years.\"}},{\"@type\":\"Question\",\"name\":\"What if I don't meet the 2-of-5-year residency test?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you don't meet the full 2-year residency requirement, you may qualify for a partial exclusion if the sale was due to a change in employment, health reasons, or unforeseen circumstances (like divorce or natural disaster). The partial exclusion is prorated based on the time you lived in the home. For example, if you lived there 1 year out of 5, you'd get half the exclusion: $125,000 (single) or $250,000 (MFJ).\"}},{\"@type\":\"Question\",\"name\":\"How is cost basis calculated for a home sale?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your cost basis is the original purchase price of the home plus the cost of capital improvements (not repairs or maintenance) minus any depreciation claimed. Capital improvements include things like a new roof, room addition, or major renovation. Routine repairs like painting or fixing a leaky faucet don't count. The higher your cost basis, the lower your capital gain.\"}},{\"@type\":\"Question\",\"name\":\"What is depreciation recapture on a rental property sale?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"When you sell a rental property, you must \\\"recapture\\\" the depreciation you claimed (or could have claimed) over the years. This recaptured depreciation is taxed at a flat 25% rate, not at the regular capital gains rate. This applies even if you didn't actually claim depreciation on your tax returns — the IRS treats it as \\\"allowed or allowable.\\\" Depreciation recapture is reported on Form 4797 and Schedule D.\"}},{\"@type\":\"Question\",\"name\":\"Do I pay capital gains tax if I sell my house at a loss?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you sell your primary residence at a loss, you generally cannot deduct the loss on your tax return. The IRS does not allow you to claim a capital loss on the sale of a personal residence. However, if the property was a rental or investment property, you may be able to deduct the loss as a capital loss, subject to the usual capital loss limitations ($3,000 per year against ordinary income, with carryforward).\"}},{\"@type\":\"Question\",\"name\":\"What is the 3.8% Net Investment Income Tax (NIIT)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The NIIT is an additional 3.8% tax on investment income (including capital gains from home sales) that applies to high-income taxpayers. It kicks in when your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (married filing jointly). The tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. This is on top of the regular capital gains tax.\"}},{\"@type\":\"Question\",\"name\":\"Can I avoid capital gains tax with a 1031 exchange?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A 1031 exchange (like-kind exchange) lets you defer capital gains tax by reinvesting the proceeds from the sale of an investment or rental property into a similar property. Important: 1031 exchanges do NOT apply to primary residences — only to investment and business properties. You must identify a replacement property within 45 days and close within 180 days. This defers the tax, it doesn't eliminate it permanently.\"}},{\"@type\":\"Question\",\"name\":\"What counts as a capital improvement vs. a repair?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Capital improvements add to your cost basis and include projects that add value, prolong the home's life, or adapt it to a new use — like adding a room, installing central air, replacing the roof, or finishing a basement. Repairs maintain the home in good condition but don't add value — like fixing a leak, repainting, or replacing a broken window. Only capital improvements increase your cost basis; repairs do not.\"}},{\"@type\":\"Question\",\"name\":\"How does selling a second home differ from a primary residence?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Second homes (vacation homes) do not qualify for the Section 121 primary residence exclusion — you'll pay capital gains tax on the entire gain. However, if you convert your second home to your primary residence and live in it for at least 2 of 5 years before selling, you may qualify for a partial exclusion (subject to the 5-year look-back rule for non-qualified use periods). The gain is still taxed at long-term capital gains rates.\"}},{\"@type\":\"Question\",\"name\":\"What are the capital gains tax rates for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For 2026, long-term capital gains (assets held over 1 year) are taxed at three rates: 0% for taxable income up to roughly $47,000 (single) or $94,000 (MFJ), 15% for income up to roughly $518,000 (single) or $583,000 (MFJ), and 20% for income above those thresholds. Short-term gains (assets held 1 year or less) are taxed at ordinary income rates. The 3.8% NIIT applies on top for high earners.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to report the sale of my home to the IRS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, you must report the sale on your tax return using Schedule D and Form 8949, even if the entire gain is excluded under Section 121. If you receive a Form 1099-S (Proceeds from Real Estate Transactions), the IRS already knows about the sale, and failing to report it can trigger a notice. If no Form 1099-S was issued and the entire gain is excludable, you still need to report it, but you won't owe any tax.\"}}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}]}15:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1e\"}}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\"]}]\n25:I[79086,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"ShareButtons\"]\n26:I[18631,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"HomeSaleTaxClient\"]\n1f:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Home Sale Tax Calculator\"}]]}]\n20:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$L25\",null,{\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"title\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"description\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on your home, rental, or second home. $250K/$500K exclusion, cost basis, depreciation recapture. No sign-up.\"}]}]\n21:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Home Sale Tax Calculator — Capital Gains on Property 2026\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on the sale of your home, rental property, or second home. Includes $250K/$500K exclusion, cost basis, and depreciation recapture. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-foreground max-w-2xl mx-auto leading-relaxed\",\"children\":\"When you sell your home, you may owe capital gains tax on the profit. If it's your primary residence and you've lived in it for at least 2 of the last 5 years, you can exclude up to $250,000 (single) or $500,000 (married) of the gain. Any remaining gain is taxed at long-term capital gains rates of 0%, 15%, or 20%, plus a 3.8% Net Investment Income Tax if your income is high enough. Rental properties are subject to depreciation recapture at 25%.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":[\"Last reviewed: February 2026 · By \",\"Rachel Mitchell\",\", \",\"CPA\",\" · Information verified against IRS.gov & IRC Section 121\"]}]]}]\n22:[\"$\",\"div\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Home Sale Tax Quick Summary\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-1\",\"children\":\"Primary Residence Exclusion\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"$$250K / $500K\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"$$250,000 for single filers, $500,000 for married filing jointly. Must live in home 2 of last 5 years.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-sky-400 mb-1\",\"children\":\"Long-Term Capital Gains Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"0% / 15% / 20%\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Plus 3.8% NIIT for high earners. Rate depends on your taxable income level.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1\",\"children\":\"Depreciation Recapture\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"25%\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"On accumulated depreciation for rental properties. Taxed regardless of your income bracket.\"}]]}]]}]]}]\n23:[\"$\",\"$L26\",null,{}]\n24:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How Capital Gains Tax on a Home Sale Works — Complete Guide\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"When you sell a home for more than you paid for it, the profit is a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"capital gain\"}],\". The IRS taxes this gain, but several exclusions and rules can reduce or eliminate the tax. The biggest break is the \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Section 121 primary residence exclusion\"}],\", which lets you exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain if you meet certain conditions.\"]}],[\"$\",\"p\",null,{\"children\":[\"The tax you owe depends on three main factors: \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(1)\"}],\" whether the home was your primary residence, a rental, or a second home; \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(2)\"}],\" how long you owned it (short-term vs. long-term); and \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(3)\"}],\" your overall taxable income, which determines your capital gains rate. Understanding these factors is key to calculating your tax accurately.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Primary residence exclusion (Section 121):\"}],\" To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. The 2 years don't need to be consecutive — you just need 24 months total. You can only use this exclusion once every 2 years. If you're married filing jointly, both spouses must meet the residency requirement, but only one needs to meet the ownership requirement.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Cost basis calculation:\"}],\" Your cost basis isn't just the purchase price. It's the purchase price \",[\"$\",\"em\",null,{\"children\":\"plus\"}],\" capital improvements \",[\"$\",\"em\",null,{\"children\":\"minus\"}],\" any depreciation you claimed. Capital improvements are projects that add value, prolong the home's life, or adapt it to a new use — think new roof, room addition, or major kitchen renovation. Repairs and maintenance (painting, fixing leaks) don't count. Selling costs like real estate commissions and closing fees also reduce your gain.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Short-term vs. long-term capital gains:\"}],\" If you owned the home for more than one year, the gain is long-term and taxed at preferential rates (0%, 15%, or 20%). If you owned it for one year or less, it's short-term and taxed at your ordinary income rate — which can be significantly higher. Most home sales involve long-term gains since people typically own homes for years.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Net Investment Income Tax (NIIT):\"}],\" If your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (MFJ), you may owe an additional 3.8% tax on your capital gains. This tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. It stacks on top of the regular capital gains rate.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[\"$L27\",\"$L28\"]}],\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\"]}]\n3a:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"LinkToUs\"]\n27:[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Step-by-Step: How to Calculate Capital Gains on a Home Sale\"}]\n28:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":1}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Determine your cost basis\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Start with the original purchase price, add the cost of capital improvements (new roof, room additions, major renovations), and subtract any depreciation you claimed (or could have claimed) on the property. This is your adjusted cost basis.\"}]]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":2}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Subtract cost basis from sale price\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Take the sale price and subtract your adjusted cost basis and selling costs (real estate commissions, title insurance, transfer taxes, and other closing costs). The result is your total capital gain.\"}]]}]]}],[\"$\",\"div\",\"3\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":3}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Apply the primary residence exclusion\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"If the home was your primary residence and you lived there for at least 24 of the last 60 months, subtract $250,000 (single) or $500,000 (MFJ). If you lived there less than 24 months but qualify for a partial exclusion, prorate based on months lived.\"}]]}]]}],[\"$\",\"div\",\"4\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":4}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Calculate tax on the remaining gain\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Apply the appropriate long-term capital gains rate to the taxable gain: 0% if your taxable income is below ~$47K (single) / ~$94K (MFJ), 15% up to ~$518K / ~$583K, or 20% above those thresholds. Add 3.8% NIIT if your MAGI exceeds $200K / $250K.\"}]]}]]}],[\"$\",\"div\",\"5\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":5}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Add depreciation recapture tax\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"If the property was ever rented out and you claimed depreciation, multiply the accumulated depreciation by 25%. Add this to your capital gains tax. The total is your overall tax on the sale.\"}]]}]]}]]}]\n29:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-sky-500/20 bg-sky-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Primary Residence Exclusion Rules (Section 121)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The Section 121 exclusion is the single most important tax break for home sellers. Here are the rules you need to know:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 my-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-emerald-400 mb-1\",\"children\":\"Exclusion Amounts\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"• \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"$$250,000\"}],\" for single filers\"]}],[\"$\",\"li\",null,{\"children\":[\"• \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"$$500,000\"}],\" for married filing jointly\"]}],[\"$\",\"li\",null,{\"children\":\"• Married couples: both must meet residency test\"}],[\"$\",\"li\",null,{\"children\":\"• Only one spouse needs to meet ownership test\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-sky-400 mb-1\",\"children\":\"Qualification Requirements\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"• Own and use as primary residence for \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"2 of 5 years\"}]]}],[\"$\",\"li\",null,{\"children\":\"• The 2 years don't need to be consecutive\"}],[\"$\",\"li\",null,{\"children\":[\"• Can only use exclusion \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"once every 2 years\"}]]}],[\"$\",\"li\",null,{\"children\":\"• Must report sale even if gain is fully excluded\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-amber-400 mb-1\",\"children\":\"Partial Exclusion\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Available if move due to health, job, or unforeseen events\"}],[\"$\",\"li\",null,{\"children\":\"• Prorated: (months lived / 24) × full exclusion\"}],[\"$\",\"li\",null,{\"children\":\"• IRS Safe Harbors: move >50 miles for work\"}],[\"$\",\"li\",null,{\"children\":\"• Also: divorce, death of spouse, multiple births\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-red-400 mb-1\",\"children\":\"Does NOT Apply To\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Rental properties (never your primary residence)\"}],[\"$\",\"li\",null,{\"children\":\"• Vacation / second homes\"}],[\"$\",\"li\",null,{\"children\":\"• Home flipped in under 1 year\"}],[\"$\",\"li\",null,{\"children\":\"• Property held in a corporation or trust\"}]]}]]}]]}]]}]]}]\n2a:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-amber-500/20 bg-amber-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Rental Property & Second Home Sales\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Selling a rental property or second home is very different from selling your primary residence. Here's what you need to know:\"}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Depreciation recapture at 25%:\"}],\" When you sell a rental property, all the depreciation you claimed (or were entitled to claim) over the years is \\\"recaptured\\\" and taxed at a flat \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"25% rate\"}],\". This is separate from the regular capital gains tax. For example, if you claimed $50,000 in depreciation over 10 years, you'll owe $12,500 in recapture tax, regardless of your income bracket. This is reported on Form 4797.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"No primary residence exclusion for pure rentals:\"}],\" If the property was always a rental and never your primary residence, you cannot use the Section 121 exclusion. The entire gain is taxable. However, the gain above the depreciation recapture amount is still taxed at the more favorable long-term capital gains rates.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"1031 exchange option:\"}],\" Instead of paying tax on the sale of a rental property, you can defer the gain by doing a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"1031 like-kind exchange\"}],\". You must identify a replacement property within 45 days and close within 180 days. The replacement property must be an investment or business property — not a personal residence. This defers the tax; it doesn't eliminate it. When you eventually sell without a 1031 exchange, you'll owe tax on the accumulated gain.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Converting rental to primary residence:\"}],\" If you move into your rental property and use it as your primary residence for at least 2 of the 5 years before selling, you may qualify for the Section 121 exclusion. However, the IRS has a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"5-year look-back rule\"}],\": any period after 2008 where the property was not your primary residence (\\\"non-qualified use\\\") reduces the exclusion proportionally. The depreciation recapture still applies regardless.\"]}]]}]]}]\n2b:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Capital Gains Tax Rates for 2026\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Long-term capital gains (assets held more than one year) are taxed at preferential rates based on your taxable income. Here are the thresholds for 2026:\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto my-4\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-border/30\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-3 px-3 font-semibold text-foreground\",\"children\":\"Rate\"}],[\"$\",\"th\",null,{\"className\":\"text-center py-3 px-3 font-semibold text-emerald-400\",\"children\":\"Single\"}],[\"$\",\"th\",null,{\"className\":\"text-center py-3 px-3 font-semibold text-sky-400\",\"children\":\"Married Filing Jointly\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"text-muted-foreground\",\"children\":[[\"$\",\"tr\",null,{\"className\":\"border-b border-border/20\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-emerald-400\",\"children\":\"0%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Up to ~$47,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Up to ~$94,000\"}]]}],[\"$\",\"tr\",null,{\"className\":\"border-b border-border/20\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-sky-400\",\"children\":\"15%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"~$47,000 to ~$518,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"~$94,000 to ~$583,000\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-amber-400\",\"children\":\"20%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Over ~$518,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Over ~$583,000\"}]]}]]}]]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"+ 3.8% NIIT for high earners:\"}],\" If your MAGI exceeds $200,000 (single) or $250,000 (MFJ), the Net Investment Income Tax adds 3.8% on top of your capital gains rate. So the effective maximum rate is \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"23.8%\"}],\" (20% + 3.8%). This applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Short-term capital gains\"}],\" (property held one year or less) are taxed at ordinary income rates, which range from 10% to 37%. There is no preferential treatment for short-term gains. This is why holding a property for more than one year before selling is so important for tax purposes.\"]}]]}]]}]\n2c:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Home Sale Tax — Key Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Primary Residence Exclusion (Single)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Primary Residence Exclusion (Single)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$250,000\"}]]}],[\"$\",\"div\",\"Primary Residence Exclusion (MFJ)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Primary Residence Exclusion (MFJ)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$500,000\"}]]}],[\"$\",\"div\",\"Long-Term Capital Gains Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Long-Term Capital Gains Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"0% / 15% / 20%\"}]]}],[\"$\",\"div\",\"Depreciation Recapture Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Depreciation Recapture Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"25%\"}]]}],[\"$\",\"div\",\"NIIT Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"NIIT Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"3.8%\"}]]}],[\"$\",\"div\",\"Residency Test\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Residency Test\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"2 of 5 years\"}]]}],[\"$\",\"div\",\"0% Rate Threshold (Single)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"0% Rate Threshold (Single)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"~$47,000 taxable income\"}]]}],[\"$\",\"div\",\"0% Rate Threshold (MFJ)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"0% Rate Threshold (MFJ)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"~$94,000 taxable income\"}]]}]]}]]}]\n2d:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Home Sale Tax Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much capital gains tax will I pay when I sell my house?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It depends on your profit, filing status, and how long you lived in the home. If it's your primary residence and you meet the 2-of-5-year test, you can exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain. Any remaining gain is taxed at long-term capital gains rates: 0%, 15%, or 20%, depending on your taxable income. High earners may also pay an additional 3.8% Net Investment Income Tax (NIIT).\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the Section 121 primary residence exclusion?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Section 121 of the Internal Revenue Code lets you exclude up to $250,000 of capital gains from the sale of your primary residence if you're single, or $500,000 if married filing jointly. To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. You can only use this exclusion once every 2 years.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What if I don't meet the 2-of-5-year residency test?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"If you don't meet the full 2-year residency requirement, you may qualify for a partial exclusion if the sale was due to a change in employment, health reasons, or unforeseen circumstances (like divorce or natural disaster). The partial exclusion is prorated based on the time you lived in the home. For example, if you lived there 1 year out of 5, you'd get half the exclusion: $125,000 (single) or $250,000 (MFJ).\"}]]}],\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\"]}]]}]\n2e:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L10\",\"capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Capital Gains Calculator\"]}],[\"$\",\"$L10\",\"property-tax-calculator\",{\"href\":\"/property-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Property Tax Calculator\"]}],[\"$\",\"$L10\",\"mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Mortgage Calculator\"]}],[\"$\",\"$L10\",\"tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Tax Refund Calculator\"]}]]}]]}]\n2f:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L3a\",null,{\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"title\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"slug\":\"home-sale-tax-calculator\"}]}]\n30:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n31:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How is cost basis calculated for a home sale?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Your cost basis is the original purchase price of the home plus the cost of capital improvements (not repairs or maintenance) minus any depreciation claimed. Capital improvements include things like a new roof, room addition, or major renovation. Routine repairs like painting or fixing a leaky faucet don't count. The higher your cost basis, the lower your capital gain.\"}]]}]\n32:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is depreciation recapture on a rental property sale?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"When you sell a rental property, you must \\\"recapture\\\" the depreciation you claimed (or could have claimed) over the years. This recaptured depreciation is taxed at a flat 25% rate, not at the regular capital gains rate. This applies even if you didn't actually claim depreciation on your tax returns — the IRS treats it as \\\"allowed or allowable.\\\" Depreciation recapture is reported on Form 4797 and Schedule D.\"}]]}]\n33:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Do I pay capital gains tax if I sell my house at a loss?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"If you sell your primary residence at a loss, you generally cannot deduct the loss on your tax return. The IRS does not allow you to claim a capital loss on the sale of a personal residence. However, if the property was a rental or investment property, you may be able to deduct the loss as a capital loss, subject to the usual capital loss limitations ($3,000 per year against ordinary income, with carryforward).\"}]]}]\n34:[\"$\",\"details\",\"6\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the 3.8% Net Investment Income Tax (NIIT)?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The NIIT is an additional 3.8% tax on investment income (including capital gains from home sales) that applies to high-income taxpayers. It kicks in when your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (married filing jointly). The tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. This is on top of the regular capital gains tax.\"}]]}]\n35:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I avoid capital gains tax with a 1031 exchange?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"A 1031 exchange (like-kind exchange) lets you defer capital gains tax by reinvesting the proceeds from the sale of an investment or rental property into a similar property. Important: 1031 exchanges do NOT apply to primary residences — only to investment and business properties. You must identify a replacement property within 45 days and close within 180 days. This defers the tax, it doesn't eliminate it permanently.\"}]]}]\n36:[\"$\",\"details\",\"8\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What counts as a capital improvement vs. a repair?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Capital improvements add to your cost basis and include projects that add value, prolong the home's life, or adapt it to a new use — like adding a room, installing central air, replacing the roof, or finishing a basement. Repairs maintain the home in good condition but don't add value — like fixing a leak, repainting, or replacing a broken window. Only capital improvements increase your cost basis; repairs do not.\"}]]}]\n37:[\"$\",\"details\",\"9\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How does selling a second home differ from a primary residence?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Second homes (vacation homes) do not qualify for the Section 121 primary residence exclusion — you'll pay capital gains tax on the entire gain. However, if you convert your second home to your primary residence and live in it for at least 2 of 5 years before selling, you may qualify for a partial exclusion (subject to the 5-year look-back rule for non-qualified use periods). The gain is still taxed at long-term capital gains rates.\"}]]}]\n38:[\"$\",\"details\",\"10\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What are the capital gains tax rates for 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"For 2026, long-term capital gains (assets held over 1 year) are taxed at three rates: 0% for taxable income up to roughly $47,000 (single) or $94,000 (MFJ), 15% for income up to roughly $518,000 (single) or $583,000 (MFJ), and 20% for income above those thresholds. Short-term gains (assets held 1 year or less) are taxed at ordinary income rates. The 3.8% NIIT applies on top for high earners.\"}]]}]\n39:[\"$\",\"details\",\"11\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Do I need to report the sale of my home to the IRS?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes, you must report the sale on your tax return using Schedule D and Form 8949, even if the entire gain is excluded under Section 121. If you receive a Form 1099-S (Proceeds from Real Estate Transactions), the IRS already knows about the sale, and failing to report it can trigger a notice. If no Form 1099-S was issued and the entire gain is excludable, you still need to report it, but you won't owe any tax.\"}]]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n18:null\n3b:T486,capital gains tax calculator on sale of property,home sale tax calculator,capital gains on home sale calculator,house sale capital gains tax calculator,capital gains real estate calculator,home sale capital gains calculator,selling house capital gains calculator,capital gains on house sale calculator,capital gains calculator on home sale,home sale capital gains tax calculator,capital gains tax on home sale,capital gains tax on sale of house,how to calculate capital gains on home sale,capital gains tax on property sale,capital gains tax on real estate sale,home sale tax exclusion calculator,section 121 exclusion calculator,primary residence capital gains calculator,rental property capital gains calculator,depreciation recapture calculator,home sale cost basis calculator,capital gains tax rate on home sale,250000 500000 exclusion calculator,sell house tax calculator,property sale tax calculator,real estate capital gains tax estimator,home sale profit tax calculator,capital gains on rental property sale,1031 exchange vs sale calculator,net investment income tax home sale,niit home sale calculator,short term vs long term capital gains home sale1c:[[\"$\",\"title\",\"0\",{\"children\":\"Home Sale Tax Calculator 2026 | Capital Gains on Property\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on your home, rental, or second home. $250K/$500K exclusion, cost basis, depreciation recapture. No sign-up.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"$3b\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"9\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"10\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"11\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/home-sale-tax-calculator\"}],[\"$\",\"meta\",\"12\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:title\",\"content\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:description\",\"content\":\"Free home sale tax calculator. Calculate capital gains tax on your home, rental, or second home. $250K/$500K exclusion, depreciation recapture, NIIT. No sign-up required.\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/home-sale-tax-calculator\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image:alt\",\"content\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:title\",\"content\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:description\",\"content\":\"Free home sale tax calculator. Calculate capital gains tax on your home, rental, or second home. $250K/$500K exclusion, depreciation recapture, NIIT. No sign-up required.\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],\"$L3c\",\"$L3d\",\"$L3e\"]\n3f:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n3c:[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}]\n3d:[\"$\",\"link\",\"28\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}]\n3e:[\"$\",\"$L3f\",\"29\",{}]\n","/home-sale-tax-calculator/__PAGE__":"1:\"$Sreact.fragment\"\nb:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"\"]\nc:I[79086,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"ShareButtons\"]\nd:I[18631,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"HomeSaleTaxClient\"]\n18:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n19:\"$Sreact.suspense\"\n24:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c2b0a8193d828dae.js\"],\"LinkToUs\"]\n2:T2a04,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Home Sale Tax Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#webpage\",\"@type\":\"WebPage\",\"name\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"description\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on the sale of your home, rental property, or second home. Includes $250K/$500K exclusion, cost basis, and depreciation recapture.\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-02-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"Home Sale Tax Calculator\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#howto\",\"@type\":\"HowTo\",\"name\":\"How to Calculate Capital Gains on a Home Sale\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"Determine your cost basis\",\"text\":\"Add your purchase price to capital improvements and subtract any depreciation claimed. This gives you the adjusted cost basis of the property.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"Calculate your capital gain\",\"text\":\"Subtract your adjusted cost basis and selling costs (commissions, closing costs) from the sale price. The result is your total capital gain.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"Apply the primary residence exclusion\",\"text\":\"If you lived in the home for 2 of the last 5 years, subtract $250,000 (single) or $500,000 (MFJ) from the gain. Partial exclusion if under 2 years.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"Calculate tax on the remaining gain\",\"text\":\"Apply the long-term capital gains rate (0%, 15%, or 20%) to the taxable gain. Add 3.8% NIIT if your income exceeds $200K/$250K.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"Add depreciation recapture tax\",\"text\":\"If you claimed depreciation (rental property), multiply the accumulated depreciation by 25%. Add this to your capital gains tax for the total tax owed.\"}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much capital gains tax will I pay when I sell my house?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on your profit, filing status, and how long you lived in the home. If it's your primary residence and you meet the 2-of-5-year test, you can exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain. Any remaining gain is taxed at long-term capital gains rates: 0%, 15%, or 20%, depending on your taxable income. High earners may also pay an additional 3.8% Net Investment Income Tax (NIIT).\"}},{\"@type\":\"Question\",\"name\":\"What is the Section 121 primary residence exclusion?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Section 121 of the Internal Revenue Code lets you exclude up to $250,000 of capital gains from the sale of your primary residence if you're single, or $500,000 if married filing jointly. To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. You can only use this exclusion once every 2 years.\"}},{\"@type\":\"Question\",\"name\":\"What if I don't meet the 2-of-5-year residency test?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you don't meet the full 2-year residency requirement, you may qualify for a partial exclusion if the sale was due to a change in employment, health reasons, or unforeseen circumstances (like divorce or natural disaster). The partial exclusion is prorated based on the time you lived in the home. For example, if you lived there 1 year out of 5, you'd get half the exclusion: $125,000 (single) or $250,000 (MFJ).\"}},{\"@type\":\"Question\",\"name\":\"How is cost basis calculated for a home sale?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your cost basis is the original purchase price of the home plus the cost of capital improvements (not repairs or maintenance) minus any depreciation claimed. Capital improvements include things like a new roof, room addition, or major renovation. Routine repairs like painting or fixing a leaky faucet don't count. The higher your cost basis, the lower your capital gain.\"}},{\"@type\":\"Question\",\"name\":\"What is depreciation recapture on a rental property sale?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"When you sell a rental property, you must \\\"recapture\\\" the depreciation you claimed (or could have claimed) over the years. This recaptured depreciation is taxed at a flat 25% rate, not at the regular capital gains rate. This applies even if you didn't actually claim depreciation on your tax returns — the IRS treats it as \\\"allowed or allowable.\\\" Depreciation recapture is reported on Form 4797 and Schedule D.\"}},{\"@type\":\"Question\",\"name\":\"Do I pay capital gains tax if I sell my house at a loss?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you sell your primary residence at a loss, you generally cannot deduct the loss on your tax return. The IRS does not allow you to claim a capital loss on the sale of a personal residence. However, if the property was a rental or investment property, you may be able to deduct the loss as a capital loss, subject to the usual capital loss limitations ($3,000 per year against ordinary income, with carryforward).\"}},{\"@type\":\"Question\",\"name\":\"What is the 3.8% Net Investment Income Tax (NIIT)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The NIIT is an additional 3.8% tax on investment income (including capital gains from home sales) that applies to high-income taxpayers. It kicks in when your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (married filing jointly). The tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. This is on top of the regular capital gains tax.\"}},{\"@type\":\"Question\",\"name\":\"Can I avoid capital gains tax with a 1031 exchange?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A 1031 exchange (like-kind exchange) lets you defer capital gains tax by reinvesting the proceeds from the sale of an investment or rental property into a similar property. Important: 1031 exchanges do NOT apply to primary residences — only to investment and business properties. You must identify a replacement property within 45 days and close within 180 days. This defers the tax, it doesn't eliminate it permanently.\"}},{\"@type\":\"Question\",\"name\":\"What counts as a capital improvement vs. a repair?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Capital improvements add to your cost basis and include projects that add value, prolong the home's life, or adapt it to a new use — like adding a room, installing central air, replacing the roof, or finishing a basement. Repairs maintain the home in good condition but don't add value — like fixing a leak, repainting, or replacing a broken window. Only capital improvements increase your cost basis; repairs do not.\"}},{\"@type\":\"Question\",\"name\":\"How does selling a second home differ from a primary residence?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Second homes (vacation homes) do not qualify for the Section 121 primary residence exclusion — you'll pay capital gains tax on the entire gain. However, if you convert your second home to your primary residence and live in it for at least 2 of 5 years before selling, you may qualify for a partial exclusion (subject to the 5-year look-back rule for non-qualified use periods). The gain is still taxed at long-term capital gains rates.\"}},{\"@type\":\"Question\",\"name\":\"What are the capital gains tax rates for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For 2026, long-term capital gains (assets held over 1 year) are taxed at three rates: 0% for taxable income up to roughly $47,000 (single) or $94,000 (MFJ), 15% for income up to roughly $518,000 (single) or $583,000 (MFJ), and 20% for income above those thresholds. Short-term gains (assets held 1 year or less) are taxed at ordinary income rates. The 3.8% NIIT applies on top for high earners.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to report the sale of my home to the IRS?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, you must report the sale on your tax return using Schedule D and Form 8949, even if the entire gain is excluded under Section 121. If you receive a Form 1099-S (Proceeds from Real Estate Transactions), the IRS already knows about the sale, and failing to report it can trigger a notice. If no Form 1099-S was issued and the entire gain is excludable, you still need to report it, but you won't owe any tax.\"}}]},{\"@id\":\"https://thetaxcalc.com/home-sale-tax-calculator#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\"]}],[\"$L9\"],\"$La\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Home Sale Tax Calculator\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$Lc\",null,{\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"title\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"description\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on your home, rental, or second home. $250K/$500K exclusion, cost basis, depreciation recapture. No sign-up.\"}]}]\n5:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Home Sale Tax Calculator — Capital Gains on Property 2026\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free home sale tax calculator for 2026. Calculate capital gains tax on the sale of your home, rental property, or second home. Includes $250K/$500K exclusion, cost basis, and depreciation recapture. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-sm text-foreground max-w-2xl mx-auto leading-relaxed\",\"children\":\"When you sell your home, you may owe capital gains tax on the profit. If it's your primary residence and you've lived in it for at least 2 of the last 5 years, you can exclude up to $250,000 (single) or $500,000 (married) of the gain. Any remaining gain is taxed at long-term capital gains rates of 0%, 15%, or 20%, plus a 3.8% Net Investment Income Tax if your income is high enough. Rental properties are subject to depreciation recapture at 25%.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":[\"Last reviewed: February 2026 · By \",\"Rachel Mitchell\",\", \",\"CPA\",\" · Information verified against IRS.gov & IRC Section 121\"]}]]}]\n6:[\"$\",\"div\",null,{\"className\":\"mb-8 rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-4\",\"children\":\"Home Sale Tax Quick Summary\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-1\",\"children\":\"Primary Residence Exclusion\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"$$250K / $500K\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"$$250,000 for single filers, $500,000 for married filing jointly. Must live in home 2 of last 5 years.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-sky-400 mb-1\",\"children\":\"Long-Term Capital Gains Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"0% / 15% / 20%\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Plus 3.8% NIIT for high earners. Rate depends on your taxable income level.\"}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-amber-400 mb-1\",\"children\":\"Depreciation Recapture\"}],[\"$\",\"p\",null,{\"className\":\"text-2xl font-bold text-foreground\",\"children\":\"25%\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"On accumulated depreciation for rental properties. Taxed regardless of your income bracket.\"}]]}]]}]]}]\n7:[\"$\",\"$Ld\",null,{}]\n8:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How Capital Gains Tax on a Home Sale Works — Complete Guide\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":[\"When you sell a home for more than you paid for it, the profit is a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"capital gain\"}],\". The IRS taxes this gain, but several exclusions and rules can reduce or eliminate the tax. The biggest break is the \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Section 121 primary residence exclusion\"}],\", which lets you exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain if you meet certain conditions.\"]}],[\"$\",\"p\",null,{\"children\":[\"The tax you owe depends on three main factors: \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(1)\"}],\" whether the home was your primary residence, a rental, or a second home; \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(2)\"}],\" how long you owned it (short-term vs. long-term); and \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"(3)\"}],\" your overall taxable income, which determines your capital gains rate. Understanding these factors is key to calculating your tax accurately.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Primary residence exclusion (Section 121):\"}],\" To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. The 2 years don't need to be consecutive — you just need 24 months total. You can only use this exclusion once every 2 years. If you're married filing jointly, both spouses must meet the residency requirement, but only one needs to meet the ownership requirement.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Cost basis calculation:\"}],\" Your cost basis isn't just the purchase price. It's the purchase price \",[\"$\",\"em\",null,{\"children\":\"plus\"}],\" capital improvements \",[\"$\",\"em\",null,{\"children\":\"minus\"}],\" any depreciation you claimed. Capital improvements are projects that add value, prolong the home's life, or adapt it to a new use — think new roof, room addition, or major kitchen renovation. Repairs and maintenance (painting, fixing leaks) don't count. Selling costs like real estate commissions and closing fees also reduce your gain.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Short-term vs. long-term capital gains:\"}],\" If you owned the home for more than one year, the gain is long-term and taxed at preferential rates (0%, 15%, or 20%). If you owned it for one year or less, it's short-term and taxed at your ordinary income rate — which can be significantly higher. Most home sales involve long-term gains since people typically own homes for years.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Net Investment Income Tax (NIIT):\"}],\" If your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (MFJ), you may owe an additional 3.8% tax on your capital gains. This tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. It stacks on top of the regular capital gains rate.\"]}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[\"$Le\",\"$Lf\"]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\"]}]\n9:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/c2b0a8193d828dae.js\",\"async\":true}]\na:[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1a\"}]}]\ne:[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Step-by-Step: How to Calculate Capital Gains on a Home Sale\"}]\nf:[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":1}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Determine your cost basis\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Start with the original purchase price, add the cost of capital improvements (new roof, room additions, major renovations), and subtract any depreciation you claimed (or could have claimed) on the property. This is your adjusted cost basis.\"}]]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":2}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Subtract cost basis from sale price\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Take the sale price and subtract your adjusted cost basis and selling costs (real estate commissions, title insurance, transfer taxes, and other closing costs). The result is your total capital gain.\"}]]}]]}],[\"$\",\"div\",\"3\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":3}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Apply the primary residence exclusion\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"If the home was your primary residence and you lived there for at least 24 of the last 60 months, subtract $250,000 (single) or $500,000 (MFJ). If you lived there less than 24 months but qualify for a partial exclusion, prorate based on months lived.\"}]]}]]}],[\"$\",\"div\",\"4\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":4}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Calculate tax on the remaining gain\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"Apply the appropriate long-term capital gains rate to the taxable gain: 0% if your taxable income is below ~$47K (single) / ~$94K (MFJ), 15% up to ~$518K / ~$583K, or 20% above those thresholds. Add 3.8% NIIT if your MAGI exceeds $200K / $250K.\"}]]}]]}],[\"$\",\"div\",\"5\",{\"className\":\"flex gap-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400\",\"children\":5}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground\",\"children\":\"Add depreciation recapture tax\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-0.5 leading-relaxed\",\"children\":\"If the property was ever rented out and you claimed depreciation, multiply the accumulated depreciation by 25%. Add this to your capital gains tax. The total is your overall tax on the sale.\"}]]}]]}]]}]\n10:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-sky-500/20 bg-sky-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Primary Residence Exclusion Rules (Section 121)\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"The Section 121 exclusion is the single most important tax break for home sellers. Here are the rules you need to know:\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 my-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-emerald-400 mb-1\",\"children\":\"Exclusion Amounts\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"• \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"$$250,000\"}],\" for single filers\"]}],[\"$\",\"li\",null,{\"children\":[\"• \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"$$500,000\"}],\" for married filing jointly\"]}],[\"$\",\"li\",null,{\"children\":\"• Married couples: both must meet residency test\"}],[\"$\",\"li\",null,{\"children\":\"• Only one spouse needs to meet ownership test\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-sky-400 mb-1\",\"children\":\"Qualification Requirements\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"• Own and use as primary residence for \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"2 of 5 years\"}]]}],[\"$\",\"li\",null,{\"children\":\"• The 2 years don't need to be consecutive\"}],[\"$\",\"li\",null,{\"children\":[\"• Can only use exclusion \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"once every 2 years\"}]]}],[\"$\",\"li\",null,{\"children\":\"• Must report sale even if gain is fully excluded\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-amber-400 mb-1\",\"children\":\"Partial Exclusion\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Available if move due to health, job, or unforeseen events\"}],[\"$\",\"li\",null,{\"children\":\"• Prorated: (months lived / 24) × full exclusion\"}],[\"$\",\"li\",null,{\"children\":\"• IRS Safe Harbors: move >50 miles for work\"}],[\"$\",\"li\",null,{\"children\":\"• Also: divorce, death of spouse, multiple births\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-red-400 mb-1\",\"children\":\"Does NOT Apply To\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-1.5 text-xs text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":\"• Rental properties (never your primary residence)\"}],[\"$\",\"li\",null,{\"children\":\"• Vacation / second homes\"}],[\"$\",\"li\",null,{\"children\":\"• Home flipped in under 1 year\"}],[\"$\",\"li\",null,{\"children\":\"• Property held in a corporation or trust\"}]]}]]}]]}]]}]]}]\n11:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-amber-500/20 bg-amber-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Rental Property & Second Home Sales\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Selling a rental property or second home is very different from selling your primary residence. Here's what you need to know:\"}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Depreciation recapture at 25%:\"}],\" When you sell a rental property, all the depreciation you claimed (or were entitled to claim) over the years is \\\"recaptured\\\" and taxed at a flat \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"25% rate\"}],\". This is separate from the regular capital gains tax. For example, if you claimed $50,000 in depreciation over 10 years, you'll owe $12,500 in recapture tax, regardless of your income bracket. This is reported on Form 4797.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"No primary residence exclusion for pure rentals:\"}],\" If the property was always a rental and never your primary residence, you cannot use the Section 121 exclusion. The entire gain is taxable. However, the gain above the depreciation recapture amount is still taxed at the more favorable long-term capital gains rates.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"1031 exchange option:\"}],\" Instead of paying tax on the sale of a rental property, you can defer the gain by doing a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"1031 like-kind exchange\"}],\". You must identify a replacement property within 45 days and close within 180 days. The replacement property must be an investment or business property — not a personal residence. This defers the tax; it doesn't eliminate it. When you eventually sell without a 1031 exchange, you'll owe tax on the accumulated gain.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Converting rental to primary residence:\"}],\" If you move into your rental property and use it as your primary residence for at least 2 of the 5 years before selling, you may qualify for the Section 121 exclusion. However, the IRS has a \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"5-year look-back rule\"}],\": any period after 2008 where the property was not your primary residence (\\\"non-qualified use\\\") reduces the exclusion proportionally. The depreciation recapture still applies regardless.\"]}]]}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Capital Gains Tax Rates for 2026\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Long-term capital gains (assets held more than one year) are taxed at preferential rates based on your taxable income. Here are the thresholds for 2026:\"}],[\"$\",\"div\",null,{\"className\":\"overflow-x-auto my-4\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"border-b border-border/30\",\"children\":[[\"$\",\"th\",null,{\"className\":\"text-left py-3 px-3 font-semibold text-foreground\",\"children\":\"Rate\"}],[\"$\",\"th\",null,{\"className\":\"text-center py-3 px-3 font-semibold text-emerald-400\",\"children\":\"Single\"}],[\"$\",\"th\",null,{\"className\":\"text-center py-3 px-3 font-semibold text-sky-400\",\"children\":\"Married Filing Jointly\"}]]}]}],[\"$\",\"tbody\",null,{\"className\":\"text-muted-foreground\",\"children\":[[\"$\",\"tr\",null,{\"className\":\"border-b border-border/20\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-emerald-400\",\"children\":\"0%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Up to ~$47,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Up to ~$94,000\"}]]}],[\"$\",\"tr\",null,{\"className\":\"border-b border-border/20\",\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-sky-400\",\"children\":\"15%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"~$47,000 to ~$518,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"~$94,000 to ~$583,000\"}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 font-semibold text-amber-400\",\"children\":\"20%\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Over ~$518,000\"}],[\"$\",\"td\",null,{\"className\":\"py-2.5 px-3 text-center\",\"children\":\"Over ~$583,000\"}]]}]]}]]}]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"+ 3.8% NIIT for high earners:\"}],\" If your MAGI exceeds $200,000 (single) or $250,000 (MFJ), the Net Investment Income Tax adds 3.8% on top of your capital gains rate. So the effective maximum rate is \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"23.8%\"}],\" (20% + 3.8%). This applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold.\"]}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Short-term capital gains\"}],\" (property held one year or less) are taxed at ordinary income rates, which range from 10% to 37%. There is no preferential treatment for short-term gains. This is why holding a property for more than one year before selling is so important for tax purposes.\"]}]]}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Home Sale Tax — Key Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Primary Residence Exclusion (Single)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Primary Residence Exclusion (Single)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$250,000\"}]]}],[\"$\",\"div\",\"Primary Residence Exclusion (MFJ)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Primary Residence Exclusion (MFJ)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$500,000\"}]]}],[\"$\",\"div\",\"Long-Term Capital Gains Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Long-Term Capital Gains Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"0% / 15% / 20%\"}]]}],[\"$\",\"div\",\"Depreciation Recapture Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Depreciation Recapture Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"25%\"}]]}],[\"$\",\"div\",\"NIIT Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"NIIT Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"3.8%\"}]]}],[\"$\",\"div\",\"Residency Test\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Residency Test\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"2 of 5 years\"}]]}],[\"$\",\"div\",\"0% Rate Threshold (Single)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"0% Rate Threshold (Single)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"~$47,000 taxable income\"}]]}],[\"$\",\"div\",\"0% Rate Threshold (MFJ)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"0% Rate Threshold (MFJ)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"~$94,000 taxable income\"}]]}]]}]]}]\n14:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Home Sale Tax Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much capital gains tax will I pay when I sell my house?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It depends on your profit, filing status, and how long you lived in the home. If it's your primary residence and you meet the 2-of-5-year test, you can exclude up to $250,000 (single) or $500,000 (married filing jointly) of the gain. Any remaining gain is taxed at long-term capital gains rates: 0%, 15%, or 20%, depending on your taxable income. High earners may also pay an additional 3.8% Net Investment Income Tax (NIIT).\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the Section 121 primary residence exclusion?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Section 121 of the Internal Revenue Code lets you exclude up to $250,000 of capital gains from the sale of your primary residence if you're single, or $500,000 if married filing jointly. To qualify, you must have owned and used the home as your primary residence for at least 2 of the 5 years before the sale. You can only use this exclusion once every 2 years.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What if I don't meet the 2-of-5-year residency test?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"If you don't meet the full 2-year residency requirement, you may qualify for a partial exclusion if the sale was due to a change in employment, health reasons, or unforeseen circumstances (like divorce or natural disaster). The partial exclusion is prorated based on the time you lived in the home. For example, if you lived there 1 year out of 5, you'd get half the exclusion: $125,000 (single) or $250,000 (MFJ).\"}]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\"]}]]}]\n15:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$Lb\",\"capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Capital Gains Calculator\"]}],[\"$\",\"$Lb\",\"property-tax-calculator\",{\"href\":\"/property-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Property Tax Calculator\"]}],[\"$\",\"$Lb\",\"mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Mortgage Calculator\"]}],[\"$\",\"$Lb\",\"tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Tax Refund Calculator\"]}]]}]]}]\n16:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L24\",null,{\"url\":\"https://thetaxcalc.com/home-sale-tax-calculator\",\"title\":\"Home Sale Tax Calculator 2026 — Capital Gains on Property\",\"slug\":\"home-sale-tax-calculator\"}]}]\n17:[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-3 text-emerald-500/60\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5\"}]}],\"Reviewed: January 2026\"]}],[\"$\",\"span\",null,{\"children\":\"Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]]}]]}]}]\n1a:null\n1b:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How is cost basis calculated for a home sale?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Your cost basis is the original purchase price of the home plus the cost of capital improvements (not repairs or maintenance) minus any depreciation claimed. Capital improvements include things like a new roof, room addition, or major renovation. Routine repairs like painting or fixing a leaky faucet don't count. The higher your cost basis, the lower your capital gain.\"}]]}]\n1c:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is depreciation recapture on a rental property sale?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"When you sell a rental property, you must \\\"recapture\\\" the depreciation you claimed (or could have claimed) over the years. This recaptured depreciation is taxed at a flat 25% rate, not at the regular capital gains rate. This applies even if you didn't actually claim depreciation on your tax returns — the IRS treats it as \\\"allowed or allowable.\\\" Depreciation recapture is reported on Form 4797 and Schedule D.\"}]]}]\n1d:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Do I pay capital gains tax if I sell my house at a loss?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"If you sell your primary residence at a loss, you generally cannot deduct the loss on your tax return. The IRS does not allow you to claim a capital loss on the sale of a personal residence. However, if the property was a rental or investment property, you may be able to deduct the loss as a capital loss, subject to the usual capital loss limitations ($3,000 per year against ordinary income, with carryforward).\"}]]}]\n1e:[\"$\",\"details\",\"6\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the 3.8% Net Investment Income Tax (NIIT)?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The NIIT is an additional 3.8% tax on investment income (including capital gains from home sales) that applies to high-income taxpayers. It kicks in when your modified adjusted gross income (MAGI) exceeds $200,000 (single) or $250,000 (married filing jointly). The tax applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold. This is on top of the regular capital gains tax.\"}]]}]\n1f:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I avoid capital gains tax with a 1031 exchange?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"A 1031 exchange (like-kind exchange) lets you defer capital gains tax by reinvesting the proceeds from the sale of an investment or rental property into a similar property. Important: 1031 exchanges do NOT apply to primary residences — only to investment and business properties. You must identify a replacement property within 45 days and close within 180 days. This defers the tax, it doesn't eliminate it permanently.\"}]]}]\n20:[\"$\",\"details\",\"8\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What counts as a capital improvement vs. a repair?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Capital improvements add to your cost basis and include projects that add value, prolong the home's life, or adapt it to a new use — like adding a room, installing central air, replacing the roof, or finishing a basement. Repairs maintain the home in good condition but don't add value — like fixing a leak, repainting, or replacing a broken window. Only capital improvements increase your cost basis; repairs do not.\"}]]}]\n21:[\"$\",\"details\",\"9\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How does selling a second home differ from a primary residence?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Second homes (vacation homes) do not qualify for the Section 121 primary residence exclusion — you'll pay capital gains tax on the entire gain. However, if you convert your second home to your primary residence and live in it for at least 2 of 5 years before selling, you may qualify for a partial exclusion (subject to the 5-year look-back rule for non-qualified use periods). The gain is still taxed at long-term capital gains rates.\"}]]}]\n22:[\"$\",\"details\",\"10\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What are the capital gains tax rates for 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"For 2026, long-term capital gains (assets held over 1 year) are taxed at three rates: 0% for taxable income up to roughly $47,000 (single) or $94,000 (MFJ), 15% for income up to roughly $518,000 (single) or $583,000 (MFJ), and 20% for income above those thresholds. Short-term gains (assets held 1 year or less) are taxed at ordinary income rates. The 3.8% NIIT applies on top for high earners.\"}]]}]\n23:[\"$\",\"details\",\"11\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Do I need to report the sale of my home to the IRS?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes, you must report the sale on your tax return using Schedule D and Form 8949, even if the entire gain is excluded under Section 121. If you receive a Form 1099-S (Proceeds from Real Estate Transactions), the IRS already knows about the sale, and failing to report it can trigger a notice. If no Form 1099-S was issued and the entire gain is excludable, you still need to report it, but you won't owe any tax.\"}]]}]\n","/home-sale-tax-calculator":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"loading\":null,\"isPartial\":false}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/