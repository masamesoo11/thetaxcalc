\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2.5 px-3 font-semibold text-amber-400\\\",\\\"children\\\":\\\"20%\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2.5 px-3 text-center\\\",\\\"children\\\":\\\"Over ~$518,000\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"py-2.5 px-3 text-center\\\",\\\"children\\\":\\\"Over ~$583,000\\\"}]]}]]}]]}]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-foreground\\\",\\\"children\\\":\\\"+ 3.8% NIIT for high earners:\\\"}],\\\" If your MAGI exceeds $200,000 (single) or $250,000 (MFJ), the Net Investment Income Tax adds 3.8% on top of your capital gains rate. So the effective maximum rate is \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-foreground\\\",\\\"children\\\":\\\"23.8%\\\"}],\\\" (20% + 3.8%). This applies to the lesser of your net investment income or the amount your MAGI exceeds the threshold.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"className\\\":\\\"text-foreground\\\",\\\"children\\\":\\\"Short-term capital gains\\\"}],\\\" (property held one year or less) are taxed at ordinary income rates, which range from 10% to 37%. There is no preferential treatment for short-term gains. This is why holding a property for more than one year before selling is so important for tax purposes.\\\"]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2c:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Home Sale Tax — Key Data for 2026\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2 lg:grid-cols-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Primary Residence Exclusion (Single)\\\",{\\\"className\\\":\\\"rou