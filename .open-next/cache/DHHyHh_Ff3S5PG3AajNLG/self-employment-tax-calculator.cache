n-colors\",\"children\":\"Salary Explorer\"}],[\"$\",\"$L10\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L10\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n14:[\"$\",\"$L1d\",null,{}]\n1e:T1ab9,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#webpage\",\"@type\":\"WebPage\",\"url\":\"https://thetaxcalc.com/self-employment-tax-calculator\",\"name\":\"Self-Employment Tax Calculator 2026\",\"description\":\"Free self-employment tax calculator with 15.3% SE tax, quarterly estimates, and deductions for 2026.\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-06-25\",\"author\":{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#author\"}},{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Self-Employment Tax Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"Self-Employment Tax Calculator 2026\",\"url\":\"https://thetaxcalc.com/self-employment-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/self-employment-tax-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#author\",\"@type\":\"Person\",\"name\":\"David Chen\",\"url\":\"https://thetaxcalc.com/about#david-chen\",\"jobTitle\":\"Tax Research Director & IRS Practice Lead, EA\",\"description\":\"David Chen is an IRS Enrolled Agent (EA) with 15+ years of experience representing taxpayers before the IRS in audits, collections, and appeals. He specializes in self-employment tax, quarterly estimated payments, independent contractor classification, and IRS dispute resolution. David is a member of the National Association of Enrolled Agents (NAEA) and the California Society of Enrolled Agents. He holds a Master of Taxation (MTax) from San Jose State University and has completed advanced coursework in IRS Circular 230 ethics. David regularly contributes to tax policy analysis and has been quoted in publications including Tax Notes and the Wall Street Journal tax section.\",\"knowsAbout\":[\"Self-Employment Tax\",\"Estimated Tax Payments\",\"IRS Representation\",\"Tax Audits\",\"1099 Tax Compliance\",\"Independent Contractor Tax\",\"IRS Collections\",\"Offer in Compromise\"],\"sameAs\":[\"https://www.linkedin.com/in/davidchenea/\",\"https://www.naea.org/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-david-chen.webp\"},{\"@id\":\"https://thetaxcalc.com/self-employment-tax-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the self-employment tax rate for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"15.3% on 92.35% of your net business income. That's 12.4% for Social Security (capped at $184,500 in income) and 2.9% for Medicare (no cap). Once you cross $200K in net SE income, tack on another 0.9% Medicare surcharge on everything above that. Basically, you're covering both the employee and employer sides of FICA since you are both.\"}},{\"@type\":\"Question\",\"name\":\"How do quarterly estimated tax payments work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"If you're self-employed, the IRS wants its money throughout the year, not just at tax time. You make four payments — April 15, June 15, September 15, and January 15 — each covering roughly a quarter of what you expect to owe (income tax plus SE tax). To dodge underpayment penalties, you generally need to pay at least 100% of last year's tax bill (110% if your AGI was over $150K) or 90% of this year's. You can pay online through IRS Direct Pay or EFTPS.\"}},{\"@type\":\"Question\",\"name\":\"Can I deduct half of my self-employment tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes! It's an above-the-line deduction, meaning you get it whether you itemize or not. If your SE tax is, say, $14,130, you deduct $7,065 from your income before calculating income tax. It lowers your AGI, which can help with state taxes too and maybe keep you under certain income thresholds. Just know it doesn't reduce the SE tax itself — that still needs to be paid in full.\"}},{\"@type\":\"Question\",\"name\":\"How does self-employment tax compare to W-2 FICA withholding?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"W-2 employees pay 7.65% and their employer matches another 7.65%. When you're self-employed, you're both — so you pay the full 15.3%. The 92.35% adjustment and the half-of-SE-tax deduction help soften the blow somewhat, but on $100K of income, you're still paying roughly $7,000 more in payroll taxes than a W-2 worker making the same amount. It's the cost of being your own boss.\"}},{\"@type\":\"Question\",\"name\":\"What tax deductions are available for self-employed individuals?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There's actually a lot to work with. Half your SE tax is deductible above the line. You can stash up to $72,000 in a Solo 401(k) for 2026 (including the employer portion). Health insurance premiums? Deductible above the line. Home office — $5 per square foot up to 300 sq ft using the simplified method, or actual expenses if you want to go that route. Business expenses like software, travel, meals (50%), supplies, and professional services all count. And don't forget the Qualified Business Income deduction, which can shave up to 20% off your qualified business income. That one's easy to miss.\"}},{\"@type\":\"Question\",\"name\":\"Should I form an S-Corporation to save on self-employment tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Maybe. The play is to split your income between a reasonable salary (subject to FICA/SE tax) and distributions (not subject to SE tax). On $150K of net income, you might take a $75K salary and $75K in distributions, saving SE tax on that second half. But — and it's a big but — S-Corps come with extra paperwork, payroll requirements, state fees, and more complex tax returns. The math usually makes sense once you're consistently clearing $60K–$80K in net income. Below that, the hassle probably isn't worth it. Talk to a CPA about your specific situation.\"}},{\"@type\":\"Question\",\"name\":\"What happens if I don't pay quarterly estimated taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You'll probably get hit with an underpayment penalty when you file your return — even if you pay everything by April 15. The penalty is basically interest on what you should've paid each quarter, usually running 3–8% annually depending on the IRS rate that quarter. Easiest way to avoid it: hit the safe harbor by paying 100% of last year's tax (110% if your AGI was over $150K) or 90% of this year's through withholding and estimated payments.\"}}]}]}15:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1e\"}}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\"]}]\n26:I[79086,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"ShareButtons\"]\n27:I[21862,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorClientPage\"]\n28:I[56848,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorScenarioSection\"]\n1f:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Self-Employment\"}]]}]\n20:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$L26\",null,{\"url\":\"https://thetaxcalc.com/self-employment-tax-calculator\",\"title\":\"Self-Employment Tax Calculator 2026 | 15.3% SE + 1099\",\"description\":\"Free 2026 self-employment tax calculator. 15.3% SE tax on 92.35% of net income, half deduction, quarterly estimates. See real take-home pay.\"}]}]\n21:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Free Self-Employment Tax Calculator — 1099 & SE Tax\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free self-employment tax calculator for 2026. Calculate SE tax (15.3% on 92.35% of net income), half deduction, quarterly estimates, 1099 & federal + state tax. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":\"Last reviewed: January 2026 · Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]\n22:[\"$\",\"$L27\",null,{\"componentKey\":\"self-employment\"}]\n23:[\"$\",\"$L28\",null,{\"calculatorType\":\"self-employment\",\"calculatorSlug\":\"self-employment-tax-calculator\"}]\n24:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"Related Tools & Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$L10\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💵\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare W-2 vs 1099 take-home pay\"}]]}]]}],[\"$\",\"$L10\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏦\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Solo 401(k) Planner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Reduce SE tax with retirement contributions\"}]]}]]}],[\"$\",\"$L10\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📈\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Capital Gains Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Investment income on top of SE income\"}]]}]]}],[\"$\",\"$L10\",\"/blog\",{\"href\":\"/blog\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📝\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Tax Guides\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Deductions, quarterly payments, and more\"}]]}]]}]]}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"15.3%. That's the <a href=\\\"https://www.irs.gov/taxtopics/tc554\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">self-employment tax rate</a>, and if you just went freelance, it's probably higher than you expected. It covers both halves of Social Security (12.4%) and Medicare (2.9%) — the half your employer used to pay plus the half that always came out of your paycheck. Nobody warned me about this when I started consulting. It's a punch in the wallet.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Here's a small relief: you don't pay 15.3% on 100% of your income. It's calculated on 92.35% of your net business income, which roughly accounts for the employer-half deduction that W-2 workers get automatically. So on $100,000 of net SE income, the tax base is $92,350 and the SE tax comes to roughly $14,130. Still hurts, but less than you might have feared at first glance. And you can deduct half of your SE tax ($7,065 in this example) as an above-the-line deduction. It doesn't reduce the SE tax itself, but it lowers your AGI, which means less federal and state income tax. Every bit counts.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Quick reference for what you're dealing with:<br/>- Social Security portion: 12.4% on income up to $184,500<br/>- Medicare portion: 2.9% on everything, no cap<br/>- Additional Medicare: 0.9% on income above $200,000<br/>- Half of SE tax is deductible above the line\"}}],[\"$\",\"p\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Quarterly estimated payments. This is where new freelancers get into trouble. You have to send the IRS money four times a year — April 15, June 15, September 15, January 15 — or face penalties. The safe harbor is paying at least 100% of last year's tax liability (110% if your AGI was over $150,000) or 90% of this year's. We estimate those quarterly amounts so there are no ugly surprises in April. Seriously, don't skip estimated payments. The penalties aren't worth it.<br/><br/>Want to see how self-employment income compares to a W-2 salary? <a href=\\\"/salary\\\">Check our salary after tax pages</a> to compare take-home pay at every income level across 23 states.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\",\"children\":\"SE Tax = Net Earnings × 92.35% × 15.3%, with deduction = SE Tax ÷ 2\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Step-by-Step\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2\",\"children\":[\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\"]}]]}],\"$L2f\",\"$L30\"]}]]}],\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",false,\"$L36\",\"$L37\"]}]\n3c:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"LinkToUs\"]\n29:[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":1}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate net self-employment income (revenue minus business expenses)\"}]]}]\n2a:[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":2}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Multiply by 92.35% (only this portion is subject to SE tax per IRS rules)\"}]]}]\n2b:[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply 12.4% Social Security tax (up to $184,500 wage base) and 2.9% Medicare (no cap)\"}]]}]\n2c:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":4}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Deduct half of SE tax from ordinary income (above-the-line deduction)\"}]]}]\n2d:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":5}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate income tax on remaining taxable income using standard brackets\"}]]}]\n2e:[\"$\",\"li\",\"5\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":6}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Add SE tax and income tax for total tax liability\"}]]}]\n2f:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Example\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"$$80,000 net SE income: SE taxable = $73,880. SE tax = $11,304 ($9,161 SS + $2,143 Medicare). Deduct $5,652 from income. Income tax on ~$57,248 ≈ $6,850. Total ≈ $18,154.\"}]]}]\n30:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"For detailed data sources and full methodology, see our \",[\"$\",\"$L10\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Methodology & Data Sources\"}],\" page.\"]}]\n31:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Key Rates & Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"SE Tax Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"SE Tax Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"15.3% on 92.35% of net income\"}]]}],[\"$\",\"div\",\"Social Security Portion\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Social Security Portion\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"12.4% (up to $184,500)\"}]]}],[\"$\",\"div\",\"Medicare Portion\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Medicare Portion\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"2.9% (no cap)\"}]]}],[\"$\",\"div\",\"Additional Medicare\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Additional Medicare\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"0.9% (above $200K)\"}]]}],[\"$\",\"div\",\"Half SE Tax Deduction\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Half SE Tax Deduction\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"Above-the-line\"}]]}]]}]]}]\n32:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Self-Employment Tax FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the self-employment tax rate for 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"15.3% on 92.35% of your net business income. That's 12.4% for Social Security (capped at $184,500 in income) and 2.9% for Medicare (no cap). Once you cross $200K in net SE income, tack on another 0.9% Medicare surcharge on everything above that. Basically, you're covering both the employee and employer sides of FICA since you are both.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do quarterly estimated tax payments work?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"If you're self-employed, the IRS wants its money throughout the year, not just at tax time. You make four payments — April 15, June 15, September 15, and January 15 — each covering roughly a quarter of what you expect to owe (income tax plus SE tax). To dodge underpayment penalties, you generally need to pay at least 100% of last year's tax bill (110% if your AGI was over $150K) or 90% of this year's. You can pay online through IRS Direct Pay or EFTPS.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Can I deduct half of my self-employment tax?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes! It's an above-the-line deduction, meaning you get it whether you itemize or not. If your SE tax is, say, $14,130, you deduct $7,065 from your income before calculating income tax. It lowers your AGI, which can help with state taxes too and maybe keep you under certain income thresholds. Just know it doesn't reduce the SE tax itself — that still needs to be paid in full.\"}]]}],\"$L38\",\"$L39\",\"$L3a\",\"$L3b\"]}]]}]\n33:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L10\",\"how-fica-taxes-work-2026\",{\"href\":\"/blog/how-fica-taxes-work-2026\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"How FICA Taxes Work in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Understanding FICA taxes (Social Security and Medicare) in 2026 — what you pay, what your employer pays, and how self-employment tax differs.\"}]]}]]}]]}]\n34:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L10\",\"paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Paycheck Calculator\"]}],[\"$\",\"$L10\",\"capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Capital Gains Calculator\"]}],[\"$\",\"$L10\",\"401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"401(k) Calculator\"]}],[\"$\",\"$L10\",\"relocation-calculator\",{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Relocation Calculator\"]}],[\"$\",\"$L10\",\"salary\",{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Salary After Tax\"]}]]}]]}]\n35:[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L3c\",null,{\"url\":\"https://thetaxcalc.com/self-employment-tax-calculator\",\"title\":\"Self-Employment Tax Calculator 2026 | 15.3% SE + 1099\",\"slug\":\"self-employment-tax-calculator\"}]}]\n36:[\"$\",\"section\",null,{\"c