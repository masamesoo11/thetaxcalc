\"}]\\n\"])</script><script>self.__next_f.push([1,\"24:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-lg font-semibold text-foreground mb-3\\\",\\\"children\\\":\\\"Related Tools \\u0026 Resources\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",\\\"/paycheck-calculator\\\",{\\\"href\\\":\\\"/paycheck-calculator\\\",\\\"className\\\":\\\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"💵\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm font-medium text-foreground\\\",\\\"children\\\":\\\"Paycheck Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"Compare W-2 vs 1099 take-home pay\\\"}]]}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/401k-retirement-calculator\\\",{\\\"href\\\":\\\"/401k-retirement-calculator\\\",\\\"className\\\":\\\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"🏦\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm font-medium text-foreground\\\",\\\"children\\\":\\\"Solo 401(k) Planner\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"Reduce SE tax with retirement contributions\\\"}]]}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/capital-gains-calculator\\\",{\\\"href\\\":\\\"/capital-gains-calculator\\\",\\\"className\\\":\\\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"📈\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm font-medium text-foreground\\\",\\\"children\\\":\\\"Capital Gains Tax\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"Investment income on top of SE income\\\"}]]}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/blog\\\",{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"📝\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm font-medium text-foreground\\\",\\\"children\\\":\\\"Tax Guides\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"Deductions, quarterly payments, and more\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"25:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12 space-y-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"How This Calculator Works\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"15.3%. That's the \\u003ca href=\\\\\\\"https://www.irs.gov/taxtopics/tc554\\\\\\\" target=\\\\\\\"_blank\\\\\\\" rel=\\\\\\\"noopener noreferrer\\\\\\\"\\u003eself-employment tax rate\\u003c/a\\u003e, and if you just went freelance, it's probably higher than you expected. It covers both halves of Social Security (12.4%) and Medicare (2.9%) — the half your employer used to pay plus the half that always came out of your paycheck. Nobody warned me about this when I started consulting. It's a punch in the wallet.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Here's a small relief: you don't pay 15.3% on 100% of your income. It's calculated on 92.35% of your net business income, which roughly accounts for the employer-half deduction that W-2 workers get automatically. So on $100,000 of net SE income, the tax base is $92,350 and the SE tax comes to roughly $14,130. Still hurts, but less than you might have feared at first glance. And you can deduct half of your SE tax ($7,065 in this example) as an above-the-line deduction. It doesn't reduce the SE tax itself, but it lowers your AGI, which means less federal and state income tax. Every bit counts.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Quick reference for what you're dealing with:\\u003cbr/\\u003e- Social Security portion: 12.4% on income up to $184,500\\u003cbr/\\u003e- Medicare portion: 2.9% on everything, no cap\\u003cbr/\\u003e- Additional Medicare: 0.9% on income above $200,000\\u003cbr/\\u003e- Half of SE tax is deductible above the line\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Quarterly estimated payments. This is where new freelancers get into trouble. You have to send the IRS money four times a year — April 15, June 15, September 15, January 15 — or face penalties. The safe harbor is paying at least 100% of last year's tax liability (110% if your AGI was over $150,000) or 90% of this year's. We estimate those quarterly amounts so there are no ugly surprises in April. Seriously, don't skip estimated payments. The penalties aren't worth it.\\u003cbr/\\u003e\\u003cbr/\\u003eWant to see how self-employment income compares to a W-2 salary? \\u003ca href=\\\\\\\"/salary\\\\\\\"\\u003eCheck our salary after tax pages\\u003c/a\\u003e to compare take-home pay at every income level across 23 states.\\\"}}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"How It's Calculated\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\\\",\\\"children\\\":\\\"Formula\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\\\",\\\"children\\\":\\\"SE Tax = Net Earnings × 92.35% × 15.3%, with deduction = SE Tax ÷ 2\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\\\",\\\"children\\\":\\\"Step-by-Step\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\"]}]]}],\\\"$L2f\\\",\\\"$L30\\\"]}]]}],\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",false,\\\"$L36\\\",\\\"$L37\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"3c:I[18274,[\\\"/_next/static/chunks/49e33bee669819de.js\\\",\\\"/_next/static/chunks/868a9c4503c53c54.js\\\",\\\"/_next/static/chunks/d791dd6e73034ab4.js\\\",\\\"/_next/static/chunks/6bcaf73165d03f74.js\\\",\\\"/_next/static/chunks/3c28bbc2a8ff143e.js\\\",\\\"/_next/static/chunks/474ace38d7992a17.js\\\",\\\"/_next/static/chunks/c9e031433494c7b2.js\\\"],\\\"LinkToUs\\\"]\\n29:[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":1}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Calculate net self-employment income (revenue minus business expenses)\\\"}]]}]\\n2a:[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":2}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Multiply by 92.35% (only this portion is subject to SE tax per IRS rules)\\\"}]]}]\\n2b:[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":3}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Apply 12.4% Social Security tax (up to $184,500 wage base) and 2.9% Medicare (no cap)\\\"}]]}]\\n2c:[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":4}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Deduct half of SE tax from ordinary income (above-the-line deduction)\\\"}]]}]\\n2d:[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"className