p-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all bg-emerald-500/12 text-emerald-400\" href=\"/tax-data\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Data</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/widgets\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code-xml h-4 w-4\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4\"></path><path d=\"m6 8-4 4 4 4\"></path><path d=\"m14.5 4-5 16\"></path></svg>Widgets</a></nav><div class=\"flex items-center gap-3\"><a class=\"hidden sm:flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all hover:scale-[1.02]\" href=\"/paycheck-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Calculate Now</a><button data-slot=\"button\" class=\"inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-8 rounded-md gap-1.5 px-3 has-[&gt;svg]:px-2.5 lg:hidden text-muted-foreground hover:text-foreground\" aria-label=\"Toggle mobile menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 12h16\"></path><path d=\"M4 18h16\"></path><path d=\"M4 6h16\"></path></svg></button></div></div></header><main id=\"main-content\" class=\"flex-1\"><div class=\"mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/tax-data#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tax Data & Statistics\"}]},{\"@id\":\"https://thetaxcalc.com/tax-data#webpage\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Data & Statistics — All 50 States\",\"description\":\"Free, citable 2026 tax data for all 50 US states. Sales tax rates, federal brackets, FICA rates, and more.\",\"url\":\"https://thetaxcalc.com/tax-data\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/tax-data#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/tax-data#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/tax-data#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/tax-data#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/tax-data#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I use this data in my article, report, or website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — that is the purpose of this page. All data is free to cite, link to, and embed. Click the \\\"Cite\\\" button on any section for an APA-formatted citation, or use the \\\"Embed\\\" button to get iframe code for your website. Attribution with a link to thetaxcalc.com is appreciated.\"}},{\"@type\":\"Question\",\"name\":\"Where does this data come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Federal tax data comes from IRS Revenue Procedures and SSA publications. State sales tax data is sourced from each state's Department of Revenue and the Tax Foundation. FICA rates are set by the Social Security Administration. We update within 48 hours of official government publications.\"}},{\"@type\":\"Question\",\"name\":\"How often is the data updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We update this page within 48 hours of any official government publication. Federal brackets are typically updated in October/November of each year. State rates may change throughout the year as legislatures pass new tax laws.\"}},{\"@type\":\"Question\",\"name\":\"Can I download the data as CSV or spreadsheet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Use the \\\"CSV\\\" button in the sales tax table to download all 50 states' rates as a CSV file. This can be opened in Excel, Google Sheets, or any spreadsheet application.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no sales tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Five states have no state or local sales tax: Delaware, Montana, New Hampshire, and Oregon. Alaska has no state sales tax but allows local taxes (avg 1.82%). These states are highlighted in the sales tax table above.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nine states have no state income tax on wages: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming. New Hampshire taxes dividends and interest but not wages. See the detailed comparison table above.\"}},{\"@type\":\"Question\",\"name\":\"What is the Social Security wage base for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 Social Security (OASDI) wage base is $184,500. The 6.2% Social Security tax applies only to the first $184,500 of earned income, for a maximum employee contribution of $11,439.00.\"}},{\"@type\":\"Question\",\"name\":\"How much can I contribute to my 401(k) in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 401(k) contribution limit is $24,500. If you are 50+, you can add $8,000 in catch-up contributions ($32,500 total). Under SECURE 2.0, workers aged 60–63 have an enhanced catch-up of $11,250 ($35,750 total).\"}}]}]}</script><nav aria-label=\"Breadcrumb\" class=\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\"><a class=\"underline underline-offset-2 decoration-muted-foreground/40 hover:decoration-foreground hover:text-foreground transition-colors flex items-center gap-1\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-house h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"></path><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg><span class=\"hidden sm:inline\">Home</span></a><span class=\"flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5 text-muted-foreground\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg><span class=\"text-foreground font-medium\">Tax Data &amp; Statistics</span></span></nav><section class=\"mb-12 text-center\"><div class=\"inline-flex items-center gap-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 px-4 py-1.5 text-sm text-emerald-400 mb-6\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database h-3.5 w-3.5\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg>Free Reference Data — All 50 States — Cite &amp; Embed Freely</div><h1 class=\"text-4xl font-bold tracking-tight text-foreground sm:text-5xl\">2026 Tax Data<!-- --> <span class=\"gradient-text\">&amp; Statistics</span></h1><p class=\"mx-auto mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed\">The most comprehensive free 2026 tax data reference — sales tax for all 50 states, federal brackets, FICA rates, and more. Download CSV, embed charts on your site, and cite freely in your articles.</p><div class=\"flex flex-wrap items-center justify-center gap-3 mt-8\"><a class=\"inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all hover:scale-[1.02]\" href=\"#sales-tax-all-states\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-receipt h-4 w-4\" aria-hidden=\"true\"><path d=\"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z\"></path><path d=\"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8\"></path><path d=\"M12 17.5v-11\"></path></svg>Sales Tax — 50 States</a><a class=\"inline-flex items-center gap-2 rounded-xl border border-border/50 bg-card/50 px-6 py-3 text-sm font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\" href=\"#federal-brackets\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-4 w-4\" aria-hidden=\"true\"><path d=\"M16 7h6v6\"></path><path d=\"m22 7-8.5 8.5-5-5L2 17\"></path></svg>Federal Brackets</a><a class=\"inline-flex items-center gap-2 rounded-xl border border-border/50 bg-card/50 px-6 py-3 text-sm font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\" href=\"#no-income-tax\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-map-pin h-4 w-4\" aria-hidden=\"true\"><path d=\"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>No-Tax States</a><a class=\"inline-flex items-center gap-2 rounded-xl border border-border/50 bg-card/50 px-6 py-3 text-sm font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\" href=\"/widgets\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code-xml h-4 w-4\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4\"></path><path d=\"m6 8-4 4 4 4\"></path><path d=\"m14.5 4-5 16\"></path></svg>Embed Widgets</a></div></section><section class=\"mb-12\"><div class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-5\"><div class=\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\"><p class=\"text-2xl font-bold text-emerald-400\">50</p><p class=\"text-sm font-semibold text-foreground mt-1\">States Covered</p><p class=\"text-xs text-muted-foreground mt-0.5\">Sales tax data</p></div><div class=\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\"><p class=\"text-2xl font-bold text-emerald-400\">7 rates</p><p class=\"text-sm font-semibold text-foreground mt-1\">Federal Brackets</p><p class=\"text-xs text-muted-foreground mt-0.5\">3 filing statuses</p></div><div class=\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\"><p class=\"text-2xl font-bold text-emerald-400\">9</p><p class=\"text-sm font-semibold text-foreground mt-1\">No-Tax States</p><p class=\"text-xs text-muted-foreground mt-0.5\">No income tax on wages</p></div><div class=\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\"><p class=\"text-2xl font-bold text-emerald-400\">$184,500</p><p class=\"text-sm font-semibold text-foreground mt-1\">SS Wage Base</p><p class=\"text-xs text-muted-foreground mt-0.5\">6.2% OASDI</p></div><div class=\"rounded-xl border border-border/30 bg-card/50 p-5 text-center\"><p class=\"text-2xl font-bold text-emerald-400\">$24,500</p><p class=\"text-sm font-semibold text-foreground mt-1\">401(k) Limit</p><p class=\"text-xs text-muted-foreground mt-0.5\">+$8,000 catch-up</p></div></div></section><section class=\"mb-12\"><div id=\"sales-tax-all-states\" class=\"scroll-mt-24 mb-6\"><div class=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\"><div class=\"flex items-center gap-3\"><div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-receipt h-5 w-5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z\"></path><path d=\"M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8\"></path><path d=\"M12 17.5v-11\"></path></svg></div><h2 class=\"text-2xl font-bold text-foreground\">Sales Tax Rates<!-- --> <span class=\"gradient-text\">— All 50 States</span></h2></div><a href=\"#sales-tax-all-states\" class=\"inline-flex items-center gap-1 rounded-lg border border-border/40 bg-muted/20 px-2.5 py-1 text-xs font-medium text-muted-foreground hover:border-emerald-