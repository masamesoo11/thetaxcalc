old text-foreground\">9.56%</span></td><td class=\"px-4 py-2.5 text-xs text-muted-foreground hidden md:table-cell\">Groceries</td></tr><tr class=\"border-b border-border/10 last:border-0 hover:bg-muted/5 transition-colors \"><td class=\"px-4 py-2.5 text-sm\"><span class=\"font-semibold text-foreground\">Tennessee</span><span class=\"ml-1.5 text-xs text-muted-foreground\">(<!-- -->TN<!-- -->)</span></td><td class=\"px-4 py-2.5 text-sm\"><span class=\"inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold bg-amber-500/10 text-amber-400\">7.00%</span></td><td class=\"px-4 py-2.5 text-sm text-muted-foreground hidden sm:table-cell\">2.56%</td><td class=\"px-4 py-2.5 text-sm\"><span class=\"font-semibold text-foreground\">9.56%</span></td><td class=\"px-4 py-2.5 text-xs text-muted-foreground hidden md:table-cell\">Groceries</td></tr><tr class=\"border-b border-border/10 last:border-0 hover:bg-muted/5 transition-colors \"><td class=\"px-4 py-2.5 text-sm\"><span class=\"font-semibold text-foreground\">Arkansas</span><span class=\"ml-1.5 text-xs text-muted-foreground\">(<!-- -->AR<!-- -->)</span></td><td class=\"px-4 py-2.5 text-sm\"><span class=\"inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold bg-amber-500/10 text-amber-400\">6.50%</span></td><td class=\"px-4 py-2.5 text-sm text-muted-foreground hidden sm:table-cell\">2.97%</td><td class=\"px-4 py-2.5 text-sm\"><span class=\"font-semibold text-foreground\">9.47%</span></td><td class=\"px-4 py-2.5 text-xs text-muted-foreground hidden md:table-cell\">Groceries</td></tr><tr class=\"border-b border-border/10 last:border-0 hover:bg-muted/5 transition-colors \"><td class=\"px-4 py-2.5 text-sm\"><span class=\"font-semibold text-foreground\">Washington</span><span class=\"ml-1.5 text-xs text-muted-foreground\">(<!-- -->WA<!-- -->)</span></td><td class=\"px-4 py-2.5 text-sm\"><span class=\"inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold bg-amber-500/10 text-amber-400\">6.50%