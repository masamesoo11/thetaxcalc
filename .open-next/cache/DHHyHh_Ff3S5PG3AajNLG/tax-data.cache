/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/0e91254c2489e470.js\",\"/_next/static/chunks/ee986bbc1626f462.js\"],\"FederalBracketsChart\"]\n26:I[10431,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/0e91254c2489e470.js\",\"/_next/static/chunks/ee986bbc1626f462.js\"],\"NoIncomeTaxTable\"]\n3e:I[10431,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/0e91254c2489e470.js\",\"/_next/static/chunks/ee986bbc1626f462.js\"],\"DataEmbedSnippets\"]\n4a:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n4b:\"$Sreact.suspense\"\n2:T1391,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/tax-data#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tax Data & Statistics\"}]},{\"@id\":\"https://thetaxcalc.com/tax-data#webpage\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Data & Statistics — All 50 States\",\"description\":\"Free, citable 2026 tax data for all 50 US states. Sales tax rates, federal brackets, FICA rates, and more.\",\"url\":\"https://thetaxcalc.com/tax-data\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/tax-data#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/tax-data#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/tax-data#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/tax-data#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com/tax-data#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I use this data in my article, report, or website?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes — that is the purpose of this page. All data is free to cite, link to, and embed. Click the \\\"Cite\\\" button on any section for an APA-formatted citation, or use the \\\"Embed\\\" button to get iframe code for your website. Attribution with a link to thetaxcalc.com is appreciated.\"}},{\"@type\":\"Question\",\"name\":\"Where does this data come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Federal tax data comes from IRS Revenue Procedures and SSA publications. State sales tax data is sourced from each state's Department of Revenue and the Tax Foundation. FICA rates are set by the Social Security Administration. We update within 48 hours of official government publications.\"}},{\"@type\":\"Question\",\"name\":\"How often is the data updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We update this page within 48 hours of any official government publication. Federal brackets are typically updated in October/November of each year. State rates may change throughout the year as legislatures pass new tax laws.\"}},{\"@type\":\"Question\",\"name\":\"Can I download the data as CSV or spreadsheet?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Use the \\\"CSV\\\" button in the sales tax table to download all 50 states' rates as a CSV file. This can be opened in Excel, Google Sheets, or any spreadsheet application.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no sales tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Five states have no state or local sales tax: Delaware, Montana, New Hampshire, and Oregon. Alaska has no state sales tax but allows local taxes (avg 1.82%). These states are highlighted in the sales tax table above.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nine states have no state income tax on wages: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming. New Hampshire taxes dividends and interest but not wages. See the detailed comparison table above.\"}},{\"@type\":\"Question\",\"name\":\"What is the Social Security wage base for 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 Social Security (OASDI) wage base is $184,500. The 6.2% Social Security tax applies only to the first $184,500 of earned income, for a maximum employee contribution of $11,439.00.\"}},{\"@type\":\"Question\",\"name\":\"How much can I contribute to my 401(k) in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The 2026 401(k) contribution limit is $24,500. If you are 50+, you can add $8,000 in catch-up contributions ($32,500 total). Under SECURE 2.0, workers aged 60–63 have an enhanced catch-up of $11,250 ($35,750 total).\"}}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\"]}],[\"$L12\",\"$L13\"],\"$L14\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L15\",null,{\"href\":\"/\",\"className\":\"underline underline-offset-2 decoration-muted-foreground/40 hover:decoration-foreground hover:text-foreground transition-colors flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-house h-3.5 w-3.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"5wwlr5\",{\"d\":\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"}],[\"$\",\"path\",\"1d0kgt\",{\"d\":\"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"hidden sm:inline\",\"children\":\"Home\"}]]}],[[\"$\",\"span\",\"0\",{\"className\":\"flex items-center gap-1.5\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"stro