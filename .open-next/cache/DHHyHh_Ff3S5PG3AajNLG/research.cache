",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Latest Studies\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2\",\"children\":[[\"$\",\"$L10\",\"2026-state-tax-burden\",{\"href\":\"/research/2026-state-tax-burden\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"State Comparison\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"12 min\",\" read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"2026 State Tax Burden: Total Tax Load by State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"We combined state income tax, property tax, and sales tax into a single effective burden figure for all 50 states. See where your state ranks and how the One Big Beautiful Bill Act shifted the picture.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]]}],[\"$\",\"$L10\",\"best-states-for-remote-workers-2026\",{\"href\":\"/research/best-states-for-remote-workers-2026\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"Lifestyle & Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"10 min\",\" read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"Best States for Remote Workers in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"A tax-adjusted ranking of the best states for full-time remote workers in 2026, factoring in income tax, cost of living, broadband coverage, and the new OBBBA tip and overtime deductions.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]]}],[\"$\",\"$L10\",\"child-tax-credit-guide-2026\",{\"href\":\"/research/child-tax-credit-guide-2026\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"Tax Credits\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"8 min\",\" read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"Child Tax Credit Guide 2026 — OBBBA Doubles CTC to $2,200\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"Everything you need to know about the 2026 Child Tax Credit under OBBBA: $2,200 per child, $1,700 refundable, phaseouts, and how it compares to prior law. With worked examples.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]]}],[\"$\",\"$L10\",\"property-tax-by-state-2026\",{\"href\":\"/research/property-tax-by-state-2026\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"Property Tax\"}],\"$L24\"]}],\"$L25\",\"$L26\",\"$L27\"]}],\"$L28\",\"$L29\"]}]]}]\n1a:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Our Research Methodology\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":\"Every study in our research hub follows the same methodology. We start with official government data — never third-party aggregators. For federal tax figures we use IRS publications and the Social Security Administration. For state data we use each state’s Department of Revenue. For demographic and economic data we use the U.S. Census Bureau and the Bureau of Economic Analysis.\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed mb-4\",\"children\":[\"After collecting raw data, we apply our calculation logic — the same logic that powers our\",\" \",[\"$\",\"$L10\",null,{\"href\":\"/paycheck-calculator\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"paycheck calculator\"}],\" \",\"and other tools — to produce derived metrics. Each step is documented in a methodology section at the bottom of the study. Every study is then reviewed by a credentialed tax professional (CPA or EA) before publication.\"]}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":[\"For a full description of how we compute every tax figure on the site, see our\",\" \",[\"$\",\"$L10\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"methodology page\"}],\".\"]}]]}]\n1b:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Research FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"What is TheTaxCalc Research?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"What is TheTaxCalc Research?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"TheTaxCalc Research is our collection of original data studies and reference guides on U.S. taxation. Each study combines official government data — IRS, SSA, Census Bureau, and state revenue departments — with our own analysis to produce practical, accurate, and fully-sourced tax insights. Every study is reviewed by a credentialed tax professional before publication.\"}]]}],[\"$\",\"div\",\"How often is the research updated?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How often is the research updated?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We update each study on its natural refresh cycle. State tax burden and property tax data refresh annually after new Census and Tax Foundation releases. Child Tax Credit and OBBBA-related research updates whenever Congress or the IRS issues new guidance. Tax refund statistics update quarterly during the filing season (January through April) and once after the season ends.\"}]]}],[\"$\",\"div\",\"Can I cite TheTaxCalc research in my own work?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Can I cite TheTaxCalc research in my own work?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. We encourage journalists, researchers, financial advisors, and educators to cite our research. Each study includes a permanent URL, publication date, and last-updated date so your readers can verify the source. Please link to the original study rather than copying the data tables wholesale. If you need a higher-resolution chart or raw data export, contact us at hello@thetaxcalc.com.\"}]]}],[\"$\",\"div\",\"Where does your data come from?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Where does your data come from?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Every figure in our research comes from an official government source. Federal tax data is sourced from IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972) and the Social Security Administration. State tax data comes from each state's Department of Revenue. Demographic and income data comes from the U.S. Census Bureau. Cost of living data comes from the Bureau of Economic Analysis and the Council for Community and Economic Research. We publish the full methodology and source list at the bottom of every study.\"}]]}],[\"$\",\"div\",\"Is TheTaxCalc research free to access?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Is TheTaxCalc research free to access?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Every study, data table, and chart in our research hub is free to read, with no paywall, no sign-up, and no email requirement. We do not collect your contact information when you read our research. We believe tax data should be freely accessible to every American. If you find the research useful, we encourage you to share it with colleagues or link to it from your own writing.\"}]]}],\"$L2a\"]}]]}]\n1c:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L10\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Take-home pay for all 50 states.\"}]]}],[\"$\",\"$L10\",\"/obbba-tax-calculator\",{\"href\":\"/obbba-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"OBBBA Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare 2026 taxes under the new tax law.\"}]]}],[\"$\",\"$L10\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"State Comparison Tool\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare any two states side-by-side.\"}]]}],[\"$\",\"$L10\",\"/tax-data\",{\"href\":\"/tax-data\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Tax Data Reference\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"All federal and state tax rates in one place.\"}]]}]]}]]}]\n1d:[\"$\",\"$L2b\",null,{\"children\":[\"$\",\"$21\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@2c\"}]}]\n24:[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"9 min\",\" read\"]}]\n25:[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"Property Tax by State 2026 — Effective Rates & Median Bills\"}]\n26:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context.\"}]\n27:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]\n28:[\"$\",\"$L10\",\"salary-needed-to-live-comfortably-2026\",{\"href\":\"/research/salary-needed-to-live-comfortably-2026\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"Salary & Cost of Living\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"11 min\",\" read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"Salary Needed to Live Comfortably in 2026 — By State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"How much do you need to earn in 2026 to live comfortably in each state? We used the 50/30/20 rule, regional cost of living, and after-tax paycheck data to estimate the magic number.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]]}]\n29:[\"$\",\"$L10\",\"tax-refund-statistics-2026\",{\"href\":\"/research/tax-refund-statistics-2026\",\"className\":\"block rounded-xl border border-border/30 bg-card/50 p-6 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-0.5 text-xs text-emerald-400\",\"children\":\"Tax Refunds\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"7 min\",\" read\"]}]]}],[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-2\",\"children\":\"Tax Refund Statistics 2026 — Average Refunds by State & Income\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":\"IRS statistics on average federal tax refunds by state, income bracket, and filing status for the 2026 filing season. Plus how OBBBA is expected to change refund sizes.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 2026\"]}]]}]\n2a:[\"$\",\"div\",\"How is this research different from your blog?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How is this research different from your blog?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Our blog covers timely tax news, how-to guides, and current-year updates. Our research hub, by contrast, contains original data-driven studies with a longer shelf life. Research pieces are typically longer (7-12 minutes of reading), include multiple data tables and charts, and undergo a more rigorous editorial review process. Both are written by credentialed tax professionals and sourced from official government data.\"}]]}]\n1f:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2d:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n22:[[\"$\",\"title\",\"0\",{\"children\":\"Research Hub — 2026 Tax Data & Original Studies | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Browse TheTaxCalc 2026 research: state tax burden rankings, best states for remote workers, child tax credit guide, property tax by state, and refund stats.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/research\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"Research Hub — 2026 Tax Data & Original Studies\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Original research and data studies from TheTaxCalc. State tax burden, remote work, child tax credit, property tax, salary needs, and refund statistics for 2026.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/research\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:alt\",\"content\":\"TheTaxCalc Research Hub — 2026 Tax Data & Original Studies\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:title\",\"content\":\"TheTaxCalc Research Hub — 2026 Tax Data & Original Studies\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:description\",\"content\":\"Original research: state tax burden, remote work, child tax credit, property tax, refund statistics.\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"26\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2d\",\"27\",{}]]\n2c:null\n","/research/__PAGE__":"1:\"$Sreact.fragment\"\nb:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"\"]\n13:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n14:\"$Sreact.suspense\"\n2:T168c,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/research#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research\",\"item\":\"https://thetaxcalc.com/research\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/research#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is TheTaxCalc Research?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TheTaxCalc Research is our collection of original data studies and reference guides on U.S. taxation. Each study combines official government data — IRS, SSA, Census Bureau, and state revenue departments — with our own analysis to produce practical, accurate, and fully-sourced tax insights. Every study is reviewed by a credentialed tax professional before publication.\"}},{\"@type\":\"Question\",\"name\":\"How often is the research updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We update each study on its natural refresh cycle. State tax burden and property tax data refresh annually after new Census and Tax Foundation releases. Child Tax Credit and OBBBA-related research updates whenever Congress or the IRS issues new guidance. Tax refund statistics update quarterly during the filing season (January through April) and once after the season ends.\"}},{\"@type\":\"Question\",\"name\":\"Can I cite TheTaxCalc research in my own work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We encourage journalists, researchers, financial advisors, and educators to cite our research. Each study includes a permanent URL, publication date, and last-updated date so your readers can verify the source. Please link to the original study rather than copying the data tables wholesale. If you need a higher-resolution chart or raw data export, contact us at hello@thetaxcalc.com.\"}},{\"@type\":\"Question\",\"name\":\"Where does your data come from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Every figure in our research comes from an official government source. Federal tax data is sourced from IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972) and the Social Security Administration. State tax data comes from each state's Department of Revenue. Demographic and income data comes from the U.S. Census Bureau. Cost of living data comes from the Bureau of Economic Analysis and the Council for Community and Economic Research. We publish the full methodology and source list at the bottom of every study.\"}},{\"@type\":\"Question\",\"name\":\"Is TheTaxCalc research free to access?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Every study, data table, and chart in our research hub is free to read, with no paywall, no sign-up, and no email requirement. We do not collect your contact information when you read our research. We believe tax data should be freely accessible to every American. If you find the research useful, we encourage you to share it with colleagues or link to it from your own writing.\"}},{\"@type\":\"Question\",\"name\":\"How is this research different from your blog?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Our blog covers timely tax news, how-to guides, and current-year updates. Our research hub, by contrast, contains original data-driven studies with a longer shelf life. Research pieces are typically longer (7-12 minutes of reading), include multiple data tables and charts, and undergo a more rigorous editorial review process. Both are written by credentialed tax professionals and sourced from official government data.\"}}]},{\"@type\":\"CollectionPage\",\"name\":\"TheTaxCalc Research Hub\",\"description\":\"Original tax research and data studies from TheTaxCalc, covering state tax burden, property tax, the Child Tax Credit, remote work, and tax refund statistics.\",\"url\":\"https://thetaxcalc.com/research\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"hasPart\":[{\"@type\":\"ScholarlyArticle\",\"headline\":\"2026 State Tax Burden: Total Tax Load by State\",\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}},{\"@type\":\"ScholarlyArticle\",\"headline\":\"Best States for Remote Workers in 2026\",\"url\":\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}},{\"@type\":\"ScholarlyArticle\",\"headline\":\"Child Tax Credit Guide 2026 — OBBBA Doubles CTC to $2,200\",\"url\":\"https://thetaxcalc.com/research/child-tax-credit-guide-2026\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}},{\"@type\":\"ScholarlyArticle\",\"headline\":\"Property Tax by State 2026 — Effective Rates & Median Bills\",\"url\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}},{\"@type\":\"ScholarlyArticle\",\"headline\":\"Salary Needed to Live Comfortably in 2026 — By State\",\"url\":\"https://thetaxcalc.com/research/salary-needed-to-live-comfortably-2026\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}},{\"@type\":\"ScholarlyArticle\",\"headline\":\"Tax Refund Statistics 2026 — Average Refunds by State & Income\",\"url\":\"https://thetaxcalc.com/research/tax-refund-statistics-2026\",\"datePublished\":\"2026-01-15\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"}}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\