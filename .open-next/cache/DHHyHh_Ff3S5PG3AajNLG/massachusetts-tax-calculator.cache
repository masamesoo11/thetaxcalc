.js\",\"async\":true}]\ne:[\"$\",\"$L21\",null,{\"children\":[\"$\",\"$22\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@23\"}]}]\n13:[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}]\n14:[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"If income exceeds $1,000,000, apply 9% surtax on the excess (millionaire's tax)\"}]\n15:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":4}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Add federal tax (10%–37% progressive brackets) and FICA (7.65%)\"}]]}]\n16:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":5}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Sum all taxes and subtract from gross pay for net take-home\"}]]}]\n17:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Example\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"$$100,000 salary, single in MA: MA taxable = $95,600. MA tax = $4,780. Federal ≈ $11,670. FICA = $7,650. Net ≈ $75,900.\"}]]}]\n18:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"For detailed data sources and full methodology, see our \",[\"$\",\"$Lf\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-