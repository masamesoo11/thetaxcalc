,[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"never\\\"}],\\\" lose money by earning more. We can't believe we still have to say this, but here we are.\\\"]}]]}]}]\\n\"])</script><script>self.__next_f.push([1,\"31:[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"group premium-card p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex items-center justify-between cursor-pointer list-none\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1u773s\\\",{\\\"d\\\":\\\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"p32p05\\\",{\\\"d\\\":\\\"M12 17h.01\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground text-sm sm:text-base\\\",\\\"children\\\":\\\"How do progressive tax brackets work?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mthhwq\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\"}],\\\"$undefined\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\\\",\\\"children\\\":\\\"Progressive means your income gets taxed in layers, not all at one rate. Take a single filer making $75,000. After the $16,100 standard deduction, taxable income is $58,900. The first $12,400 gets 10%, the chunk from $12,401 to $50,400 gets 12%, and only the remaining $8,500 gets 22%. Your total federal tax is the sum of those three pieces — not 22% of the whole thing. Big difference.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"32:[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"group premium-card p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex items-center justify-between cursor-pointer list-none\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1u773s\\\",{\\\"d\\\":\\\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"p32p05\\\",{\\\"d\\\":\\\"M12 17h.01\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground text-sm sm:text-base\\\",\\\"children\\\":\\\"What is the difference between marginal and effective tax rates?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mthhwq\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\"}],\\\"$undefined\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\\\",\\\"children\\\":\\\"Your marginal rate is what hits your last dollar earned — it's your top bracket. Your effective rate is your total tax divided by your total income — the real average rate you pay. Example: a single filer at $75K has a marginal rate of 22% but an effective federal rate of about 11.6%. That's a massive difference, and confusing the two is why some people think a raise will cost them money. It won't.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"33:[\\\"$\\\",\\\"details\\\",\\\"4\\\",{\\\"className\\\":\\\"group premium-card p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex items-center justify-between cursor-pointer list-none\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"circle\\\",\\\"1mglay\\\",{\\\"cx\\\":\\\"12\\\",\\\"cy\\\":\\\"12\\\",\\\"r\\\":\\\"10\\\"}],[\\\"$\\\",\\\"path\\\",\\\"1u773s\\\",{\\\"d\\\":\\\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\\\"}],[\\\"$\\\",\\\"path\\\",\\\"p32p05\\\",{\\\"d\\\":\\\"M12 17h.01\\\"}],\\\"$undefined\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground text-sm sm:text-base\\\",\\\"children\\\":\\\"Did the 2026 tax brackets change from 2025?\\\"}]]}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"mthhwq\\\",{\\\"d\\\":\\\"m9 18 6-6-6-6\\\"}],\\\"$undefined\\\"]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\\\",\\\"children\\\":\\\"Yep. The IRS adjusts for inflation every year. For 2026, the OBBBA significantly boosted the standard deduction: from $14,600 to $16,100 (single) and $29,200 to $32,200 (married). Bracket thresholds also increased. These adjustments are supposed to prevent \\\\\\\"bracket creep\\\\\\\" — where inflation pushes you into a higher bracket even though your purchasing power didn't actually improve. Doesn't always work perfectly, but it helps.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"34:[\\\"$\\\",\\\"details\\\",\\\"5\\\",{\\\"className\\\":\\\"group premium-card p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex items-center justify-between cursor-pointer li