 sm:text-3xl font-bold text-foreground\",\"children\":[\"2026 Federal Tax Brackets by \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Filing Status\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl\",\"children\":\"Pick your filing status below. These are the official IRS numbers for 2026 — not estimates, not last year's data. The real deal.\"}]]}],[\"$\",\"div\",null,{\"className\":\"premium-card p-4 sm:p-6\",\"children\":[\"$\",\"$Lf\",null,{}]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-xs text-muted-foreground flex items-start gap-2\",\"children\":[[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info h-3.5 w-3.5 shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],\"Tax brackets apply to \",[\"$\",\"strong\",null,{\"children\":\"taxable income\"}],\", which is your gross income minus the standard deduction (or itemized deductions). Only the income within each bracket is taxed at that rate.\"]}]]}]}]\n5:[\"$\",\"section\",null,{\"className\":\"py-12 sm:py-16 border-t border-border/20\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl sm:text-3xl font-bold text-foreground\",\"children\":[\"2026 \",[\"$\",\"span\",null,{\"className\":\"gradient-text\",\"children\":\"Standard Deductions\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl\",\"children\":\"The standard deduction is basically free money — it shaves thousands off your taxable income before any brackets kick in. Most people take it instead of itemizing. Here are the 2026 amounts:\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-4\",\"children\":[[\"$\",\"div\",\"Single\",{\"className\":\"premium-card p-6 hover-lift\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-600/20 to-teal-600/10 mb-4\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-dollar-sign h-5 w-5 text-emerald-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"line\",\"7eqyqh\",{\"x1\":\"12\",\"x2\":\"12\",\"y1\":\"2\",\"y2\":\"22\"}],[\"$\",\"path\",\"1b0p4s\",{\"d\":\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"}],\"$undefined\"]}]}],[\"$\",\"p\",null,{\"className\":\"text-xs uppercase tracking-wider text-muted-foreground font-medium\",\"children\":\"Single\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-2xl font-bold text-foreground\",\"children\":\"$$16,100\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-muted-foreground\",\"children\":\"Also applies to Married Filing Separately\"}]]}],[\"$\",\"div\",\"Married Filing Jointly\",{\"className\":\"premium-card p-6 hover-lift\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-teal-600/20 to-emerald-600/10 mb-4\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-trending-up h-5 w-5 text-teal-400\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"