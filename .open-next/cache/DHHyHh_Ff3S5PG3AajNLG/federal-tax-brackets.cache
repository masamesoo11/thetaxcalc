d\"]}],[\"$\",\"div\",\"5\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between items-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"children\":\"22% on $50,401 – $58,900\"}],[\"$\",\"span\",null,{\"className\":\"font-medium tabular-nums text-amber-400\",\"children\":\"$$1,870.00\"}]]}],\"$undefined\"]}],[\"$\",\"div\",\"6\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between items-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"children\":\"Total Federal Tax\"}],[\"$\",\"span\",null,{\"className\":\"font-medium tabular-nums text-red-400 font-semibold\",\"children\":\"$$7,670.00\"}]]}],[\"$\",\"div\",null,{\"className\":\"divider-glow mt-3 mb-3\"}]]}],[\"$\",\"div\",\"7\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between items-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"children\":\"Effective Federal Rate\"}],[\"$\",\"span\",null,{\"className\":\"font-medium tabular-nums text-foreground\",\"children\":\"10.23%\"}]]}],\"$undefined\"]}],[\"$\",\"div\",\"8\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex justify-between items-center\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"children\":\"Marginal Rate\"}],[\"$\",\"span\",null,{\"className\":\"font-medium tabular-nums text-foreground\",\"children\":\"22%\"}]]}],\"$undefined\"]}]]}]\n2e:[\"$\",\"div\",null,{\"className\":\"mt-6 space-y-2\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs uppercase tracking-wider text-muted-foreground font-medium\",\"children\":\"Bracket Fill Visualization\"}],[\"$\",\"div\",null,{\"className\":\"flex rounded-lg overflow-hidden h-8 text-xs font-semibold\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-emerald-500/30 flex items-center justify-center text-emerald-300\",\"style\":{\"width\":\"19.9%\"},\"children\":\"10%\"}],[\"$\",\"div\",null,{\"className\":\"bg-teal-500/30 flex items-center justify-center text-teal-300\",\"style\":{\"width\":\"60.9%\"},\"children\":\"12%\"}],[\"$\",\"div\",null,{\"className\":\"bg-amber-500/30 flex items-center justify-center text-amber-300\",\"style\":{\"width\":\"19.2%\"},\"children\":\"22%\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex justify-between text-[10px] text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"children\":\"$$0\"}],[\"$\",\"span\",null,{\"children\":\"$$11,925\"}],[\"$\",\"span\",null,{\"children\":\"$$48,475\"}],[\"$\",\"span\",null,{\"children\":\"$$60,000\"}]]}]]}]\n2f:[\"$\",\"p\",null,{\"className\":\"text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-emerald-400 font-semibold\",\"children\":\"Example:\"}],\" \",[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"children\":[\"Same filer: $8,113 tax ÷ $75,000 gross =\",\" \",[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"10.82%\"}],\" effective rate — nearly half the marginal rate.\"]}]]}]\n30:[\"$\",\"div\",null,{\"className\":\"mt-6 premium-card p-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-info h-5 w-5 text-emerald-400 shrink-0 mt-0.5\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1dtifu\",{\"d\":\"M12 16v-4\"}],[\"$\",\"path\",\"e9boi3\",{\"d\":\"M12 8h.01\"}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"strong\",null,{\"className\":\"text-foreground\",\"children\":\"Key Insight:\"}],\" Getting a raise that pushes you into the next bracket only affects the dollars \",[\"$\",\"em\",null,{\"children\":\"above\"}],\" the threshold. If you're a single filer at $48,000 and get a $2,000 raise, only the $475 above the 12% bracket limit ($48,475) is taxed at 22%. The rest is still at 10% and 12%. You \",[\"$\",\"em\",null,{\"children\":\"never\"}],\" lose money by earning more. We can't believe we still have to say this, but here we are.\"]}]]}]}]\n31:[\"$\",\"details\",\"2\",{\"className\":\"group premium-card p-5\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between cursor-pointer list-none\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"font-semibold text-foreground text-sm sm:text-base\",\"children\":\"How do progressive tax brackets work?\"}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\",\"children\":\"Progressive means your income gets taxed in layers, not all at one rate. Take a single filer making $75,000. After the $16,100 standard deduction, taxable income is $58,900. The first $12,400 gets 10%, the chunk from $12,401 to $50,400 gets 12%, and only the remaining $8,500 gets 22%. Your total federal tax is the sum of those three pieces — not 22% of the whole thing. Big difference.\"}]]}]\n32:[\"$\",\"details\",\"3\",{\"className\":\"group premium-card p-5\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between cursor-pointer list-none\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"font-semibold text-foreground text-sm sm:text-base\",\"children\":\"What is the difference between marginal and effective tax rates?\"}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\",\"children\":\"Your marginal rate is what hits your last dollar earned — it's your top bracket. Your effective rate is your total tax divided by your total income — the real average rate you pay. Example: a single filer at $75K has a marginal rate of 22% but an effective federal rate of about 11.6%. That's a massive difference, and confusing the two is why some people think a raise will cost them money. It won't.\"}]]}]\n33:[\"$\",\"details\",\"4\",{\"className\":\"group premium-card p-5\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between cursor-pointer list-none\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"font-semibold text-foreground text-sm sm:text-base\",\"children\":\"Did the 2026 tax brackets change from 2025?\"}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\",\"children\":\"Yep. The IRS adjusts for inflation every year. For 2026, the OBBBA significantly boosted the standard deduction: from $14,600 to $16,100 (single) and $29,200 to $32,200 (married). Bracket thresholds also increased. These adjustments are supposed to prevent \\\"bracket creep\\\" — where inflation pushes you into a higher bracket even though your purchasing power didn't actually improve. Doesn't always work perfectly, but it helps.\"}]]}]\n34:[\"$\",\"details\",\"5\",{\"className\":\"group premium-card p-5\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex items-center justify-between cursor-pointer list-none\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3\",\"children\":[[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-circle-question-mark h-5 w-5 text-emerald-400 shrink-0\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"circle\",\"1mglay\",{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"path\",\"1u773s\",{\"d\":\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"}],[\"$\",\"path\",\"p32p05\",{\"d\":\"M12 17h.01\"}],\"$undefined\"]}],[\"$\",\"span\",null,{\"className\":\"font-semibold text-foreground text-sm sm:text-base\",\"children\":\"What is the standard deduction for someone 65 or older?\"}]]}],[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-chevron-right h-4 w-4 text-muted-foreground shrink-0 transition-transform group-open:rotate-90\",\"aria-hidden\":\"true\",\"children\":[[\"$\",\"path\",\"mthhwq\",{\"d\":\"m9 18 6-6-6-6\"}],\"$undefined\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground leading-relaxed pl-8\",\"children\":\"For 2026, if you're 65+, you get an extra deduction on top of the base. Single and HOH filers get another $2,000 (so $18,100 or $26,150 total). Married filing jointly gets $1,600 per qualifying spouse — so a married couple both 65+ would deduct $35,400 ($32,200 + $1,600 + $1,600). Nice little bonus for older taxpayers.\"}]]}]\n35:[\"$\",\"a\",null,{\"href\":\"https://www.irs.gov/filing/federal-income-tax-rates-and-brackets\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-muted-foreground hover:text-emerald-400 underline transition-colors\",\"children\":\"IRS Brackets Page ↗\"}]\n36:[\"$\",\"$L10\",\"/salary/150000\",{\"href\":\"/salary/150000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$150K\"}]\n37:[\"$\",\"$L10\",\"/salary/200000\",{\"href\":\"/salary/200000\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-muted/20 px-3 py-1.5 text-xs font-medium text-foreground hover:border-emerald-500/30 hover:text-emerald-400 transition-all\",\"children\":\"$$200K\"}]\n38:[\"$\",\"div\",null,{\"className\":\"mt-3 space-y-2\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/salary\",\"className\":\"group flex items-center gap-2 text-sm text-muted-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"All 26 Salary Levels\"]}],[\"$\",\"$L10\",null,{\"href\":\"/compare\",\"className\":\"group flex items-center gap-2 text-sm text-m