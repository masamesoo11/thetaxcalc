-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"📈\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-sm font-medium text-foreground\\\",\\\"children\\\":\\\"Capital Gains Tax\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"Tax on selling your previous home\\\"}]]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"24:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12 space-y-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":[\\\"How the \\\",\\\"Free Mortgage Calculator\\\",\\\" Works\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Your monthly mortgage payment comes from a formula: M = P × [r(1+r)^n] / [(1+r)^n - 1]. P is the loan amount, r is the monthly rate (annual rate ÷ 12), and n is total payments (years × 12). It spits out a fixed payment that pays off every penny by the end of the term. Simple enough. What surprises people is how that payment breaks down. On a 30-year, $280,000 loan at 6.5%, your first payment is roughly 86% interest and only 14% principal. You feel like you're treading water. By year 15 it's about 50/50, and in the final years nearly everything goes to principal. My brother bought his first house in 2019 and called me panicked after seeing his first amortization statement — \\\\\\\"I'm basically just paying interest!\\\\\\\" Yeah. That's how it works at first. Stick with it.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Extra payments go 100% toward principal. Every dollar you add saves you interest for the remaining life of the loan. Adding $200/month extra on that $280K loan at 6.5% saves roughly $76,856 in interest and pays it off more than 5 years early. Compound interest working for you instead of against you, for once.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"We generate a full amortization schedule — month by month, principal vs interest, remaining balance. For a detailed walkthrough, check the \\u003ca href=\\\\\\\"https://www.consumerfinance.gov/consumer-tools/mortgages\\\\\\\" target=\\\\\\\"_blank\\\\\\\" rel=\\\\\\\"noopener noreferrer\\\\\\\"\\u003eCFPB mortgage resources\\u003c/a\\u003e. Key things to keep in mind:\\u003cbr/\\u003e- Recommended housing cost ratio: no more than 28% of gross income\\u003cbr/\\u003e- 20% down payment avoids PMI entirely\\u003cbr/\\u003e- Common loan terms are 15, 20, or 30 years\\u003cbr/\\u003e- Even small extra payments make a big difference over 30 years\\\"}}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":[\\\"Free Mortgage Calculator\\\",\\\" — Key Rates \\u0026 Data for 2026\\\"]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Formula\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Formula\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"M = P × [r(1+r)^n] / [(1+r)^n - 1]\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Common Loan Terms\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Common Loan Terms\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"15, 20, or 30 years\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Current Avg 30-Year Rate\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Current Avg 30-Year Rate\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"~6.5% (varies)\\\"}]]}],\\\"$L27\\\",\\\"$L28\\\"]}]]}],\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"32:I[18274,[\\\"/_next/static/chunks/49e33bee669819de.js\\\",\\\"/_next/static/chunks/868a9c4503c53c54.js\\\",\\\"/_next/static/chunks/d791dd6e73034ab4.js\\\",\\\"/_next/static/chunks/906782c6c13c1e2f.js\\\"],\\\"LinkToUs\\\"]\\n27:[\\\"$\\\",\\\"div\\\",\\\"Recommended Housing Ratio\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Recommended Housing Ratio\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"≤28% of gross income\\\"}]]}]\\n28:[\\\"$\\\",\\\"div\\\",\\\"Typical Down Payment\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/60 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\\\",\\\"children\\\":\\\"Typical Down Payment\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-base font-bold text-foreground\\\",\\\"children\\\":\\\"20% (avoids PMI)\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"29:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6\\\",\\\"children\\\":\\\"Mortgage Calculator FAQ\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"How is a monthly mortgage payment calculated?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"It's based on your loan amount, interest rate, and term length. The math formula is kinda ugly, but the concept is simple: the bank calculates a fixed monthly payment that pays off both interest and principal over the full term. Your rate divided by 12 gives the monthly rate, and the total number of payments is years times 12. Just use a mortgage calculator — nobody's doing this by hand.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"How much can extra mortgage payments save?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"It's kind of absurd how much difference a little extra makes. On a $280K loan at 6.5% over 30 years, adding $200/month extra saves you roughly $77K in interest and pays off the loan about 5 years early. Bump it to $500/month and you're saving over $140K and cutting more than a decade off the term. Every extra dollar goes straight to principal, which means less interest accruing going forward.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"Should I choose a 15-year or 30-year mortgage?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"fill\\\":\\\"none\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"children\\\":[\\\"$\\\",\\\"path\\\",null,{\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"d\\\":\\\"M19 9l-7 7-7-7\\\"}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"15-year saves you a ton in interest and usually comes with a lower rate (often 0.5–1% less), but the monthly payment is significantly higher. On a $280K loan: 15-year at 5.5% is about $2,287/month with ~$132K total interest, while 30-year at 6.5% is $1,769/month with ~$357K in interest. If you can comfortably swing the higher payment, 15-year is the financial winner. But a lot of people go 30-year and just make extra payments when they can — gives you flexibility if money gets tight.\\\"}]]}],\\\"$L30\\\",\\\"$L31\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"2a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-lg font-semibold text-foreground mb-4\\\",\\\"children\\\":\\\"Related Articles\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",\\\"2026-federal-tax-brackets-explained\\\",{\\\"href\\\":\\\"/blog/2026-federal-tax-brackets-explained\\\",\\\"className\\\":\\\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\