\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Early on, most of it. On a 30-year $280K loan at 6.5%, your very first payment is about 86% interest and only 14% principal. It slowly flips — around year 15 you're at roughly 50/50, and by year 25 almost everything goes to principal. That's amortization for you. It's also why making extra payments in the early years has the biggest impact on your total interest costs.\"}]]}]\n31:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much house can I afford?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The old rule of thumb is the 28/36 rule: no more than 28% of gross monthly income on housing costs (mortgage + taxes + insurance), and no more than 36% on total debt. For a $75K salary, that caps your monthly housing payment around $1,750. With 20% down at 6.5%, you're looking at a home in the $250K–$280K range depending on local property taxes and insurance. But honestly, just because you can qualify for that much doesn't mean you should max it out — leave yourself some breathing room.\"}]]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n33:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n18:null\n1c:[[\"$\",\"title\",\"0\",{\"children\":\"Mortgage Calculator 2026 | Amortization\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Free mortgage calculator with extra payments, amortization & payoff comparison. No sign-up. Calculate monthly payment and interest.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"free mortgage calculator,mortgage calculator,home loan calculator,amortization calculator,mortgage payment calculator,extra payment calculator,mortgage payoff,monthly mortgage payment,mortgage interest calculator\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"9\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"10\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"11\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/mortgage-calculator\"}],[\"$\",\"meta\",\"12\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:title\",\"content\":\"Mortgage Calculator 2026 — Amortization & Extra Payments\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:description\",\"content\":\"Free mortgage calculator. Monthly payment, amortization & extra payment savings. No sign-up.\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/mortgage-calculator\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image:alt\",\"content\":\"Mortgage Calculator 2026 — Amortization & Extra Payments\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:title\",\"content\":\"Mortgage Calculator 2026 — Amortization & Extra Payments\"}],[\"$\",\"meta\",\"25\",{\"name\":\"twitter:description\",\"content\":\"Free mortgage calculator. Monthly payment, amortization & extra payment savings. No sign-up.\"}],[\"$\",\"meta\",\"26\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"27\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"28\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L33\",\"29\",{}]]\n","/mortgage-calculator/__PAGE__":"1:\"$Sreact.fragment\"\nb:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/906782c6c13c1e2f.js\"],\"\"]\nc:I[79086,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/906782c6c13c1e2f.js\"],\"ShareButtons\"]\nd:I[59300,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/906782c6c13c1e2f.js\"],\"MortgageCalculatorClient\"]\n17:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n18:\"$Sreact.suspense\"\n1c:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/906782c6c13c1e2f.js\"],\"LinkToUs\"]\n2:T15df,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Mortgage Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#webpage\",\"@type\":\"WebPage\",\"name\":\"Mortgage Calculator with Extra Payments\",\"description\":\"Free mortgage calculator with extra payments, amortization schedule, and payoff comparison for 2026.\",\"url\":\"https://thetaxcalc.com/mortgage-calculator\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-15\",\"author\":{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"Mortgage Calculator with Extra Payments\",\"url\":\"https://thetaxcalc.com/mortgage-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/mortgage-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is a monthly mortgage payment calculated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's based on your loan amount, interest rate, and term length. The math formula is kinda ugly, but the concept is simple: the bank calculates a fixed monthly payment that pays off both interest and principal over the full term. Your rate divided by 12 gives the monthly rate, and the total number of payments is years times 12. Just use a mortgage calculator — nobody's doing this by hand.\"}},{\"@type\":\"Question\",\"name\":\"How much can extra mortgage payments save?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It's kind of absurd how much difference a little extra makes. On a $280K loan at 6.5% over 30 years, adding $200/month extra saves you roughly $77K in interest and pays off the loan about 5 years early. Bump it to $500/month and you're saving over $140K and cutting more than a decade off the term. Every extra dollar goes straight to principal, which means less interest accruing going forward.\"}},{\"@type\":\"Question\",\"name\":\"Should I choose a 15-year or 30-year mortgage?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"15-year saves you a ton in interest and usually comes with a lower rate (often 0.5–1% less), but the monthly payment is significantly higher. On a $280K loan: 15-year at 5.5% is about $2,287/month with ~$132K total interest, while 30-year at 6.5% is $1,769/month with ~$357K in interest. If you can comfortably swing the higher payment, 15-year is the financial winner. But a lot of people go 30-year and just make extra payments when they can — gives you flexibility if money gets tight.\"}},{\"@type\":\"Question\",\"name\":\"What percentage of my mortgage payment goes to interest?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Early on, most of it. On a 30-year $280K loan at 6.5%, your very first payment is about 86% interest and only 14% principal. It slowly flips — around year 15 you're at roughly 50/50, and by year 25 almost everything goes to principal. That's amortization for you. It's also why making extra payments in the early years has the biggest impact on your total interest costs.\"}},{\"@type\":\"Question\",\"name\":\"How much house can I afford?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The old rule of thumb is the 28/36 rule: no more than 28% of gross monthly income on housing costs (mortgage + taxes + insurance), and no more than 36% on total debt. For a $75K salary, that caps your monthly housing payment around $1,750. With 20% down at 6.5%, you're looking at a home in the $250K–$280K range depending on local property taxes and insurance. But honestly, just because you can qualify for that much doesn't mean you should max it out — leave yourself some breathing room.\"}}]},{\"@id\":\"https://thetaxcalc.com/mortgage-calculator#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\"]}],[\"$L9\"],\"$La\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Mortgage\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$Lc\",null,{\"url\":\"https://thetaxcalc.com/mortgage-calculator\",\"title\":\"Mortgage Calculator 2026 | Payment & Amortization\",\"description\":\"Free mortgage calculator with extra payments, amortization & payoff comparison. No sign-up. Calculate monthly payment and interest.\"}]}]\n5:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Free Mortgage Calculator\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free mortgage calculator with extra payments, amortization schedule, and payoff comparison. Calculate monthly payment using M = P × [r(1+r)^n] / [(1+r)^n - 1]. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":[\"Last reviewed: January 2026 · By \",\"Rachel Mitchell\",\", \",\"CPA\",\" · Tax data verified against IRS Publication 15-T & state revenue departments\"]}]]}]\n6:[\"$\",\"$Ld\",null,{}]\n7:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":[\"More \",\"Free Mortgage Calculator\",\" Tools & Resources\"]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$Lb\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💵\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"See if you can afford the monthly payment\"}]]}]]}],[\"$\",\"$Lb\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏦\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"401(k) Planner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Balance mortgage vs retirement savings\"}]]}]]}],[\"$\",\"$Lb\",\"/relocation-calculator\",{\"href\":\"/relocation-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏠\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Relocation Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Compare housing costs across states\"}]]}]]}],[\"$\",\"$Lb\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📈\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Capital Gains Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Tax on selling your previous home\"}]]}]]}]]}]]}]\n8:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":[\"How the \",\"Free Mortgage Calculator\",\" Works\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Your monthly mortgage payment comes from a formula: M = P × [r(1+r)^n] / [(1+r)^n - 1]. P is the loan amount, r is the monthly rate (annual rate ÷ 12), and n is total payments (years × 12). It spits out a fixed payment that pays off every penny by the end of the term. Simple enough. What surprises people is how that payment breaks down. On a 30-year, $280,000 loan at 6.5%, your first payment is roughly 86% interest and only 14% principal. You feel like you're treading water. By year 15 it's about 50/50, and in the final years nearly everything goes to principal. My brother bought his first house in 2019 and called me panicked after seeing his first amortization statement — \\\"I'm basically just paying interest!\\\" Yeah. That's how it works at first. Stick with it.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Extra payments go 100% toward principal. Every dollar you add saves you interest for the remaining life of the loan. Adding $200/month extra on that $280K loan at 6.5% saves roughly $76,856 in interest and pays it off more than 5 years early. Compound interest working for you instead of against you, for once.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"We generate a full amortization schedule — month by month, principal vs interest, remaining balance. For a detailed walkthrough, check the <a href=\\\"https://www.consumerfinance.gov/consumer-tools/mortgages\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">CFPB mortgage resources</a>. Key things to keep in mind:<br/>- Recommended housing cost ratio: no more than 28% of gross income<br/>- 20% down payment avoids PMI entirely<br/>- Common loan terms are 15, 20, or 30 years<br/>- Even small extra payments make a big difference over 30 years\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":[\"Free Mortgage Calculator\",\" — Key Rates & Data for 2026\"]}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"Formula\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Formula\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"M = P × [r(1+r)^n] / [(1+r)^n - 1]\"}]]}],[\"$\",\"div\",\"Common Loan Terms\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Common Loan Terms\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"15, 20, or 30 years\"}]]}],[\"$\",\"div\",\"Current Avg 30-Year Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Current Avg 30-Year Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"~6.5% (varies)\"}]]}],\"$Le\",\"$Lf\"]}]]}],\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\"]}]\n9:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/906782c6c13c1e2f.js\",\"async\":true}]\na:[\"$\",\"$L17\",null,{\"children\":[\"$\",\"$18\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@19\"}]}]\ne:[\"$\",\"div\",\"Recommended Housing Ratio\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Recommended Housing Ratio\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"≤28% of gross income\"}]]}]\nf:[\"$\",\"div\",\"Typical Down Payment\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Typical Down Payment\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"20% (avoids PMI)\"}]]}]\n10:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Mortgage Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How is a monthly mortgage payment calculated?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It's based on your loan amount, interest rate, and term length. The math formula is kinda ugly, but the concept is simple: the bank calculates a fixed monthly payment that pays off both interest and principal over the full term. Your rate divided by 12 gives the monthly rate, and the total number of payments is years times 12. Just use a mortgage calculator — nobody's doing this by hand.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much can extra mortgage payments save?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It's kind of absurd how much difference a little extra makes. On a $280K loan at 6.5% over 30 years, adding $200/month extra saves you roughly $77K in interest and pays off the loan about 5 years early. Bump it to $500/month and you're saving over $140K and cutting more than a decade off the term. Every extra dollar goes straight to principal, which means less interest accruing going forward.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Should I choose a 15-year or 30-year mortgage?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"15-year saves you a ton in interest and usually comes with a lower rate (often 0.5–1% less), but the monthly payment is significantly higher. On a $280K loan: 15-year at 5.5% is about $2,287/month with ~$132K total interest, while 30-year at 6.5% is $1,769/month with ~$357K in interest. If you can comfortably swing the higher payment, 15-year is the financial winner. But a lot of people go 30-year and just make extra payments when they can — gives you flexibility if money gets tight.\"}]]}],\"$L1a\",\"$L1b\"]}]]}]\n11:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$Lb\",\"2026-federal-tax-brackets-explained\",{\"href\":\"/blog/2026-federal-tax-brackets-explained\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"2026 Federal Tax Brackets Explained\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Complete guide to the 2026 federal income tax brackets, standard deductions, and how to calculate your effective tax rate.\"}]]}]]}]]}]\n12:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$Lb\",\"paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"roun