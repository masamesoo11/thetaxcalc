{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[calculator]/layout,_N_T_/[calculator]/page,_N_T_/overtime-tax-calculator"},"segmentPaths":["/_tree","/_full","/$d$calculator/__PAGE__","/$d$calculator","/_index","/_head"]},"html":"<!DOCTYPE html><!--DHHyHh_Ff3S5PG3AajNLG--><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/34d933785a17edf3.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/bfd6eb476abf7f9c.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/dec11ab5b071f102.js\"/><script src=\"/_next/static/chunks/f091501564eb2ea3.js\" async=\"\"></script><script src=\"/_next/static/chunks/771dedee3f5e1621.js\" async=\"\"></script><script src=\"/_next/static/chunks/170d65956da23aac.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-585fb9a968b38771.js\" async=\"\"></script><script src=\"/_next/static/chunks/49e33bee669819de.js\" async=\"\"></script><script src=\"/_next/static/chunks/868a9c4503c53c54.js\" async=\"\"></script><script src=\"/_next/static/chunks/d791dd6e73034ab4.js\" async=\"\"></script><script src=\"/_next/static/chunks/c322938c6693d41b.js\" async=\"\"></script><script async=\"\" data-cfasync=\"false\" src=\"https://www.googletagmanager.com/gtag/js?id=G-9SEBTKFT61\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/61cc43b3d7ad2990.js\" async=\"\"></script><script src=\"/_next/static/chunks/5552623386487b15.js\" async=\"\"></script><script src=\"/_next/static/chunks/6bcaf73165d03f74.js\" async=\"\"></script><script src=\"/_next/static/chunks/3c28bbc2a8ff143e.js\" async=\"\"></script><script src=\"/_next/static/chunks/474ace38d7992a17.js\" async=\"\"></script><script src=\"/_next/static/chunks/c9e031433494c7b2.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Free Overtime Tax Calculator 2026 — After-Tax OT Pay</title><meta name=\"description\" content=\"Free overtime tax calculator 2026. Calculate after-tax overtime pay at 1.5x rate. Federal, FICA &amp; state taxes included. No sign-up required.\"/><meta name=\"author\" content=\"Rachel Mitchell, CPA\"/><meta name=\"keywords\" content=\"free overtime tax calculator,overtime tax calculator,overtime pay calculator,overtime calculator 2026,after tax overtime pay,overtime tax rate,1.5x overtime calculator,time and a half calculator,overtime take home pay,how much overtime is taxed,no tax on overtime calculator,free tax calculator for 2026\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"finance\"/><meta name=\"classification\" content=\"Tax Calculator\"/><link rel=\"canonical\" href=\"https://thetaxcalc.com/overtime-tax-calculator\"/><meta name=\"google-site-verification\" content=\"verify_google_site_verification_token\"/><meta property=\"og:title\" content=\"Overtime Tax Calculator 2026 — After-Tax OT Pay\"/><meta property=\"og:description\" content=\"Free overtime tax calculator 2026. Calculate after-tax overtime pay. Federal, FICA &amp; state taxes. No sign-up.\"/><meta property=\"og:url\" content=\"https://thetaxcalc.com/overtime-tax-calculator\"/><meta property=\"og:site_name\" content=\"TheTaxCalc\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Overtime Tax Calculator 2026 — After-Tax OT Pay\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Overtime Tax Calculator 2026 — After-Tax OT Pay\"/><meta name=\"twitter:description\" content=\"Free overtime tax calculator 2026. Calculate after-tax overtime pay. Federal, FICA &amp; state taxes. No sign-up.\"/><meta name=\"twitter:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script data-cfasync=\"false\">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n