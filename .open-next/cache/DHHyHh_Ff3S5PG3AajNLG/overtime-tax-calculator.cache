7.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"ShareButtons\"]\n11:I[21862,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorClientPage\"]\n12:I[56848,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorScenarioSection\"]\n22:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n23:\"$Sreact.suspense\"\n28:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"LinkToUs\"]\n2:T16f0,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#webpage\",\"@type\":\"WebPage\",\"url\":\"https://thetaxcalc.com/overtime-tax-calculator\",\"name\":\"Overtime Tax Calculator 2026\",\"description\":\"Free overtime tax calculator with federal OT exemption under the One Big Beautiful Bill Act for 2026.\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-06-25\",\"author\":{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#author\"}},{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Overtime Tax Calculator\"}]},{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#webapp\",\"@type\":\"WebApplication\",\"name\":\"Overtime Tax Calculator 2026\",\"url\":\"https://thetaxcalc.com/overtime-tax-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/overtime-tax-calculator\"},\"author\":{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#author\",\"@type\":\"Person\",\"name\":\"David Chen\",\"url\":\"https://thetaxcalc.com/about#david-chen\",\"jobTitle\":\"Tax Research Director & IRS Practice Lead, EA\",\"description\":\"David Chen is an IRS Enrolled Agent (EA) with 15+ years of experience representing taxpayers before the IRS in audits, collections, and appeals. He specializes in self-employment tax, quarterly estimated payments, independent contractor classification, and IRS dispute resolution. David is a member of the National Association of Enrolled Agents (NAEA) and the California Society of Enrolled Agents. He holds a Master of Taxation (MTax) from San Jose State University and has completed advanced coursework in IRS Circular 230 ethics. David regularly contributes to tax policy analysis and has been quoted in publications including Tax Notes and the Wall Street Journal tax section.\",\"knowsAbout\":[\"Self-Employment Tax\",\"Estimated Tax Payments\",\"IRS Representation\",\"Tax Audits\",\"1099 Tax Compliance\",\"Independent Contractor Tax\",\"IRS Collections\",\"Offer in Compromise\"],\"sameAs\":[\"https://www.linkedin.com/in/davidchenea/\",\"https://www.naea.org/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-david-chen.webp\"},{\"@id\":\"https://thetaxcalc.com/overtime-tax-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the No Tax on Overtime law?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Under the 2025 Trump tax law (the 'One Big Beautiful Bill Act'), overtime pay is exempt from federal income tax for tax years 2025 through 2028. This means if you earn overtime pay — defined as hours worked beyond 40 per week at 1.5x your regular rate or higher — that portion of your income is not subject to federal income tax. However, FICA taxes (Social Security 6.2% + Medicare 1.45%) still apply to overtime pay. The exemption sunsets after December 31, 2028 unless Congress extends it.\"}},{\"@type\":\"Question\",\"name\":\"Does the overtime tax exemption apply to my state income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In most states, no. Only the federal income tax exemption is automatic. Most states have not conformed to the federal OT exemption, meaning your state will still tax overtime pay as regular income. States with no income tax (like Texas, Florida, Washington, Nevada, etc.) effectively don't tax overtime at the state level since they don't tax any income. Check with your state's revenue department for conformity updates.\"}},{\"@type\":\"Question\",\"name\":\"How much can I save with no tax on overtime?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on your hourly wage, overtime hours, and federal tax bracket. A worker earning $30/hour who works 10 hours of overtime per week saves roughly $2,000–$4,000 per year in federal income tax, depending on their bracket. Higher earners in the 22% or 24% brackets see the biggest savings. Use this calculator to see your exact savings based on your situation.\"}},{\"@type\":\"Question\",\"name\":\"When does the overtime tax exemption expire?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The exemption is currently scheduled to sunset after December 31, 2028. This means it applies to tax years 2025, 2026, 2027, and 2028. After that, overtime pay will once again be taxed as regular income at the federal level unless Congress passes legislation to extend or make the exemption permanent.\"}},{\"@type\":\"Question\",\"name\":\"Does the overtime exemption apply to salaried employees?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Generally no. The exemption applies to overtime pay as defined by the Fair Labor Standards Act (FLSA) — hours worked beyond 40 in a workweek at a rate of at least 1.5x your regular hourly rate. Most salaried employees classified as 'exempt' under FLSA don't receive overtime pay, so there's nothing to exempt. However, non-exempt salaried workers who do receive overtime pay would qualify for the federal income tax exemption on those overtime payments.\"}},{\"@type\":\"Question\",\"name\":\"Is FICA (Social Security and Medicare) still taken from overtime pay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, absolutely. The No Tax on Overtime law only exempts overtime pay from federal income tax. FICA taxes — 6.2% for Social Security (up to the $184,500 wage cap for 2026) and 1.45% for Medicare (no cap) — still apply to all wages including overtime. If you earn over $200,000, the additional 0.9% Medicare tax also applies. Don't confuse the income tax exemption with a total tax exemption.\"}}]}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],[\"$La\",\"$Lb\",\"$Lc\",\"$Ld\"],\"$Le\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Overtime Tax\"}]]}]\n4:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$L10\",null,{\"url\":\"https://thetaxcalc.com/overtime-tax-calculator\",\"title\":\"Free Overtime Tax Calculator 2026 — After-Tax OT Pay\",\"description\":\"Free overtime tax calculator 2026. Calculate after-tax overtime pay at 1.5x rate. Federal, FICA & state taxes included. No sign-up required.\"}]}]\n5:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Free Overtime Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free overtime tax calculator for 2026. Calculate your after-tax overtime pay at 1.5x rate. See how much OT you actually keep after federal, FICA & state taxes. No sign-up.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":\"Last reviewed: January 2026 · Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]\n6:[\"$\",\"$L11\",null,{\"componentKey\":\"overtime\"}]\n7:[\"$\",\"$L12\",null,{\"calculatorType\":\"overtime\",\"calculatorSlug\":\"overtime-tax-calculator\"}]\n8:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"Related Tools & Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$Lf\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💵\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Full take-home pay breakdown\"}]]}]]}],[\"$\",\"$Lf\",\"/bonus-tax-calculator\",{\"href\":\"/bonus-tax-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Bonus Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Another type of supplemental pay\"}]]}]]}],[\"$\",\"$Lf\",\"/irs-withholding-calculator\",{\"href\":\"/irs-withholding-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📋\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"IRS Withholding\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Adjust W-4 for OT income\"}]]}]]}],[\"$\",\"$Lf\",\"/salary\",{\"href\":\"/salary\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📈\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Salary After Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home pay at every level\"}]]}]]}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Overtime pay is calculated at 1.5x your regular hourly rate for hours worked beyond 40 in a week — that's the federal standard under the <a href=\\\"https://www.dol.gov/agencies/whd/flsa\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Fair Labor Standards Act</a>. So if you make $30/hour, your OT rate is $45/hour. Sounds great until you see the taxes. Overtime is taxed as ordinary income at your marginal federal rate, plus FICA (7.65%), plus state income tax. For someone in the 22% federal bracket in a state like Illinois, the combined hit on OT earnings can approach 35%. That $45/hour OT becomes more like $29/hour after taxes.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Here's the thing most people miss: overtime gets taxed at your marginal rate, not your effective rate. Your effective rate is the blended average across all brackets. But OT income stacks on top of your regular income, so it fills the highest bracket first. If your regular salary puts you at the top of the 12% bracket, every OT dollar is taxed at 22% federally. That's a big jump. Still, even at a higher tax rate, overtime puts more money in your pocket — just not as much as the gross number suggests.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Some states have proposed eliminating state income tax on overtime pay, but as of 2026, no state has enacted such a law. Federal tax on overtime remains unchanged. Your best strategy is knowing your marginal rate before you volunteer for extra shifts so you can make an informed decision about whether the after-tax pay is worth the extra hours.\"}}],[\"$\",\"p\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"A quick example: earning $20/hour with 10 hours of OT per week means an extra $300/week in gross OT pay. In a 22% federal bracket with 7.65% FICA and no state tax, you'd keep about $211 of that $300. In Illinois with 4.95% state tax, you'd keep about $196. Over a year of consistent OT, that's $10,000–$11,000 extra take-home — real money, but significantly less than the $15,600 gross.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\",\"children\":\"OT Pay = OT Hours × Regular Rate × 1.5; OT Tax = Federal (22% supplemental) + State Rate + FICA\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Step-by-Step\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":1}],\"$L13\"]}],\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\"]}]]}],\"$L19\",\"$L1a\"]}]]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",false,\"$L20\",\"$L21\"]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/6bcaf73165d03f74.js\",\"async\":true}]\nb:[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"async\":true}]\nc:[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/474ace38d7992a17.js\",\"async\":true}]\nd:[\"$\",\"script\",\"script-3\",{\"src\":\"/_next/static/chunks/c9e031433494c7b2.js\",\"async\":true}]\ne:[\"$\",\"$L22\",null,{\"children\":[\"$\",\"$23\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@24\"}]}]\n13:[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate overtime pay rate (1.5× regular rate for most employees per FLSA)\"}]\n14:[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":2}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Add OT pay to regular gross income\"}]]}]\n15:[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply federal supplemental withholding rate of 22% (or aggregate method)\"}]]}]\n16:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":4}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply state supplemental withholding rate (varies by state)\"}]]}]\n17:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":5}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate FICA (6.2% SS + 1.45% Medicare) on total earnings\"}]]}]\n18:[\"$\",\"li\",\"5\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":6}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract all taxes from total gross to get net overtime pay\"}]]}]\n19:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Example\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"10 OT hours at $30/hr regular rate: OT pay = 10 × $45 = $450. Federal withholding (22%) = $99. FICA = $34.43. State varies. Net OT ≈ $317.\"}]]}]\n1a:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"For detailed data sources and full methodology, see our \",[\"$\",\"$Lf\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Methodology & Data Sources\"}],\" page.\"]}]\n1b:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Key Rates & Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"OT Pay Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"OT Pay Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"1.5x regular rate\"}]]}],[\"$\",\"div\",\"Federal Tax on OT\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Federal Tax on OT\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"At marginal rate (10%–37%)\"}]]}],[\"$\",\"div\",\"FICA Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"FICA Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"7.65%\"}]]}],[\"$\",\"div\",\"Typical Combined Tax on OT\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Typical Combined Tax on OT\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"25%–35%\"}]]}],[\"$\",\"div\",\"FLSA OT Threshold\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"FLSA OT Threshold\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"After 40 hours/week\"}]]}]]}]]}]\n1c:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Overtime Tax Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the No Tax on Overtime law?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Under the 2025 Trump tax law (the 'One Big Beautiful Bill Act'), overtime pay is exempt from federal income tax for tax years 2025 through 2028. This means if you earn overtime pay — defined as hours worked beyond 40 per week at 1.5x your regular rate or higher — that portion of your income is not subject to federal income tax. However, FICA taxes (Social Security 6.2% + Medicare 1.45%) still apply to overtime pay. The exemption sunsets after December 31, 2028 unless Congress extends it.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does the overtime tax exemption apply to my state income tax?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"In most states, no. Only the federal income tax exemption is automatic. Most states have not conformed to the federal OT exemption, meaning your state will still tax overtime pay as regular income. States with no income tax (like Texas, Florida, Washington, Nevada, etc.) effectively don't tax overtime at the state level since they don't tax any income. Check with your state's revenue department for conformity updates.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much can I save with no tax on overtime?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"It depends on your hourly wage, overtime hours, and federal tax bracket. A worker earning $30/hour who works 10 hours of overtime per week saves roughly $2,000–$4,000 per year in federal income tax, depending on their bracket. Higher earners in the 22% or 24% brackets see the biggest savings. Use this calculator to see your exact savings based on your situation.\"}]]}],\"$L25\",\"$L26\",\"$L27\"]}]]}]\n1d:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$Lf\",\"2026-federal-tax-brackets-explained\",{\"href\":\"/blog/2026-federal-tax-brackets-explained\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"2026 Tax Brackets: IRS Income Tax Brackets 2026 Explained\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Complete guide to the IRS 2026 tax brackets — income tax brackets 2026, marginal tax rate, federal income tax rates, adjusted gross income, and tax credits for married couples filing jointly.\"}]]}],[\"$\",\"$Lf\",\"how-fica-taxes-work-2026\",{\"href\":\"/blog/how-fica-taxes-work-2026\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"How FICA Taxes Work in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Understanding FICA taxes (Social Security and Medicare) in 2026 — what you pay, what your employer pays, and how self-employment tax differs.\"}]]}]]}]]}]\n1e:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\