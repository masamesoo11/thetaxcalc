\"className\\\":\\\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"How This Calculator Works\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Start early. That's the whole game with retirement savings. This calculator estimates your 401(k) balance at retirement based on contributions, employer match, expected returns, and years left to save. The earlier you begin, the less you need to put in each year.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"1\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"The math is future value of a series. Each year's contribution grows at your assumed annual return for every remaining year until retirement. Year 1 grows for the full period. Year 10 grows for 10 fewer years. Add it all up — that's your projected balance. The concept is straightforward. The results can be surprising. Someone who starts at 25 and contributes $500/month with a 7% return ends up with roughly $1.2 million by 65. Start at 35 with the same contributions? About $567,000. Ten years of delay costs you over $600K. That's compound growth for you — brutal if you're late, powerful if you're early.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"2\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"The employer match is free money. Typical structure: 50% match up to 6% of salary. Make $100K, contribute 6% ($6,000), employer adds $3,000. If you're not contributing enough to get the full match, you're throwing away thousands every year.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"For 2026, the \\u003ca href=\\\\\\\"https://www.irs.gov/retirement-plans/plan-participant-employee/retirement-topics-401k-and-profit-sharing-plan-contribution-limits\\\\\\\" target=\\\\\\\"_blank\\\\\\\" rel=\\\\\\\"noopener noreferrer\\\\\\\"\\u003e401(k) contribution limit is $24,500\\u003c/a\\u003e. Catch-up contribution for ages 50+ is another $8,000. Ages 60-63 get an even bigger catch-up of $11,250. The calculator defaults to 7% annual return, which is a reasonable long-term assumption for a diversified stock portfolio. Real returns bounce around — up 20% some years, down 15% others — but 7% is a solid planning number over decades.\\\"}}],[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"RMD age is 73. That's when the IRS makes you start withdrawing. But that's a problem for future you.\\\"}}]]}]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"How It's Calculated\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\\\",\\\"children\\\":\\\"Formula\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\\\",\\\"children\\\":\\\"Future Balance = P(1+r)^n + C[((1+r)^n − 1) / r], where P = current balance, r = annual return, n = years, C = annual contribution\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\\\",\\\"children\\\":\\\"Step-by-Step\\\"}],[\\\"$\\\",\\\"ol\\\",null,{\\\"className\\\":\\\"space-y-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"li\\\",\\\"0\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[\\\"$L29\\\",\\\"$L2a\\\"]}],\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\"]}]]}],\\\"$L30\\\",\\\"$L31\\\"]}]]}],\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",\\\"$L36\\\",false,\\\"$L37\\\",\\\"$L38\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"3b:I[18274,[\\\"/_next/static/chunks/49e33bee669819de.js\\\",\\\"/_next/static/chunks/868a9c4503c53c54.js\\\",\\\"/_next/static/chunks/d791dd6e73034ab4.js\\\",\\\"/_next/static/chunks/6bcaf73165d03f74.js\\\",\\\"/_next/static/chunks/3c28bbc2a8ff143e.js\\\",\\\"/_next/static/chunks/474ace38d7992a17.js\\\",\\\"/_next/static/chunks/c9e031433494c7b2.js\\\"],\\\"LinkToUs\\\"]\\n29:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":1}]\\n2a:[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Start with current 401(k) balance (or $0 if starting fresh)\\\"}]\\n2b:[\\\"$\\\",\\\"li\\\",\\\"1\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\\\",\\\"children\\\":2}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"leading-relaxed\\\",\\\"children\\\":\\\"Add annual employee contribution (up to $24,500 for 2026, or $32,500 if age 50+)\\\"}]]}]\\n2c:[\\\"$\\\",\\\"li\\\",\\\"2\\\",{\\\"className\\\":\\\"flex gap-3 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"flex h-6 w-6 shrink-0 items-center justify-center