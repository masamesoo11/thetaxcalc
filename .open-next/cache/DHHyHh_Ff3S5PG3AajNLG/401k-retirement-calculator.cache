 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📖 Tax Glossary\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Key terms explained\"}]]}],[\"$\",\"$L10\",null,{\"href\":\"/blog\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📝 Tax Guides & Blog\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Expert tax tips & guides\"}]]}]]}]]}]\n39:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the difference between traditional and Roth 401(k)?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Traditional = pre-tax now, taxed when you withdraw in retirement. Roth = taxed now, tax-free withdrawals later. The basic rule of thumb: if you think you'll be in a lower tax bracket in retirement, go traditional. If you think rates will be higher or you just want the certainty of tax-free income later, Roth makes sense. A lot of people split between both for flexibility.\"}]]}]\n3a:[\"$\",\"details\",\"4\",{\"className\":\"group roun