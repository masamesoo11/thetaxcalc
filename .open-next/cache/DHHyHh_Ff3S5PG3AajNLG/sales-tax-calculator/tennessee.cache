ttps://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Sales Tax Calculator\",\"item\":\"https://thetaxcalc.com/sales-tax-calculator\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Tennessee Sales Tax\"}]},{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#webpage\",\"@type\":\"WebPage\",\"name\":\"Tennessee Sales Tax Calculator 2026\",\"description\":\"Calculate sales tax for Tennessee. Combined rate: 9.56%. Free, no sign-up required.\",\"url\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-01-01\",\"author\":{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#author\"},\"reviewedBy\":{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#webapp\",\"@type\":\"WebApplication\",\"name\":\"Tennessee Sales Tax Calculator 2026\",\"url\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\"},\"author\":{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"}},{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the sales tax rate in Tennessee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The state sales tax rate in Tennessee is 7.00%. With average local taxes, the combined rate is approximately 9.56%. Actual rates may vary by city and county within Tennessee.\"}},{\"@type\":\"Question\",\"name\":\"Why does the sales tax rate vary within Tennessee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Tennessee allows local jurisdictions (counties, cities, and special districts) to add their own sales taxes on top of the 7.00% state rate. These local rates vary by location, which is why you might pay a different total rate in different cities within Tennessee.\"}},{\"@type\":\"Question\",\"name\":\"What items are exempt from sales tax in Tennessee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In Tennessee, groceries, prescription drugs are exempt from state sales tax. However, clothing are still subject to sales tax. Exemptions may vary at the local level.\"}},{\"@type\":\"Question\",\"name\":\"How do I calculate sales tax in Tennessee?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Multiply the purchase price by the combined tax rate. For example, on a $100 purchase at the 9.56% combined rate in Tennessee: $100 × 0.956 = $9.56 in tax. Total price: $109.56.\"}},{\"@type\":\"Question\",\"name\":\"Does Tennessee charge sales tax on online purchases?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Following the 2018 South Dakota v. Wayfair Supreme Court ruling, online retailers must collect Tennessee sales tax on purchases shipped to Tennessee residents. The rate is based on the buyer's location within Tennessee.\"}}]},{\"@id\":\"https://thetaxcalc.com/sales-tax-calculator/tennessee#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}]}16:[\"$\",\"main\",null,{\"className\":\"min-h-screen bg-background\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}],\"$L20\"]}]\n21:I[2265,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/c01ab6c2a7154e10.js\"],\"StateSalesTaxClientPage\"]\n20:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex items-center gap-2 text-sm text-muted-foreground\",\"children\":[[\"$\",\"li\",null,{\"children\":[\"$\",\"$L11\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}]}],[\"$\",\"li\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"$L11\",null,{\"href\":\"/sales-tax-calculator\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Sales Tax Calculator\"}]}],[\"$\",\"li\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"li\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Tennessee\"}]]}]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Tennessee Sales Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-lg text-muted-foreground max-w-3xl\",\"children\":\"Free Tennessee sales tax calculator 2026. 7.00% state + 2.56% local = 9.56% combined. Reverse calc & exemptions. No sign-up.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8\",\"children\":[\"$\",\"$L21\",null,{\"defaultState\":\"tennessee\"}]}],[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":[\"How \",\"Tennessee\",\" Sales Tax Works\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Tennessee charges a 7.00% state sales tax rate. On top of that, local jurisdictions (counties, cities, special districts) add their own taxes, bringing the average combined rate to 9.56%. That means on a $1,000 purchase, you'd pay approximately $95.60 in sales tax for a total of $1095.60.\"}}],[\"$\",\"div\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"The Tennessee state rate of 7.00% applies uniformly across the state, but local surtaxes vary significantly by location. The average local rate across TN is 2.56%, but some cities and counties charge more or less than this average. This calculator uses the average local rate, but you can override it with your specific city rate for a more accurate calculation.\"}}],[\"$\",\"div\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Good news: Tennessee exempts groceries, prescription drugs from state sales tax. However, clothing are still subject to sales tax in Tennessee. These exemptions can make a real difference in your annual spending, especially on groceries which are a recurring expense for every household.\"}}],[\"$\",\"div\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Need to work backwards? If you have a total receipt and need to find the original price before tax, use the reverse sales tax formula: divide the total by (1 + tax rate). For example, a $1095.60 total with 9.56% tax means the original price was $1,000 ($1095.60 ÷ 1.956). This is useful for expense reports and bookkeeping.\"}}],[\"$\",\"div\",\"4\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Since the 2018 <a href=\\\"https://www.oyez.org/cases/2017/17-494\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">South Dakota v. Wayfair</a> Supreme Court decision, online retailers must collect Tennessee sales tax on purchases shipped to TN residents. Most online purchases now include Tennessee sales tax based on the buyer's location, including any applicable local taxes.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"mt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":[\"Tennessee\",\" Sales Tax Key Rates (2026)\"]}],\"$L22\"]}],\"$L23\",\"$L24\",\"$L25\",\"$L26\"]}]\n22:[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3 max-w-4xl\",\"children\":[[\"$\",\"div\",\"Tennessee State Rate\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-medium uppercase tracking-wider text-muted-foreground\",\"children\":\"Tennessee State Rate\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-lg font-bold text-emerald-400\",\"children\":\"7.00%\"}]]}],[\"$\",\"div\",\"Tennessee Avg Local Rate\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-medium uppercase tracking-wider text-muted-foreground\",\"children\":\"Tennessee Avg Local Rate\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-lg font-bold text-emerald-400\",\"children\":\"2.56%\"}]]}],[\"$\",\"div\",\"Tennessee Combined Rate\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-medium uppercase tracking-wider text-muted-foreground\",\"children\":\"Tennessee Combined Rate\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-lg font-bold text-emerald-400\",\"children\":\"9.56%\"}]]}],[\"$\",\"div\",\"Tax on $1,000\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-medium uppercase tracking-wider text-muted-foreground\",\"children\":\"Tax on $1,000\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-lg font-bold text-emerald-400\",\"children\":\"$$95.60\"}]]}],[\"$\",\"div\",\"Total on $1,000\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-medium uppercase tracking-wider text-muted-foreground\",\"children\":\"Total on $1,000\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-lg font-bold text-emerald-400\",\"children\":\"$$1095.60\"}]]}]]}]\n23:[\"$\",\"section\",null,{\"className\":\"mt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":[\"Tennessee\",\" Sales Tax FAQ\"]}],[\"$\",\"div\",null,{\"className\":\"space-y-4 max-w-4xl\",\"children\":[[\"$\",\"div\",\"0\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"What is the sales tax rate in Tennessee?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The state sales tax rate in Tennessee is 7.00%. With average local taxes, the combined rate is approximately 9.56%. Actual rates may vary by city and county within Tennessee.\"}]]}],[\"$\",\"div\",\"1\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Why does the sales tax rate vary within Tennessee?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Tennessee allows local jurisdictions (counties, cities, and special districts) to add their own sales taxes on top of the 7.00% state rate. These local rates vary by location, which is why you might pay a different total rate in different cities within Tennessee.\"}]]}],[\"$\",\"div\",\"2\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"What items are exempt from sales tax in Tennessee?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"In Tennessee, groceries, prescription drugs are exempt from state sales tax. However, clothing are still subject to sales tax. Exemptions may vary at the local level.\"}]]}],[\"$\",\"div\",\"3\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"How do I calculate sales tax in Tennessee?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Multiply the purchase price by the combined tax rate. For example, on a $100 purchase at the 9.56% combined rate in Tennessee: $100 × 0.956 = $9.56 in tax. Total price: $109.56.\"}]]}],[\"$\",\"div\",\"4\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Does Tennessee charge sales tax on online purchases?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Following the 2018 South Dakota v. Wayfair Supreme Court ruling, online retailers must collect Tennessee sales tax on purchases shipped to Tennessee residents. The rate is based on the buyer's location within Tennessee.\"}]]}]]}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mt-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Nearby State Sales Tax Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/sales-tax-calculator\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":\"All 50 States\"}],[[\"$\",\"$L11\",\"kentucky\",{\"href\":\"/sales-tax-calculator/kentucky\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-card/80 px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors\",\"children\":\"Kentucky (6.00%)\"}],[\"$\",\"$L11\",\"virginia\",{\"href\":\"/sales-tax-calculator/virginia\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-card/80 px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors\",\"children\":\"Virginia (5.75%)\"}],[\"$\",\"$L11\",\"northcarolina\",{\"href\":\"/sales-tax-calculator/northcarolina\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-card/80 px-4 py-2 text-sm font-medium text-foreground hover:bg-muted/50 transition-colors\",\"children\":\"North Carolina (6.98%)\"}],[\"$\",\"$L11\",\"georgia\",{\"href\":\"/sales-tax-calculator/georgia\",\"className\":\"inline-flex items-center rounded-lg border border-border/50 bg-card/80 px-4 py-2 text-sm font-medium text-foreg