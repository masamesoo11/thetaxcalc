reground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Louisiana income tax rate: 1.85%–4.25%. Progressive income tax. Top rate 4.25% above $50,000. This means your paycheck in Louisiana is only reduced by federal income tax and FICA — plus state tax at 4.25% top rate.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"The 2026 federal tax brackets apply the same way in Louisiana as everywhere else: 10%–37% progressive rates after the $16,100 standard deduction (single) or $32,200 (married). FICA adds 6.2% Social Security (up to $184,500) + 1.45% Medicare.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Louisiana has a progressive income tax ranging from 1.85%–4.25%. Louisiana has one of the highest combined sales tax rates (9.55%) but very low property taxes (0.55%). On a $75,000 salary (single filer), your take-home pay is approximately $59,950 per year after federal tax, FICA, and state income tax.\"}}],[\"$\",\"p\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Louisiana also has a 4.45% state (9.55% avg combined) sales tax and 0.55% average effective property tax rate. Louisiana has one of the highest combined sales tax rates (9.55%) but very low property taxes (0.55%).\"}}],[\"$\",\"p\",\"4\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Use the calculator above to see your exact take-home pay in Louisiana. Enter your salary, filing status, and any pre-tax deductions to get an instant, accurate result — no sign-up required.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emeral