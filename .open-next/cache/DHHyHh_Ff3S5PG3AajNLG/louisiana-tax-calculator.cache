{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/[calculator]/layout,_N_T_/[calculator]/page,_N_T_/louisiana-tax-calculator"},"segmentPaths":["/_tree","/_full","/$d$calculator/__PAGE__","/$d$calculator","/_index","/_head"]},"html":"<!DOCTYPE html><!--DHHyHh_Ff3S5PG3AajNLG--><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/34d933785a17edf3.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/bfd6eb476abf7f9c.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/dec11ab5b071f102.js\"/><script src=\"/_next/static/chunks/f091501564eb2ea3.js\" async=\"\"></script><script src=\"/_next/static/chunks/771dedee3f5e1621.js\" async=\"\"></script><script src=\"/_next/static/chunks/170d65956da23aac.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-585fb9a968b38771.js\" async=\"\"></script><script src=\"/_next/static/chunks/49e33bee669819de.js\" async=\"\"></script><script src=\"/_next/static/chunks/868a9c4503c53c54.js\" async=\"\"></script><script src=\"/_next/static/chunks/d791dd6e73034ab4.js\" async=\"\"></script><script src=\"/_next/static/chunks/c322938c6693d41b.js\" async=\"\"></script><script async=\"\" data-cfasync=\"false\" src=\"https://www.googletagmanager.com/gtag/js?id=G-9SEBTKFT61\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/61cc43b3d7ad2990.js\" async=\"\"></script><script src=\"/_next/static/chunks/5552623386487b15.js\" async=\"\"></script><script src=\"/_next/static/chunks/6bcaf73165d03f74.js\" async=\"\"></script><script src=\"/_next/static/chunks/3c28bbc2a8ff143e.js\" async=\"\"></script><script src=\"/_next/static/chunks/474ace38d7992a17.js\" async=\"\"></script><script src=\"/_next/static/chunks/c9e031433494c7b2.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>LA Tax Calculator 2026 | 1.85-4.75%</title><meta name=\"description\" content=\"Free Louisiana tax calculator 2026. Take-home pay after progressive tax (1.85%–4.75%). No sign-up.\"/><meta name=\"author\" content=\"Rachel Mitchell, CPA\"/><meta name=\"keywords\" content=\"free Louisiana tax calculator,Louisiana tax calculator,LA paycheck calculator,Louisiana income tax,Louisiana 4.75% tax,Louisiana take home pay,Louisiana salary calculator,free tax calculator for 2026,LA state tax 2026\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follo