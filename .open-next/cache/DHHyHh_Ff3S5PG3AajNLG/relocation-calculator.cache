ll,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Side-by-side tax comparison\"}]]}]]}],[\"$\",\"$Lf\",\"/mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏠\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Mortgage Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Housing costs in your new state\"}]]}]]}],[\"$\",\"$Lf\",\"/salary\",{\"href\":\"/salary\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Salary After Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home for every salary level\"}]]}]]}]]}]]}]\n9:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"My sister got a job offer in San Francisco that paid $15,000 more than her Chicago salary. Sounded great until she ran the numbers. After California state tax and higher housing costs, she'd actually have less money left over. That's exactly what this calculator prevents. It tells you the salary you'd need in a new state to match your current take-home pay.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"How it works: first we calculate your current take-home after federal tax, FICA, and your state's income tax. Then we figure out what gross salary in the target state would give you the same net pay, accounting for that state's tax rates and deductions.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Let's look at a real example. $100,000 in Texas (0% state tax) gets you roughly $79,000 take-home. To end up with the same $79,000 in California, you'd need to earn about $120,000–$125,000. California's progressive income tax eats an extra $5,000–$8,000 that Texas doesn't touch. That's a car payment, a vacation, or a decent chunk of retirement savings — just gone to state tax.\"}}],[\"$\",\"p\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"This tool focuses on income tax differences. But look, income tax isn't the whole story:<br/>- Property taxes: <a href=\\\"/texas-tax-calculator\\\">Texas</a> is brutal (~1.71%), <a href=\\\"/california-tax-calculator\\\">California</a> is surprisingly mild (~0.71%)<br/>- Sales taxes vary significantly by state and city<br/>- Housing costs are the big one — $1,500/month in Houston can be $3,000 in San Francisco<br/>Check our <a href=\\\"/compare\\\">state comparison pages</a> for the full picture.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 bo