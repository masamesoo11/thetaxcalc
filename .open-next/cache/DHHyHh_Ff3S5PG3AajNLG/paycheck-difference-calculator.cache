ext-sm text-blue-400 mb-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-arrow-right-left h-3.5 w-3.5\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"1x1c3m\\\",{\\\"d\\\":\\\"m16 3 4 4-4 4\\\"}],[\\\"$\\\",\\\"path\\\",\\\"zbl0bi\\\",{\\\"d\\\":\\\"M20 7H4\\\"}],[\\\"$\\\",\\\"path\\\",\\\"h9nckh\\\",{\\\"d\\\":\\\"m8 21-4-4 4-4\\\"}],[\\\"$\\\",\\\"path\\\",\\\"g4d7ey\\\",{\\\"d\\\":\\\"M4 17h16\\\"}],\\\"$undefined\\\"]}],\\\"State-by-State\\\"]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-4xl font-bold tracking-tight text-foreground sm:text-5xl\\\",\\\"children\\\":[\\\"Paycheck Difference\\\",\\\" \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"gradient-text\\\",\\\"children\\\":\\\"Calculator\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mx-auto mt-4 max-w-2xl text-lg text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"See exactly how much your take-home pay changes when you move states, change jobs, or adjust deductions. Real numbers, no guesswork.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"18:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10 rounded-xl border border-border/30 bg-card/50 p-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6 text-center\\\",\\\"children\\\":[\\\"How It \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"gradient-text\\\",\\\"children\\\":\\\"Works\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-6 sm:grid-cols-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-500/10 text-blue-400 font-bold text-lg mb-3\\\",\\\"children\\\":\\\"1\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-1\\\",\\\"children\\\":\\\"Enter Your Paycheck\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Input your current salary, state, and filing status as the baseline.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-500/10 text-blue-400 font-bold text-lg mb-3\\\",\\\"children\\\":\\\"2\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-1\\\",\\\"children\\\":\\\"Add a Comparison\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Add another scenario with a different state, salary, or deductions.\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-center\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-500/10 text-blue-400 font-bold text-lg mb-3\\\",\\\"children\\\":\\\"3\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-foreground mb-1\\\",\\\"children\\\":\\\"See the Difference\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The difference column shows exactly how much more or less you take home.\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[\\\"$\\\",\\\"$L29\\\",null,{\\\"defaultScenario\\\":{\\\"id\\\":\\\"default\\\",\\\"label\\\":\\\"Current Paycheck\\\",\\\"salary\\\":75000,\\\"payFrequency\\\":\\\"annual\\\",\\\"stateKey\\\":\\\"illinois\\\",\\\"filingStatus\\\":\\\"single\\\",\\\"retirement401k\\\":0,\\\"hsaContribution\\\":0,\\\"nycResident\\\":false}}]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10 space-y-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground\\\",\\\"children\\\":[\\\"How State Taxes Affect Your \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"gradient-text\\\",\\\"children\\\":\\\"Paycheck\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Your paycheck is not just your salary minus federal taxes. State income tax can take another 0% to 13.3% off the top, depending on where you live. For someone earning $75,000, that means a difference of up to $10,000 in annual take-home pay between the highest-tax and lowest-tax states. Our paycheck difference calculator lets you see the exact dollar impact of state taxes, filing status changes, and pre-tax deductions side by side, so you know precisely what you gain or lose by moving or changing your withholding.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The gap between states is widening. California charges up to 13.3% in state income tax, Hawaii up to 11%, and Oregon up to 9.9%. Meanwhile, nine states — Texas, Florida, Washington, Nevada, Wyoming, Alaska, South Dakota, Tennessee, and New Hampshire — charge zero personal income tax on wages. If you earn $100,000 and move from California to Texas, you keep roughly $10,000 more per year without changing your salary. That is the power of state tax policy on your paycheck, and it is exactly what this calculator is designed to reveal.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"But state tax is only part of the story. Pre-tax deductions like 401(k) contributions ($24,500 limit in 2026) and HSA contributions ($4,150 for individuals) reduce your taxable income at the federal and state level. By maximizing these deductions, you can lower your effective tax rate significantly. Our calculator lets you adjust 401(k) and HSA amounts independently for each scenario, so you can model the full impact of deductions on your take-home pay across different states and salary levels.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Every calculation uses the 2026 federal tax brackets, the $16,100 standard deduction for single filers, the $184,500 Social Security wage base, and the latest published state income tax rates from all 50 state revenue departments. Whether you are comparing a move from Illinois to Texas, evaluating a raise, or simply curious how much state tax costs you, this calculator gives you accurate, instant results.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6\\\",\\\"children\\\":[\\\"Paycheck Difference \\\",[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"gradient-text\\\",\\\"children\\\":\\\"FAQ\\\"}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"How much difference does state tax make on my paycheck?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\",\\\"strokeLinejoin\\\":\\\"round\\\",\\\"className\\\":\\\"lucide lucide-chevron-down h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\\\",\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":[[\\\"$\\\",\\\"path\\\",\\\"qrunsl\\\",{\\\"d\\\":\\\"m6 9 6 6 6-6\\\"}],\\\"$undefined\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"It can be dramatic. If you earn $75,000, living in Texas (0% state tax) instead of California (up to 9.3% at that bracket) saves you roughly $5,000–$7,000 per year in state taxes alone. Moving from Illinois (4.95%) to Texas saves about $3,500 per year at the same salary. Our calculator shows you the exact dollar difference for any salary and state pair.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-sm sm:text-base\\\",\\\"children\\\":\\\"Which states have no income tax?\\\"}],[\\\"$\\\",\\\"svg\\\",null,{\\\"ref\\\":\\\"$undefined\\\",\\\"xmlns\\\":\\\"http://www.w3.org/2000/svg\\\",\\\"width\\\":24,\\\"height\\\":24,\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"fill\\\":\\\"none\\\",\\\"stroke\\\":\\\"currentColor\\\",\\\"strokeWidth\\\":2,\\\"strokeLinecap\\\":\\\"round\\\