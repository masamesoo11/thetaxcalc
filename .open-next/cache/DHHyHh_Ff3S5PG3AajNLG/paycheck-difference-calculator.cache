ia-hidden\":\"true\",\"children\":[[\"$\",\"rect\",\"1nb95v\",{\"width\":\"16\",\"height\":\"20\",\"x\":\"4\",\"y\":\"2\",\"rx\":\"2\"}],[\"$\",\"line\",\"x4nwl0\",{\"x1\":\"8\",\"x2\":\"16\",\"y1\":\"6\",\"y2\":\"6\"}],[\"$\",\"line\",\"wjye3r\",{\"x1\":\"16\",\"x2\":\"16\",\"y1\":\"14\",\"y2\":\"18\"}],[\"$\",\"path\",\"1m94wz\",{\"d\":\"M16 10h.01\"}],[\"$\",\"path\",\"1nrarc\",{\"d\":\"M12 10h.01\"}],[\"$\",\"path\",\"19clt8\",{\"d\":\"M8 10h.01\"}],[\"$\",\"path\",\"1etili\",{\"d\":\"M12 14h.01\"}],[\"$\",\"path\",\"6423bh\",{\"d\":\"M8 14h.01\"}],[\"$\",\"path\",\"mhygvu\",{\"d\":\"M12 18h.01\"}],[\"$\",\"path\",\"lrp35t\",{\"d\":\"M8 18h.01\"}],\"$undefined\"]}],\"Paycheck Calculator\",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right h-4 w-4\",\"aria-hidden\":\"true\",\"children\":[\"$L11\",\"$L12\",\"$undefined\"]}]]}]]}],\"$L13\"]}]}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],\"$L14\"]}]]}]\n5:[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$Ld\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$Lf\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n15:T12cc,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/paycheck-difference-calculator#software\",\"@type\":\"WebApplication\",\"name\":\"Paycheck Difference Calculator\",\"url\":\"https://thetaxcalc.com/paycheck-difference-calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/paycheck-difference-calculator\"},\"description\":\"Calculate the difference in take-home pay between two states or salaries. Free 2026 calculator for all 50 states.\",\"provider\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"author\":{\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"}},{\"@id\":\"https://thetaxcalc.com/paycheck-difference-calculator#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much difference does state tax make on my paycheck?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It can be dramatic. If you earn $75,000, living in Texas (0% state tax) instead of California (up to 9.3% at that bracket) saves you roughly $5,000–$7,000 per year in state taxes alone. Moving from Illinois (4.95%) to Texas saves about $3,500 per year at the same salary. Our calculator shows you the exact dollar difference for any salary and state pair.\"}},{\"@type\":\"Question\",\"name\":\"Which states have no income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nine states levy no personal income tax: Alaska, Florida, Nevada, New Hampshire, South Dakota, Tennessee, Texas, Washington, and Wyoming. New Hampshire taxes dividend and interest income but not wages. If you live in any of these states, your paycheck only shrinks due to federal tax and FICA — no state tax is withheld.\"}},{\"@type\":\"Question\",\"name\":\"How do I compare my paycheck if I move to a different state?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Enter your current salary and state as the first scenario, then add a second scenario with the same salary and your new state. The calculator will show your after-tax take-home pay for both, plus the exact difference. You can also adjust the salary if the move comes with a raise or pay cut.\"}},{\"@type\":\"Question\",\"name\":\"Does this account for local or city taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, for New York City residents. If you select New York state and enable the NYC Resident toggle, the calculator includes the city income tax (3.078%–3.876%). Most other cities do not levy local income taxes, but if they do, you would need to factor those in separately.\"}},{\"@type\":\"Question\",\"name\":\"What about FICA — does that change by state?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. FICA taxes — 6.2% for Social Security (up to the $184,500 wage base in 2026) and 1.45% for Medicare — are federal and do not vary by state. Everyone pays the same FICA regardless of where they live. The only FICA variation is the 0.9% Additional Medicare Tax on income over $200,000.\"}},{\"@type\":\"Question\",\"name\":\"Can I see the difference in bi-weekly or monthly take-home pay?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The comparison table shows net take-home pay annually, monthly, and bi-weekly for each scenario. The difference column applies to each time period, so you can see exactly how much more or less each paycheck would be.\"}}]},{\"@id\":\"https://thetaxcalc.com/paycheck-difference-calculator#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Paycheck Difference Calculator\"}]}]}6:[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}],\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\"]}],[\"$L1e\",\"$L1f\",\"$L20\",\"$L21\"],\"$L22\"]}]\n7:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L23\",null,{\"children\":\"$L24\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L25\",null,{\"children\":[\"$\",\"$26\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L27\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n28:I[46236,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"DynamicProviders\"]\n29:I[3971,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/1d7d79b8f76d8a62.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"ScenarioComparison\"]\n2d:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundar