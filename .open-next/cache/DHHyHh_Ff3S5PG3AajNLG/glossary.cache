-foreground hover:text-emerald-400 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"h-1 w-1 rounded-full bg-emerald-500/40 shrink-0 group-hover:bg-emerald-400 transition-colors\"}],\"Relocation Calculator\"]}]]}]]}],\"$L17\"]}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"mt-16 border-t border-border/20 pt-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"glass-emerald p-6 sm:p-8 rounded-2xl\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-bold text-foreground mb-3\",\"children\":\"Why Bother Learning This Stuff?\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3 text-sm text-muted-foreground leading-relaxed\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Here's the thing — tax laws change every single year, and 2026 is no exception. New brackets. A Social Security wage cap of $184,500. Standard deductions at $16,100 (single), $32,200 (married), $24,150 (HOH). If you don't know what these numbers mean, you're basically guessing at your own finances. And guessing with the IRS? Not a great strategy.\"}],[\"$\",\"p\",null,{\"children\":\"Whether you're a W-2 employee staring at your pay stub trying to figure out where all the money went, a freelancer drowning in quarterly estimates, or an investor trying not to get killed on capital gains — these terms matter. We defined them in plain language with real 2026 figures, and we linked each one to a calculator so you can actually use what you learn. Knowledge is power. Especially when the IRS is involved.\"}]]}]]}]}]\n9:[\"$\",\"section\",null,{\"className\":\"py-12 border-t border-border/20\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8\",\"children\":[\"$\",\"section\",null,{\"aria-label\":\"Author: Rachel Mitchell\",\"className\":\"rounded-xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 to-card/80 p-5 sm:p-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex items-start gap-4\",\"children\":[[\"$\",\"img\",null,{\"src\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\",\"alt\":\"Rachel Mitchell, CPA\",\"width\":48,\"height\":48,\"className\":\"h-12 w-12 shrink-0 rounded-full object-cover ring-1 ring-emerald-500/30\",\"loading\":\"lazy\"}],[\"$\",\"div\",null,{\"className\":\"min-w-0 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/about#rachel-mitchell\",\"className\":\"text-base font-semibold text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Rachel Mitchell\"}],[\"$\",\"span\",null,{\"className\":\"inline-flex items-center rounded-md bg-emerald-500/15 px-2 py-0.5 text-xs font-semibold text-emerald-400 ring-1 ring-emerald-500/25\",\"children\":\"CPA\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-0.5 text-sm text-muted-foreground\",\"children\":[\"Lead Tax Analyst & Editorial Director\",\", TheTaxCalc\"]}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm leading-relaxed text-muted-foreground line-clamp-2\",\"children\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\"}],[\"$\",\"div\",null,{\"className\":\"mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-1\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3 w-