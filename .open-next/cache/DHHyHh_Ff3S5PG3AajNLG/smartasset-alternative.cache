-calculator\\\",{\\\"href\\\":\\\"/new-york-tax-calculator\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"New York\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/mortgage-calculator\\\",{\\\"href\\\":\\\"/mortgage-calculator\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Mortgage\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/capital-gains-calculator\\\",{\\\"href\\\":\\\"/capital-gains-calculator\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Capital Gains\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/401k-retirement-calculator\\\",{\\\"href\\\":\\\"/401k-retirement-calculator\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"401(k)\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/blog\\\",{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Blog\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/glossary\\\",{\\\"href\\\":\\\"/glossary\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Glossary\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/compare\\\",{\\\"href\\\":\\\"/compare\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Compare States\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/salary\\\",{\\\"href\\\":\\\"/salary\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Salary Explorer\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/federal-tax-brackets\\\",{\\\"href\\\":\\\"/federal-tax-brackets\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Tax Brackets\\\"}],[\\\"$\\\",\\\"$L10\\\",\\\"/about\\\",{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"About\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"14:[\\\"$\\\",\\\"$L26\\\",null,{}]\\n16:[\\\"$\\\",\\\"nav\\\",null,{\\\"aria-label\\\":\\\"Breadcrumb\\\",\\\"className\\\":\\\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"hover:text-foreground transition-colors\\\",\\\"children\\\":\\\"Home\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"/\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-foreground font-medium\\\",\\\"children\\\":\\\"SmartAsset Alternative\\\"}]]}]\\n17:[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\\\",\\\"children\\\":\\\"The Free SmartAsset Alternative — Paycheck, Mortgage \\u0026 Tax Calculators\\\"}]\\n18:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-lg text-muted-foreground leading-relaxed mb-8\\\",\\\"children\\\":\\\"SmartAsset built a popular suite of financial calculators — but they also collect your contact information, match you with up to three paying financial advisors, and require an email address before showing you full results. TheTaxCalc is a free, no-strings alternative: every calculator runs in your browser, no sign-up required, and your numbers never touch our servers. Here’s how we compare.\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"19:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Why Look for a SmartAsset Alternative?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-4\\\",\\\"children\\\":\\\"SmartAsset is a well-known personal finance site that publishes a paycheck calculator, a mortgage calculator, a retirement calculator, and several other tools. The site is owned by a company whose business model is lead generation: when you enter your information to use a calculator, SmartAsset typically asks for your name, email, and phone number, then matches you with up to three financial advisors who pay SmartAsset for those introductions.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed mb-4\\\",\\\"children\\\":\\\"That’s not necessarily a bad thing — many users want advisor introductions. But if you just want to know how much you’ll take home after taxes, or whether you can afford a $400,000 mortgage, you probably don’t want your inbox flooded with advisor solicitations. TheTaxCalc was built to be the no-strings alternative: you type in your numbers, you get your answer, you leave. No accounts, no emails, no advisor matches.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The other big reason users seek an alternative is privacy. When you enter your salary, savings rate, or mortgage details into a lead-generation calculator, that data is collected, stored, and in some cases shared with third parties. On TheTaxCalc, every calculation runs entirely in your browser using JavaScript — your numbers never reach our servers. We couldn’t see them even if we wanted to.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1a:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Feature Comparison\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"overflow-x-auto rounded-xl border border-border/30\\\",\\\"children\\\":[\\\"$\\\",\\\"table\\\",null,{\\\"className\\\":\\\"w-full text-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"thead\\\",null,{\\\"className\\\":\\\"bg-muted/30\\\",\\\"children\\\":[\\\"$\\\",\\\"tr\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"th\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-left font-semibold text-foreground\\\",\\\"children\\\":\\\"Feature\\\"}],[\\\"$\\\",\\\"th\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-center font-semibold text-emerald-400\\\",\\\"children\\\":\\\"TheTaxCalc\\\"}],[\\\"$\\\",\\\"th\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-center font-semibold text-muted-foreground\\\",\\\"children\\\":\\\"SmartAsset\\\"}]]}]}],[\\\"$\\\",\\\"tbody\\\",null,{\\\"className\\\":\\\"divide-y divide-border/20\\\",\\\"children\\\":[[\\\"$\\\",\\\"tr\\\",\\\"Paycheck calculator (50 states)\\\",{\\\"className\\\":\\\"bg-card/30\\\",\\\"children\\\":[[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-foreground\\\",\\\"children\\\":\\\"Paycheck calculator (50 states)\\\"}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-center\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-emerald-400 font-bold\\\",\\\"children\\\":\\\"✓\\\"}]}],[\\\"$\\\",\\\"td\\\",null,{\\\"className\\\":\\\"px-4 py-3 text-center\\\",\\\"children\\\":[\\\"$\\\",\