 place. If you want to share your results, you can copy the URL or screenshot it yourself — but by default, what you calculate on TheTaxCalc is between you and your browser.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1c:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Calculators You Can Use Right Now\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L10\\\",\\\"/paycheck-calculator\\\",{\\\"href\\\":\\\"/paycheck-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Paycheck Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Take-home pay for all 50 states with federal, FICA, and state income tax.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/mortgage-calculator\\\",{\\\"href\\\":\\\"/mortgage-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Mortgage Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Monthly payment, amortization schedule, and extra payment scenarios.\\\"}]]}],[\\\"$\\\",\\\"$L10\\\",\\\"/401k-retirement-calculator\\\",{\\\"href\\\":\\\"/401k-retirement-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\