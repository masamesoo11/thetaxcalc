\\":\\\"/compare\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Compare States\\\"}],[\\\"$\\\",\\\"$L11\\\",\\\"/salary\\\",{\\\"href\\\":\\\"/salary\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Salary Explorer\\\"}],[\\\"$\\\",\\\"$L11\\\",\\\"/federal-tax-brackets\\\",{\\\"href\\\":\\\"/federal-tax-brackets\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"Tax Brackets\\\"}],[\\\"$\\\",\\\"$L11\\\",\\\"/about\\\",{\\\"href\\\":\\\"/about\\\",\\\"className\\\":\\\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\\\",\\\"children\\\":\\\"About\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"15:[\\\"$\\\",\\\"$L1e\\\",null,{}]\\n\"])</script><script>self.__next_f.push([1,\"1f:T1c6c,\"])</script><script>self.__next_f.push([1,\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#breadcrumb\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://thetaxcalc.com\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Research\\\",\\\"item\\\":\\\"https://thetaxcalc.com/research\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Best States for Remote Workers in 2026\\\",\\\"item\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026\\\"}]},{\\\"@type\\\":\\\"FAQPage\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#faq\\\",\\\"mainEntity\\\":[{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Which state is best for remote workers in 2026?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Texas ranks first in our 2026 Remote Worker Index, combining zero state income tax with a moderate cost of living, strong broadband in major metros, and no convenience-of-the-employer rule. A remote worker earning $100,000 in Texas takes home roughly $7,800 more per year than the same worker in California, before accounting for cost of living differences. Florida, Tennessee, Nevada, and Wyoming round out the top 5.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How does OBBBA affect remote workers?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"OBBBA helps remote workers in three ways. First, the TCJA brackets were made permanent, preventing a reversion to higher federal rates. Second, the SALT cap increase from $10,000 to $40,400 benefits remote workers who itemize in high-tax states. Third, the new tip and overtime deductions help remote workers in traditionally tipped occupations or who log regular overtime. Use our OBBBA tax calculator to see your specific savings.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What is the convenience-of-the-employer rule?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"The convenience-of-the-employer rule is a tax rule in several states (New York, Pennsylvania, Delaware, Nebraska, Arkansas, Connecticut) that taxes a remote worker based on the location of the employer, not the location of the worker. If you live in Texas but work remotely for a New York employer, New York can require you to pay state income tax on that wage income — even though you never set foot in New York. We penalize states with this rule in our Remote Worker Index.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Do remote workers have to pay taxes in multiple states?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"It depends. If you work remotely from a single state for an employer in another state, you may owe tax in both states — your home state on all income, and the employer's state if it applies the convenience-of-the-employer rule. If you travel between states for work, you may owe tax in each state where you performed work, prorated by days worked. Most states offer a credit for tax paid to other states, but the rules vary. Consult a tax professional for your specific situation.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How is the Remote Worker Index calculated?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"We score each state on a 0-100 scale using four weighted factors: after-tax income for a $100,000 single filer (40% weight), cost of living index (30% weight), broadband coverage at 100 Mbps+ (20% weight), and remote-worker friendliness including no convenience-of-the-employer rule and OBBBA deductions (10% weight). The scoring methodology is published in full in the study appendix.\\\"}},{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Should I move to a no-income-tax state as a remote worker?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"For many remote workers, the answer is yes — the tax savings can fully offset relocation costs within 12 to 18 months. But consider three things first: (1) cost of living differences may reduce or eliminate the savings in some no-income-tax states, (2) some states like Texas make up revenue through higher property and sales taxes, and (3) if your employer applies the convenience-of-the-employer rule, moving may not reduce your tax bill. Use our paycheck calculator to compare take-home pay across states before deciding.\\\"}}]},{\\\"@type\\\":\\\"ScholarlyArticle\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#article\\\",\\\"headline\\\":\\\"Best States for Remote Workers in 2026\\\",\\\"description\\\":\\\"A tax-adjusted ranking of the best states for full-time remote workers in 2026. Factoring in income tax, cost of living, broadband coverage, and the new OBBBA tip and overtime deductions.\\\",\\\"datePublished\\\":\\\"2026-01-15\\\",\\\"dateModified\\\":\\\"2026-01-15\\\",\\\"inLanguage\\\":\\\"en-US\\\",\\\"url\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TheTaxCalc Research Team\\\",\\\"url\\\":\\\"https://thetaxcalc.com/about\\\"},\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TheTaxCalc\\\",\\\"url\\\":\\\"https://thetaxcalc.com\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://thetaxcalc.com/logo.svg\\\"}},\\\"about\\\":\\\"Lifestyle \\u0026 Tax\\\",\\\"keywords\\\":[\\\"tax research\\\",\\\"2026 taxes\\\",\\\"lifestyle \\u0026 tax\\\"],\\\"mainEntityOfPage\\\":{\\\"@type\\\":\\\"WebPage\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026\\\"}},{\\\"@type\\\":\\\"Dataset\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#dataset-1\\\",\\\"name\\\":\\\"2026 Remote Worker Index Scores — All 50 States\\\",\\\"description\\\":\\\"Composite 0-100 score and four sub-scores (after-tax income, cost of living, broadband, friendliness) for each state.\\\",\\\"creator\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TheTaxCalc\\\"},\\\"url\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#index-data\\\",\\\"inLanguage\\\":\\\"en-US\\\",\\\"license\\\":\\\"https://creativecommons.org/licenses/by/4.0/\\\",\\\"isAccessibleForFree\\\":true,\\\"distribution\\\":{\\\"@type\\\":\\\"DataDownload\\\",\\\"encodingFormat\\\":\\\"text/html\\\",\\\"contentUrl\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#index-data\\\"}},{\\\"@type\\\":\\\"Dataset\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#dataset-2\\\",\\\"name\\\":\\\"2026 State Broadband Coverage at 100 Mbps+\\\",\\\"description\\\":\\\"Percentage of households with access to fixed terrestrial broadband at 100 Mbps download and 20 Mbps upload or faster, by state.\\\",\\\"creator\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TheTaxCalc, sourced from FCC Broadband Deployment Report\\\"},\\\"url\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#broadband-data\\\",\\\"inLanguage\\\":\\\"en-US\\\",\\\"license\\\":\\\"https://creativecommons.org/licenses/by/4.0/\\\",\\\"isAccessibleForFree\\\":true,\\\"distribution\\\":{\\\"@type\\\":\\\"DataDownload\\\",\\\"encodingFormat\\\":\\\"text/html\\\",\\\"contentUrl\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#broadband-data\\\"}},{\\\"@type\\\":\\\"Dataset\\\",\\\"@id\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#dataset-3\\\",\\\"name\\\":\\\"2026 State Cost of Living Index\\\",\\\"description\\\":\\\"Composite cost of living index (U.S. average = 100) covering housing, groceries, utilities, transportation, and healthcare, by state.\\\",\\\"creator\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TheTaxCalc, sourced from C2ER\\\"},\\\"url\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#col-data\\\",\\\"inLanguage\\\":\\\"en-US\\\",\\\"license\\\":\\\"https://creativecommons.org/licenses/by/4.0/\\\",\\\"isAccessibleForFree\\\":true,\\\"distribution\\\":{\\\"@type\\\":\\\"DataDownload\\\",\\\"encodingFormat\\\":\\\"text/html\\\",\\\"contentUrl\\\":\\\"https://thetaxcalc.com/research/best-states-for-remote-workers-2026#col-data\\\"}}]}\"])</script><script>self.__next_f.push([1,\"16:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"$1f\\\"}}],\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\",\\\"$L23\\\",\\\"$L24\\\",\\\"$L25\\\",\\\"$L26\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"20:[\\\"$\\\",\\\"nav\\\",null,{\\\"aria-label\\\":\\\"Breadcrumb\\\",\\\"className\\\":\\\"mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"hover:text-foreground transition-colors\\\",\\\"children\\\":\\\"Home\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"/\\\"}],[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/research\\\",\\\"className\\\":\\\"hover:text-foreground transition-colors\\\",\\\"children\\\":\\\"Research\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"aria-hidden\\\":\\\"true\\\",\\\"children\\\":\\\"/\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-foreground font-medium line-clamp-1\\\",\\\"children\\\":\\\"Best States for Remote Workers in 2026\\\"}]]}]\\n21:[\\\"$\\\",\\\"header\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center gap-2 mb-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs text-emerald-400\\\",\\\"children\\\":\\\"Lifestyle \\u0026 Tax\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":[\\\"Published \\\",\\\"January 15, 2026\\\"]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":\\\"·\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":[\\\"10 min\\\",\\\" read\\\"]}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\\\",\\\"children\\\":\\\"Best States for Remote Workers in 2026\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-lg text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"With 28% of U.S. workers now fully or partially remote, the choice of state of residence has become a powerful tax planning lever. We ranked all 50 states using four weighted factors: after-tax income, cost of living, broadband coverage, and remote-worker friendliness (including the new OBBBA tip and overtime deductions).\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"22:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-8 mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"section\\\",\\\"Methodology: The Remote Worker Index\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Methodology: The Remote Worker Index\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Our 2026 Remote Worker Index scores each state on a 0-100 scale using four weighted factors. After-tax income for a $100,000 single filer (40% weight) is calculated using our paycheck calculator logic — federal income tax, FICA, and state income tax all included. Cost of living index from the Council for Community and Economic Research (30% weight) measures how far that after-tax income goes. Broadband coverage (20% weight) from the FCC measures the percentage of households with access to 100 Mbps+ internet, essential for video calls and file uploads. Remote-worker friendliness (10% weight) reflects state policies like no convenience-of-the-rule taxation and the OBBBA tip and overtime deductions for tipped and hourly workers.\\\"}]]}],[\\\"$\\\",\\\"section\\\",\\\"Top 10 Best States for Remote Workers in 2026\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Top 10 Best States for Remote Workers in 2026\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Texas ranks first in our 2026 index, combining zero state income tax with a moderate cost of living and good broadband coverage in major metros. Florida follows at second — no state income tax, warm weather, and a growing tech corridor. Tennessee, Nevada, Wyoming, Washington, South Dakota, New Hampshire, and North Carolina round out the top 10. Several of these states have no state individual income tax at all (Texas, Florida, Tennessee, Nevada, Wyoming, Washington, South Dakota). New Hampshire makes the list despite taxing dividend and interest income because wages are exempt and the state has excellent broadband. North Carolina rounds out the top 10 with a flat 4.5% income tax and a strong research-triangle tech corridor.\\\"}]]}],[\\\"$\\\",\\\"section\\\",\\\"Bottom 10 States for Remote Workers in 2026\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Bottom 10 States for Remote Workers in 2026\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The bottom 10 states for remote workers are concentrated in the Northeast and West Coast, where high taxes combine with high costs of living. California ranks 50th in our index — although it has world-class broadband in major metros, the top marginal state income tax rate of 13.3% and a cost of living 50% above the national average wipe out the benefit. New York (49th), Hawaii (48th), Connecticut (47th), Vermont (46th), New Jersey (45th), Maine (44th), Rhode Island (43rd), Oregon (42nd), and Illinois (41st) round out the bottom 10. The OBBBA SALT cap increase helps itemizers in these states on the federal side, but the underlying state tax burden remains the heaviest in the nation.\\\"}]]}],[\\\"$\\\",\\\"section\\\",\\\"How OBBBA Tip and Overtime Deductions Affect the Rankings\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"How OBBBA Tip and Overtime Deductions Affect the Rankings\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The One Big Beautiful Bill Act introduced two new above-the-line deductions for the 2026 tax year: a tip income deduction for qualifying tipped occupations and an overtime pay deduction for qualifying overtime pay. While these deductions are temporary (scheduled to sunset in future years), they meaningfully affect remote workers in traditionally tipped occupations (food delivery, hospitality support) and remote hourly workers who log overtime. For these workers, a state with no income tax becomes even more attractive because the federal deduction is taken against federal tax, but state tax still applies unless the state has no income tax. TheTaxCalc's OBBBA tax calculator shows the exact federal savings.\\\"}]]}],\\\"$L27\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Datasets Used in This Study\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed mb-4\\\",\\\"children\\\":\\\"Each dataset below is the underlying data table or source for this study. All datasets are licensed under Creative Commons Attribution 4.0 (CC BY 4.0) and are free to reuse with attribution to TheTaxCalc.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"2026 Remote Worker Index Scores — All 50 States\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground\\\",\\\"children\\\":\\\"2026 Remote Worker Index Scores — All 50 States\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Composite 0-100 score and four sub-scores (after-tax income, cost of living, broadband, friendliness) for each state.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground mt-2\\\",\\\"children\\\":[\\\"Creator: \\\",\\\"TheTaxCalc\\\",\\\" · License: CC BY 4.0\\\"]}]]}],[\\\"$\\\",\\\"div\\\",\\\"2026 State Broadband Coverage at 100 Mbps+\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground\\\",\\\"children\\\":\\\"2026 State Broadband Coverage at 100 Mbps+\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Percentage of households with access to fixed terrestrial broadband at 100 Mbps download and 20 Mbps upload or faster, by state.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground mt-2\\\",\\\"children\\\":[\\\"Creator: \\\",\\\"TheTaxCalc, sourced from FCC Broadband Deployment Report\\\",\\\" · License: CC BY 4.0\\\"]}]]}],[\\\"$\\\",\\\"div\\\",\\\"2026 State Cost of Living Index\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-muted/20 p-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground\\\",\\\"children\\\":\\\"2026 State Cost of Living Index\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Composite cost of living index (U.S. average = 100) covering housing, groceries, utilities, transportation, and healthcare, by state.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground mt-2\\\",\\\"children\\\":[\\\"Creator: \\\",\\\"TheTaxCalc, sourced from C2ER\\\",\\\" · License: CC BY 4.0\\\"]}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"24:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-6\\\",\\\"children\\\":\\\"Frequently Asked Questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",\\\"Which state is best for remote workers in 2026?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Which state is best for remote workers in 2026?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Texas ranks first in our 2026 Remote Worker Index, combining zero state income tax with a moderate cost of living, strong broadband in major metros, and no convenience-of-the-employer rule. A remote worker earning $100,000 in Texas takes home roughly $7,800 more per year than the same worker in California, before accounting for cost of living differences. Florida, Tennessee, Nevada, and Wyoming round out the top 5.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"How does OBBBA affect remote workers?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"How does OBBBA affect remote workers?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"OBBBA helps remote workers in three ways. First, the TCJA brackets were made permanent, preventing a reversion to higher federal rates. Second, the SALT cap increase from $10,000 to $40,400 benefits remote workers who itemize in high-tax states. Third, the new tip and overtime deductions help remote workers in traditionally tipped occupations or who log regular overtime. Use our OBBBA tax calculator to see your specific savings.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"What is the convenience-of-the-employer rule?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"What is the convenience-of-the-employer rule?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"The convenience-of-the-employer rule is a tax rule in several states (New York, Pennsylvania, Delaware, Nebraska, Arkansas, Connecticut) that taxes a remote worker based on the location of the employer, not the location of the worker. If you live in Texas but work remotely for a New York employer, New York can require you to pay state income tax on that wage income — even though you never set foot in New York. We penalize states with this rule in our Remote Worker Index.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"Do remote workers have to pay taxes in multiple states?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Do remote workers have to pay taxes in multiple states?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"It depends. If you work remotely from a single state for an employer in another state, you may owe tax in both states — your home state on all income, and the employer's state if it applies the convenience-of-the-employer rule. If you travel between states for work, you may owe tax in each state where you performed work, prorated by days worked. Most states offer a credit for tax paid to other states, but the rules vary. Consult a tax professional for your specific situation.\\\"}]]}],[\\\"$\\\",\\\"div\\\",\\\"How is the Remote Worker Index calculated?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[\\\"$L28\\\",\\\"$L29\\\"]}],\\\"$L2a\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"25:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mb-10 rounded-xl border border-border/30 bg-muted/10 p-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Sources \\u0026 Methodology\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed mb-3\\\",\\\"children\\\":[\\\"This study uses official government data, including IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972), Social Security Administration data, U.S. Census Bureau American Community Survey, the FCC Broadband Deployment Report, and each state’s Department of Revenue. Tax law changes from the One Big Beautiful Bill Act (P.L. 119-1) are incorporated throughout. For full calculation details, see our\\\",\\\" \\\",[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/methodology\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"methodology page\\\"}],\\\".\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-xs text-muted-foreground\\\",\\\"children\\\":[\\\"Last updated: \\\",\\\"January 15, 2026\\\",\\\". This study is reviewed annually and updated whenever material new data is published by the IRS or other official sources.\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"26:[\\\"$\\\",\\\"section\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Related Resources\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid gap-3 sm:grid-cols-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L11\\\",\\\"/paycheck-calculator\\\",{\\\"href\\\":\\\"/paycheck-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Paycheck Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"See your after-tax take-home pay for any state.\\\"}]]}],[\\\"$\\\",\\\"$L11\\\",\\\"/obbba-tax-calculator\\\",{\\\"href\\\":\\\"/obbba-tax-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"OBBBA Tax Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Compare 2026 taxes under OBBBA vs prior law.\\\"}]]}],[\\\"$\\\",\\\"$L11\\\",\\\"/tax-refund-calculator\\\",{\\\"href\\\":\\\"/tax-refund-calculator\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"Tax Refund Calculator\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Estimate your 2026 federal refund.\\\"}]]}],[\\\"$\\\",\\\"$L11\\\",\\\"/compare\\\",{\\\"href\\\":\\\"/compare\\\",\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-medium text-foreground\\\",\\\"children\\\":\\\"State Comparison Tool\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground mt-1\\\",\\\"children\\\":\\\"Compare any two states side-by-side.\\\"}]]}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-4 text-sm text-muted-foreground\\\",\\\"children\\\":[\\\"$\\\",\\\"$L11\\\",null,{\\\"href\\\":\\\"/research\\\",\\\"className\\\":\\\"text-emerald-400 hover:text-emerald-300 underline\\\",\\\"children\\\":\\\"← Back to all research studies\\\"}]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"27:[\\\"$\\\",\\\"section\\\",\\\"Considerations Beyond Taxes\\\",{\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold text-foreground mb-4\\\",\\\"children\\\":\\\"Considerations Beyond Taxes\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"Taxes are the largest single factor for most remote workers, but they are not the only one. Several states (including New York, Pennsylvania, Delaware, Nebraska, Arkansas, and Connecticut) apply convenience-of-the-employer rules, which means a remote worker whose employer is in New York but who lives in Texas can still owe New York state income tax on that wage income. We penalize these states in our remote-worker friendliness sub-score. Additionally, some states have begun taxing remote workers based on the number of days worked in the state (the so-called \\\\\\\"digital nomad\\\\\\\" tax issue). Workers who regularly cross state lines should consult a tax professional about multi-state filing obligations.\\\"}]]}]\\n28:[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"How is the Remote Worker Index calculated?\\\"}]\\n29:[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"We score each state on a 0-100 scale using four weighted factors: after-tax income for a $100,000 single filer (40% weight), cost of living index (30% weight), broadband coverage at 100 Mbps+ (20% weight), and remote-worker friendliness including no convenience-of-the-employer rule and OBBBA deductions (10% weight). The scoring methodology is published in full in the study appendix.\\\"}]\\n2a:[\\\"$\\\",\\\"div\\\",\\\"Should I move to a no-income-tax state as a remote worker?\\\",{\\\"className\\\":\\\"rounded-lg border border-border/30 bg-card/50 p-5\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-semibold text-foreground mb-2\\\",\\\"children\\\":\\\"Should I move to a no-income-tax state as a remote worker?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm text-muted-foreground leading-relaxed\\\",\\\"children\\\":\\\"For many remote workers, the answer is yes — the tax savings can fully offset relocation costs within 12 to 18 months. But consider three things first: (1) cost of living differences may reduce or eliminate the savings in some no-income-tax states, (2) some states like Texas make up revenue through higher property and sales taxes, and (3) if your employer applies the convenience-of-the-employer rule, moving may not reduce your tax bill. Use our paycheck calculator to compare take-home pay across states before deciding.\\\"}]]}]\\n\"])</script><script>self.__next_f.push([1,\"1b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n\"])</script><script>self.__next_f.push([1,\"2b:I[27201,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/61cc43b3d7ad2990.js\\\"],\\\"IconMark\\\"]\\n19:null\\n\"])</script><script>self.__next_f.push([1,\"1d:[[\\\"$\\\",\\\"title\\\",\\\"0\\\