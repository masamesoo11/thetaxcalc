ndefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\n7:[\"$\",\"$1\",\"c\",{\"children\":[\"$L16\",null,[\"$\",\"$L17\",null,{\"children\":[\"$\",\"$18\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@19\"}]}]]}]\n8:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1a\",null,{\"children\":\"$L1b\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1c\",null,{\"children\":[\"$\",\"$18\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1d\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n1e:I[46236,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"DynamicProviders\"]\n12:[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}]\n13:[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}]\n14:[\"$\",\"div\",null,{\"className\":\"mt-10 flex flex-wrap items-center justify-center gap-3 text-sm\",\"children\":[[\"$\",\"$L11\",\"/illinois-tax-calculator\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Illinois\"}],[\"$\",\"$L11\",\"/texas-tax-calculator\",{\"href\":\"/texas-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Texas\"}],[\"$\",\"$L11\",\"/florida-tax-calculator\",{\"href\":\"/florida-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Florida\"}],[\"$\",\"$L11\",\"/california-tax-calculator\",{\"href\":\"/california-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"California\"}],[\"$\",\"$L11\",\"/new-york-tax-calculator\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"New York\"}],[\"$\",\"$L11\",\"/mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Mortgage\"}],[\"$\",\"$L11\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Capital Gains\"}],[\"$\",\"$L11\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"401(k)\"}],[\"$\",\"$L11\",\"/blog\",{\"href\":\"/blog\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Blog\"}],[\"$\",\"$L11\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}],[\"$\",\"$L11\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L11\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}],[\"$\",\"$L11\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L11\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n15:[\"$\",\"$L1e\",null,{}]\n1f:T1ce6,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research\",\"item\":\"https://thetaxcalc.com/research\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Property Tax by State 2026 — Effective Rates & Median Bills\",\"item\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Which state has the highest property taxes in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"New Jersey has the highest property taxes in the nation in 2026, with an effective rate of approximately 2.21% and a median annual bill of $9,500. Illinois, Connecticut, New Hampshire, and Vermont round out the top 5. Several of these states (New Jersey, Illinois, Connecticut, New Hampshire) have had the highest property taxes in the nation for decades, driven by a combination of high local government spending, school funding formulas, and limited alternative revenue sources.\"}},{\"@type\":\"Question\",\"name\":\"Which state has the lowest property taxes in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hawaii has the lowest property taxes in the nation in 2026, with an effective rate of approximately 0.28% and a median annual bill of $2,100. The low rate is supported by state tourism revenue and a generous homestead exemption that significantly reduces assessed value for owner-occupants. Alabama, Colorado, Louisiana, and the District of Columbia round out the lowest 5.\"}},{\"@type\":\"Question\",\"name\":\"How is property tax calculated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Property tax is calculated as the assessed value of your home multiplied by the local millage rate (or tax rate), then divided by 1,000. Assessed value may or may not equal market value depending on your state — some states assess at full market value, others at a percentage, and others use classification systems. Effective property tax rate (which we report) is the median annual property tax paid divided by the median home value, giving a percentage that captures what a typical homeowner actually pays as a share of their home's value.\"}},{\"@type\":\"Question\",\"name\":\"How does the OBBBA SALT cap affect property tax deduction?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The OBBBA SALT cap increase from $10,000 to $40,400 lets itemizers deduct up to $40,400 in combined state income tax, property tax, and sales tax (up from $10,000 under TCJA). For a homeowner in New Jersey with a $9,500 property tax bill, the increased cap means they can deduct the full amount (subject to total SALT and MAGI phaseout). Single filers with MAGI above $500,000 and married filers above $1,000,000 face a phaseout that reduces the cap back to $10,000.\"}},{\"@type\":\"Question\",\"name\":\"Why are Texas property taxes so high if there is no state income tax?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Texas has no state individual income tax, so the state funds government services primarily through property tax and sales tax. Texas ranks in the top 10 nationally for effective property tax rate (around 1.7%), with suburban Dallas, Houston, and Austin metros often exceeding 2.2%. The trade-off: a Texas family earning $150,000 pays no state income tax but pays roughly $2,500 more per year in property tax on a $400,000 home than they would in California. The net effect is generally positive for high earners.\"}},{\"@type\":\"Question\",\"name\":\"Can I deduct property tax if I take the standard deduction?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Property tax is deductible only if you itemize deductions on Schedule A. With the 2026 OBBBA standard deduction of $16,100 (single) or $32,200 (MFJ), most taxpayers now take the standard deduction and cannot separately deduct property tax. However, the OBBBA SALT cap increase from $10,000 to $40,400 makes itemizing more attractive for homeowners in high-property-tax states, especially those with mortgage interest and charitable contributions to itemize.\"}}]},{\"@type\":\"ScholarlyArticle\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#article\",\"headline\":\"Property Tax by State 2026 — Effective Rates & Median Bills\",\"description\":\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context and the OBBBA SALT cap impact.\",\"datePublished\":\"2026-01-15\",\"dateModified\":\"2026-01-15\",\"inLanguage\":\"en-US\",\"url\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc Research Team\",\"url\":\"https://thetaxcalc.com/about\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/logo.svg\"}},\"about\":\"Property Tax\",\"keywords\":[\"tax research\",\"2026 taxes\",\"property tax\"],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#dataset-1\",\"name\":\"2026 Effective Property Tax Rates by State\",\"description\":\"Median annual property tax paid divided by median home value, expressed as a percentage, for all 50 states plus D.C.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from U.S. Census Bureau ACS 5-year\"},\"url\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#effective-rates\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#effective-rates\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#dataset-2\",\"name\":\"2026 Median Annual Property Tax Bills by State\",\"description\":\"Median annual property tax payment in current dollars for owner-occupied housing units, for all 50 states plus D.C.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from U.S. Census Bureau ACS 5-year\"},\"url\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#median-bills\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#median-bills\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#dataset-3\",\"name\":\"2026 County-Level Property Tax Rates — Top 50 Counties\",\"description\":\"Effective property tax rate and median bill for the 50 most populous U.S. counties, with state context.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from Tax Foundation county-level data\"},\"url\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#county-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/property-tax-by-state-2026#county-data\"}}]}16:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}],\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\"]}]\n20:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$L11\",null,{\"href\":\"/research\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Research\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium line-clamp-1\",\"children\":\"Property Tax by State 2026 — Effective Rates & Median Bills\"}]]}]\n21:[\"$\",\"header\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs text-emerald-400\",\"children\":\"Property Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 15, 2026\"]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"·\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"9 min\",\" read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"Property Tax by State 2026 — Effective Rates & Median Bills\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed\",\"children\":\"Property tax is the largest single state and local tax for many homeowners, often exceeding state income tax. We compiled effective property tax rates and median annual property tax bills for all 50 states in 2026, with county-level context for the most populous areas.\"}]]}]\n22:[\"$\",\"div\",null,{\"className\":\"space-y-8 mb-10\",\"children\":[[\"$\",\"section\",\"Methodology: Effective Rate vs Nominal Rate\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Methodology: Effective Rate vs Nominal Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Property tax is notoriously difficult to compare across states because each state assesses property differently. Some states assess at full market value, others at a percentage of market value, and others use complex classification systems. To make apples-to-apples comparisons, we use effective property tax rate: the median annual property tax paid divided by the median home value, expressed as a percentage. This captures what a typical homeowner actually pays in property tax as a share of their home's value. Median home values and median property tax payments come from the U.S. Census Bureau's American Community Survey 5-year estimates (latest available, 2020-2024). We also report median annual property tax bills in dollars, which combine the effective rate with the median home value.\"}]]}],[\"$\",\"section\",\"Top 10 Highest Property Tax States in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Highest Property Tax States in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"New Jersey has the highest property taxes in the nation, with an effective rate of approximately 2.21% and a median annual bill of $9,500. Illinois ranks second at 2.08% effective rate ($5,200 median bill), driven by Cook County (Chicago). Connecticut ranks third at 2.00% ($6,200 median bill). New Hampshire, Vermont, Pennsylvania, Texas, Wisconsin, Nebraska, and Ohio round out the top 10. Notably, Texas appears in the top 10 despite having no state income tax — the state compensates with above-average property taxes, particularly in suburban Dallas, Houston, and Austin. The OBBBA $40,400 SALT cap increase (up from $10,000) provides meaningful federal deduction relief for itemizers in these high-property-tax states.\"}]]}],[\"$\",\"section\",\"Top 10 Lowest Property Tax States in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Lowest Property Tax States in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Hawaii has the lowest property taxes in the nation, with an effective rate of approximately 0.28% and a median annual bill of $2,100. The low rate is supported by the state's tourism revenue and a homestead exemption that significantly reduces assessed value for owner-occupants. Alabama ranks second at 0.41% ($900 median bill), followed by Colorado, Louisiana, the District of Columbia, Delaware, South Carolina, West Virginia, Wyoming, and Arkansas. Several of these states (Louisiana, Alabama, South Carolina) offer generous homestead exemptions that reduce the taxable value of owner-occupied homes. The low effective rates in Colorado and Wyoming are supported by mineral and energy extraction revenue.\"}]]}],[\"$\",\"section\",\"How OBBBA Affects Property Taxpayers\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How OBBBA Affects Property Taxpayers\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA SALT cap increase from $10,000 to $40,400 (with a phaseout for high earners) is one of the most impactful changes for property taxpayers in 2026. For an itemizing homeowner in New Jersey with a $9,500 property tax bill plus $8,000 in state income tax, the old $10,000 cap meant they could only deduct $10,000 of the $17,500 total — losing $7,500 of deductions. Under OBBBA, they can deduct the full $17,500, saving approximately $1,650 in federal tax (at the 22% marginal rate on the additional $8,000 of deductible SALT). Single filers with MAGI above $500,000 and married filers above $1,000,000 face a phaseout that reduces the cap back to $10,000 over a $200,000 range. Use our OBBBA tax calculator to see your exact savings.\"}]]}],\"$L27\"]}]\n23:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Datasets Used in This Study\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Each dataset below is the underlying data table or source for this study. All datasets are licensed under Creative Commons Attribution 4.0 (CC BY 4.0) and are free to reuse with attribution to TheTaxCalc.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"2026 Effective Property Tax Rates by State\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Effective Property Tax Rates by State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Median annual property tax paid divided by median home value, expressed as a percentage, for all 50 states plus D.C.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from U.S. Census Bureau ACS 5-year\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 Median Annual Property Tax Bills by State\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Median Annual Property Tax Bills by State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Median annual property tax payment in current dollars for owner-occupied housing units, for all 50 states plus D.C.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from U.S. Census Bureau ACS 5-year\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 County-Level Property Tax Rates — Top 50 Counties\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 County-Level Property Tax Rates — Top 50 Counties\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Effective property tax rate and median bill for the 50 most populous U.S. counties, with state context.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from Tax Foundation county-level data\",\" · License: CC BY 4.0\"]}]]}]]}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"Which state has the highest property taxes in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the highest property taxes in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"New Jersey has the highest property taxes in the nation in 2026, with an effective rate of approximately 2.21% and a median annual bill of $9,500. Illinois, Connecticut, New Hampshire, and Vermont round out the top 5. Several of these states (New Jersey, Illinois, Connecticut, New Hampshire) have had the highest property taxes in the nation for decades, driven by a combination of high local government spending, school funding formulas, and limited alternative revenue sources.\"}]]}],[\"$\",\"div\",\"Which state has the lowest property taxes in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the lowest property taxes in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Hawaii has the lowest property taxes in the nation in 2026, with an effective rate of approximately 0.28% and a median annual bill of $2,100. The low rate is supported by state tourism revenue and a generous homestead exemption that significantly reduces assessed value for owner-occupants. Alabama, Colorado, Louisiana, and the District of Columbia round out the lowest 5.\"}]]}],[\"$\",\"div\",\"How is property tax calculated?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How is property tax calculated?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Property tax is calculated as the assessed value of your home multiplied by the local millage rate (or tax rate), then divided by 1,000. Assessed value may or may not equal market value depending on your state — some states assess at full market value, others at a percentage, and others use classification systems. Effective property tax rate (which we report) is the median annual property tax paid divided by the median home value, giving a percentage that captures what a typical homeowner actually pays as a share of their home's value.\"}]]}],[\"$\",\"div\",\"How does the OBBBA SALT cap affect property tax deduction?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How does the OBBBA SALT cap affect property tax deduction?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"The OBBBA SALT cap increase from $10,000 to $40,400 lets itemizers deduct up to $40,400 in combined state income tax, property tax, and sales tax (up from $10,000 under TCJA). For a homeowner in New Jersey with a $9,500 property tax bill, the increased cap means they can deduct the full amount (subject to total SALT and MAGI phaseout). Single filers with MAGI above $500,000 and married filers above $1,000,000 face a phaseout that reduces the cap back to $10,000.\"}]]}],[\"$\",\"div\",\"Why are Texas property taxes so high if there is no state income tax?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[\"$L28\",\"$L29\"]}],\"$L2a\"]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-muted/10 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Sources & Methodology\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":[\"This study uses official government data, including IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972), Social Security Administration data, U.S. Census Bureau American Community Survey, the FCC Broadband Deployment Report, and each state’s Department of Revenue. Tax law changes from the One Big Beautiful Bill Act (P.L. 119-1) are incorporated throughout. For full calculation details, see our\",\" \",[\"$\",\"$L11\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"methodology page\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Last updated: \",\"January 15, 2026\",\". This study is reviewed annually and updated whenever material new data is published by the IRS or other official sources.\"]}]]}]\n26:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L11\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"See your after-tax take-home pay for any state.\"}]]}],[\"$\",\"$L11\",\"/obbba-tax-calculator\",{\"href\":\"/obbba-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"OBBBA Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare 2026 taxes under OBBBA vs prior law.\"}]]}],[\"$\",\"$L11\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Estimate your 2026 federal refund.\"}]]}],[\"$\",\"$L11\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"State Comparison Tool\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare any two states side-by-side.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/research\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"← Back to all research studies\"}]}]]}]\n27:[\"$\",\"section\",\"County-Level Variation Within States\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"County-Level Variation Within States\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"Statewide effective rates hide significant within-state variation. In Illinois, Cook County (Chicago) has effective rates above 2.5%, while suburban Collar counties are closer to 2.0%. In Texas, school district property taxes vary by county and can swing the total bill by 30% or more. In New York, Long Island (Nassau and Suffolk counties) has some of the highest property tax bills in the country — many over $13,000 annually — while upstate counties are closer to the national median. Always check your specific county and school district when budgeting for property tax. The Tax Foundation publishes county-level property tax data in its annual report.\"}]]}]\n28:[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Why are Texas property taxes so high if there is no state income tax?\"}]\n29:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Texas has no state individual income tax, so the state funds government services primarily through property tax and sales tax. Texas ranks in the top 10 nationally for effective property tax rate (around 1.7%), with suburban Dallas, Houston, and Austin metros often exceeding 2.2%. The trade-off: a Texas family earning $150,000 pays no state income tax but pays roughly $2,500 more per year in property tax on a $400,000 home than they would in California. The net effect is generally positive for high earners.\"}]\n2a:[\"$\",\"div\",\"Can I deduct property tax if I take the standard deduction?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Can I deduct property tax if I take the standard deduction?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No. Property tax is deductible only if you itemize deductions on Schedule A. With the 2026 OBBBA standard deduction of $16,100 (single) or $32,200 (MFJ), most taxpayers now take the standard deduction and cannot separately deduct property tax. However, the OBBBA SALT cap increase from $10,000 to $40,400 makes itemizing more attractive for homeowners in high-property-tax states, especially those with mortgage interest and charitable contributions to itemize.\"}]]}]\n1b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2b:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n19:null\n1d:[[\"$\",\"title\",\"0\",{\"children\":\"Property Tax by State 2026 — Effective Rates and Median Bills | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context and the OBBBA SALT cap impact.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"Property Tax by State 2026 — Effective Rates and Median Bills\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context and the OBBBA SALT cap impact.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/research/property-tax-by-state-2026\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:published_time\",\"content\":\"2026-01-15T08:00:00.000Z\"}],[\"$\",\"meta\",\"18\",{\"property\":\"article:author\",\"content\":\"TheTaxCalc Research Team\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:title\",\"content\":\"TheTaxCalc — Free 2026 Paycheck & Mortgage Calculator\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:description\",\"content\":\"Compute your take-home pay after federal, FICA, and state taxes. Supports IL, TX, FL, CA, NY.\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"23\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"24\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2b\",\"25\",{}]]\n","segmentData":{"/_tree":":HL[\"/_next/static/chunks/34d933785a17edf3.css\",\"style\"]\n:HL[\"/_next/static/chunks/bfd6eb476abf7f9c.css\",\"style\"]\n:HL[\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"tree\":{\"name\":\"\",\"paramType\":null,\"paramKey\":\"\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"research\",\"paramType\":null,\"paramKey\":\"research\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"slug\",\"paramType\":\"d\",\"paramKey\":\"property-tax-by-state-2026\",\"hasRuntimePrefetch\":false,\"slots\":{\"children\":{\"name\":\"__PAGE__\",\"paramType\":null,\"paramKey\":\"__PAGE__\",\"hasRuntimePrefetch\":false,\"slots\":null,\"isRootLayout\":false}},\"isRootLayout\":false}},\"isRootLayout\":false}},\"isRootLayout\":true},\"staleTime\":300}\n","/_full":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"ClientAnalytics\"]\n9:I[63491,[\"/_next/static/chunks/c322938c6693d41b.js\"],\"default\"]\n:HL[\"/_next/static/chunks/34d933785a17edf3.css\",\"style\"]\n:HL[\"/_next/static/chunks/bfd6eb476abf7f9c.css\",\"style\"]\n:HL[\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n:HL[\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\",\"font\",{\"crossOrigin\":\"\",\"type\":\"font/woff2\"}]\n3:T670,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_st