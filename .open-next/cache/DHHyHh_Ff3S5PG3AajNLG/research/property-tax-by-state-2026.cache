{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/research/layout,_N_T_/research/[slug]/layout,_N_T_/research/[slug]/page,_N_T_/research/property-tax-by-state-2026"},"segmentPaths":["/_tree","/_full","/research/$d$slug/__PAGE__","/research/$d$slug","/research","/_index","/_head"]},"html":"<!DOCTYPE html><!--DHHyHh_Ff3S5PG3AajNLG--><html lang=\"en-US\" class=\"dark\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/797e433ab948586e-s.p.29207c2f.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.3b6cae6d.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/34d933785a17edf3.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/bfd6eb476abf7f9c.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/dec11ab5b071f102.js\"/><script src=\"/_next/static/chunks/f091501564eb2ea3.js\" async=\"\"></script><script src=\"/_next/static/chunks/771dedee3f5e1621.js\" async=\"\"></script><script src=\"/_next/static/chunks/170d65956da23aac.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-585fb9a968b38771.js\" async=\"\"></script><script src=\"/_next/static/chunks/49e33bee669819de.js\" async=\"\"></script><script src=\"/_next/static/chunks/868a9c4503c53c54.js\" async=\"\"></script><script src=\"/_next/static/chunks/d791dd6e73034ab4.js\" async=\"\"></script><script src=\"/_next/static/chunks/c322938c6693d41b.js\" async=\"\"></script><script async=\"\" data-cfasync=\"false\" src=\"https://www.googletagmanager.com/gtag/js?id=G-9SEBTKFT61\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/61cc43b3d7ad2990.js\" async=\"\"></script><script src=\"/_next/static/chunks/5552623386487b15.js\" async=\"\"></script><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"/><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\"/><link rel=\"preconnect\" href=\"https://www.googletagmanager.com\"/><link rel=\"preconnect\" href=\"https://www.google-analytics.com\"/><link rel=\"preconnect\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.googleapis.com\"/><link rel=\"dns-prefetch\" href=\"https://fonts.gstatic.com\"/><link rel=\"dns-prefetch\" href=\"https://www.googletagmanager.com\"/><link rel=\"dns-prefetch\" href=\"https://www.google-analytics.com\"/><link rel=\"dns-prefetch\" href=\"https://analytics.ahrefs.com\"/><link rel=\"dns-prefetch\" href=\"https://www.irs.gov\"/><link rel=\"dns-prefetch\" href=\"https://taxfoundation.org\"/><link rel=\"manifest\" href=\"/manifest.json\"/><meta name=\"theme-color\" content=\"#0a0f1e\"/><meta name=\"next-size-adjust\" content=\"\"/><title>Property Tax by State 2026 — Effective Rates and Median Bills | TheTaxCalc</title><meta name=\"description\" content=\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context and the OBBBA SALT cap impact.\"/><link rel=\"author\" href=\"https://thetaxcalc.com/about#rachel-mitchell\"/><meta name=\"author\" content=\"Rachel Mitchell, CPA\"/><meta name=\"creator\" content=\"TheTaxCalc\"/><meta name=\"publisher\" content=\"TheTaxCalc\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><meta name=\"category\" content=\"finance\"/><meta name=\"classification\" content=\"Tax Calculator\"/><link rel=\"canonical\" href=\"https://thetaxcalc.com/research/property-tax-by-state-2026\"/><meta name=\"google-site-verification\" content=\"verify_google_site_verification_token\"/><meta property=\"og:title\" content=\"Property Tax by State 2026 — Effective Rates and Median Bills\"/><meta property=\"og:description\" content=\"Effective property tax rates and median annual property tax bills for all 50 states in 2026. From New Jersey (highest) to Hawaii (lowest), with county-level context and the OBBBA SALT cap impact.\"/><meta property=\"og:url\" content=\"https://thetaxcalc.com/research/property-tax-by-state-2026\"/><meta property=\"og:site_name\" content=\"TheTaxCalc\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-01-15T08:00:00.000Z\"/><meta property=\"article:author\" content=\"TheTaxCalc Research Team\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"TheTaxCalc — Free 2026 Paycheck &amp; Mortgage Calculator\"/><meta name=\"twitter:description\" content=\"Compute your take-home pay after federal, FICA, and state taxes. Supports IL, TX, FL, CA, NY.\"/><meta name=\"twitter:image\" content=\"https://thetaxcalc.com/opengraph-image.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script data-cfasync=\"false\">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\n})(window,document,'script','dataLayer','GTM-KWWRJFPZ');</script><script data-cfasync=\"false\">\n                  window.dataLayer = window.dataLayer || [];\n                  function gtag(){dataLayer.push(arguments);}\n                  gtag('js', new Date());\n                  gtag('config', 'G-9SEBTKFT61');\n                </script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com/#organization\",\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/icon.png\"},\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment. Trusted by thousands of users for accurate, up-to-date tax estimates.\",\"foundingDate\":\"2022\",\"sameAs\":[\"https://thetaxcalc.com/about\",\"https://thetaxcalc.com/blog\",\"https://thetaxcalc.com/research\",\"https://thetaxcalc.com/methodology\"],\"contactPoint\":[{\"@type\":\"ContactPoint\",\"url\":\"https://thetaxcalc.com/about#contact\",\"contactType\":\"customer support\",\"availableLanguage\":[\"English\"]}]},{\"@id\":\"https://thetaxcalc.com/#website\",\"@type\":\"WebSite\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"description\":\"Free 2026 tax calculators — paycheck, mortgage, 401(k), capital gains, and self-employment.\",\"inLanguage\":\"en-US\",\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://thetaxcalc.com/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@id\":\"https://thetaxcalc.com/#webpage-home\",\"@type\":\"WebPage\",\"name\":\"2026 Tax Calculator — Paycheck & Take-Home Pay | 50 States\",\"description\":\"Free 2026 tax calculator. Take-home pay after federal, FICA & state tax. 64 tools & 50-state sales tax data. No sign-up.\",\"url\":\"https://thetaxcalc.com\",\"inLanguage\":\"en-US\",\"isPartOf\":{\"@id\":\"https://thetaxcalc.com/#website\"},\"about\":{\"@type\":\"Thing\",\"name\":\"Tax Calculator\"}}]}</script><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"geist_a71539c9-module__T19VSG__variable geist_mono_8d43a2aa-module__8Li5zG__variable antialiased bg-background text-foreground\"><div hi