ded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"California\"}],[\"$\",\"$L11\",\"/new-york-tax-calculator\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"New York\"}],[\"$\",\"$L11\",\"/mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Mortgage\"}],[\"$\",\"$L11\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Capital Gains\"}],[\"$\",\"$L11\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"401(k)\"}],[\"$\",\"$L11\",\"/blog\",{\"href\":\"/blog\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Blog\"}],[\"$\",\"$L11\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}],[\"$\",\"$L11\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L11\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}],[\"$\",\"$L11\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L11\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n15:[\"$\",\"$L1e\",null,{}]\n1f:T1af6,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research\",\"item\":\"https://thetaxcalc.com/research\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"2026 State Tax Burden: Total Tax Load by State\",\"item\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is state tax burden?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. It combines three components: state income tax (effective rate on median household income), property tax (effective rate on median home value weighted by homeownership rate), and sales tax (combined state and local rate applied to the share of income subject to sales tax). Our 2026 rankings cover all 50 states plus the District of Columbia.\"}},{\"@type\":\"Question\",\"name\":\"Which state has the highest tax burden in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"New York has the highest state tax burden in 2026 at an estimated 13.4% of income, driven by the nation's top state income tax rate (10.9%), the New York City local income tax for city residents, and high combined state and local sales taxes averaging 8.5%. Connecticut, Hawaii, California, and Vermont round out the top 5. The OBBBA $40,400 SALT cap increase provides some federal tax relief for itemizers in these states.\"}},{\"@type\":\"Question\",\"name\":\"Which state has the lowest tax burden in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Alaska has the lowest state tax burden in 2026 at an estimated 4.6%, thanks to no state income tax, no state sales tax, and the annual Permanent Fund Dividend that effectively makes the state tax burden negative for many residents. Wyoming, Tennessee, Florida, and South Dakota round out the lowest 5. Several of these states (Alaska, Wyoming, Tennessee, Florida, South Dakota, Nevada, Texas, Washington) have no state individual income tax at all.\"}},{\"@type\":\"Question\",\"name\":\"Does the OBBBA SALT cap change reduce state taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The OBBBA SALT cap increase from $10,000 to $40,400 only changes how much of your state and local taxes you can deduct against your federal income tax. It does not reduce your actual state and local tax bill. However, for itemizers in high-tax states, the federal tax savings can be substantial — up to $2,860 for a California family with $200,000 income paying $23,000 in SALT. Use our OBBBA tax calculator to compute your exact savings.\"}},{\"@type\":\"Question\",\"name\":\"How do you calculate the effective property tax rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We calculate effective property tax rate as the median annual property tax paid divided by the median home value in each state, sourced from the U.S. Census Bureau's American Community Survey 5-year estimates and the Tax Foundation's annual property tax report. We then apply this rate to the state's homeownership rate to produce a population-weighted figure that reflects what a typical resident pays in property tax as a share of income.\"}},{\"@type\":\"Question\",\"name\":\"How often is this study updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This study is updated annually in January, after the U.S. Census Bureau releases new American Community Survey data and after each state legislature finalizes its tax brackets for the upcoming year. Material mid-year changes (such as a state enacting a new tax law) are incorporated within 30 days of enactment. The \\\"last updated\\\" date at the top of the study reflects the most recent revision.\"}}]},{\"@type\":\"ScholarlyArticle\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#article\",\"headline\":\"2026 State Tax Burden: Total Tax Load by State\",\"description\":\"Total state tax burden (income + property + sales) for all 50 states in 2026. See which states have the highest and lowest effective tax burden, and how OBBBA changed the picture.\",\"datePublished\":\"2026-01-15\",\"dateModified\":\"2026-01-15\",\"inLanguage\":\"en-US\",\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc Research Team\",\"url\":\"https://thetaxcalc.com/about\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/logo.svg\"}},\"about\":\"State Comparison\",\"keywords\":[\"tax research\",\"2026 taxes\",\"state comparison\"],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-1\",\"name\":\"2026 State Income Tax Brackets — All 50 States\",\"description\":\"Top marginal state income tax rate and standard deduction for each of the 50 states, for the 2026 tax year.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#income-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#income-tax-data\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-2\",\"name\":\"2026 Combined State and Local Sales Tax Rates\",\"description\":\"State base sales tax rate plus average local add-on rate, weighted by population, for all 50 states.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from Tax Foundation\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#sales-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#sales-tax-data\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-3\",\"name\":\"2026 Effective Property Tax Rates by State\",\"description\":\"Median annual property tax bill divided by median home value, with state homeownership rate, for all 50 states.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from U.S. Census Bureau ACS\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#property-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#property-tax-data\"}}]}16:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}],\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\"]}]\n20:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L11\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$L11\",null,{\"href\":\"/research\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Research\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium line-clamp-1\",\"children\":\"2026 State Tax Burden: Total Tax Load by State\"}]]}]\n21:[\"$\",\"header\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs text-emerald-400\",\"children\":\"State Comparison\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 15, 2026\"]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"·\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"12 min\",\" read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"2026 State Tax Burden: Total Tax Load by State\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed\",\"children\":\"We combined state income tax, property tax, and sales tax into a single effective burden figure for all 50 states, weighted by median household income. The result is a single percentage that represents how much of a typical resident's income goes to state and local taxes.\"}]]}]\n27:T40d,The states with the lowest total tax burden in 2026 are concentrated in the South and Mountain West. Alaska has the lowest burden in the nation at an estimated 4.6%, thanks to no state income tax and no state sales tax (although localities may levy sales tax). Alaska also distributes an annual Permanent Fund Dividend to residents — effectively a negative tax. Wyoming follows at 5.4%, with no state income tax and low property taxes supported by mineral extraction revenue. Tennessee, Florida, South Dakota, Nevada, Texas, Washington, New Hampshire, and North Carolina round out the lowest 10. Notably, several of these states (Texas, Florida, Washington, Nevada, South Dakota, Wyoming, Alaska, Tennessee, New Hampshire) have no state individual income tax at all, though Texas and Florida make up some revenue through higher property and sales taxes. For remote workers considering a relocation, the bottom 10 states offer substantial long-term savings compared to the top 10 — a difference of up to 8 percentage points of income.22:[\"$\",\"div\",null,{\"className\":\"space-y-8 mb-10\",\"children\":[[\"$\",\"section\",\"Methodology: How We Calculate Total Tax Burden\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Methodology: How We Calculate Total Tax Burden\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. We calculate it as the sum of three components: state income tax (effective rate on median household income), property tax (effective rate on median home value applied to the homeownership rate), and sales tax (combined state and average local rate applied to 35% of income, the average share of income subject to sales tax). All figures are for the 2026 tax year and are sourced from each state's Department of Revenue, the U.S. Census Bureau, and the Tax Foundation's annual state and local tax report.\"}]]}],[\"$\",\"section\",\"Top 10 Highest State Tax Burdens in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Highest State Tax Burdens in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The states with the highest total tax burden in 2026 are concentrated in the Northeast and along the West Coast. New York leads the nation at an estimated 13.4% total burden, driven by the nation's highest state income tax (top rate of 10.9% plus the New York City local income tax for city residents) and a combined state-and-local sales tax averaging 8.5%. Connecticut follows at 12.1%, with high property taxes (median bill over $6,200) and a progressive income tax reaching 6.99%. Hawaii ranks third at 11.8% — despite low property taxes, the state's 7.25% general excise tax (effectively a sales tax) applies to nearly all transactions including business-to-business. California, Vermont, New Jersey, Illinois, Maine, Rhode Island, and Minnesota round out the top 10. The One Big Beautiful Bill Act's $40,400 SALT cap increase provides meaningful federal deduction relief for itemizers in these states, though it does not reduce the underlying state tax burden itself.\"}]]}],[\"$\",\"section\",\"Top 10 Lowest State Tax Burdens in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Lowest State Tax Burdens in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"$27\"}]]}],\"$L28\",\"$L29\"]}]\n23:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Datasets Used in This Study\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Each dataset below is the underlying data table or source for this study. All datasets are licensed under Creative Commons Attribution 4.0 (CC BY 4.0) and are free to reuse with attribution to TheTaxCalc.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"2026 State Income Tax Brackets — All 50 States\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 State Income Tax Brackets — All 50 States\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Top marginal state income tax rate and standard deduction for each of the 50 states, for the 2026 tax year.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 Combined State and Local Sales Tax Rates\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Combined State and Local Sales Tax Rates\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"State base sales tax rate plus average local add-on rate, weighted by population, for all 50 states.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from Tax Foundation\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 Effective Property Tax Rates by State\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Effective Property Tax Rates by State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Median annual property tax bill divided by median home value, with state homeownership rate, for all 50 states.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from U.S. Census Bureau ACS\",\" · License: CC BY 4.0\"]}]]}]]}]]}]\n24:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"What is state tax burden?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"What is state tax burden?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. It combines three components: state income tax (effective rate on median household income), property tax (effective rate on median home value weighted by homeownership rate), and sales tax (combined state and local rate applied to the share of income subject to sales tax). Our 2026 rankings cover all 50 states plus the District of Columbia.\"}]]}],[\"$\",\"div\",\"Which state has the highest tax burden in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the highest tax burden in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"New York has the highest state tax burden in 2026 at an estimated 13.4% of income, driven by the nation's top state income tax rate (10.9%), the New York City local income tax for city residents, and high combined state and local sales taxes averaging 8.5%. Connecticut, Hawaii, California, and Vermont round out the top 5. The OBBBA $40,400 SALT cap increase provides some federal tax relief for itemizers in these states.\"}]]}],[\"$\",\"div\",\"Which state has the lowest tax burden in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the lowest tax burden in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Alaska has the lowest state tax burden in 2026 at an estimated 4.6%, thanks to no state income tax, no state sales tax, and the annual Permanent Fund Dividend that effectively makes the state tax burden negative for many residents. Wyoming, Tennessee, Florida, and South Dakota round out the lowest 5. Several of these states (Alaska, Wyoming, Tennessee, Florida, South Dakota, Nevada, Texas, Washington) have no state individual income tax at all.\"}]]}],[\"$\",\"div\",\"Does the OBBBA SALT cap change reduce state taxes?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Does the OBBBA SALT cap change reduce state taxes?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No. The OBBBA SALT cap increase from $10,000 to $40,400 only changes how much of your state and local taxes you can deduct against your federal income tax. It does not reduce your actual state and local tax bill. However, for itemizers in high-tax states, the federal tax savings can be substantial — up to $2,860 for a California family with $200,000 income paying $23,000 in SALT. Use our OBBBA tax calculator to compute your exact savings.\"}]]}],[\"$\",\"div\",\"How do you calculate the effective property tax rate?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How do you calculate the effective property tax rate?\"}],\"$L2a\"]}],\"$L2b\"]}]]}]\n25:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-muted/10 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Sources & Methodology\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":[\"This study uses official government data, including IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972), Social Security Administration data, U.S. Census Bureau American Community Survey, the FCC Broadband Deployment Report, and each state’s Department of Revenue. Tax law changes from the One Big Beautiful Bill Act (P.L. 119-1) are incorporated throughout. For full calculation details, see our\",\" \",[\"$\",\"$L11\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"methodology page\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Last updated: \",\"January 15, 2026\",\". This study is reviewed annually and updated whenever material new data is published by the IRS or other official sources.\"]}]]}]\n26:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$L11\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"See your after-tax take-home pay for any state.\"}]]}],[\"$\",\"$L11\",\"/obbba-tax-calculator\",{\"href\":\"/obbba-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"OBBBA Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare 2026 taxes under OBBBA vs prior law.\"}]]}],[\"$\",\"$L11\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Estimate your 2026 federal refund.\"}]]}],[\"$\",\"$L11\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"State Comparison Tool\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare any two states side-by-side.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground\",\"children\":[\"$\",\"$L11\",null,{\"href\":\"/research\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"← Back to all research studies\"}]}]]}]\n28:[\"$\",\"section\",\"How OBBBA Changed the Picture\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How OBBBA Changed the Picture\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The One Big Beautiful Bill Act of 2025 raised the SALT deduction cap from $10,000 to $40,400, which meaningfully reduces the federal tax owed by itemizers in high-burden states. However, it does not reduce the underlying state and local tax burden itself — it only changes how much of that burden can be deducted against federal income. For a California family with $200,000 income paying $23,000 in combined state and local taxes, the OBBBA SALT cap increase saves approximately $2,860 in federal tax (at the 22% marginal rate on the additional $13,000 of deductible SALT). For residents of low-tax states who take the standard deduction, OBBBA's SALT change has no effect. Use our free OBBBA tax calculator to see exactly how the new law affects your situation.\"}]]}]\n29:[\"$\",\"section\",\"Why State Tax Burden Matters\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Why State Tax Burden Matters\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"State tax burden affects three groups differently. For retirees living on a fixed income, a 5-percentage-point difference in state tax burden can translate to thousands of dollars per year in additional spending power. For remote workers, who can choose their state of residence, the burden differential can fully offset the cost of relocation within a year or two. For business owners and high earners, state tax burden is often the single largest variable in their overall tax picture — and a primary driver of interstate migration patterns. TheTaxCalc's state tax burden rankings are updated annually to reflect new brackets, new rates, and any state-level tax law changes.\"}]]}]\n2a:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We calculate effective property tax rate as the median annual property tax paid divided by the median home value in each state, sourced from the U.S. Census Bureau's American Community Survey 5-year estimates and the Tax Foundation's annual property tax report. We then apply this rate to the state's homeownership rate to produce a population-weighted figure that reflects what a typical resident pays in property tax as a share of income.\"}]\n2b:[\"$\",\"div\",\"How often is this study updated?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How often is this study updated?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"This study is updated annually in January, after the U.S. Census Bureau releases new American Community Survey data and after each state legislature finalizes its tax brackets for the upcoming year. Material mid-year changes (such as a state enacting a new tax law) are incorporated within 30 days of enactment. The \\\"last updated\\\" date at the top of the study reflects the most recent revision.\"}]]}]\n1b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n2c:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n19:null\n1d:[[\"$\",\"title\",\"0\",{\"children\":\"2026 State Tax Burden Rankings — Income + Property + Sales Tax | TheTaxCalc\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Total state tax burden (income + property + sales) for all 50 states in 2026. See which states have the highest and lowest effective tax burden, and how OBBBA changed the picture.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://thetaxcalc.com/about#rachel-mitchell\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"2026 State Tax Burden Rankings — Income + Property + Sales Tax\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Total state tax burden (income + property + sales) for all 50 states in 2026. See which states have the highest and lowest effective tax burden, and how OBBBA changed the picture.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"17\",{\"property\":\"article:published_time\",\"content\":\"2026-01-15T08:00:00.000Z\"}],[\"$\",\"meta\",\"18\",{\"property\":\"article:author\",\"content\":\"TheTaxCalc Research Team\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:title\",\"content\":\"TheTaxCalc — Free 2026 Paycheck & Mortgage Calculator\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:description\",\"content\":\"Compute your take-home pay after federal, FICA, and state taxes. Supports IL, TX, FL, CA, NY.\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"link\",\"23\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\"}],[\"$\",\"link\",\"24\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-touch-icon.png\"}],[\"$\",\"$L2c\",\"25\",{}]]\n","/research/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\nb:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"\"]\n11:I[97367,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"OutletBoundary\"]\n12:\"$Sreact.suspense\"\n2:T1af6,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"BreadcrumbList\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Research\",\"item\":\"https://thetaxcalc.com/research\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"2026 State Tax Burden: Total Tax Load by State\",\"item\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}]},{\"@type\":\"FAQPage\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is state tax burden?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. It combines three components: state income tax (effective rate on median household income), property tax (effective rate on median home value weighted by homeownership rate), and sales tax (combined state and local rate applied to the share of income subject to sales tax). Our 2026 rankings cover all 50 states plus the District of Columbia.\"}},{\"@type\":\"Question\",\"name\":\"Which state has the highest tax burden in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"New York has the highest state tax burden in 2026 at an estimated 13.4% of income, driven by the nation's top state income tax rate (10.9%), the New York City local income tax for city residents, and high combined state and local sales taxes averaging 8.5%. Connecticut, Hawaii, California, and Vermont round out the top 5. The OBBBA $40,400 SALT cap increase provides some federal tax relief for itemizers in these states.\"}},{\"@type\":\"Question\",\"name\":\"Which state has the lowest tax burden in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Alaska has the lowest state tax burden in 2026 at an estimated 4.6%, thanks to no state income tax, no state sales tax, and the annual Permanent Fund Dividend that effectively makes the state tax burden negative for many residents. Wyoming, Tennessee, Florida, and South Dakota round out the lowest 5. Several of these states (Alaska, Wyoming, Tennessee, Florida, South Dakota, Nevada, Texas, Washington) have no state individual income tax at all.\"}},{\"@type\":\"Question\",\"name\":\"Does the OBBBA SALT cap change reduce state taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The OBBBA SALT cap increase from $10,000 to $40,400 only changes how much of your state and local taxes you can deduct against your federal income tax. It does not reduce your actual state and local tax bill. However, for itemizers in high-tax states, the federal tax savings can be substantial — up to $2,860 for a California family with $200,000 income paying $23,000 in SALT. Use our OBBBA tax calculator to compute your exact savings.\"}},{\"@type\":\"Question\",\"name\":\"How do you calculate the effective property tax rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We calculate effective property tax rate as the median annual property tax paid divided by the median home value in each state, sourced from the U.S. Census Bureau's American Community Survey 5-year estimates and the Tax Foundation's annual property tax report. We then apply this rate to the state's homeownership rate to produce a population-weighted figure that reflects what a typical resident pays in property tax as a share of income.\"}},{\"@type\":\"Question\",\"name\":\"How often is this study updated?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"This study is updated annually in January, after the U.S. Census Bureau releases new American Community Survey data and after each state legislature finalizes its tax brackets for the upcoming year. Material mid-year changes (such as a state enacting a new tax law) are incorporated within 30 days of enactment. The \\\"last updated\\\" date at the top of the study reflects the most recent revision.\"}}]},{\"@type\":\"ScholarlyArticle\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#article\",\"headline\":\"2026 State Tax Burden: Total Tax Load by State\",\"description\":\"Total state tax burden (income + property + sales) for all 50 states in 2026. See which states have the highest and lowest effective tax burden, and how OBBBA changed the picture.\",\"datePublished\":\"2026-01-15\",\"dateModified\":\"2026-01-15\",\"inLanguage\":\"en-US\",\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden\",\"author\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc Research Team\",\"url\":\"https://thetaxcalc.com/about\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://thetaxcalc.com/logo.svg\"}},\"about\":\"State Comparison\",\"keywords\":[\"tax research\",\"2026 taxes\",\"state comparison\"],\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-1\",\"name\":\"2026 State Income Tax Brackets — All 50 States\",\"description\":\"Top marginal state income tax rate and standard deduction for each of the 50 states, for the 2026 tax year.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#income-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#income-tax-data\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-2\",\"name\":\"2026 Combined State and Local Sales Tax Rates\",\"description\":\"State base sales tax rate plus average local add-on rate, weighted by population, for all 50 states.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from Tax Foundation\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#sales-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#sales-tax-data\"}},{\"@type\":\"Dataset\",\"@id\":\"https://thetaxcalc.com/research/2026-state-tax-burden#dataset-3\",\"name\":\"2026 Effective Property Tax Rates by State\",\"description\":\"Median annual property tax bill divided by median home value, with state homeownership rate, for all 50 states.\",\"creator\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc, sourced from U.S. Census Bureau ACS\"},\"url\":\"https://thetaxcalc.com/research/2026-state-tax-burden#property-tax-data\",\"inLanguage\":\"en-US\",\"license\":\"https://creativecommons.org/licenses/by/4.0/\",\"isAccessibleForFree\":true,\"distribution\":{\"@type\":\"DataDownload\",\"encodingFormat\":\"text/html\",\"contentUrl\":\"https://thetaxcalc.com/research/2026-state-tax-burden#property-tax-data\"}}]}0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}],null,\"$La\"]}],\"loading\":null,\"isPartial\":false}\n3:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"$Lb\",null,{\"href\":\"/research\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Research\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium line-clamp-1\",\"children\":\"2026 State Tax Burden: Total Tax Load by State\"}]]}]\n4:[\"$\",\"header\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2 mb-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"rounded-full bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 text-xs text-emerald-400\",\"children\":\"State Comparison\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Published \",\"January 15, 2026\"]}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"·\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"12 min\",\" read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4\",\"children\":\"2026 State Tax Burden: Total Tax Load by State\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-muted-foreground leading-relaxed\",\"children\":\"We combined state income tax, property tax, and sales tax into a single effective burden figure for all 50 states, weighted by median household income. The result is a single percentage that represents how much of a typical resident's income goes to state and local taxes.\"}]]}]\nc:T40d,The states with the lowest total tax burden in 2026 are concentrated in the South and Mountain West. Alaska has the lowest burden in the nation at an estimated 4.6%, thanks to no state income tax and no state sales tax (although localities may levy sales tax). Alaska also distributes an annual Permanent Fund Dividend to residents — effectively a negative tax. Wyoming follows at 5.4%, with no state income tax and low property taxes supported by mineral extraction revenue. Tennessee, Florida, South Dakota, Nevada, Texas, Washington, New Hampshire, and North Carolina round out the lowest 10. Notably, several of these states (Texas, Florida, Washington, Nevada, South Dakota, Wyoming, Alaska, Tennessee, New Hampshire) have no state individual income tax at all, though Texas and Florida make up some revenue through higher property and sales taxes. For remote workers considering a relocation, the bottom 10 states offer substantial long-term savings compared to the top 10 — a difference of up to 8 percentage points of income.5:[\"$\",\"div\",null,{\"className\":\"space-y-8 mb-10\",\"children\":[[\"$\",\"section\",\"Methodology: How We Calculate Total Tax Burden\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Methodology: How We Calculate Total Tax Burden\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. We calculate it as the sum of three components: state income tax (effective rate on median household income), property tax (effective rate on median home value applied to the homeownership rate), and sales tax (combined state and average local rate applied to 35% of income, the average share of income subject to sales tax). All figures are for the 2026 tax year and are sourced from each state's Department of Revenue, the U.S. Census Bureau, and the Tax Foundation's annual state and local tax report.\"}]]}],[\"$\",\"section\",\"Top 10 Highest State Tax Burdens in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Highest State Tax Burdens in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The states with the highest total tax burden in 2026 are concentrated in the Northeast and along the West Coast. New York leads the nation at an estimated 13.4% total burden, driven by the nation's highest state income tax (top rate of 10.9% plus the New York City local income tax for city residents) and a combined state-and-local sales tax averaging 8.5%. Connecticut follows at 12.1%, with high property taxes (median bill over $6,200) and a progressive income tax reaching 6.99%. Hawaii ranks third at 11.8% — despite low property taxes, the state's 7.25% general excise tax (effectively a sales tax) applies to nearly all transactions including business-to-business. California, Vermont, New Jersey, Illinois, Maine, Rhode Island, and Minnesota round out the top 10. The One Big Beautiful Bill Act's $40,400 SALT cap increase provides meaningful federal deduction relief for itemizers in these states, though it does not reduce the underlying state tax burden itself.\"}]]}],[\"$\",\"section\",\"Top 10 Lowest State Tax Burdens in 2026\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Top 10 Lowest State Tax Burdens in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"$c\"}]]}],\"$Ld\",\"$Le\"]}]\n6:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-card/50 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Datasets Used in This Study\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-4\",\"children\":\"Each dataset below is the underlying data table or source for this study. All datasets are licensed under Creative Commons Attribution 4.0 (CC BY 4.0) and are free to reuse with attribution to TheTaxCalc.\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"div\",\"2026 State Income Tax Brackets — All 50 States\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 State Income Tax Brackets — All 50 States\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Top marginal state income tax rate and standard deduction for each of the 50 states, for the 2026 tax year.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 Combined State and Local Sales Tax Rates\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Combined State and Local Sales Tax Rates\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"State base sales tax rate plus average local add-on rate, weighted by population, for all 50 states.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from Tax Foundation\",\" · License: CC BY 4.0\"]}]]}],[\"$\",\"div\",\"2026 Effective Property Tax Rates by State\",{\"className\":\"rounded-lg border border-border/30 bg-muted/20 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-foreground\",\"children\":\"2026 Effective Property Tax Rates by State\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Median annual property tax bill divided by median home value, with state homeownership rate, for all 50 states.\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-2\",\"children\":[\"Creator: \",\"TheTaxCalc, sourced from U.S. Census Bureau ACS\",\" · License: CC BY 4.0\"]}]]}]]}]]}]\n7:[\"$\",\"section\",null,{\"className\":\"mb-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"div\",\"What is state tax burden?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"What is state tax burden?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"State tax burden is the percentage of a typical resident's income that goes to state and local taxes. It combines three components: state income tax (effective rate on median household income), property tax (effective rate on median home value weighted by homeownership rate), and sales tax (combined state and local rate applied to the share of income subject to sales tax). Our 2026 rankings cover all 50 states plus the District of Columbia.\"}]]}],[\"$\",\"div\",\"Which state has the highest tax burden in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the highest tax burden in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"New York has the highest state tax burden in 2026 at an estimated 13.4% of income, driven by the nation's top state income tax rate (10.9%), the New York City local income tax for city residents, and high combined state and local sales taxes averaging 8.5%. Connecticut, Hawaii, California, and Vermont round out the top 5. The OBBBA $40,400 SALT cap increase provides some federal tax relief for itemizers in these states.\"}]]}],[\"$\",\"div\",\"Which state has the lowest tax burden in 2026?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Which state has the lowest tax burden in 2026?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"Alaska has the lowest state tax burden in 2026 at an estimated 4.6%, thanks to no state income tax, no state sales tax, and the annual Permanent Fund Dividend that effectively makes the state tax burden negative for many residents. Wyoming, Tennessee, Florida, and South Dakota round out the lowest 5. Several of these states (Alaska, Wyoming, Tennessee, Florida, South Dakota, Nevada, Texas, Washington) have no state individual income tax at all.\"}]]}],[\"$\",\"div\",\"Does the OBBBA SALT cap change reduce state taxes?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"Does the OBBBA SALT cap change reduce state taxes?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"No. The OBBBA SALT cap increase from $10,000 to $40,400 only changes how much of your state and local taxes you can deduct against your federal income tax. It does not reduce your actual state and local tax bill. However, for itemizers in high-tax states, the federal tax savings can be substantial — up to $2,860 for a California family with $200,000 income paying $23,000 in SALT. Use our OBBBA tax calculator to compute your exact savings.\"}]]}],[\"$\",\"div\",\"How do you calculate the effective property tax rate?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How do you calculate the effective property tax rate?\"}],\"$Lf\"]}],\"$L10\"]}]]}]\n8:[\"$\",\"section\",null,{\"className\":\"mb-10 rounded-xl border border-border/30 bg-muted/10 p-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Sources & Methodology\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed mb-3\",\"children\":[\"This study uses official government data, including IRS publications (Rev. Proc. 2025-25, Pub. 15-T, Pub. 972), Social Security Administration data, U.S. Census Bureau American Community Survey, the FCC Broadband Deployment Report, and each state’s Department of Revenue. Tax law changes from the One Big Beautiful Bill Act (P.L. 119-1) are incorporated throughout. For full calculation details, see our\",\" \",[\"$\",\"$Lb\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"methodology page\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"Last updated: \",\"January 15, 2026\",\". This study is reviewed annually and updated whenever material new data is published by the IRS or other official sources.\"]}]]}]\n9:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Related Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"$Lb\",\"/paycheck-calculator\",{\"href\":\"/paycheck-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"See your after-tax take-home pay for any state.\"}]]}],[\"$\",\"$Lb\",\"/obbba-tax-calculator\",{\"href\":\"/obbba-tax-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"OBBBA Tax Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare 2026 taxes under OBBBA vs prior law.\"}]]}],[\"$\",\"$Lb\",\"/tax-refund-calculator\",{\"href\":\"/tax-refund-calculator\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"Tax Refund Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Estimate your 2026 federal refund.\"}]]}],[\"$\",\"$Lb\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-lg border border-border/30 bg-card/50 p-4 hover:border-emerald-500/40 hover:bg-emerald-500/5 transition-colors\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-medium text-foreground\",\"children\":\"State Comparison Tool\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground mt-1\",\"children\":\"Compare any two states side-by-side.\"}]]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-sm text-muted-foreground\",\"children\":[\"$\",\"$Lb\",null,{\"href\":\"/research\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"← Back to all research studies\"}]}]]}]\na:[\"$\",\"$L11\",null,{\"children\":[\"$\",\"$12\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@13\"}]}]\nd:[\"$\",\"section\",\"How OBBBA Changed the Picture\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How OBBBA Changed the Picture\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"The One Big Beautiful Bill Act of 2025 raised the SALT deduction cap from $10,000 to $40,400, which meaningfully reduces the federal tax owed by itemizers in high-burden states. However, it does not reduce the underlying state and local tax burden itself — it only changes how much of that burden can be deducted against federal income. For a California family with $200,000 income paying $23,000 in combined state and local taxes, the OBBBA SALT cap increase saves approximately $2,860 in federal tax (at the 22% marginal rate on the additional $13,000 of deductible SALT). For residents of low-tax states who take the standard deduction, OBBBA's SALT change has no effect. Use our free OBBBA tax calculator to see exactly how the new law affects your situation.\"}]]}]\ne:[\"$\",\"section\",\"Why State Tax Burden Matters\",{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Why State Tax Burden Matters\"}],[\"$\",\"p\",null,{\"className\":\"text-muted-foreground leading-relaxed\",\"children\":\"State tax burden affects three groups differently. For retirees living on a fixed income, a 5-percentage-point difference in state tax burden can translate to thousands of dollars per year in additional spending power. For remote workers, who can choose their state of residence, the burden differential can fully offset the cost of relocation within a year or two. For business owners and high earners, state tax burden is often the single largest variable in their overall tax picture — and a primary driver of interstate migration patterns. TheTaxCalc's state tax burden rankings are updated annually to reflect new brackets, new rates, and any state-level tax law changes.\"}]]}]\nf:[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"We calculate effective property tax rate as the median annual property tax paid divided by the median home value in each state, sourced from the U.S. Census Bureau's American Community Survey 5-year estimates and the Tax Foundation's annual property tax report. We then apply this rate to the state's homeownership rate to produce a population-weighted figure that reflects what a typical resident pays in property tax as a share of income.\"}]\n10:[\"$\",\"div\",\"How often is this study updated?\",{\"className\":\"rounded-lg border border-border/30 bg-card/50 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"font-semibold text-foreground mb-2\",\"children\":\"How often is this study updated?\"}],[\"$\",\"p\",null,{\"className\":\"text-sm text-muted-foreground leading-relaxed\",\"children\":\"This study is updated annually in January, after the U.S. Census Bureau releases new American Community Survey data and after each state legislature finalizes its tax brackets for the upcoming year. Material mid-year changes (such as a state enacting a new tax law) are incorporated within 30 days of enactment. The \\\"last updated\\\" date at the top of the study reflects the most recent revision.\"}]]}]\n13:null\n","/research/$d$slug":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"loading\":null,\"isPartial\":false}\n","/research":"1:\"$Sreact.fragment\"\n2:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n3:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\n0:{\"buildId\":\"DHHyHh_Ff3S5PG3AajNLG\",\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L3\",null,{}]}]]}],\"loading\":null,\"isPartial\":false}\n","/_index":"1:\"$Sreact.fragment\"\n2:I[85561,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"ClientAnalytics\"]\n6:I[40264,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"QueryProvider\"]\n7:I[41631,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"SiteShell\"]\n8:I[40230,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"WebMCPProvider\"]\n9:I[39756,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\na:I[58298,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/5552623386487b15.js\"],\"default\"]\nb:I[37457,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"default\"]\nc:I[22016,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"\"]\n10:I[46236,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\"],\"Dyn