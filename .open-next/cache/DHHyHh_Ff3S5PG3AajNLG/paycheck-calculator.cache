w-4\" aria-hidden=\"true\"><path d=\"M16 7h6v6\"></path><path d=\"m22 7-8.5 8.5-5-5L2 17\"></path></svg>Salary</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/tax-data\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Data</a><a class=\"flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium transition-all text-muted-foreground hover:bg-muted/50 hover:text-foreground\" href=\"/widgets\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code-xml h-4 w-4\" aria-hidden=\"true\"><path d=\"m18 16 4-4-4-4\"></path><path d=\"m6 8-4 4 4 4\"></path><path d=\"m14.5 4-5 16\"></path></svg>Widgets</a></nav><div class=\"flex items-center gap-3\"><a class=\"hidden sm:flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all hover:scale-[1.02]\" href=\"/paycheck-calculator\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chart-column h-4 w-4\" aria-hidden=\"true\"><path d=\"M3 3v16a2 2 0 0 0 2 2h16\"></path><path d=\"M18 17V9\"></path><path d=\"M13 17V5\"></path><path d=\"M8 17v-3\"></path></svg>Calculate Now</a><button data-slot=\"button\" class=\"inline-flex items-center justify-center whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent dark:hover:bg-accent/50 h-8 rounded-md gap-1.5 px-3 has-[&gt;svg]:px-2.5 lg:hidden text-muted-foreground hover:text-foreground\" aria-label=\"Toggle mobile menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 12h16\"></path><path d=\"M4 18h16\"></path><path d=\"M4 6h16\"></path></svg></button></div></div></header><main id=\"main-content\" class=\"flex-1\"><div class=\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com#webpage\",\"@type\":\"WebPage\",\"name\":\"Paycheck Calculator — Federal, FICA & State Tax Take-Home Pay\",\"description\":\"Free 2026 paycheck calculator. Instantly compute your take-home pay after federal tax, FICA (Social Security + Medicare), and state income tax deductions.\",\"url\":\"https://thetaxcalc.com/paycheck-calculator\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-06-25\",\"author\":{\"@id\":\"https://thetaxcalc.com/#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Paycheck Calculator\"}]},{\"@id\":\"https://thetaxcalc.com#software\",\"@type\":\"WebApplication\",\"name\":\"TheTaxCalc Paycheck Calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/paycheck-calculator\"}},{\"@id\":\"https://thetaxcalc.com#howto\",\"@type\":\"HowTo\",\"name\":\"How to Calculate Your Take-Home Pay\",\"step\":[{\"@type\":\"HowToStep\",\"name\":\"Enter Gross Salary\",\"text\":\"Input your annual, monthly, bi-weekly, weekly, or hourly salary\"},{\"@type\":\"HowToStep\",\"name\":\"Select State\",\"text\":\"Choose IL (4.95%), TX (0%), FL (0%), CA (1%–13.3%), or NY (4%–10.9%)\"},{\"@type\":\"HowToStep\",\"name\":\"Choose Filing Status\",\"text\":\"Select Single, Married, or Head of Household\"},{\"@type\":\"HowToStep\",\"name\":\"Add Pre-Tax Deductions\",\"text\":\"Enter 401(k) and HSA contributions\"},{\"@type\":\"HowToStep\",\"name\":\"View Instant Results\",\"text\":\"See your net take-home pay, effective tax rate, and full deduction breakdown\"}]},{\"@id\":\"https://thetaxcalc.com/#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do I calculate my take-home pay from my salary?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start with your gross salary and chip away at it. Federal income tax uses progressive brackets, so your first dollars are taxed less than your last. Then there's FICA (7.65% for Social Security and Medicare) and whatever your state takes — if you're lucky enough to live in a no-income-tax state, that part's zero. Pre-tax stuff like 401(k) contributions and HSA deposits lower your taxable income for federal and state purposes, but they don't touch FICA. Honestly, the easiest way is just to use a calculator — doing it by hand is a pain.\"}},{\"@type\":\"Question\",\"name\":\"What is FICA and how much does it take from my paycheck?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"FICA is the payroll tax that funds Social Security and Medicare. You pay 6.2% for Social Security (capped at $184,500 in earnings for 2026) and 1.45% for Medicare with no cap. So that's 7.65% total coming out of every paycheck. And if you earn over $200,000, there's an extra 0.9% Medicare surcharge on everything above that. Your employer matches what you pay, but that's their problem — you just see the 7.65% on your pay stub.\"}},{\"@type\":\"Question\",\"name\":\"How much is taken out of a $75,000 salary in taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Roughly speaking, a single filer making $75K will lose about $7,670 to federal tax (after the $16,100 standard deduction), another $5,738 to FICA, and then it depends entirely on where you live. In Texas or Florida? Zero state tax, so you're keeping around $61,600. In Illinois? Subtract another $3,575 and you're closer to $58,000. The state you pick makes a real difference.\"}},{\"@type\":\"Question\",\"name\":\"Does contributing to a 401(k) reduce my taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yep, and it's pretty much the easiest tax win out there. Every dollar you put in a traditional 401(k) drops your taxable income by a dollar for federal and state tax purposes (though not for FICA). Toss in $10,000 on a $75K salary and you're only taxed on $65K — that could save you over $2,200 in federal tax alone if you're in the 22% bracket. The 2026 limit is $24,500 if you want to go hard.\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between effective tax rate and marginal tax rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Here's the thing — they sound similar but they're completely different. Your effective rate is your overall average: total tax divided by gross income. Your marginal rate is what hits your last dollar earned, meaning the top bracket you fall into. So someone making $75K has a marginal rate of 22%, but their effective federal rate is more like 11–12% because the first chunk of income gets taxed at way lower rates. People mix these up all the time and it leads to bad decisions.\"}},{\"@type\":\"Question\",\"name\":\"What is the 2026 standard deduction?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For 2026, the federal standard deduction is $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household. The standard deduction reduces your taxable income dollar-for-dollar — a single filer earning $75,000 is only taxed on $58,900. Most taxpayers (about 87%) take the standard deduction instead of itemizing because it's higher than their total itemized deductions (SALT, mortgage interest, charity). The OBBBA increased the SALT cap to $40,400 for 2026, which may make itemizing more attractive for taxpayers in high-tax states like California, New York, and New Jersey.\"}},{\"@type\":\"Question\",\"name\":\"When are 2026 taxes due?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For the 2026 tax year (income earned January 1 – December 31, 2026), your federal tax return is due on Tuesday, April 15, 2027. If you file for an extension with Form 4868, you get until October 15, 2027 to file — but any taxes you owe are still due by April 15. Quarterly estimated tax payments for self-employed individuals are due April 15, June 15, September 15, 2026, and January 15, 2027. State income tax deadlines vary by state but typically align with the federal April 15 deadline.\"}},{\"@type\":\"Question\",\"name\":\"How much is $75,000 a year after taxes in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On a $75,000 salary in 2026, your take-home pay depends on your state. After federal income tax ($7,670 for single filers) and FICA ($5,738), you keep about $61,592 in no-income-tax states like Texas, Florida, Washington, Nevada, and Wyoming. In Illinois (4.95% flat), you keep about $58,017. In California (1%–13.3%), take-home drops to around $54,849. In New York (4%–10.9%), about $55,413. Use our paycheck calculator above to see exact numbers for your state and filing status.\"}},{\"@type\":\"Question\",\"name\":\"How to calculate federal income tax step by step?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"To calculate your 2026 federal income tax: (1) Start with your gross income (wages, salary, self-employment income). (2) Subtract pre-tax deductions like 401(k) contributions and HSA. (3) Subtract the standard deduction ($16,100 single / $32,200 married). (4) Apply the 2026 federal tax brackets progressively — 10% on the first $11,600, then 12%, 22%, 24%, 32%, 35%, and 37% as income increases. (5) Subtract any tax credits (Child Tax Credit $2,200, education credits). (6) Add FICA (7.65%). The result is your total tax liability. Our paycheck calculator does all of this instantly for all 50 states.\"}},{\"@type\":\"Question\",\"name\":\"What is OASDI tax and how much is it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OASDI stands for Old-Age, Survivors, and Disability Insurance — it's the official name for Social Security tax. OASDI tax is 6.2% of your wages up to the 2026 wage cap of $184,500. Your employer matches this 6.2%, for a total of 12.4% sent to the Social Security Administration. OASDI is part of FICA (Federal Insurance Contributions Act), which also includes Medicare tax at 1.45% with no wage cap. Together, FICA totals 7.65% of your paycheck. If you earn over $200,000, an additional 0.9% Medicare surtax applies. Use our paycheck calculator above to see exactly how much OASDI tax comes out of your salary.\"}},{\"@type\":\"Question\",\"name\":\"How to check amended tax return status?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"To check your amended tax return status (Form 1040-X), use the IRS 'Where's My Amended Return?' tool at IRS.gov/individuals/where-s-my-amended-return. You'll need your Social Security number, date of birth, and ZIP code. Amended returns take up to 16 weeks to process (up from 8 weeks in prior years). You can also call the IRS amended return hotline at 866-464-2050, but wait at least 3 weeks after mailing your Form 1040-X before checking. If you filed electronically, the IRS typically processes amendments faster than paper-filed ones. Note: amended returns cannot be tracked through the standard 'Where's My Refund?' tool — only through the dedicated amended return tracker.\"}}]}]}</script><nav aria-label=\"Breadcrumb\" class=\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\"><a class=\"hover:text-foreground transition-colors\" href=\"/\">Home</a><span class=\"text-muted-foreground\" aria-hidden=\"true\">/</span><span class=\"text-foreground font-medium\">Paycheck Calculator</span></nav><div class=\"mb-4 flex justify-center\"><div class=\"flex items-center gap-2\"><span class=\"flex items-center gap-1.5 text-xs text-muted-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-share2 lucide-share-2 h-3.5 w-3.5\" aria-hidden=\"true\"><circle cx=\"18\" cy=\"5\" r=\"3\"></circle><circle cx=\"6\" cy=\"12\" r=\"3\"></circle><circle cx=\"18\" cy=\"19\" r=\"3\"></circle><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"></line><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"></line></svg>Share:</span><a href=\"https://twitter.com/intent/tweet?text=Free%202026%20Paycheck%20Calculator%20%E2%80%94%20Federal%2C%20FICA%20%26%20State%20Tax&amp;url=https%3A%2F%2Fthetaxcalc.com%2Fpaycheck-calculator&amp;via=TheTaxCalc\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center justify-center rounded-lg border border-border/30 p-2 transition-all hover:bg-sky-500/10 hover:text-sky-400 hover:border-sky-500/30\" aria-label=\"Share on Twitter / X\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-twitter h-4 w-4\" aria-hidden=\"true\"><path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\"></path></svg></a><a href=\"https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fthetaxcalc.com%2Fpaycheck-calculator\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center justify-center rounded-lg border border-border/30 p-2 transition-all hover:bg-blue-500/10 hover:text-blue-400 hover:border-blue-500/30\" aria-label=\"Share on LinkedIn\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-linkedin h-4 w-4\" aria-hidden=\"true\"><path d=\"M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z\"></path><rect width=\"4\" height=\"12\" x=\"2\" y=\"9\"></rect><circle cx=\"4\" cy=\"4\" r=\"2\"></circle></svg></a><button data-slot=\"button\" class=\"justify-center whitespace-nowrap font-medium disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:text-accent-foreground dark:hover:bg-accent/50 h-8 has-[&gt;svg]:px-2.5 inline-flex items-center gap-1.5 rounded-lg border border-border/30 px-3 py-2 text-xs transition-all hover:bg-muted/50\" aria-label=\"Copy link\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-link2 lucide-link-2 h-3.5 w-3.5\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"></path><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"></path><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line></svg>Copy Link</button></div></div><div class=\"mb-8 text-center\"><h1 class=\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\">Free Paycheck Calculator</h1><p class=\"mt-2 text-muted-foreground max-w-2xl mx-auto\">Free paycheck tax calculator for 2026. Calculate take-home pay after federal, FICA &amp; state taxes. No sign-up required. Supports IL, TX, FL, CA, NY with 401(k) and HSA deductions.</p><p class=\"mt-2 text-xs text-muted-foreground\">Last reviewed: January 2026 · Tax data verified against IRS Publication 15-T &amp; state revenue departments</p></div><!--$!--><template data-dgst=\"BAILOUT_TO_CLIENT_SIDE_RENDERING\"></template><div class=\"space-y-6\"><div class=\"grid gap-6 lg:grid-cols-5\"><div class=\"space-y-4 lg:col-span-3\"><div class=\"rounded-xl border border-border/30 bg-card/50 p-6\"><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-6 w-40 mb-4\"></div><div class=\"space-y-4\"><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-10 w-full\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-10 w-full\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-10 w-2/3\"></div></div></div></div><div class=\"lg:col-span-2\"><div class=\"rounded-xl border border-border/30 bg-card/50 p-6\"><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-6 w-32 mb-4\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-20 w-full mb-4\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-4 w-full\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-4 w-3/4\"></div><div data-slot=\"skeleton\" class=\"bg-accent animate-pulse rounded-md h-4 w-1/2\"></div></div></div></div></div><!--/$--><section class=\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\"><h2 class=\"text-lg font-semibold text-foreground mb-3\">Related Tools &amp; Resources</h2><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2\"><a class=\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\" href=\"/401k-retirement-calculator\"><span>🏦</span><div><span class=\"text-sm font-medium text-foreground\">401(k) Planner</span><p class=\"text-xs text-muted-foreground\">Reduce taxable income with pre-tax contributions</p></div></a><a class=\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\" href=\"/compare\"><span>📊</span><div><span class=\"text-sm font-medium text-foreground\">Compare States</span><p class=\"text-xs text-muted-foreground\">See how your take-home compares across states</p></div></a><a class=\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\" href=\"/self-employment-tax-calculator\"><span>💼</span><div><span class=\"text-sm font-medium text-foreground\">Self-Employment Tax</span><p class=\"text-xs text-muted-foreground\">Freelancer? Calculate your SE tax</p></div></a><a class=\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\" href=\"/salary\"><span>💰</span><div><span class=\"text-sm font-medium text-foreground\">Salary After Tax</span><p class=\"text-xs text-muted-foreground\">Take-home pay for every salary level</p></div></a></div></section><div class=\"mt-12 space-y-10\"><section class=\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">How This Calculator Works</h2><div class=\"space-y-4\"><p class=\"text-muted-foreground leading-relaxed\">Look at your pay stub sometime. That number at the bottom — the one that actually hits your bank — is way smaller than the number at the top. This calculator tells you why, line by line. All withholding calculations follow <a href=\"https://www.irs.gov/publications/p15t\" target=\"_blank\" rel=\"noopener noreferrer\">IRS Publication 15-T</a>.</p><p class=\"text-muted-foreground leading-relaxed\">Here's what comes out of every paycheck. Federal tax uses progressive brackets from 10% up to 37%, with standard deductions of $16,100 (single) or $32,200 (married). Then <a href=\"/glossary\">FICA</a>: 6.2% for Social Security on income up to $184,500, and 1.45% for Medicare on everything. Make over $200,000? Add another 0.9% Medicare surtax on the amount above that.</p><p class=\"text-muted-foreground leading-relaxed\">My buddy in Chicago and I compared stubs once. Same salary, same filing status. He walked away with about $3,800 less for the year because Illinois takes 4.95% and my state takes nothing. That's when it hit me — state tax is not a small factor. We cover five states here: Illinois at 4.95% flat, Texas at 0%, Florida at 0%, California at 1%–13.3% progressive, and New York at 4%–10.9% plus a potential NYC tax.</p><p class=\"text-muted-foreground leading-relaxed\">A couple things that help soften the blow:<br/>- <a href=\"/401k-retirement-calculator\">401(k) contributions</a> reduce taxable income at both federal and state level<br/>- HSA contributions do the same<br/>- These pre-tax deductions are basically a discount on your tax bill</p><p class=\"text-muted-foreground leading-relaxed\">Bottom line — you'll see your net pay, effective tax rate, and marginal rate. Most people think their effective rate is higher than it actually is. Go ahead, see for yourself.</p></div></section><section class=\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">How It&#x27;s Calculated</h2><div class=\"space-y-5\"><div><h3 class=\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\">Formula</h3><div class=\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\">Net Pay = Gross Income − (Federal Tax + State Tax + FICA + Pre-tax Deductions)</div></div><div><h3 class=\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\">Step-by-Step</h3><ol class=\"space-y-2\"><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">1</span><span class=\"leading-relaxed\">Subtract pre-tax deductions (401(k), HSA) from gross income to get adjusted gross</span></li><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">2</span><span class=\"leading-relaxed\">Apply the standard deduction ($16,100 single / $32,200 married) to get taxable income</span></li><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">3</span><span class=\"leading-relaxed\">Calculate federal tax using progressive brackets (10%–37%) per IRS Publication 15-T</span></li><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">4</span><span class=\"leading-relaxed\">Calculate state tax using the selected state&#x27;s brackets or flat rate</span></li><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">5</span><span class=\"leading-relaxed\">Calculate FICA: 6.2% Social Security (up to $184,500) + 1.45% Medicare (no cap)</span></li><li class=\"flex gap-3 text-sm text-muted-foreground\"><span class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\">6</span><span class=\"leading-relaxed\">Subtract all taxes and deductions from gross pay to get net take-home pay</span></li></ol></div><div><h3 class=\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\">Example</h3><div class=\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\">A single filer in Texas earning $75,000/year: Standard deduction of $16,100 leaves $58,900 taxable. Federal tax ≈ $7,670. FICA = $5,738. State tax = $0. Net pay ≈ $61,592/year.</div></div><p class=\"text-xs text-muted-foreground\">For detailed data sources and full methodology, see our <a class=\"text-emerald-400 hover:text-emerald-300 underline\" href=\"/methodology\">Methodology &amp; Data Sources</a> page.</p></div></section><section class=\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Key Rates &amp; Data for 2026</h2><div class=\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\"><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\">Federal Tax Brackets</p><p class=\"text-base font-bold text-foreground\">10% – 37%</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\">Standard Deduction (Single)</p><p class=\"text-base font-bold text-foreground\">$16,100</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\">Social Security Rate</p><p class=\"text-base font-bold text-foreground\">6.2% (up to $184,500)</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\">Medicare Rate</p><p class=\"text-base font-bold text-foreground\">1.45% (no cap)</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\">Additional Medicare Tax</p><p class=\"text-base font-bold text-foreground\">0.9% (above $200K)</p></div></div></section><section><h2 class=\"text-2xl font-bold text-foreground mb-6\">Paycheck Calculator FAQ</h2><div class=\"space-y-3\"><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">How do I calculate my take-home pay from my salary?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">Start with your gross salary and chip away at it. Federal income tax uses progressive brackets, so your first dollars are taxed less than your last. Then there&#x27;s FICA (7.65% for Social Security and Medicare) and whatever your state takes — if you&#x27;re lucky enough to live in a no-income-tax state, that part&#x27;s zero. Pre-tax stuff like 401(k) contributions and HSA deposits lower your taxable income for federal and state purposes, but they don&#x27;t touch FICA. Honestly, the easiest way is just to use a calculator — doing it by hand is a pain.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">What is FICA and how much does it take from my paycheck?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">FICA is the payroll tax that funds Social Security and Medicare. You pay 6.2% for Social Security (capped at $184,500 in earnings for 2026) and 1.45% for Medicare with no cap. So that&#x27;s 7.65% total coming out of every paycheck. And if you earn over $200,000, there&#x27;s an extra 0.9% Medicare surcharge on everything above that. Your employer matches what you pay, but that&#x27;s their problem — you just see the 7.65% on your pay stub.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">How much is taken out of a $75,000 salary in taxes?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">Roughly speaking, a single filer making $75K will lose about $7,670 to federal tax (after the $16,100 standard deduction), another $5,738 to FICA, and then it depends entirely on where you live. In Texas or Florida? Zero state tax, so you&#x27;re keeping around $61,600. In Illinois? Subtract another $3,575 and you&#x27;re closer to $58,000. The state you pick makes a real difference.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">Does contributing to a 401(k) reduce my taxes?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">Yep, and it&#x27;s pretty much the easiest tax win out there. Every dollar you put in a traditional 401(k) drops your taxable income by a dollar for federal and state tax purposes (though not for FICA). Toss in $10,000 on a $75K salary and you&#x27;re only taxed on $65K — that could save you over $2,200 in federal tax alone if you&#x27;re in the 22% bracket. The 2026 limit is $24,500 if you want to go hard.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">What is the difference between effective tax rate and marginal tax rate?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">Here&#x27;s the thing — they sound similar but they&#x27;re completely different. Your effective rate is your overall average: total tax divided by gross income. Your marginal rate is what hits your last dollar earned, meaning the top bracket you fall into. So someone making $75K has a marginal rate of 22%, but their effective federal rate is more like 11–12% because the first chunk of income gets taxed at way lower rates. People mix these up all the time and it leads to bad decisions.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">What is the 2026 standard deduction?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">For 2026, the federal standard deduction is $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household. The standard deduction reduces your taxable income dollar-for-dollar — a single filer earning $75,000 is only taxed on $58,900. Most taxpayers (about 87%) take the standard deduction instead of itemizing because it&#x27;s higher than their total itemized deductions (SALT, mortgage interest, charity). The OBBBA increased the SALT cap to $40,400 for 2026, which may make itemizing more attractive for taxpayers in high-tax states like California, New York, and New Jersey.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">When are 2026 taxes due?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">For the 2026 tax year (income earned January 1 – December 31, 2026), your federal tax return is due on Tuesday, April 15, 2027. If you file for an extension with Form 4868, you get until October 15, 2027 to file — but any taxes you owe are still due by April 15. Quarterly estimated tax payments for self-employed individuals are due April 15, June 15, September 15, 2026, and January 15, 2027. State income tax deadlines vary by state but typically align with the federal April 15 deadline.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">How much is $75,000 a year after taxes in 2026?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">On a $75,000 salary in 2026, your take-home pay depends on your state. After federal income tax ($7,670 for single filers) and FICA ($5,738), you keep about $61,592 in no-income-tax states like Texas, Florida, Washington, Nevada, and Wyoming. In Illinois (4.95% flat), you keep about $58,017. In California (1%–13.3%), take-home drops to around $54,849. In New York (4%–10.9%), about $55,413. Use our paycheck calculator above to see exact numbers for your state and filing status.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">How to calculate federal income tax step by step?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">To calculate your 2026 federal income tax: (1) Start with your gross income (wages, salary, self-employment income). (2) Subtract pre-tax deductions like 401(k) contributions and HSA. (3) Subtract the standard deduction ($16,100 single / $32,200 married). (4) Apply the 2026 federal tax brackets progressively — 10% on the first $11,600, then 12%, 22%, 24%, 32%, 35%, and 37% as income increases. (5) Subtract any tax credits (Child Tax Credit $2,200, education credits). (6) Add FICA (7.65%). The result is your total tax liability. Our paycheck calculator does all of this instantly for all 50 states.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">What is OASDI tax and how much is it?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">OASDI stands for Old-Age, Survivors, and Disability Insurance — it&#x27;s the official name for Social Security tax. OASDI tax is 6.2% of your wages up to the 2026 wage cap of $184,500. Your employer matches this 6.2%, for a total of 12.4% sent to the Social Security Administration. OASDI is part of FICA (Federal Insurance Contributions Act), which also includes Medicare tax at 1.45% with no wage cap. Together, FICA totals 7.65% of your paycheck. If you earn over $200,000, an additional 0.9% Medicare surtax applies. Use our paycheck calculator above to see exactly how much OASDI tax comes out of your salary.</div></details><details class=\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\"><summary class=\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\"><h3 class=\"text-sm sm:text-base\">How to check amended tax return status?</h3><svg class=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M19 9l-7 7-7-7\"></path></svg></summary><div class=\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\">To check your amended tax return status (Form 1040-X), use the IRS &#x27;Where&#x27;s My Amended Return?&#x27; tool at IRS.gov/individuals/where-s-my-amended-return. You&#x27;ll need your Social Security number, date of birth, and ZIP code. Amended returns take up to 16 weeks to process (up from 8 weeks in prior years). You can also call the IRS amended return hotline at 866-464-2050, but wait at least 3 weeks after mailing your Form 1040-X before checking. If you filed electronically, the IRS typically processes amendments faster than paper-filed ones. Note: amended returns cannot be tracked through the standard &#x27;Where&#x27;s My Refund?&#x27; tool — only through the dedicated amended return tracker.</div></details></div></section><section class=\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\"><p class=\"text-lg font-semibold text-foreground mb-4\">Related Articles</p><div class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\"><a class=\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\" href=\"/blog/2026-federal-tax-brackets-explained\"><h3 class=\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\">2026 Tax Brackets: IRS Income Tax Brackets 2026 Explained</h3><p class=\"text-xs text-muted-foreground leading-relaxed line-clamp-2\">Complete guide to the IRS 2026 tax brackets — income tax brackets 2026, marginal tax rate, federal income tax rates, adjusted gross income, and tax credits for married couples filing jointly.</p></a><a class=\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\" href=\"/blog/how-fica-taxes-work-2026\"><h3 class=\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\">How FICA Taxes Work in 2026</h3><p class=\"text-xs text-muted-foreground leading-relaxed line-clamp-2\">Understanding FICA taxes (Social Security and Medicare) in 2026 — what you pay, what your employer pays, and how self-employment tax differs.</p></a></div></section><section class=\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\"><p class=\"text-lg font-semibold text-foreground mb-4\">Related Calculators</p><div class=\"flex flex-wrap gap-3\"><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/illinois-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Illinois Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/texas-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Texas Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/florida-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Florida Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/california-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>California Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/new-york-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>New York Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/self-employment-tax-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Self-Employment Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/401k-retirement-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>401(k) Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/relocation-calculator\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Relocation Calculator</a><a class=\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\" href=\"/salary\"><svg class=\"h-3.5 w-3.5\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13 7l5 5m0 0l-5 5m5-5H6\"></path></svg>Salary After Tax</a></div></section><div class=\"mt-8\"><div class=\"rounded-xl border border-border/30 bg-card/50 p-5\"><div class=\"flex items-center gap-2 mb-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-link2 lucide-link-2 h-4 w-4 text-emerald-400\" aria-hidden=\"true\"><path d=\"M9 17H7A5 5 0 0 1 7 7h2\"></path><path d=\"M15 7h2a5 5 0 1 1 0 10h-2\"></path><line x1=\"8\" x2=\"16\" y1=\"12\" y2=\"12\"></line></svg><h3 class=\"text-sm font-semibold text-foreground\">Link to This Calculator</h3></div><p class=\"text-xs text-muted-foreground mb-3\">Help others find this free tool — add a link