-sm font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Relocation Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Salary you'd need if you move to another state\"}]]}]]}],[\"$\",\"$L10\",null,{\"href\":\"/401k-retirement-calculator\",\"className\":\"group flex items-start gap-3 rounded-lg border border-border/50 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-lg\",\"children\":\"📈\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"401(k) Calculator\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Project your retirement savings with compound growth\"}]]}]]}],[\"$\",\"$L10\",null,{\"href\":\"/glossary\",\"className\":\"group flex items-start gap-3 rounded-lg border border-border/50 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-lg\",\"children\":\"📖\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Tax Glossary\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Key tax terms explained in plain English\"}]]}]]}],[\"$\",\"$L10\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"group flex items-start gap-3 rounded-lg border border-border/50 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-lg\",\"children\":\"📋\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Tax Brackets 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground mt-0.5\",\"children\":\"Full federal bracket breakdown with examples\"}]]}]]}]]}]]}]\n36:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Explore More Tools\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/compare\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📊 Compare States\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Side-by-side tax comparison\"}]]}],[\"$\",\"$L10\",null,{\"href\":\"/salary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"💰 Salary After Tax\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home for $30K–$500K\"}]]}],[\"$\",\"$L10\",null,{\"href\":\"/federal-tax-brackets\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📋 Tax Brackets 2026\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Federal brackets & rates\"}]]}],[\"$\",\"$L10\",null,{\"href\":\"/glossary\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📖 Tax Glossary\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Key terms explained\"}]]}],[\"$\",\"$L10\",null,{\"href\":\"/blog\",\"className\":\"flex items-center gap-2 rounded-lg border border-border/50 p-3 hover:bg-accent/50 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium\",\"children\":\"📝 Tax Guides & Blog\"}],[\"$\",\"span\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Expert tax tips & guides\"}]]}]]}]]}]\n37:[\"$\",\"details\",\"3\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Does contributing to a 401(k) reduce my taxes?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yep, and it's pretty much the easiest tax win out there. Every dollar you put in a traditional 401(k) drops your taxable income by a dollar for federal and state tax purposes (though not for FICA). Toss in $10,000 on a $75K salary and you're only taxed on $65K — that could save you over $2,200 in federal tax alone if you're in the 22% bracket. The 2026 limit is $24,500 if you want to go hard.\"}]]}]\n38:[\"$\",\"details\",\"4\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the difference between effective tax rate and marginal tax rate?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Here's the thing — they sound similar but they're completely different. Your effective rate is your overall average: total tax divided by gross income. Your marginal rate is what hits your last dollar earned, meaning the top bracket you fall into. So someone making $75K has a marginal rate of 22%, but their effective federal rate is more like 11–12% because the first chunk of income gets taxed at way lower rates. People mix these up all the time and it leads to bad decisions.\"}]]}]\n39:[\"$\",\"details\",\"5\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is the 2026 standard deduction?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"For 2026, the federal standard deduction is $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household. The standard deduction reduces your taxable income dollar-for-dollar — a single filer earning $75,000 is only taxed on $58,900. Most taxpayers (about 87%) take the standard deduction instead of itemizing because it's higher than their total itemized deductions (SALT, mortgage interest, charity). The OBBBA increased the SALT cap to $40,400 for 2026, which may make itemizing more attractive for taxpayers in high-tax states like California, New York, and New Jersey.\"}]]}]\n3a:[\"$\",\"details\",\"6\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"When are 2026 taxes due?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"For the 2026 tax year (income earned January 1 – December 31, 2026), your federal tax return is due on Tuesday, April 15, 2027. If you file for an extension with Form 4868, you get until October 15, 2027 to file — but any taxes you owe are still due by April 15. Quarterly estimated tax payments for self-employed individuals are due April 15, June 15, September 15, 2026, and January 15, 2027. State income tax deadlines vary by state but typically align with the federal April 15 deadline.\"}]]}]\n3b:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much is $75,000 a year after taxes in 2026?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"On a $75,000 salary in 2026, your take-home pay depends on your state. After federal income tax ($7,670 for single filers) and FICA ($5,738), you keep about $61,592 in no-income-tax states like Texas, Florida, Washington, Nevada, and Wyoming. In Illinois (4.95% flat), you keep about $58,017. In California (1%–13.3%), take-home drops to around $54,849. In New York (4%–10.9%), about $55,413. Use our paycheck calculator above to see exact numbers for your state and filing status.\"}]]}]\n3c:[\"$\",\"details\",\"8\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How to calculate federal income tax step by step?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"To calculate your 2026 federal income tax: (1) Start with your gross income (wages, salary, self-employment income). (2) Subtract pre-tax deductions like 401(k) contributions and HSA. (3) Subtract the standard deduction ($16,100 single / $32,200 married). (4) Apply the 2026 federal tax brackets progressively — 10% on the first $11,600, then 12%, 22%, 24%, 32%, 35%, and 37% as income increases. (5) Subtract any tax credits (Child Tax Credit $2,200, education credits). (6) Add FICA (7.65%). The result is your total tax liability. Our paycheck calculator does all of this instantly for all 50 states.\"}]]}]\n3d:[\"$\",\"details\",\"9\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is OASDI tax and how much is it?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"OASDI stands for Old-Age, Survivors, and Disability Insurance — it's the official name for Social Security tax. OASDI tax is 6.2% of your wages up to the 2026 wage cap of $184,500. Your employer matches this 6.2%, for a total of 12.4% sent to the Social Security Administration. OASDI is part of FICA (Federal Insurance Contributions Act), which also includes Medicare tax at 1.45% with no wage cap. Together, FICA totals 7.65% of your paycheck. If you earn over $200,000, an additional 0.9% Medicare surtax applies. Use our paycheck calculator above to see exactly how much OASDI tax comes out of your salary.\"}]]}]\n3e:[\"$\",\"details\",\"10\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How to check amended tax return status?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"To check your amended tax return status (Form 1040-X), use the IRS 'Where's My Amended Return?' tool at IRS.gov/individuals/where-s-my-amended-return. You'll need your Social Security number, date of birth, and ZIP code. Amended returns take up to 16 weeks to process (up from 8 weeks in prior years). You can also call the IRS amended return hotline at 866-464-2050, but wait at least 3 weeks after mailing your Form 1040-X before checking. If you filed electronically, the IRS typically processes amendments faster than paper-filed ones. Note: amended returns cannot be tracked through the standard 'Where's My Refund?' tool — only through the dedicated amended return tracker.\"}]]}]\n3f:[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}]\n40:[\"$\",\"$L10\",\"relocation-calculator\",{\"href\":\"/relocation-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Relocation Calculator\"]}]\n41:[\"$\",\"$L10\",\"salary\",{\"href\":\"/salary\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"h-3.5 w-3.5\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M13 7l5 5m0 0l-5 5m5-5H6\"}]}],\"Salary After Tax\"]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n43:I[27201,[\"/_next/static/chunks/ff1a16fafef87110.js\",\"/_next/static/chunks/61cc43b3d7ad2990.js\"],\"IconMark\"]\n18:null\n1c:[[\"$\",\"title\",\"0\",{\"children\":\"Free Paycheck Calculator 2026 | After-Tax Take-Home Pay\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Free paycheck tax calculator for 2026. Calculate take-home pay after federal, FICA & state taxes. No sign-up. Covers IL, TX, FL, CA, NY.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"author\",\"content\":\"Rachel Mitchell, CPA\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"free paycheck tax calculator,free tax calculator for paycheck,free tax calculator federal and state,free tax calculator for 2026,take home pay calculator,salary calculator,after tax salary,net pay calculator,2026 paycheck calculator,FICA calculator,federal tax calculator,free tax calculator no sign up,free tax calculator online\"}],[\"$\",\"meta\",\"4\",{\"name\":\"creator\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"5\",{\"name\":\"publisher\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"6\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"7\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"meta\",\"8\",{\"name\":\"category\",\"content\":\"finance\"}],[\"$\",\"meta\",\"9\",{\"name\":\"classification\",\"content\":\"Tax Calculator\"}],[\"$\",\"link\",\"10\",{\"rel\":\"canonical\",\"href\":\"https://thetaxcalc.com/paycheck-calculator\"}],[\"$\",\"meta\",\"11\",{\"name\":\"google-site-verification\",\"content\":\"verify_google_site_verification_token\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:title\",\"content\":\"Free Paycheck Calculator 2026 | After-Tax Take-Home Pay\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:description\",\"content\":\"Free paycheck tax calculator for 2026. Take-home pay after federal, FICA & state taxes. No sign-up. IL, TX, FL, CA, NY.\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:url\",\"content\":\"https://thetaxcalc.com/paycheck-calculator\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:site_name\",\"content\":\"TheTaxCalc\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:locale\",\"content\":\"en_US\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://thetaxcalc.com/opengraph-image.png\"}],[\"$\",\"meta\",\"18\",{\"property\":\"