emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Texas\"}],[\"$\",\"$L10\",\"/florida-tax-calculator\",{\"href\":\"/florida-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Florida\"}],[\"$\",\"$L10\",\"/california-tax-calculator\",{\"href\":\"/california-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"California\"}],[\"$\",\"$L10\",\"/new-york-tax-calculator\",{\"href\":\"/new-york-tax-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"New York\"}],[\"$\",\"$L10\",\"/mortgage-calculator\",{\"href\":\"/mortgage-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Mortgage\"}],[\"$\",\"$L10\",\"/capital-gains-calculator\",{\"href\":\"/capital-gains-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Capital Gains\"}],[\"$\",\"$L10\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"401(k)\"}],[\"$\",\"$L10\",\"/blog\",{\"href\":\"/blog\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Blog\"}],[\"$\",\"$L10\",\"/glossary\",{\"href\":\"/glossary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Glossary\"}],[\"$\",\"$L10\",\"/compare\",{\"href\":\"/compare\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Compare States\"}],[\"$\",\"$L10\",\"/salary\",{\"href\":\"/salary\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Salary Explorer\"}],[\"$\",\"$L10\",\"/federal-tax-brackets\",{\"href\":\"/federal-tax-brackets\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"Tax Brackets\"}],[\"$\",\"$L10\",\"/about\",{\"href\":\"/about\",\"className\":\"rounded-full border border-border/30 bg-card/30 px-3 py-1 text-muted-foreground hover:text-emerald-400 hover:border-emerald-500/30 transition-colors\",\"children\":\"About\"}]]}]\n14:[\"$\",\"$L1d\",null,{}]\n1e:T2843,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@id\":\"https://thetaxcalc.com#webpage\",\"@type\":\"WebPage\",\"name\":\"Paycheck Calculator — Federal, FICA & State Tax Take-Home Pay\",\"description\":\"Free 2026 paycheck calculator. Instantly compute your take-home pay after federal tax, FICA (Social Security + Medicare), and state income tax deductions.\",\"url\":\"https://thetaxcalc.com/paycheck-calculator\",\"inLanguage\":\"en-US\",\"dateModified\":\"2026-06-25\",\"author\":{\"@id\":\"https://thetaxcalc.com/#author\"},\"publisher\":{\"@id\":\"https://thetaxcalc.com/#organization\"},\"breadcrumb\":{\"@id\":\"https://thetaxcalc.com#breadcrumb\"}},{\"@id\":\"https://thetaxcalc.com#breadcrumb\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://thetaxcalc.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Paycheck Calculator\"}]},{\"@id\":\"https://thetaxcalc.com#software\",\"@type\":\"WebApplication\",\"name\":\"TheTaxCalc Paycheck Calculator\",\"applicationCategory\":\"FinanceApplication\",\"operatingSystem\":\"Web\",\"offers\":{\"@type\":\"Offer\",\"price\":0,\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://thetaxcalc.com/paycheck-calculator\"}},{\"@id\":\"https://thetaxcalc.com#howto\",\"@type\":\"HowTo\",\"name\":\"How to Calculate Your Take-Home Pay\",\"step\":[{\"@type\":\"HowToStep\",\"name\":\"Enter Gross Salary\",\"text\":\"Input your annual, monthly, bi-weekly, weekly, or hourly salary\"},{\"@type\":\"HowToStep\",\"name\":\"Select State\",\"text\":\"Choose IL (4.95%), TX (0%), FL (0%), CA (1%–13.3%), or NY (4%–10.9%)\"},{\"@type\":\"HowToStep\",\"name\":\"Choose Filing Status\",\"text\":\"Select Single, Married, or Head of Household\"},{\"@type\":\"HowToStep\",\"name\":\"Add Pre-Tax Deductions\",\"text\":\"Enter 401(k) and HSA contributions\"},{\"@type\":\"HowToStep\",\"name\":\"View Instant Results\",\"text\":\"See your net take-home pay, effective tax rate, and full deduction breakdown\"}]},{\"@id\":\"https://thetaxcalc.com/#author\",\"@type\":\"Person\",\"name\":\"Rachel Mitchell\",\"url\":\"https://thetaxcalc.com/about#rachel-mitchell\",\"jobTitle\":\"Lead Tax Analyst & Editorial Director, CPA\",\"description\":\"Rachel Mitchell is a Certified Public Accountant (CPA) licensed in Illinois with over 12 years of experience in individual and small-business taxation. She specializes in federal and state income tax compliance, FICA optimization, payroll tax strategy, and multi-state tax planning. Rachel holds an MS in Taxation from Golden Gate University and a BS in Accounting from the University of Illinois Urbana-Champaign. She is an active member of the American Institute of Certified Public Accountants (AICPA) and the Illinois CPA Society. Before joining TheTaxCalc, Rachel spent 8 years at a Big Four accounting firm advising high-net-worth clients on tax-efficient wealth strategies.\",\"knowsAbout\":[\"Federal Income Tax\",\"State Income Tax\",\"FICA Tax\",\"Payroll Tax\",\"IRS Compliance\",\"Tax Planning\",\"Multi-State Taxation\",\"Tax-Advantaged Accounts\"],\"sameAs\":[\"https://www.linkedin.com/in/rachelmitchellcpa/\",\"https://www.aicpa-cima.com/\"],\"worksFor\":{\"@type\":\"Organization\",\"name\":\"TheTaxCalc\",\"url\":\"https://thetaxcalc.com\"},\"image\":\"https://thetaxcalc.com/author-rachel-mitchell.webp\"},{\"@id\":\"https://thetaxcalc.com#faq\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How do I calculate my take-home pay from my salary?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start with your gross salary and chip away at it. Federal income tax uses progressive brackets, so your first dollars are taxed less than your last. Then there's FICA (7.65% for Social Security and Medicare) and whatever your state takes — if you're lucky enough to live in a no-income-tax state, that part's zero. Pre-tax stuff like 401(k) contributions and HSA deposits lower your taxable income for federal and state purposes, but they don't touch FICA. Honestly, the easiest way is just to use a calculator — doing it by hand is a pain.\"}},{\"@type\":\"Question\",\"name\":\"What is FICA and how much does it take from my paycheck?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"FICA is the payroll tax that funds Social Security and Medicare. You pay 6.2% for Social Security (capped at $184,500 in earnings for 2026) and 1.45% for Medicare with no cap. So that's 7.65% total coming out of every paycheck. And if you earn over $200,000, there's an extra 0.9% Medicare surcharge on everything above that. Your employer matches what you pay, but that's their problem — you just see the 7.65% on your pay stub.\"}},{\"@type\":\"Question\",\"name\":\"How much is taken out of a $75,000 salary in taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Roughly speaking, a single filer making $75K will lose about $7,670 to federal tax (after the $16,100 standard deduction), another $5,738 to FICA, and then it depends entirely on where you live. In Texas or Florida? Zero state tax, so you're keeping around $61,600. In Illinois? Subtract another $3,575 and you're closer to $58,000. The state you pick makes a real difference.\"}},{\"@type\":\"Question\",\"name\":\"Does contributing to a 401(k) reduce my taxes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yep, and it's pretty much the easiest tax win out there. Every dollar you put in a traditional 401(k) drops your taxable income by a dollar for federal and state tax purposes (though not for FICA). Toss in $10,000 on a $75K salary and you're only taxed on $65K — that could save you over $2,200 in federal tax alone if you're in the 22% bracket. The 2026 limit is $24,500 if you want to go hard.\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between effective tax rate and marginal tax rate?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Here's the thing — they sound similar but they're completely different. Your effective rate is your overall average: total tax divided by gross income. Your marginal rate is what hits your last dollar earned, meaning the top bracket you fall into. So someone making $75K has a marginal rate of 22%, but their effective federal rate is more like 11–12% because the first chunk of income gets taxed at way lower rates. People mix these up all the time and it leads to bad decisions.\"}},{\"@type\":\"Question\",\"name\":\"What is the 2026 standard deduction?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For 2026, the federal standard deduction is $16,100 for single filers, $32,200 for married filing jointly, and $24,150 for head of household. The standard deduction reduces your taxable income dollar-for-dollar — a single filer earning $75,000 is only taxed on $58,900. Most taxpayers (about 87%) take the standard deduction instead of itemizing because it's higher than their total itemized deductions (SALT, mortgage interest, charity). The OBBBA increased the SALT cap to $40,400 for 2026, which may make itemizing more attractive for taxpayers in high-tax states like California, New York, and New Jersey.\"}},{\"@type\":\"Question\",\"name\":\"When are 2026 taxes due?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"For the 2026 tax year (income earned January 1 – December 31, 2026), your federal tax return is due on Tuesday, April 15, 2027. If you file for an extension with Form 4868, you get until October 15, 2027 to file — but any taxes you owe are still due by April 15. Quarterly estimated tax payments for self-employed individuals are due April 15, June 15, September 15, 2026, and January 15, 2027. State income tax deadlines vary by state but typically align with the federal April 15 deadline.\"}},{\"@type\":\"Question\",\"name\":\"How much is $75,000 a year after taxes in 2026?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"On a $75,000 salary in 2026, your take-home pay depends on your state. After federal income tax ($7,670 for single filers) and FICA ($5,738), you keep about $61,592 in no-income-tax states like Texas, Florida, Washington, Nevada, and Wyoming. In Illinois (4.95% flat), you keep about $58,017. In California (1%–13.3%), take-home drops to around $54,849. In New York (4%–10.9%), about $55,413. Use our paycheck calculator above to see exact numbers for your state and filing status.\"}},{\"@type\":\"Question\",\"name\":\"How to calculate federal income tax step by step?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"To calculate your 2026 federal income tax: (1) Start with your gross income (wages, salary, self-employment income). (2) Subtract pre-tax deductions like 401(k) contributions and HSA. (3) Subtract the standard deduction ($16,100 single / $32,200 married). (4) Apply the 2026 federal tax brackets progressively — 10% on the first $11,600, then 12%, 22%, 24%, 32%, 35%, and 37% as income increases. (5) Subtract any tax credits (Child Tax Credit $2,200, education credits). (6) Add FICA (7.65%). The result is your total tax liability. Our paycheck calculator does all of this instantly for all 50 states.\"}},{\"@type\":\"Question\",\"name\":\"What is OASDI tax and how much is it?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"OASDI stands for Old-Age, Survivors, and Disability Insurance — it's the official name for Social Security tax. OASDI tax is 6.2% of your wages up to the 2026 wage cap of $184,500. Your employer matches this 6.2%, for a total of 12.4% sent to the Social Security Administration. OASDI is part of FICA (Federal Insurance Contributions Act), which also includes Medicare tax at 1.45% with no wage cap. Together, FICA totals 7.65% of your paycheck. If you earn over $200,000, an additional 0.9% Medicare surtax applies. Use our paycheck calculator above to see exactly how much OASDI tax comes out of your salary.\"}},{\"@type\":\"Question\",\"name\":\"How to check amended tax return status?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"To check your amended tax return status (Form 1040-X), use the IRS 'Where's My Amended Return?' tool at IRS.gov/individuals/where-s-my-amended-return. You'll need your Social Security number, date of birth, and ZIP code. Amended returns take up to 16 weeks to process (up from 8 weeks in prior years). You can also call the IRS amended return hotline at 866-464-2050, but wait at least 3 weeks after mailing your Form 1040-X before checking. If you filed electronically, the IRS typically processes amendments faster than paper-filed ones. Note: amended returns cannot be tracked through the standard 'Where's My Refund?' tool — only through the dedicated amended return tracker.\"}}]}]}15:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1e\"}}],\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\"]}]\n26:I[79086,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"ShareButtons\"]\n27:I[21862,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorClientPage\"]\n28:I[56848,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"CalculatorScenarioSection\"]\n1f:[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"mb-6 flex items-center gap-1.5 text-sm text-muted-foreground\",\"children\":[[\"$\",\"$L10\",null,{\"href\":\"/\",\"className\":\"hover:text-foreground transition-colors\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground\",\"aria-hidden\":\"true\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-foreground font-medium\",\"children\":\"Paycheck Calculator\"}]]}]\n20:[\"$\",\"div\",null,{\"className\":\"mb-4 flex justify-center\",\"children\":[\"$\",\"$L26\",null,{\"url\":\"https://thetaxcalc.com/paycheck-calculator\",\"title\":\"Free 2026 Paycheck Calculator — Federal, FICA & State Tax\",\"description\":\"Free paycheck tax calculator for 2026. Calculate take-home pay after federal, FICA & state taxes. No sign-up. Covers IL, TX, FL, CA, NY.\"}]}]\n21:[\"$\",\"div\",null,{\"className\":\"mb-8 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Free Paycheck Calculator\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-muted-foreground max-w-2xl mx-auto\",\"children\":\"Free paycheck tax calculator for 2026. Calculate take-home pay after federal, FICA & state taxes. No sign-up required. Supports IL, TX, FL, CA, NY with 401(k) and HSA deductions.\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs text-muted-foreground\",\"children\":\"Last reviewed: January 2026 · Tax data verified against IRS Publication 15-T & state revenue departments\"}]]}]\n22:[\"$\",\"$L27\",null,{\"componentKey\":\"home\"}]\n23:[\"$\",\"$L28\",null,{\"calculatorType\":\"home\",\"calculatorSlug\":\"paycheck-calculator\"}]\n24:[\"$\",\"section\",null,{\"className\":\"mt-8 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"Related Tools & Resources\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-2\",\"children\":[[\"$\",\"$L10\",\"/401k-retirement-calculator\",{\"href\":\"/401k-retirement-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"🏦\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"401(k) Planner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Reduce taxable income with pre-tax contributions\"}]]}]]}],[\"$\",\"$L10\",\"/compare\",{\"href\":\"/compare\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"📊\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Compare States\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"See how your take-home compares across states\"}]]}]]}],[\"$\",\"$L10\",\"/self-employment-tax-calculator\",{\"href\":\"/self-employment-tax-calculator\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💼\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Self-Employment Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Freelancer? Calculate your SE tax\"}]]}]]}],[\"$\",\"$L10\",\"/salary\",{\"href\":\"/salary\",\"className\":\"flex items-start gap-2 rounded-lg p-2 hover:bg-emerald-500/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"children\":\"💰\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm font-medium text-foreground\",\"children\":\"Salary After Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":\"Take-home pay for every salary level\"}]]}]]}]]}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mt-12 space-y-10\",\"children\":[[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How This Calculator Works\"}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Look at your pay stub sometime. That number at the bottom — the one that actually hits your bank — is way smaller than the number at the top. This calculator tells you why, line by line. All withholding calculations follow <a href=\\\"https://www.irs.gov/publications/p15t\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">IRS Publication 15-T</a>.\"}}],[\"$\",\"p\",\"1\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Here's what comes out of every paycheck. Federal tax uses progressive brackets from 10% up to 37%, with standard deductions of $16,100 (single) or $32,200 (married). Then <a href=\\\"/glossary\\\">FICA</a>: 6.2% for Social Security on income up to $184,500, and 1.45% for Medicare on everything. Make over $200,000? Add another 0.9% Medicare surtax on the amount above that.\"}}],[\"$\",\"p\",\"2\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"My buddy in Chicago and I compared stubs once. Same salary, same filing status. He walked away with about $3,800 less for the year because Illinois takes 4.95% and my state takes nothing. That's when it hit me — state tax is not a small factor. We cover five states here: Illinois at 4.95% flat, Texas at 0%, Florida at 0%, California at 1%–13.3% progressive, and New York at 4%–10.9% plus a potential NYC tax.\"}}],[\"$\",\"p\",\"3\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"A couple things that help soften the blow:<br/>- <a href=\\\"/401k-retirement-calculator\\\">401(k) contributions</a> reduce taxable income at both federal and state level<br/>- HSA contributions do the same<br/>- These pre-tax deductions are basically a discount on your tax bill\"}}],[\"$\",\"p\",\"4\",{\"className\":\"text-muted-foreground leading-relaxed\",\"dangerouslySetInnerHTML\":{\"__html\":\"Bottom line — you'll see your net pay, effective tax rate, and marginal rate. Most people think their effective rate is higher than it actually is. Go ahead, see for yourself.\"}}]]}]]}],[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"How It's Calculated\"}],[\"$\",\"div\",null,{\"className\":\"space-y-5\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Formula\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 font-mono text-sm text-foreground\",\"children\":\"Net Pay = Gross Income − (Federal Tax + State Tax + FICA + Pre-tax Deductions)\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Step-by-Step\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":1}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract pre-tax deductions (401(k), HSA) from gross income to get adjusted gross\"}]]}],\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\"]}]]}],\"$L2e\",\"$L2f\"]}]]}],\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",false,\"$L35\",\"$L36\"]}]\n42:I[18274,[\"/_next/static/chunks/49e33bee669819de.js\",\"/_next/static/chunks/868a9c4503c53c54.js\",\"/_next/static/chunks/d791dd6e73034ab4.js\",\"/_next/static/chunks/6bcaf73165d03f74.js\",\"/_next/static/chunks/3c28bbc2a8ff143e.js\",\"/_next/static/chunks/474ace38d7992a17.js\",\"/_next/static/chunks/c9e031433494c7b2.js\"],\"LinkToUs\"]\n29:[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":2}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Apply the standard deduction ($16,100 single / $32,200 married) to get taxable income\"}]]}]\n2a:[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":3}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate federal tax using progressive brackets (10%–37%) per IRS Publication 15-T\"}]]}]\n2b:[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":4}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate state tax using the selected state's brackets or flat rate\"}]]}]\n2c:[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":5}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Calculate FICA: 6.2% Social Security (up to $184,500) + 1.45% Medicare (no cap)\"}]]}]\n2d:[\"$\",\"li\",\"5\",{\"className\":\"flex gap-3 text-sm text-muted-foreground\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-400\",\"children\":6}],[\"$\",\"span\",null,{\"className\":\"leading-relaxed\",\"children\":\"Subtract all taxes and deductions from gross pay to get net take-home pay\"}]]}]\n2e:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold uppercase tracking-wider text-emerald-400 mb-2\",\"children\":\"Example\"}],[\"$\",\"div\",null,{\"className\":\"rounded-lg bg-background/50 border border-border/30 p-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"A single filer in Texas earning $75,000/year: Standard deduction of $16,100 leaves $58,900 taxable. Federal tax ≈ $7,670. FICA = $5,738. State tax = $0. Net pay ≈ $61,592/year.\"}]]}]\n2f:[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"For detailed data sources and full methodology, see our \",[\"$\",\"$L10\",null,{\"href\":\"/methodology\",\"className\":\"text-emerald-400 hover:text-emerald-300 underline\",\"children\":\"Methodology & Data Sources\"}],\" page.\"]}]\n30:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-6 sm:p-8\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-4\",\"children\":\"Key Rates & Data for 2026\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-3 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"div\",\"Federal Tax Brackets\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Federal Tax Brackets\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"10% – 37%\"}]]}],[\"$\",\"div\",\"Standard Deduction (Single)\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Standard Deduction (Single)\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"$$16,100\"}]]}],[\"$\",\"div\",\"Social Security Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Social Security Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"6.2% (up to $184,500)\"}]]}],[\"$\",\"div\",\"Medicare Rate\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Medicare Rate\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"1.45% (no cap)\"}]]}],[\"$\",\"div\",\"Additional Medicare Tax\",{\"className\":\"rounded-lg border border-border/30 bg-card/60 p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1\",\"children\":\"Additional Medicare Tax\"}],[\"$\",\"p\",null,{\"className\":\"text-base font-bold text-foreground\",\"children\":\"0.9% (above $200K)\"}]]}]]}]]}]\n31:[\"$\",\"section\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-foreground mb-6\",\"children\":\"Paycheck Calculator FAQ\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How do I calculate my take-home pay from my salary?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Start with your gross salary and chip away at it. Federal income tax uses progressive brackets, so your first dollars are taxed less than your last. Then there's FICA (7.65% for Social Security and Medicare) and whatever your state takes — if you're lucky enough to live in a no-income-tax state, that part's zero. Pre-tax stuff like 401(k) contributions and HSA deposits lower your taxable income for federal and state purposes, but they don't touch FICA. Honestly, the easiest way is just to use a calculator — doing it by hand is a pain.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"What is FICA and how much does it take from my paycheck?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"FICA is the payroll tax that funds Social Security and Medicare. You pay 6.2% for Social Security (capped at $184,500 in earnings for 2026) and 1.45% for Medicare with no cap. So that's 7.65% total coming out of every paycheck. And if you earn over $200,000, there's an extra 0.9% Medicare surcharge on everything above that. Your employer matches what you pay, but that's their problem — you just see the 7.65% on your pay stub.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-5 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much is taken out of a $75,000 salary in taxes?\"}],[\"$\",\"svg\",null,{\"className\":\"h-4 w-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180\",\"fill\":\"none\",\"viewBox\":\"0 0 24 24\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"children\":[\"$\",\"path\",null,{\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"d\":\"M19 9l-7 7-7-7\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"px-5 pb-5 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Roughly speaking, a single filer making $75K will lose about $7,670 to federal tax (after the $16,100 standard deduction), another $5,738 to FICA, and then it depends entirely on where you live. In Texas or Florida? Zero state tax, so you're keeping around $61,600. In Illinois? Subtract another $3,575 and you're closer to $58,000. The state you pick makes a real difference.\"}]]}],\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\"]}]]}]\n32:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid gap-4 sm:grid-cols-2 lg:grid-cols-3\",\"children\":[[\"$\",\"$L10\",\"2026-federal-tax-brackets-explained\",{\"href\":\"/blog/2026-federal-tax-brackets-explained\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"2026 Tax Brackets: IRS Income Tax Brackets 2026 Explained\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Complete guide to the IRS 2026 tax brackets — income tax brackets 2026, marginal tax rate, federal income tax rates, adjusted gross income, and tax credits for married couples filing jointly.\"}]]}],[\"$\",\"$L10\",\"how-fica-taxes-work-2026\",{\"href\":\"/blog/how-fica-taxes-work-2026\",\"className\":\"group rounded-lg border border-border/30 bg-card/60 p-4 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-sm font-semibold text-foreground group-hover:text-emerald-400 transition-colors mb-1\",\"children\":\"How FICA Taxes Work in 2026\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-muted-foreground leading-relaxed line-clamp-2\",\"children\":\"Understanding FICA taxes (Social Security and Medicare) in 2026 — what you pay, what your employer pays, and how self-employment tax differs.\"}]]}]]}]]}]\n33:[\"$\",\"section\",null,{\"className\":\"rounded-xl border border-border/30 bg-card/50 p-6 sm:p-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-foreground mb-4\",\"children\":\"Related Calculators\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L10\",\"illinois-tax-calculator\",{\"href\":\"/illinois-tax-calculator\",\"className\":\"inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/5 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-500/50 transition-all\",\"children\":[[\"$\",\"