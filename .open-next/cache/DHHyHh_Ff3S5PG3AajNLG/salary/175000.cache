hildren\":[[\"$\",\"span\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"How much federal tax do I pay on $175,000?\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground text-xl group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-4 pb-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"On a $175,000 salary with single filing status and the $16,100 standard deduction, your federal income tax is approximately $30,734. This is calculated using the 2026 progressive brackets — your marginal rate (top bracket) is higher than your effective rate. FICA payroll tax adds another $13,388 (6.2% Social Security + 1.45% Medicare).\"}]]}]\n2d:[\"$\",\"details\",\"7\",{\"className\":\"group rounded-xl border border-border/30 bg-card/50 overflow-hidden\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer items-center justify-between gap-3 p-4 text-left font-medium text-foreground hover:bg-muted/10 transition-colors\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-sm sm:text-base\",\"children\":\"Is $175,000 a good salary?\"}],[\"$\",\"span\",null,{\"className\":\"text-muted-foreground text-xl group-open:rotate-45 transition-transform\",\"children\":\"+\"}]]}],[\"$\",\"div\",null,{\"className\":\"px-4 pb-4 text-sm text-muted-foreground leading-relaxed\",\"children\":\"A $175,000 salary puts you in the top 10-15% of U.S. earners. This is an excellent income that allows for comfortable living and significant savings. In high-tax states like California or New York, you'll feel the impact of progressive brackets — consider maximizing 401(k) contributions to lower your taxable income.\"}]]}]\n2e:[\"$\",\"div\",null,{\"className\":\"font-medium text-foreground group-hover:text-emerald-400 transition-colors\",\"children\":\"Tennessee\"}]\n2f:[\"$\",\"div\",null,{\"className\":\"text-xs text-muted-foreground\",\"children\":[\"$$130,879\",\"/yr\"]}]\n30:[\"$\",\"$L24\