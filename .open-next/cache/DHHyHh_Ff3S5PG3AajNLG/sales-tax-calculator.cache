reground\">1.09%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">7.19%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/30 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/vermont\">Vermont</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">6%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">0.36%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">6.36%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/10 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/virginia\">Virginia</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">4.30%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">1.45%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">5.75%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/30 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/washington\">Washington</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">6.50%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">2.91%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">9.41%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/10 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/westvirginia\">West Virginia</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">6%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">0.55%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">6.55%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/30 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/wisconsin\">Wisconsin</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">5%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">0.46%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">5.46%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr><tr class=\"border-b border-border/20 bg-card/10 hover:bg-muted/20 transition-colors\"><td class=\"px-4 py-2.5\"><a class=\"font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/wyoming\">Wyoming</a></td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">4%</td><td class=\"px-4 py-2.5 text-right text-muted-foreground\">1.36%</td><td class=\"px-4 py-2.5 text-right font-semibold text-foreground\">5.36%</td><td class=\"px-4 py-2.5 text-center\"><span class=\"inline-flex items-center justify-center h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold\" aria-label=\"Yes\">Y</span></td></tr></tbody></table></div><p class=\"mt-3 text-xs text-muted-foreground\">Rates are based on 2026 state tax data. Local rates are averages and may differ by city/county. Always verify with your state department of revenue.</p></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">How to Calculate Sales Tax</h2><div class=\"space-y-6 max-w-4xl\"><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400 ring-1 ring-emerald-500/25\">1</div><div><h3 class=\"text-base font-semibold text-foreground\">Identify the purchase price</h3><p class=\"mt-1 text-sm text-muted-foreground leading-relaxed\">Determine the pre-tax price of the item or service you are purchasing. This is the sticker price before any sales tax is added. For example, if a television is listed at $999, the purchase price is $999.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400 ring-1 ring-emerald-500/25\">2</div><div><h3 class=\"text-base font-semibold text-foreground\">Find your combined sales tax rate</h3><p class=\"mt-1 text-sm text-muted-foreground leading-relaxed\">Look up your state sales tax rate and any local (city, county, special district) taxes that apply. The combined rate is the sum of state + local rates. For example, California has a 7.25% state rate plus an average 1.57% local rate, giving a combined rate of 8.82%. Use the rate table above for all 50 states.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400 ring-1 ring-emerald-500/25\">3</div><div><h3 class=\"text-base font-semibold text-foreground\">Check for tax-exempt categories</h3><p class=\"mt-1 text-sm text-muted-foreground leading-relaxed\">Verify whether your purchase falls under a tax-exempt category in your state. Most states exempt groceries and prescription drugs from sales tax. A few states (Minnesota, New Jersey, Pennsylvania, Vermont) also exempt clothing. If the item is exempt, the sales tax is $0.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400 ring-1 ring-emerald-500/25\">4</div><div><h3 class=\"text-base font-semibold text-foreground\">Multiply price by the combined tax rate</h3><p class=\"mt-1 text-sm text-muted-foreground leading-relaxed\"><strong>Sales Tax = Purchase Price x Combined Tax Rate</strong>. For example, a $100 purchase at 8.25% combined rate = $100 x 0.0825 = $8.25 in sales tax. The state portion and local portion can be calculated separately: $100 x 0.06 = $6.00 state tax, $100 x 0.0225 = $2.25 local tax.</p></div></div><div class=\"flex gap-4\"><div class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-sm font-bold text-emerald-400 ring-1 ring-emerald-500/25\">5</div><div><h3 class=\"text-base font-semibold text-foreground\">Add the tax to get the total price</h3><p class=\"mt-1 text-sm text-muted-foreground leading-relaxed\"><strong>Total Price = Purchase Price + Sales Tax</strong>. Using the example: $100 + $8.25 = $108.25. Alternatively, you can calculate the total in one step: <strong>Total = Purchase Price x (1 + Tax Rate)</strong>. $100 x 1.0825 = $108.25.</p></div></div></div><div class=\"mt-6 rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-5\"><p class=\"text-sm font-semibold text-foreground mb-2\">Quick Example: $1,000 Purchase in California</p><div class=\"text-sm text-muted-foreground space-y-1\"><p>Purchase Price: $1,000.00</p><p>California State Rate: 7.25%</p><p>Average Local Rate: 1.57%</p><p>Combined Rate: 8.82%</p><p>State Tax: $72.50 | Local Tax: $15.70 | Total Tax: $88.20</p><p class=\"font-semibold text-foreground\">Total Price: $1,088.20</p></div></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Figuring Sales Tax — The Complete Guide</h2><div class=\"max-w-4xl space-y-4 text-muted-foreground leading-relaxed\"><p>Figuring sales tax is one of the most common calculations in everyday life. Whether you are at a retail store, buying a car, or shopping online, knowing how to figure sales tax helps you understand the true cost of your purchase. Our sales tax estimator above handles the math for you — but if you want to figure it out yourself, here is everything you need to know.</p><h3 class=\"text-lg font-semibold text-foreground mt-6\">Sales Tax Formula</h3><p>The sales tax formula is straightforward: <strong class=\"text-foreground\">Sales Tax = Purchase Price × Tax Rate</strong>. To get the total price including tax: <strong class=\"text-foreground\">Total = Purchase Price × (1 + Tax Rate)</strong>. For example, figuring sales tax on a $50 purchase at 7%: $50 × 0.07 = $3.50 in tax, for a total of $53.50.</p><h3 class=\"text-lg font-semibold text-foreground mt-6\">How to Figure Sales Tax on Any Purchase</h3><div class=\"grid gap-3 sm:grid-cols-2 my-4\"><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-sm font-semibold text-emerald-400 mb-1\">Retail Purchases</p><p class=\"text-xs text-muted-foreground\">In-store purchases automatically add sales tax at the register. The receipt shows the tax amount separately. Use our retail tax calculator above to estimate tax before you shop.</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-sm font-semibold text-sky-400 mb-1\">Online Shopping</p><p class=\"text-xs text-muted-foreground\">Since the 2018 Wayfair ruling, online retailers collect sales tax in most states. The tax rate is based on the delivery address, not the seller&#x27;s location. Use our sales tax estimator to check your rate.</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-sm font-semibold text-amber-400 mb-1\">Restaurant &amp; Food</p><p class=\"text-xs text-muted-foreground\">Restaurant meals are taxable in all states that have sales tax. Some states charge an additional restaurant tax or prepared food tax on top of the general sales tax. Groceries may be exempt or taxed at a lower rate.</p></div><div class=\"rounded-lg border border-border/30 bg-card/60 p-4\"><p class=\"text-sm font-semibold text-purple-400 mb-1\">Vehicles &amp; Big Ticket</p><p class=\"text-xs text-muted-foreground\">Car sales tax is usually paid at the DMV. Trade-in credits may reduce the taxable amount in most states (except CA). Use our car sales tax calculator above for exact numbers.</p></div></div><h3 class=\"text-lg font-semibold text-foreground mt-6\">Sales Tax by Purchase Type</h3><p>Different types of purchases may have different tax rates or exemptions within the same state. Here is a quick reference:</p><div class=\"overflow-x-auto rounded-lg border border-border/50 my-4\"><table class=\"w-full text-sm\"><thead><tr class=\"border-b border-border/50 bg-muted/30\"><th class=\"px-4 py-2.5 text-left font-semibold text-foreground\">Purchase Type</th><th class=\"px-4 py-2.5 text-left font-semibold text-foreground\">Typical Tax Treatment</th><th class=\"px-4 py-2.5 text-left font-semibold text-foreground\">Notes</th></tr></thead><tbody class=\"text-muted-foreground\"><tr class=\"border-b border-border/20 bg-card/30\"><td class=\"px-4 py-2\">General merchandise</td><td class=\"px-4 py-2\">Full state + local rate</td><td class=\"px-4 py-2\">Standard sales tax applies</td></tr><tr class=\"border-b border-border/20 bg-card/10\"><td class=\"px-4 py-2\">Groceries / food</td><td class=\"px-4 py-2\">Exempt or reduced in most states</td><td class=\"px-4 py-2\">IL charges 1%; MS charges full rate</td></tr><tr class=\"border-b border-border/20 bg-card/30\"><td class=\"px-4 py-2\">Prescription drugs</td><td class=\"px-4 py-2\">Exempt in all states with sales tax</td><td class=\"px-4 py-2\">OTC drugs vary by state</td></tr><tr class=\"border-b border-border/20 bg-card/10\"><td class=\"px-4 py-2\">Clothing</td><td class=\"px-4 py-2\">Exempt in MN, NJ, PA, VT</td><td class=\"px-4 py-2\">NY exempts items under $110</td></tr><tr class=\"border-b border-border/20 bg-card/30\"><td class=\"px-4 py-2\">Restaurant meals</td><td class=\"px-4 py-2\">Full rate + possible meal tax</td><td class=\"px-4 py-2\">Some cities add 1-2% restaurant tax</td></tr><tr class=\"bg-card/10\"><td class=\"px-4 py-2\">Vehicles</td><td class=\"px-4 py-2\">Full rate, trade-in may reduce</td><td class=\"px-4 py-2\">Paid at DMV, not dealership</td></tr></tbody></table></div><p>For the most accurate results, use our free sales tax estimator above. Select your state, enter the purchase price, and get instant calculations including state tax, local tax, and total price. It works as a retail tax calculator, food tax calculator, and general sales tax rate finder — all in one tool.</p></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Reverse Sales Tax Calculator -- How It Works</h2><div class=\"max-w-4xl space-y-4 text-muted-foreground leading-relaxed\"><p>A reverse sales tax calculator (also called a backwards sales tax calculator) finds the original price before tax when you only know the total amount paid. This is useful for expense reports, bookkeeping, and budgeting when you have a receipt showing only the total.</p><div class=\"rounded-lg border border-amber-500/20 bg-amber-500/5 p-5\"><p class=\"text-sm font-semibold text-foreground mb-2\">Reverse Sales Tax Formula</p><p class=\"text-lg font-mono text-amber-400 mb-2\">Original Price = Total Paid / (1 + Tax Rate)</p><p class=\"text-sm text-muted-foreground\"><strong>Example:</strong> You paid $1,088.20 total in California (8.82% combined rate).<br/>Original Price = $1,088.20 / 1.0882 = $1,000.00<br/>Sales Tax = $1,088.20 - $1,000.00 = $88.20</p></div><p>The reverse sales tax formula works because the total price is the original price multiplied by (1 + tax rate). By dividing the total by this factor, you reverse the calculation to find the pre-tax amount. This method is mathematically exact and works for any tax rate.</p><p>Use the reverse calculator above to instantly find original prices and tax amounts for any total and any state. Simply enter the total amount you paid and select your state.</p></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Car &amp; Vehicle Sales Tax Calculator</h2><div class=\"max-w-4xl space-y-4 text-muted-foreground leading-relaxed\"><p>Buying a car is one of the largest purchases most people make, and sales tax on a vehicle can add hundreds or thousands of dollars to the total cost. Our car sales tax calculator above estimates the sales tax on any vehicle purchase for all 50 states.</p><h3 class=\"text-lg font-semibold text-foreground mt-6\">How Vehicle Sales Tax Works</h3><p>In most states, the sales tax on a vehicle purchase is calculated the same way as general sales tax: the vehicle price multiplied by the combined state and local sales tax rate. However, there are important differences to know:</p><ul class=\"list-disc list-inside space-y-2 ml-4\"><li><strong class=\"text-foreground\">Trade-in credits:</strong> Most states (TX, FL, NY, IL, etc.) allow you to deduct the trade-in value from the purchase price before calculating sales tax. This can save you significant money -- on a $10,000 trade-in at 8% tax, that is $800 in tax savings.</li><li><strong class=\"text-foreground\">No trade-in credit states:</strong> California and a few other states do not allow trade-in deductions for sales tax purposes. You pay tax on the full vehicle price regardless of trade-in value.</li><li><strong class=\"text-foreground\">Registration and title fees:</strong> These are separate from sales tax and vary by state. They are typically not tax-deductible.</li><li><strong class=\"text-foreground\">Private party purchases:</strong> Some states charge use tax instead of sales tax on private-party vehicle sales, often at the same rate.</li></ul><div class=\"rounded-lg border border-blue-500/20 bg-blue-500/5 p-5\"><p class=\"text-sm font-semibold text-foreground mb-2\">Car Sales Tax Example</p><p class=\"text-sm text-muted-foreground\">Buying a $35,000 car in Texas with a $10,000 trade-in:<br/>Taxable amount: $35,000 - $10,000 = $25,000<br/>Texas combined rate: 8.20%<br/>Sales tax: $25,000 x 0.0820 = $2,050.00<br/>Total cost: $35,000 + $2,050.00 = $37,050.00</p></div></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">IRS Sales Tax Deduction</h2><div class=\"max-w-4xl space-y-4 text-muted-foreground leading-relaxed\"><p>If you itemize deductions on your federal tax return (Schedule A), you can choose to deduct state and local sales tax instead of state and local income tax. This is known as the IRS sales tax deduction, and it can save you thousands of dollars -- especially if you live in a state with no income tax.</p><h3 class=\"text-lg font-semibold text-foreground mt-4\">Who Should Use the Sales Tax Deduction?</h3><p>The sales tax deduction is most beneficial for residents of states with no income tax. These include Texas, Florida, Washington, Nevada, Wyoming, South Dakota, Alaska, Tennessee, and New Hampshire. Since these states do not charge income tax, deducting sales tax is almost always the better choice.</p><h3 class=\"text-lg font-semibold text-foreground mt-4\">How to Calculate the IRS Sales Tax Deduction</h3><p>You have two options for calculating your sales tax deduction:</p><ol class=\"list-decimal list-inside space-y-2 ml-4\"><li><strong class=\"text-foreground\">IRS Sales Tax Tables:</strong> The IRS provides optional state sales tax tables in the Schedule A instructions. These give you a standard deduction amount based on your income and state. You can add actual sales tax paid on major purchases (cars, boats, home improvements) on top of the table amount.</li><li><strong class=\"text-foreground\">Actual Receipts:</strong> Keep all receipts throughout the year and total the actual sales tax you paid. This method is more work but may result in a larger deduction if you made significant taxable purchases.</li></ol><div class=\"rounded-lg border border-emerald-500/20 bg-emerald-500/5 p-5\"><p class=\"text-sm text-muted-foreground\"><strong class=\"text-foreground\">Important:</strong> The SALT (State and Local Tax) deduction cap is $10,000 ($5,000 if married filing separately). This means the total of your state income tax or sales tax, plus property tax, cannot exceed $10,000. Plan your deductions accordingly.</p></div></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Online Sales Tax &amp; E-Commerce</h2><div class=\"max-w-4xl space-y-4 text-muted-foreground leading-relaxed\"><p>Since the landmark 2018 Supreme Court ruling in <a href=\"https://www.oyez.org/cases/2017/17-494\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-emerald-400 hover:underline\">South Dakota v. Wayfair, Inc.</a>, states can require online retailers to collect sales tax even if the retailer has no physical presence in the state. This decision overturned the previous physical presence requirement and fundamentally changed e-commerce taxation.</p><h3 class=\"text-lg font-semibold text-foreground mt-4\">Marketplace Facilitator Laws</h3><p>Most states have enacted marketplace facilitator laws that require platforms like Amazon, eBay, Etsy, and Walmart Marketplace to collect and remit sales tax on behalf of third-party sellers. This means that if you buy from a third-party seller on Amazon, Amazon is responsible for collecting the correct sales tax based on your location.</p><h3 class=\"text-lg font-semibold text-foreground mt-4\">Economic Nexus Thresholds</h3><p>States establish economic nexus thresholds that determine when an out-of-state seller must begin collecting sales tax. Common thresholds include $100,000 in annual sales or 200 transactions in the state. Once a seller exceeds these thresholds, they must register with the state and collect sales tax on future sales.</p><p>For consumers, the practical effect is that most online purchases now include sales tax. If you are shopping online and sales tax was not collected, you may owe use tax to your state. Use our sales tax calculator above to estimate how much tax you should have paid on tax-free online purchases.</p></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Lowest &amp; Highest Sales Tax States</h2><div class=\"grid gap-6 sm:grid-cols-2 max-w-4xl\"><div><h3 class=\"text-lg font-semibold text-foreground mb-3 flex items-center gap-2\"><span class=\"inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/15 text-xs font-bold text-emerald-400 ring-1 ring-emerald-500/25\">5</span>Lowest Combined Sales Tax Rates</h3><div class=\"space-y-2\"><div class=\"flex items-center justify-between rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/hawaii\">Hawaii</a><span class=\"text-sm font-bold text-emerald-400\">4.44<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/wyoming\">Wyoming</a><span class=\"text-sm font-bold text-emerald-400\">5.36<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/wisconsin\">Wisconsin</a><span class=\"text-sm font-bold text-emerald-400\">5.46<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/maine\">Maine</a><span class=\"text-sm font-bold text-emerald-400\">5.50<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-emerald-500/20 bg-emerald-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/virginia\">Virginia</a><span class=\"text-sm font-bold text-emerald-400\">5.75<!-- -->%</span></div></div><p class=\"mt-2 text-xs text-muted-foreground\">Excludes states with 0% sales tax (DE, MT, NH, OR).</p></div><div><h3 class=\"text-lg font-semibold text-foreground mb-3 flex items-center gap-2\"><span class=\"inline-flex h-6 w-6 items-center justify-center rounded-full bg-red-500/15 text-xs font-bold text-red-400 ring-1 ring-red-500/25\">5</span>Highest Combined Sales Tax Rates</h3><div class=\"space-y-2\"><div class=\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/louisiana\">Louisiana</a><span class=\"text-sm font-bold text-red-400\">9.56<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/tennessee\">Tennessee</a><span class=\"text-sm font-bold text-red-400\">9.56<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/arkansas\">Arkansas</a><span class=\"text-sm font-bold text-red-400\">9.47<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/washington\">Washington</a><span class=\"text-sm font-bold text-red-400\">9.41<!-- -->%</span></div><div class=\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\"><a class=\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\" href=\"/sales-tax-calculator/alabama\">Alabama</a><span class=\"text-sm font-bold text-red-400\">9.24<!-- -->%</span></div></div></div></div><div class=\"mt-6 max-w-4xl\"><h3 class=\"text-lg font-semibold text-foreground mb-3\">States with No Sales Tax</h3><div class=\"flex flex-wrap gap-3\"><a class=\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\" href=\"/sales-tax-calculator/alaska\">Alaska<!-- --> (0%)</a><a class=\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\" href=\"/sales-tax-calculator/delaware\">Delaware<!-- --> (0%)</a><a class=\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\" href=\"/sales-tax-calculator/montana\">Montana<!-- --> (0%)</a><a class=\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\" href=\"/sales-tax-calculator/newhampshire\">New Hampshire<!-- --> (0%)</a><a class=\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\" href=\"/sales-tax-calculator/oregon\">Oregon<!-- --> (0%)</a></div></div></section><section class=\"mt-12\" id=\"faq\"><h2 class=\"text-2xl font-bold text-foreground mb-6\">Sales Tax Calculator FAQ</h2><div class=\"space-y-4 max-w-4xl\"><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">How do I calculate sales tax?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Multiply the purchase price by the combined sales tax rate (state + local). For example, a $100 purchase at 8.25% combined rate: $100 x 0.0825 = $8.25 in sales tax. The total you pay is $108.25. Use the calculator above to get exact numbers for any state and price.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">How do I calculate sales tax backwards (reverse sales tax)?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Divide the total amount paid by (1 + tax rate). For example, if you paid $108.25 total and the combined tax rate is 8.25%: $108.25 / 1.0825 = $100.00 original price. The sales tax was $8.25. Use our reverse sales tax calculator above for instant results.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Which states have no sales tax?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Five states have no state sales tax: Delaware (0%), Montana (0%), New Hampshire (0%), Oregon (0%), and Alaska (0% state rate, but local municipalities can charge up to 7.5%). These no-sales-tax states are popular for large purchases, but your home state may require you to pay use tax on items brought back from tax-free states.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Do I pay sales tax on a car purchase?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Yes, most states charge sales tax on vehicle purchases. The rate is typically the same as the general sales tax rate for your location. Some states allow trade-in credits that reduce the taxable amount, potentially saving you hundreds of dollars. Car sales tax is usually paid at the DMV when you register the vehicle, not at the dealership. Use our car sales tax calculator above to estimate your vehicle tax.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Can I deduct sales tax on my IRS tax return?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Yes. On Schedule A (Itemized Deductions), you can choose to deduct state and local sales tax instead of state and local income tax -- but you cannot deduct both. This deduction is most beneficial for residents of states with no income tax (Texas, Florida, Washington, Nevada, Wyoming, South Dakota, Alaska, Tennessee, New Hampshire). The IRS provides optional sales tax tables, or you can calculate your actual sales tax paid using receipts.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">What is the average sales tax rate in the US?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">The average combined state and local sales tax rate across the US is approximately 6.5% to 7.5%. State-level rates range from 0% (in Delaware, Montana, New Hampshire, Oregon) to 7.25% (California). When local taxes are added, combined rates can exceed 10% in some cities. Louisiana, Tennessee, and Arkansas have the highest average combined rates.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Are groceries subject to sales tax?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Most states exempt groceries from state sales tax, though local taxes may still apply. A few states, like Mississippi, charge the full sales tax rate on groceries. Some states, like Illinois, charge a reduced rate (1%) on groceries. Check the tax-exempt categories in the calculator above for your specific state.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Do I pay sales tax on online purchases?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Yes. Since the 2018 South Dakota v. Wayfair Supreme Court ruling, online retailers must collect sales tax on purchases shipped to states that impose sales tax, regardless of physical presence. Marketplace facilitators like Amazon, eBay, and Etsy are required to collect and remit sales tax on behalf of third-party sellers in most states.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">What is a sales tax exemption?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">A sales tax exemption means certain items or services are not subject to sales tax. Common exemptions include groceries, prescription drugs, clothing (in some states like Minnesota, New Jersey, Pennsylvania), manufacturing equipment, and items purchased for resale. Non-profit organizations may also qualify for sales tax exemptions with proper documentation.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">How is sales tax calculated on a car with a trade-in?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">In most states, the trade-in value reduces the taxable amount. For example, buying a $35,000 car with a $10,000 trade-in at 6% sales tax means you pay tax on $25,000 ($1,500) instead of $35,000 ($2,100) -- saving $600. However, some states like California charge sales tax on the full vehicle price regardless of trade-in. Use our car sales tax calculator above for your state.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">What is the IRS sales tax deduction and who should use it?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">The IRS sales tax deduction allows you to deduct state and local sales tax on Schedule A instead of state and local income tax. This is especially valuable if you live in a state with no income tax (TX, FL, WA, NV, WY, SD, AK, TN, NH). You can use the IRS Sales Tax Deduction Calculator or actual receipts. The deduction is subject to the $10,000 SALT cap ($5,000 for married filing separately).</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Which state has the highest sales tax?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Louisiana has the highest average combined sales tax rate at approximately 9.56%, followed closely by Tennessee (9.56%) and Arkansas (9.47%). However, within any state, specific cities can have even higher rates due to local add-ons. For example, some cities in Alabama and Louisiana have combined rates exceeding 11%.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">How do I figure out sales tax from a total amount?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">To figure out sales tax from a total, divide the total by (1 + tax rate) to get the original price, then subtract the original from the total. For example, if you paid $107.00 total at 7% tax: $107.00 ÷ 1.07 = $100.00 original price. Sales tax = $107.00 - $100.00 = $7.00. Use our reverse sales tax calculator above for instant results.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">What is the sales tax formula?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">The sales tax formula is: Sales Tax = Purchase Price × Tax Rate. To calculate the total with tax: Total = Purchase Price × (1 + Tax Rate). For reverse calculation: Original Price = Total Paid ÷ (1 + Tax Rate). These formulas work for any state and any tax rate — just convert the percentage to a decimal (7% = 0.07).</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">How do I calculate sales tax on a restaurant bill?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Restaurant meals are subject to the full combined sales tax rate (state + local) in all states that impose sales tax. Some cities add an additional restaurant or prepared food tax of 1-2% on top. To calculate: multiply the bill amount by your combined rate. For a $50 bill at 8.5% combined rate: $50 × 0.085 = $4.25 in tax. Tip is calculated on the pre-tax amount and is not subject to sales tax.</p></div><div class=\"rounded-lg border border-border/50 bg-card/80 p-5\"><h3 class=\"text-base font-semibold text-foreground\">Can I find my sales tax rate by zip code?</h3><p class=\"mt-2 text-sm text-muted-foreground leading-relaxed\">Yes. Sales tax rates vary by location within each state because local (city, county, district) taxes are added on top of the state rate. Two addresses in the same state can have different combined rates. Our calculator above uses the average combined rate for each state. For the most precise rate by zip code, check your state department of revenue website or use the state and local rate override feature in our calculator.</p></div></div></section><section class=\"mt-12\"><h2 class=\"text-2xl font-bold text-foreground mb-4\">Sales Tax by State</h2><p class=\"text-muted-foreground mb-4\">Select a state for a detailed sales tax calculator with local rate override, reverse calculator, and tax-exempt information.</p><div class=\"flex flex-wrap gap-2 max-w-5xl\"><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\" href=\"/sales-tax-calculator/alabama\">AL<!-- --> <!-- -->9.2%</a><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\" href=\"/sales-tax-calculator/alaska\">AK<!-- --> <!-- -->0%</a><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\" href=\"/sales-tax-calculator/arizona\">AZ<!-- --> <!-- -->8.4%</a><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\" href=\"/sales-tax-calculator/arkansas\">AR<!-- --> <!-- -->9.5%</a><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\" href=\"/sales-tax-calculator/california\">CA<!-- --> <!-- -->8.8%</a><a class=\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foregroun