[\"$\",\"td\",null,{\"className\":\"px-4 py-2\",\"children\":\"Full rate + possible meal tax\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-2\",\"children\":\"Some cities add 1-2% restaurant tax\"}]]}],[\"$\",\"tr\",null,{\"className\":\"bg-card/10\",\"children\":[[\"$\",\"td\",null,{\"className\":\"px-4 py-2\",\"children\":\"Vehicles\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-2\",\"children\":\"Full rate, trade-in may reduce\"}],[\"$\",\"td\",null,{\"className\":\"px-4 py-2\",\"children\":\"Paid at DMV, not dealership\"}]]}]]}]\n5a:[\"$\",\"p\",null,{\"children\":\"For the most accurate results, use our free sales tax estimator above. Select your state, enter the purchase price, and get instant calculations including state tax, local tax, and total price. It works as a retail tax calculator, food tax calculator, and general sales tax rate finder — all in one tool.\"}]\n5b:[\"$\",\"span\",null,{\"className\":\"text-sm font-bold text-red-400\",\"children\":[\"9.56\",\"%\"]}]\n5c:[\"$\",\"div\",\"arkansas\",{\"className\":\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/sales-tax-calculator/arkansas\",\"className\":\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Arkansas\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-bold text-red-400\",\"children\":[\"9.47\",\"%\"]}]]}]\n5d:[\"$\",\"div\",\"washington\",{\"className\":\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/sales-tax-calculator/washington\",\"className\":\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Washington\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-bold text-red-400\",\"children\":[\"9.41\",\"%\"]}]]}]\n5e:[\"$\",\"div\",\"alabama\",{\"className\":\"flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-4 py-2.5\",\"children\":[[\"$\",\"$L8\",null,{\"href\":\"/sales-tax-calculator/alabama\",\"className\":\"text-sm font-medium text-foreground hover:text-emerald-400 transition-colors\",\"children\":\"Alabama\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-bold text-red-400\",\"children\":[\"9.24\",\"%\"]}]]}]\n5f:[\"$\",\"div\",null,{\"className\":\"mt-6 max-w-4xl\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-semibold text-foreground mb-3\",\"children\":\"States with No Sales Tax\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3\",\"children\":[[\"$\",\"$L8\",\"alaska\",{\"href\":\"/sales-tax-calculator/alaska\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":[\"Alaska\",\" (0%)\"]}],[\"$\",\"$L8\",\"delaware\",{\"href\":\"/sales-tax-calculator/delaware\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":[\"Delaware\",\" (0%)\"]}],[\"$\",\"$L8\",\"montana\",{\"href\":\"/sales-tax-calculator/montana\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":[\"Montana\",\" (0%)\"]}],[\"$\",\"$L8\",\"newhampshire\",{\"href\":\"/sales-tax-calculator/newhampshire\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":[\"New Hampshire\",\" (0%)\"]}],[\"$\",\"$L8\",\"oregon\",{\"href\":\"/sales-tax-calculator/oregon\",\"className\":\"inline-flex items-center rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-400 hover:bg-emerald-500/20 transition-colors\",\"children\":[\"Oregon\",\" (0%)\"]}]]}]]}]\n60:[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The average combined state and local sales tax rate across the US is approximately 6.5% to 7.5%. State-level rates range from 0% (in Delaware, Montana, New Hampshire, Oregon) to 7.25% (California). When local taxes are added, combined rates can exceed 10% in some cities. Louisiana, Tennessee, and Arkansas have the highest average combined rates.\"}]\n61:[\"$\",\"div\",\"6\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Are groceries subject to sales tax?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Most states exempt groceries from state sales tax, though local taxes may still apply. A few states, like Mississippi, charge the full sales tax rate on groceries. Some states, like Illinois, charge a reduced rate (1%) on groceries. Check the tax-exempt categories in the calculator above for your specific state.\"}]]}]\n62:[\"$\",\"div\",\"7\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Do I pay sales tax on online purchases?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Since the 2018 South Dakota v. Wayfair Supreme Court ruling, online retailers must collect sales tax on purchases shipped to states that impose sales tax, regardless of physical presence. Marketplace facilitators like Amazon, eBay, and Etsy are required to collect and remit sales tax on behalf of third-party sellers in most states.\"}]]}]\n63:[\"$\",\"div\",\"8\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"What is a sales tax exemption?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"A sales tax exemption means certain items or services are not subject to sales tax. Common exemptions include groceries, prescription drugs, clothing (in some states like Minnesota, New Jersey, Pennsylvania), manufacturing equipment, and items purchased for resale. Non-profit organizations may also qualify for sales tax exemptions with proper documentation.\"}]]}]\n64:[\"$\",\"div\",\"9\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"How is sales tax calculated on a car with a trade-in?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"In most states, the trade-in value reduces the taxable amount. For example, buying a $35,000 car with a $10,000 trade-in at 6% sales tax means you pay tax on $25,000 ($1,500) instead of $35,000 ($2,100) -- saving $600. However, some states like California charge sales tax on the full vehicle price regardless of trade-in. Use our car sales tax calculator above for your state.\"}]]}]\n65:[\"$\",\"div\",\"10\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"What is the IRS sales tax deduction and who should use it?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The IRS sales tax deduction allows you to deduct state and local sales tax on Schedule A instead of state and local income tax. This is especially valuable if you live in a state with no income tax (TX, FL, WA, NV, WY, SD, AK, TN, NH). You can use the IRS Sales Tax Deduction Calculator or actual receipts. The deduction is subject to the $10,000 SALT cap ($5,000 for married filing separately).\"}]]}]\n66:[\"$\",\"div\",\"11\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Which state has the highest sales tax?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Louisiana has the highest average combined sales tax rate at approximately 9.56%, followed closely by Tennessee (9.56%) and Arkansas (9.47%). However, within any state, specific cities can have even higher rates due to local add-ons. For example, some cities in Alabama and Louisiana have combined rates exceeding 11%.\"}]]}]\n67:[\"$\",\"div\",\"12\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"How do I figure out sales tax from a total amount?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"To figure out sales tax from a total, divide the total by (1 + tax rate) to get the original price, then subtract the original from the total. For example, if you paid $107.00 total at 7% tax: $107.00 ÷ 1.07 = $100.00 original price. Sales tax = $107.00 - $100.00 = $7.00. Use our reverse sales tax calculator above for instant results.\"}]]}]\n68:[\"$\",\"div\",\"13\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"What is the sales tax formula?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"The sales tax formula is: Sales Tax = Purchase Price × Tax Rate. To calculate the total with tax: Total = Purchase Price × (1 + Tax Rate). For reverse calculation: Original Price = Total Paid ÷ (1 + Tax Rate). These formulas work for any state and any tax rate — just convert the percentage to a decimal (7% = 0.07).\"}]]}]\n69:[\"$\",\"div\",\"14\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"How do I calculate sales tax on a restaurant bill?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Restaurant meals are subject to the full combined sales tax rate (state + local) in all states that impose sales tax. Some cities add an additional restaurant or prepared food tax of 1-2% on top. To calculate: multiply the bill amount by your combined rate. For a $50 bill at 8.5% combined rate: $50 × 0.085 = $4.25 in tax. Tip is calculated on the pre-tax amount and is not subject to sales tax.\"}]]}]\n6a:[\"$\",\"div\",\"15\",{\"className\":\"rounded-lg border border-border/50 bg-card/80 p-5\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-base font-semibold text-foreground\",\"children\":\"Can I find my sales tax rate by zip code?\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-sm text-muted-foreground leading-relaxed\",\"children\":\"Yes. Sales tax rates vary by location within each state because local (city, county, district) taxes are added on top of the state rate. Two addresses in the same state can have different combined rates. Our calculator above uses the average combined rate for each state. For the most precise rate by zip code, check your state department of revenue website or use the state and local rate override feature in our calculator.\"}]]}]\n6b:[\"$\",\"$L8\",\"illinois\",{\"href\":\"/sales-tax-calculator/illinois\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"IL\",\" \",\"8.9%\"]}]\n6c:[\"$\",\"$L8\",\"indiana\",{\"href\":\"/sales-tax-calculator/indiana\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"IN\",\" \",\"7.0%\"]}]\n6d:[\"$\",\"$L8\",\"iowa\",{\"href\":\"/sales-tax-calculator/iowa\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"IA\",\" \",\"6.9%\"]}]\n6e:[\"$\",\"$L8\",\"kansas\",{\"href\":\"/sales-tax-calculator/kansas\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"KS\",\" \",\"8.7%\"]}]\n6f:[\"$\",\"$L8\",\"kentucky\",{\"href\":\"/sales-tax-calculator/kentucky\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"KY\",\" \",\"6.0%\"]}]\n70:[\"$\",\"$L8\",\"louisiana\",{\"href\":\"/sales-tax-calculator/louisiana\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"LA\",\" \",\"9.6%\"]}]\n71:[\"$\",\"$L8\",\"maine\",{\"href\":\"/sales-tax-calculator/maine\",\"className\":\"inline-flex items-center rounded-md px-3 py-1.5 text-xs font-medium transition-colors bg-muted/30 text-muted-foreground border border-border/30 hover:bg-muted/50 hover:text-foreground\",\"children\":[\"ME\",\" \",\"5.5%\"]}]\n72:[\"$\"